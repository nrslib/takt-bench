   114	function copyAttachmentEntry(sourcePath: string, destinationPath: string): void {
   115	  const stats = fs.lstatSync(sourcePath);
   116	  if (stats.isSymbolicLink()) {
   117	    throw new Error(`Task attachments must not contain symlinks: ${sourcePath}`);
   118	  }
   119	  if (stats.isDirectory()) {
   120	    fs.mkdirSync(destinationPath, { recursive: true });
   121	    for (const entry of fs.readdirSync(sourcePath)) {
   122	      copyAttachmentEntry(path.join(sourcePath, entry), path.join(destinationPath, entry));
   123	    }
   124	    return;
   125	  }
   126	  if (!stats.isFile()) {
   127	    throw new Error(`Task attachments must be regular files or directories: ${sourcePath}`);
   128	  }
   129	  fs.mkdirSync(path.dirname(destinationPath), { recursive: true });
   130	  fs.copyFileSync(sourcePath, destinationPath);
   131	}
