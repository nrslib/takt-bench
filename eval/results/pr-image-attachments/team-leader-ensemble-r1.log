   172	/**
   173	 * Validate that downloaded content is actually an image and set proper extension
   174	 */
   175	export function validateAndSetImageExtension(attachment: StoredImageAttachment): StoredImageAttachment {
   176	  try {
   177	    const imageBuffer = fs.readFileSync(attachment.tempPath);
   178	    
   179	      // Check magic bytes to determine image type
   180	      let extension = '';
   181	      if (imageBuffer.length >= 8) {
   182	        // PNG: 89 50 4E 47 0D 0A 1A 0A
   183	        if (imageBuffer[0] === 0x89 && imageBuffer[1] === 0x50 && imageBuffer[2] === 0x4E && imageBuffer[3] === 0x47 && 
   184	            imageBuffer[4] === 0x0D && imageBuffer[5] === 0x0A && imageBuffer[6] === 0x1A && imageBuffer[7] === 0x0A) {
   185	          extension = '.png';
   186	        }
   187	        // JPEG: FF D8 FF
   188	        else if (imageBuffer.length >= 2 && imageBuffer[0] === 0xFF && imageBuffer[1] === 0xD8) {
   189	          extension = '.jpg';
   190	        }
   191	        // GIF: 47 49 46 38 37 61 or 47 49 46 38 39 61
   192	        else if (imageBuffer.length >= 6 && 
   193	                ((imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x38 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61) ||
   194	                 (imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x39 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61))) {
   195	          extension = '.gif';
   196	        }
   197	        // WebP: 52 49 46 46 ?? ?? ?? ?? 57 45 42 50 (RIFF....WEBP)
   198	        else if (imageBuffer.length >= 12 && 
   199	                imageBuffer[0] === 0x52 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x46 &&
   200	                imageBuffer[8] === 0x57 && imageBuffer[9] === 0x45 && imageBuffer[10] === 0x42 && imageBuffer[11] === 0x50) {
   201	          extension = '.webp';
   202	        }
   203	      }
   204	    
   205	    if (!extension) {
   206	      throw new Error('Unsupported image format');
   207	    }
   208	    
   209	    // Update file name and temp path with proper extension
   210	    const newFileName = attachment.fileName.replace(/\.[^.]+$/, extension);
   211	    const newTempPath = attachment.tempPath.replace(/\.[^.]+$/, extension);
   212	    
   213	    // Rename the file
   214	    fs.renameSync(attachment.tempPath, newTempPath);
   215	    
   216	    return {
   217	      ...attachment,
   218	      fileName: newFileName,
   219	      tempPath: newTempPath,
   220	    };
   221	  } catch (err) {
   222	     // Clean up on error
   223	     if (fs.existsSync(attachment.tempPath)) {
   224	       fs.unlinkSync(attachment.tempPath);
   225	     }
   226	     fs.rmSync(path.dirname(attachment.tempPath), { recursive: true, force: true });
   227	    throw new Error(`Failed to validate image: ${getErrorMessage(err)}`);
   228	  }
   229	}
