describe('extractImageUrls', () => {
  it('should extract markdown image URLs', () => {
    const text = '![alt](https://example.com/image.png)';
    expect(extractImageUrls(text)).toEqual(['https://example.com/image.png']);
  });

  it('should extract HTML image URLs with double quotes', () => {
    const text = '<img src="https://example.com/image.png" />';
    expect(extractImageUrls(text)).toEqual(['https://example.com/image.png']);
  });

  it('should extract HTML image URLs with single quotes', () => {
    const text = "<img src='https://example.com/image.png' />";
    expect(extractImageUrls(text)).toEqual(['https://example.com/image.png']);
  });

  it('should maintain order of appearance for mixed syntax', () => {
    const text = '<img src="https://example.com/first.png" />![alt](https://example.com/second.png)<img src=\'https://example.com/third.png\' />';
    expect(extractImageUrls(text)).toEqual([
      'https://example.com/first.png',
      'https://example.com/second.png',
      'https://example.com/third.png'
    ]);
  });

  it('should remove duplicates while preserving first occurrence order', () => {
    const text = '![alt](https://example.com/image.png)<img src="https://example.com/image.png" /><img src=\'https://example.com/other.png\' />![alt](https://example.com/image.png)';
    expect(extractImageUrls(text)).toEqual([
      'https://example.com/image.png',
      'https://example.com/other.png'
    ]);
  });

  it('should ignore plain URLs that are not in image syntax', () => {
    const text = 'Check https://example.com/image.png for details![alt](https://example.com/real.png)';
    expect(extractImageUrls(text)).toEqual(['https://example.com/real.png']);
  });

  it('should return empty array for text without images', () => {
    const text = 'Just plain text with no images.';
    expect(extractImageUrls(text)).toEqual([]);
  });
});

describe('filterGithubAttachmentUrls', () => {
  it('should keep GitHub attachment URLs', () => {
    const urls = [
      'https://github.com/user-attachments/assets/abc123.png',
      'https://user-images.githubusercontent.com/1234567/abc-def.png',
      'https://assets.githubusercontent.com/images/environments/octocat.png'
    ];
    expect(filterGithubAttachmentUrls(urls)).toEqual(urls);
  });

  it('should reject non-GitHub URLs', () => {
    const urls = [
      'https://example.com/image.png',
      'https://github.com/user-attachments/assets/abc123.png', // valid
      'https://google.com/logo.png'
    ];
    expect(filterGithubAttachmentUrls(urls)).toEqual([
      'https://github.com/user-attachments/assets/abc123.png'
    ]);
  });

  it('should handle empty array', () => {
    expect(filterGithubAttachmentUrls([])).toEqual([]);
  });

  it('should handle invalid URLs gracefully', () => {
      const urls = [
        'not-a-url',
        'https://github.com/user-attachments/assets/valid.png'
      ];
      expect(filterGithubAttachmentUrls(urls)).toEqual([
        'https://github.com/user-attachments/assets/valid.png'
      ]);
    });
  });

