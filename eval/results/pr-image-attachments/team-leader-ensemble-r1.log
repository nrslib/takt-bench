import { createHash } from 'node:crypto';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { execFileSync } from 'node:child_process';
import { mkdtempSync } from 'node:fs';
import { getErrorMessage } from './index.js';
import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
import { assertRegularImageAttachmentFile } from './imageAttachmentReferences.js';
import { ensureCurrentTmpDirExists } from './tmpdir.js';


/**
 * Extract image URLs from text (markdown and HTML formats)
 * Supports:
 * - ![alt](url)
 * - <img src="url" />
 * - <img src='url' />
 */
export function extractImageUrls(text: string): string[] {
  const matches: { position: number; url: string }[] = [];

  // Markdown image syntax: ![alt](url)
  const markdownRegex = /!\[[^\]]*\]\(([^)]+)\)/g;
  let match;
  while ((match = markdownRegex.exec(text)) !== null) {
    const captured = match[1];
    if (captured !== undefined) {
      matches.push({ position: match.index, url: captured });
    }
  }

  // HTML img tag with double quotes: <img src="url" />
  const htmlDoubleRegex = /<img\s+[^>]*src="([^"]*)"[^>]*\/?>/gi;
  while ((match = htmlDoubleRegex.exec(text)) !== null) {
    const captured = match[1];
    if (captured !== undefined) {
      matches.push({ position: match.index, url: captured });
    }
  }

  // HTML img tag with single quotes: <img src='url' />
  const htmlSingleRegex = /<img\s+[^>]*src='([^']*)'[^>]*\/?>/gi;
  while ((match = htmlSingleRegex.exec(text)) !== null) {
    const captured = match[1];
    if (captured !== undefined) {
      matches.push({ position: match.index, url: captured });
    }
  }

  // Sort by position to maintain order of appearance
  matches.sort((a, b) => a.position - b.position);

  // Remove duplicates while preserving the order of first appearance
  const seen = new Set<string>();
  const uniqueUrls: string[] = [];
  for (const match of matches) {
    if (!seen.has(match.url)) {
      seen.add(match.url);
      uniqueUrls.push(match.url);
    }
  }

  return uniqueUrls;
}

/**
 * Filter URLs to only include GitHub attachment URLs for security
 */
export function filterGithubAttachmentUrls(urls: string[]): string[] {
  return urls.filter(url => {
    try {
      const urlObj = new URL(url);
      // GitHub attachment URLs typically follow patterns like:
      // https://github.com/user-attachments/assets/...
      // https://user-images.githubusercontent.com/...
      // https://assets.githubusercontent.com/...
      return (
        urlObj.hostname === 'github.com' && 
        urlObj.pathname.includes('/user-attachments/assets/')
      ) || 
      urlObj.hostname.endsWith('.githubusercontent.com');
    } catch {
      return false;
    }
  });
}

/**
 * Download an image from a URL using gh CLI
 * Returns a StoredImageAttachment object with temp file path and placeholder
 */
export function downloadImage(url: string, cwd: string, successCount: number): StoredImageAttachment {
  // Create temporary directory for downloaded image
  const tmpDir = mkdtempSync(path.join(ensureCurrentTmpDirExists(), 'takt-image-'));
  let fileName: string = '';
  let tempPath: string = '';
  try {
     const ghStatus = checkGhCli(cwd);
     if (!ghStatus.available) {
       throw new Error((ghStatus as { error: string }).error);
     }

    fileName = `image-${createHash('sha256').update(url).digest('hex').slice(0, 8)}.tmp`;
    tempPath = path.join(tmpDir, fileName);

    // Use gh api to download the image (works with authenticated requests)
    const buffer = execFileSync(
      'gh',
      ['api', url, '--method', 'GET', '--header', 'Accept: application/octet-stream'],
      { cwd, encoding: 'buffer', maxBuffer: 100 * 1024 * 1024 } // 100MB max
    );
    
    fs.writeFileSync(tempPath, buffer);
    
    // Validate it's a regular image file
    assertRegularImageAttachmentFile(tempPath, 'Downloaded image');
    
      // Now validate and set the proper extension
      const imageBuffer = fs.readFileSync(tempPath);
      let extension = '';
      if (imageBuffer.length >= 8) {
        // PNG: 89 50 4E 47 0D 0A 1A 0A
        if (imageBuffer[0] === 0x89 && imageBuffer[1] === 0x50 && imageBuffer[2] === 0x4E && imageBuffer[3] === 0x47 && 
            imageBuffer[4] === 0x0D && imageBuffer[5] === 0x0A && imageBuffer[6] === 0x1A && imageBuffer[7] === 0x0A) {
          extension = '.png';
        }
        // JPEG: FF D8 FF
        else if (imageBuffer.length >= 2 && imageBuffer[0] === 0xFF && imageBuffer[1] === 0xD8) {
          extension = '.jpg';
        }
        // GIF: 47 49 46 38 37 61 or 47 49 46 38 39 61
        else if (imageBuffer.length >= 6 && 
                ((imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x38 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61) ||
                 (imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x39 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61))) {
          extension = '.gif';
        }
        // WebP: 52 49 46 46 ?? ?? ?? ?? 57 45 42 50 (RIFF....WEBP)
        else if (imageBuffer.length >= 12 && 
                imageBuffer[0] === 0x52 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x46 &&
                imageBuffer[8] === 0x57 && imageBuffer[9] === 0x45 && imageBuffer[10] === 0x42 && imageBuffer[11] === 0x50) {
          extension = '.webp';
        }
      }
    
    if (!extension) {
      throw new Error('Unsupported image format');
    }
    
    // Update file name and temp path with proper extension
    const newFileName = fileName.replace(/\.[^.]+$/, extension);
    const newTempPath = tempPath.replace(/\.[^.]+$/, extension);
    
    // Rename the file
    fs.renameSync(tempPath, newTempPath);
    
    return {
      placeholder: `[Image #${successCount + 1}]`,
      tempPath: newTempPath,
      fileName: newFileName,
    };
  } catch (err) {
    // Clean up temp file if it was created
    if (tempPath && fs.existsSync(tempPath)) {
      fs.unlinkSync(tempPath);
    }
     // Clean up temp directory
     fs.rmSync(tmpDir, { recursive: true, force: true });
    throw new Error(`Failed to download image from ${url}: ${getErrorMessage(err)}`);
  }
}

/**
 * Validate that downloaded content is actually an image and set proper extension
 */
export function validateAndSetImageExtension(attachment: StoredImageAttachment): StoredImageAttachment {
  try {
    const imageBuffer = fs.readFileSync(attachment.tempPath);
    
      // Check magic bytes to determine image type
      let extension = '';
      if (imageBuffer.length >= 8) {
        // PNG: 89 50 4E 47 0D 0A 1A 0A
        if (imageBuffer[0] === 0x89 && imageBuffer[1] === 0x50 && imageBuffer[2] === 0x4E && imageBuffer[3] === 0x47 && 
            imageBuffer[4] === 0x0D && imageBuffer[5] === 0x0A && imageBuffer[6] === 0x1A && imageBuffer[7] === 0x0A) {
          extension = '.png';
        }
        // JPEG: FF D8 FF
        else if (imageBuffer.length >= 2 && imageBuffer[0] === 0xFF && imageBuffer[1] === 0xD8) {
          extension = '.jpg';
        }
        // GIF: 47 49 46 38 37 61 or 47 49 46 38 39 61
        else if (imageBuffer.length >= 6 && 
                ((imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x38 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61) ||
                 (imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x39 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61))) {
          extension = '.gif';
        }
        // WebP: 52 49 46 46 ?? ?? ?? ?? 57 45 42 50 (RIFF....WEBP)
        else if (imageBuffer.length >= 12 && 
                imageBuffer[0] === 0x52 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x46 &&
                imageBuffer[8] === 0x57 && imageBuffer[9] === 0x45 && imageBuffer[10] === 0x42 && imageBuffer[11] === 0x50) {
          extension = '.webp';
        }
      }
    
    if (!extension) {
      throw new Error('Unsupported image format');
    }
    
    // Update file name and temp path with proper extension
    const newFileName = attachment.fileName.replace(/\.[^.]+$/, extension);
    const newTempPath = attachment.tempPath.replace(/\.[^.]+$/, extension);
    
    // Rename the file
    fs.renameSync(attachment.tempPath, newTempPath);
    
    return {
      ...attachment,
      fileName: newFileName,
      tempPath: newTempPath,
    };
  } catch (err) {
     // Clean up on error
     if (fs.existsSync(attachment.tempPath)) {
       fs.unlinkSync(attachment.tempPath);
     }
     fs.rmSync(path.dirname(attachment.tempPath), { recursive: true, force: true });
    throw new Error(`Failed to validate image: ${getErrorMessage(err)}`);
  }
}

/**
 * Check if gh CLI is available
 */
export function checkGhCli(cwd: string = process.cwd()): { available: true } | { available: false; error: string } {
  try {
    execFileSync('gh', ['--version'], { cwd, stdio: 'pipe' });
    return { available: true };
   } catch {
     return { 
       available: false, 
       error: '`gh` CLI がインストールされていません。https://cli.github.com からインストールしてください' 
     };
   }
}

/**
 * Get temporary directory
 */
export function getTempDir(): string {
  return process.env.TMPDIR || '/tmp';
}import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { extractImageUrls, filterGithubAttachmentUrls, downloadImage, validateAndSetImageExtension } from '../shared/utils/imageUrls.js';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { tmpdir } from 'node:os';
