    71	    try {
    72	      const urlObj = new URL(url);
    73	      // GitHub attachment URLs typically follow patterns like:
    74	      // https://github.com/user-attachments/assets/...
    75	      // https://user-images.githubusercontent.com/...
    76	      // https://assets.githubusercontent.com/...
    77	      return (
