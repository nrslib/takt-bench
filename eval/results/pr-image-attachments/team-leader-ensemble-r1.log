     6	export async function resolveIssueInput(
     7	  issueOption: number | undefined,
     8	  task: string | undefined,
     9	  cwd?: string,
    10	): Promise<{ initialInput: string; issueNumber?: number } | null> {
    11	  if (issueOption) {
    12	    const provider = getGitProvider();
    13	    const cliStatus = provider.checkCliStatus(cwd);
    14	    if (!cliStatus.available) {
    15	      throw new Error(cliStatus.error);
    16	    }
    17	    const issue = await withProgress(
    18	      'Fetching issue...',
    19	      (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
    20	      async () => provider.fetchIssue(issueOption, cwd),
    21	    );
    22	    return { initialInput: formatIssueAsTask(issue), issueNumber: issueOption };
    23	  }
    24	
    25	  if (task && isDirectTask(task)) {
    26	    const provider = getGitProvider();
    27	    const cliStatus = provider.checkCliStatus(cwd);
    28	    if (!cliStatus.available) {
    29	      throw new Error(cliStatus.error);
    30	    }
    31	    const tokens = task.trim().split(/\s+/);
    32	    const issueNumbers = parseIssueNumbers(tokens);
    33	    if (issueNumbers.length === 0) {
    34	      throw new Error(`Invalid issue reference: ${task}`);
    35	    }
    36	    const issues = await withProgress(
    37	      'Fetching issues...',
    38	      (fetchedIssues) => `Issues fetched: ${fetchedIssues.map((issue) => `#${issue.number}`).join(', ')}`,
    39	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    40	    );
    41	    return {
    42	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    43	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
    44	    };
    45	  }
    46	
    47	  return null;
    48	}
