   363	  reportDirName?: string,
   364	): Promise<boolean> {
   365	  const safeWorkflow = sanitizeTerminalText(workflow);
   366	  info(`Running workflow: ${safeWorkflow}`);
   367	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   368	    ? {
   369	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   370	        ...(options.model !== undefined ? { model: options.model } : {}),
   371	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   372	      }
