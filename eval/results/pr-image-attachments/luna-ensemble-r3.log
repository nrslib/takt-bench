+const IMAGE_FORMATS: Readonly<Record<string, GitHubImagePayload>> = {
+  'image/png': { mimeType: 'image/png', extension: 'png' },
+  'image/jpeg': { mimeType: 'image/jpeg', extension: 'jpg' },
+  'image/gif': { mimeType: 'image/gif', extension: 'gif' },
+  'image/webp': { mimeType: 'image/webp', extension: 'webp' },
+};
+
+function removeHtmlComments(text: string): string {
+  let result = '';
+  let cursor = 0;
+  while (cursor < text.length) {
+    const start = text.indexOf('<!--', cursor);
+    if (start === -1) {
+      result += text.slice(cursor);
+      break;
+    }
+    result += text.slice(cursor, start);
+    const end = text.indexOf('-->', start + 4);
+    if (end === -1) {
+      result += ' '.repeat(text.length - start);
+      break;
+    }
+    result += ' '.repeat(end + 3 - start);
+    cursor = end + 3;
+  }
+  return result;
+}
+
+function removeFencedCodeBlocks(text: string): string {
+  const lines = text.split('\n');
+  let fenceCharacter: '`' | '~' | undefined;
+  let fenceLength = 0;
+
+  for (let index = 0; index < lines.length; index += 1) {
+    const lineWithoutQuote = lines[index]!.replace(/^\s{0,3}(?:>\s?)+/, '');
+    const fence = lineWithoutQuote.match(/^\s{0,3}(`{3,}|~{3,})/);
+    if (fenceCharacter !== undefined) {
+      lines[index] = ' '.repeat(lines[index]!.length);
+      if (
+        fence
+        && fence[1]![0] === fenceCharacter
+        && fence[1]!.length >= fenceLength
+      ) {
+        fenceCharacter = undefined;
+        fenceLength = 0;
+      }
+      continue;
+    }
+    if (fence) {
+      fenceCharacter = fence[1]![0] as '`' | '~';
+      fenceLength = fence[1]!.length;
+      lines[index] = ' '.repeat(lines[index]!.length);
+    }
+  }
+
+  return lines.join('\n');
+}
+
+function removeInlineCode(text: string): string {
+  let result = text;
+  let cursor = 0;
+  while (cursor < result.length) {
+    const start = result.indexOf('`', cursor);
+    if (start === -1) {
+      break;
+    }
+    let markerLength = 1;
+    while (result[start + markerLength] === '`') {
+      markerLength += 1;
+    }
+    const marker = '`'.repeat(markerLength);
+    const end = result.indexOf(marker, start + markerLength);
+    const endExclusive = end === -1 ? result.length : end + markerLength;
+    result = `${result.slice(0, start)}${' '.repeat(endExclusive - start)}${result.slice(endExclusive)}`;
+    cursor = endExclusive;
+  }
+  return result;
+}
+
+function removeNonRenderableMarkdown(text: string): string {
+  return removeInlineCode(removeFencedCodeBlocks(removeHtmlComments(text)));
+}
+
+function normalizeRepositoryPart(value: string): string {
+  return value.toLowerCase();
+}
+
+function isGitHubPullRequestUrl(value: string): boolean {
+  try {
+    const parsed = new URL(value);
+    return parsed.protocol === 'https:'
+      && ['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase());
+  } catch {
+    return false;
+  }
+}
+
+function classifyGitHubAttachmentUrl(
+  value: string,
+  repository: GitHubRepository,
+): GitHubAttachmentRequest | undefined {
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    return undefined;
+  }
+
+  if (
+    parsed.protocol !== 'https:'
+    || !['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase())
+    || parsed.username.length > 0
+    || parsed.password.length > 0
+    || parsed.port.length > 0
+  ) {
+    return undefined;
+  }
+
+  const segments = parsed.pathname.split('/').filter(Boolean);
+  if (segments[0] === 'user-attachments' && segments[1] === 'assets') {
+    return segments.length >= 3 ? { requiresAuthentication: false } : undefined;
+  }
+
+  if (segments.length < 4 || segments[2] !== 'assets' || segments[3]!.length === 0) {
+    return undefined;
+  }
+  if (
+    normalizeRepositoryPart(segments[0]!) !== normalizeRepositoryPart(repository.owner)
+    || normalizeRepositoryPart(segments[1]!) !== normalizeRepositoryPart(repository.repo)
+  ) {
+    return undefined;
+  }
+  return { requiresAuthentication: true };
+}
+
+export function isAllowedGitHubAttachmentUrl(
+  value: string,
+  repository: GitHubRepository,
+): boolean {
+  return classifyGitHubAttachmentUrl(value, repository) !== undefined;
+}
+
+function hasPrefix(data: Buffer, prefix: readonly number[]): boolean {
+  return prefix.every((value, index) => data[index] === value);
+}
+
+function hasWebpSignature(data: Buffer): boolean {
+  return hasPrefix(data, [0x52, 0x49, 0x46, 0x46])
+    && data.length >= 12
+    && data.subarray(8, 12).toString('ascii') === 'WEBP';
+}
+
+function matchesImageFormat(mimeType: string, data: Buffer): boolean {
+  switch (mimeType) {
+    case 'image/png':
+      return hasPrefix(data, [0x89, 0x50, 0x4e, 0x47]);
+    case 'image/jpeg':
+      return hasPrefix(data, [0xff, 0xd8, 0xff]);
+    case 'image/gif':
+      return data.subarray(0, 6).toString('ascii') === 'GIF87a'
+        || data.subarray(0, 6).toString('ascii') === 'GIF89a';
+    case 'image/webp':
+      return hasWebpSignature(data);
+  }
+  return false;
+}
+
+export function validateGitHubImagePayload(
+  contentType: string,
+  data: Buffer,
+): GitHubImagePayload {
+  const mimeType = contentType.split(';', 1)[0]!.trim().toLowerCase();
+  const format = IMAGE_FORMATS[mimeType];
+  if (format === undefined) {
+    throw new Error(`Unsupported GitHub image Content-Type: ${contentType}`);
+  }
+  if (data.length > MAX_GITHUB_IMAGE_BYTES) {
+    throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
+  }
+  if (!matchesImageFormat(mimeType, data)) {
+    throw new Error(`Content-Type and image data do not match: ${contentType}`);
+  }
+  return format;
+}
+
+interface ImageMatch {
+  readonly index: number;
+  readonly url: string;
+}
+
+function existingImageNumbers(prReview: PrReviewData): Set<number> {
+  const usedNumbers = new Set<number>();
+  const placeholderPattern = /\[Image #(\d+)\]/g;
+  for (const body of getPrReviewBodiesInTaskOrder(prReview)) {
+    for (const match of removeNonRenderableMarkdown(body).matchAll(placeholderPattern)) {
+      const number = Number(match[1]);
+      if (Number.isSafeInteger(number) && number > 0) {
+        usedNumbers.add(number);
+      }
+    }
+  }
+  return usedNumbers;
+}
+
+function nextAvailableImageNumber(usedNumbers: Set<number>): number {
+  let number = 1;
+  while (usedNumbers.has(number)) {
+    number += 1;
+  }
+  usedNumbers.add(number);
+  return number;
+}
+
+export function extractGitHubPrImageReferences(prReview: PrReviewData): GitHubPrImageReference[] {
+  const references: GitHubPrImageReference[] = [];
+  const seenUrls = new Set<string>();
+  const usedNumbers = existingImageNumbers(prReview);
+  const repository = parseGitHubRepositoryFromPrUrl(prReview.url);
+  const markdownImagePattern = /(?<!\\)!\[[^\]]*\]\(\s*(https:\/\/[^)\s]+)(?:\s+["'][^)]*["'])?\s*\)/g;
+  const htmlImagePattern = /<img\b[^>]*\bsrc\s*=\s*["'](https:\/\/[^"']+)["'][^>]*>/gi;
+
+  for (const body of getPrReviewBodiesInTaskOrder(prReview)) {
+    const sanitizedBody = removeNonRenderableMarkdown(body);
+    const matches: ImageMatch[] = [
+      ...Array.from(sanitizedBody.matchAll(markdownImagePattern), (match) => ({
+        index: match.index ?? 0,
+        url: match[1]!,
+      })),
+      ...Array.from(sanitizedBody.matchAll(htmlImagePattern), (match) => ({
+        index: match.index ?? 0,
+        url: match[1]!,
+      })),
+    ].sort((left, right) => left.index - right.index);
+
+    for (const match of matches) {
+      if (
+        !isAllowedGitHubAttachmentUrl(match.url, repository)
+        || seenUrls.has(match.url)
+      ) {
+        continue;
+      }
+      seenUrls.add(match.url);
+      const number = nextAvailableImageNumber(usedNumbers);
+      references.push({
+        placeholder: `[Image #${number}]`,
+        url: match.url,
+      });
+    }
+  }
+  return references;
+}
+
+export function replaceGitHubPrImageReferences(
+  text: string,
+  references: readonly GitHubPrImageReference[],
+): string {
+  const renderedText = removeNonRenderableMarkdown(text);
+  const replacements: Array<{ start: number; end: number; value: string }> = [];
+  for (const reference of references) {
+    const escapedUrl = reference.url.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    const markdownPattern = new RegExp(
+      `(?<!\\\\)!\\[[^\\]]*\\]\\(\\s*${escapedUrl}(?:\\s+["'][^)]*["'])?\\s*\\)`,
+      'g',
+    );
+    const htmlPattern = new RegExp(
+      `<img\\b[^>]*\\bsrc\\s*=\\s*["']${escapedUrl}["'][^>]*>`,
+      'gi',
+    );
+    for (const match of renderedText.matchAll(markdownPattern)) {
+      if (match.index !== undefined) {
+        replacements.push({
+          start: match.index,
+          end: match.index + match[0].length,
+          value: reference.placeholder,
+        });
+      }
+    }
+    for (const match of renderedText.matchAll(htmlPattern)) {
+      if (match.index !== undefined) {
+        replacements.push({
+          start: match.index,
+          end: match.index + match[0].length,
+          value: reference.placeholder,
+        });
+      }
+    }
+  }
+
+  return replacements
+    .sort((left, right) => right.start - left.start)
+    .reduce(
+      (result, replacement) => `${result.slice(0, replacement.start)}${replacement.value}${result.slice(replacement.end)}`,
+      text,
+    );
+}
+
+function readImageNumber(placeholder: string): number {
+  const number = Number(placeholder.match(/^\[Image #(\d+)\]$/)?.[1]);
+  if (!Number.isSafeInteger(number) || number < 1) {
+    throw new Error(`Invalid GitHub image placeholder: ${placeholder}`);
+  }
+  return number;
+}
+
+function getGitHubAuthToken(cwd: string): string {
+  const token = execFileSync('gh', ['auth', 'token'], {
+    cwd,
+    encoding: 'utf-8',
+    stdio: ['pipe', 'pipe', 'pipe'],
+  }).trim();
+  if (token.length === 0) {
+    throw new Error('gh auth token returned an empty token');
+  }
+  return token;
+}
+
+async function readResponseBody(response: Response): Promise<Buffer> {
+  const contentLength = response.headers.get('content-length');
+  if (contentLength !== null) {
+    const declaredLength = Number(contentLength);
+    if (Number.isSafeInteger(declaredLength) && declaredLength > MAX_GITHUB_IMAGE_BYTES) {
+      throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
+    }
+  }
+
+  if (response.body === null) {
+    throw new Error('GitHub image response body is missing');
+  }
+
+  const reader = response.body.getReader();
+  const chunks: Buffer[] = [];
+  let totalBytes = 0;
+  while (true) {
+    const chunk = await reader.read();
+    if (chunk.done) {
+      break;
+    }
+    const buffer = Buffer.from(chunk.value);
+    totalBytes += buffer.length;
+    if (totalBytes > MAX_GITHUB_IMAGE_BYTES) {
+      await reader.cancel();
+      throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
+    }
+    chunks.push(buffer);
+  }
+  return Buffer.concat(chunks, totalBytes);
+}
+
+async function fetchGitHubImage(
+  url: string,
+  token: string | undefined,
+): Promise<{ contentType: string; body: Buffer }> {
+  const headers = new Headers({ Accept: 'application/octet-stream' });
+  if (token !== undefined) {
+    headers.set('Authorization', `Bearer ${token}`);
+  }
+  const response = await fetch(url, { headers });
+  if (!response.ok) {
+    throw new Error(`GitHub image request failed with HTTP ${response.status}`);
+  }
+  const contentType = response.headers.get('content-type');
+  if (contentType === null || contentType.trim().length === 0) {
+    throw new Error('GitHub image response Content-Type is missing');
+  }
+  return { contentType, body: await readResponseBody(response) };
+}
+
+function createGitHubPrImageResource(
+  attachmentDirectory: string,
+  attachments: readonly StoredImageAttachment[],
+): GitHubPrImageResource {
+  let cleaned = false;
+  const cleanupOnExit = (): void => {
+    try {
+      cleanup();
+    } catch (error) {
+      log.debug('Failed to cleanup GitHub PR image resource on process exit', {
+        error: getErrorMessage(error),
+      });
+    }
+  };
+  const cleanup = (): void => {
+    if (cleaned) {
+      return;
+    }
+    rmSync(attachmentDirectory, { recursive: true, force: true });
+    cleaned = true;
+    process.removeListener('exit', cleanupOnExit);
+  };
+  process.once('exit', cleanupOnExit);
+  return { attachments, cleanup };
+}
+
+export async function downloadGitHubPrImages(
+  references: readonly GitHubPrImageReference[],
+  cwd: string,
+  prUrl: string,
+): Promise<GitHubPrImageResource> {
+  if (references.length === 0) {
+    return { attachments: [], cleanup: () => undefined };
+  }
+
+  const repository = parseGitHubRepositoryFromPrUrl(prUrl);
+  const requests = references.map((reference) => {
+    const request = classifyGitHubAttachmentUrl(reference.url, repository);
+    if (request === undefined) {
+      throw new Error(`GitHub image URL is outside the pull request repository scope: ${reference.url}`);
+    }
+    return request;
+  });
+  const token = requests.some((request) => request.requiresAuthentication)
+    ? getGitHubAuthToken(cwd)
+    : undefined;
+  const attachmentDirectory = mkdtempSync(path.join(os.tmpdir(), `takt-github-pr-${randomUUID()}-`));
+  const attachments: StoredImageAttachment[] = [];
+  const imageResource = createGitHubPrImageResource(attachmentDirectory, attachments);
+
+  try {
+    ensurePrivateDirectory(attachmentDirectory);
+    for (const [index, reference] of references.entries()) {
+      const response = await fetchGitHubImage(
+        reference.url,
+        requests[index]!.requiresAuthentication ? token : undefined,
+      );
+      const image = validateGitHubImagePayload(response.contentType, response.body);
+      const imageNumber = readImageNumber(reference.placeholder);
+      const fileName = `image-${imageNumber}.${image.extension}`;
+      const tempPath = path.join(attachmentDirectory, fileName);
+      writeNewPrivateFileWithMode(tempPath, response.body, 0o600);
+      attachments.push({ placeholder: reference.placeholder, tempPath, fileName });
+    }
+    return imageResource;
+  } catch (error) {
+    imageResource.cleanup();
+    throw error;
+  }
+}
+
+export async function prepareGitHubPrTask(
+  prReview: PrReviewData,
+  cwd: string,
+): Promise<PreparedGitHubPrTask> {
+  if (!isGitHubPullRequestUrl(prReview.url)) {
+    return { review: prReview };
+  }
+  const references = extractGitHubPrImageReferences(prReview);
+  if (references.length === 0) {
+    return { review: prReview };
+  }
+
+  const imageResource = await downloadGitHubPrImages(references, cwd, prReview.url);
+  try {
+    return {
+      review: {
+        ...prReview,
+        body: replaceGitHubPrImageReferences(prReview.body, references),
+        comments: prReview.comments.map((comment) => ({
+          ...comment,
+          body: replaceGitHubPrImageReferences(comment.body, references),
+        })),
+        reviews: prReview.reviews.map((review) => ({
+          ...review,
+          body: replaceGitHubPrImageReferences(review.body, references),
+        })),
+      },
+      imageResource,
+    };
+  } catch (error) {
+    imageResource.cleanup();
+    throw error;
+  }
+}
