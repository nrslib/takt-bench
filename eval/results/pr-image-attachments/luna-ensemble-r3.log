    24	  getWorkflowDescription,
    25	  resolveConfigValue,
    26	  resolveConfigValues,
    27	  loadPersonaSessions,
    28	} from '../../infra/config/index.js';
    29	import { resolvePersonaSessionId } from '../../infra/config/project/sessionStore.js';
    30	import { resolveAssistantProviderModel } from '../../features/interactive/assistantConfig.js';
    31	import { program } from './program.js';
    32	import { getCliExecutionContext } from './initialization.js';
    33	import { resolveAgentOverrides, resolveWorkflowCliOption } from './helpers.js';
    34	import { loadTaskHistory } from './taskHistory.js';
    35	import { resolveIssueInput, resolvePrInput } from './routing-inputs.js';
    36	import { createPullRequestContext } from '../../core/workflow/pr-context.js';
    37	import { toLocalBranchRef } from '../../shared/utils/gitBranchValidation.js';
    38	import { getAssistantSessionPersona } from '../../features/interactive/assistantMode.js';
    39	import type { GitHubPrImageResource } from '../../infra/github/pr-images.js';
    40	import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
    41	
    42	export async function executeDefaultAction(task?: string): Promise<void> {
    43	  const { cwd: resolvedCwd, pipelineMode } = getCliExecutionContext();
    44	  const opts = program.opts();
    45	  if (!pipelineMode && (opts.autoPr === true || opts.draft === true)) {
    46	    logError('--auto-pr/--draft are supported only in --pipeline mode');
    47	    process.exit(1);
    48	  }
    49	  const prNumber = opts.pr as number | undefined;
    50	  const issueNumber = opts.issue as number | undefined;
    51	
    52	  if (prNumber && issueNumber) {
    53	    logError('--pr and --issue cannot be used together');
    54	    process.exit(1);
    55	  }
    56	
    57	  if (prNumber && (opts.task as string | undefined)) {
    58	    logError('--pr and --task cannot be used together');
    59	    process.exit(1);
    60	  }
    61	  const agentOverrides = resolveAgentOverrides(program);
    62	  let resolvedWorkflow: string | undefined;
    63	  try {
    64	    resolvedWorkflow = resolveWorkflowCliOption(opts as Record<string, unknown>);
    65	  } catch (error) {
    66	    logError(error instanceof Error ? error.message : String(error));
    67	    process.exit(1);
    68	  }
    69	  const resolvedPipelineWorkflow = resolvedWorkflow;
    70	  if (pipelineMode && resolvedPipelineWorkflow === undefined) {
    71	    logError('--workflow (-w) is required in pipeline mode');
    72	    process.exit(1);
    73	  }
    74	  const resolvedPipelineAutoPr = opts.autoPr === true
    75	    ? true
    76	    : (resolveConfigValue(resolvedCwd, 'autoPr') ?? false);
    77	  const resolvedPipelineDraftPr = opts.draft === true
    78	    ? true
    79	    : (resolveConfigValue(resolvedCwd, 'draftPr') ?? false);
    80	  const selectOptions: SelectAndExecuteOptions = {
    81	    workflow: resolvedWorkflow,
    82	  };
    83	
    84	  if (pipelineMode) {
    85	    const exitCode = await executePipeline({
    86	      issueNumber,
    87	      prNumber,
    88	      task: opts.task as string | undefined,
    89	      workflow: resolvedPipelineWorkflow!,
    90	      branch: opts.branch as string | undefined,
    91	      autoPr: resolvedPipelineAutoPr,
    92	      draftPr: resolvedPipelineDraftPr,
    93	      repo: opts.repo as string | undefined,
    94	      skipGit: opts.skipGit === true,
    95	      cwd: resolvedCwd,
    96	      provider: agentOverrides?.provider,
    97	      model: agentOverrides?.model,
    98	      autoStrategy: agentOverrides?.autoStrategy,
    99	    });
   100	
   101	    if (exitCode !== 0) {
   102	      process.exit(exitCode);
   103	    }
   104	    return;
   105	  }
   106	
   107	  const taskFromOption = opts.task as string | undefined;
   108	  if (taskFromOption) {
   109	    selectOptions.skipTaskList = true;
   110	    await selectAndExecuteTask(resolvedCwd, taskFromOption, selectOptions, agentOverrides);
   111	    return;
   112	  }
   113	
   114	  let directTask: string | undefined = task;
   115	  let sourceContext: string | undefined;
   116	  let prBranch: string | undefined;
   117	  let prBaseBranch: string | undefined;
   118	  let prAttachments: StoredImageAttachment[] | undefined;
   119	  let prImageResource: GitHubPrImageResource | undefined;
   120	  let sourceIssueNumber: number | undefined;
   121	
   122	  try {
   123	    if (prNumber) {
   124	      try {
   125	        const prResult = await resolvePrInput(prNumber, resolvedCwd);
   126	        directTask = undefined;
   127	        sourceContext = prResult.initialInput;
   128	        prBranch = prResult.prBranch;
   129	        prBaseBranch = prResult.baseBranch;
   130	        prImageResource = prResult.imageResource;
   131	        prAttachments = prImageResource ? [...prImageResource.attachments] : undefined;
   132	        const resolvedPrBase = prBaseBranch ?? resolveBaseBranch(resolvedCwd).branch;
   133	        selectOptions.traceTaskContext = {
   134	          source: 'pr_review',
   135	          prNumber,
   136	          branch: prBranch,
   137	          baseBranch: resolvedPrBase,
   138	        };
   139	        if (prBranch !== undefined) {
   140	          selectOptions.prContext = createPullRequestContext({
   141	            source: 'pr_review',
   142	            prNumber,
   143	            baseBranch: resolvedPrBase,
   144	            headBranch: prBranch,
   145	            baseBranchSource: prBaseBranch === undefined ? 'default_branch_fallback' : 'pull_request',
   146	          });
   147	        }
   148	      } catch (e) {
   149	        throw new Error(getErrorMessage(e), { cause: e });
   150	      }
   151	    } else {
   152	      try {
   153	        const issueResult = await resolveIssueInput(issueNumber, task);
   154	        if (issueResult) {
   155	          directTask = undefined;
   156	          sourceContext = issueResult.initialInput;
   157	          sourceIssueNumber = issueResult.issueNumber;
   158	          selectOptions.traceTaskContext = {
   159	            source: 'issue',
   160	            ...(sourceIssueNumber !== undefined ? { issueNumber: sourceIssueNumber } : {}),
   161	          };
   162	        }
   163	      } catch (e) {
   164	        logError(getErrorMessage(e));
   165	        process.exit(1);
   166	      }
   167	    }
   168	
   169	    const globalConfig = resolveConfigValues(
   170	      resolvedCwd,
   171	      ['language', 'interactivePreviewSteps'],
   172	    );
   173	    const lang = resolveLanguage(globalConfig.language);
   174	
   175	    const workflowId = await determineWorkflow(resolvedCwd, selectOptions.workflow);
   176	    if (workflowId === null) {
   177	      info(getLabel('interactive.ui.cancelled', lang));
   178	      return;
   179	    }
   180	
   181	    const previewCount = globalConfig.interactivePreviewSteps;
   182	    const workflowDesc = getWorkflowDescription(
   183	      workflowId,
   184	      resolvedCwd,
   185	      previewCount,
   186	      resolvedCwd,
   187	      agentOverrides,
   188	    );
   189	
   190	    const availableInteractiveModes = sourceContext && !directTask
   191	      ? INTERACTIVE_MODES.filter((mode) => mode !== 'passthrough')
   192	      : INTERACTIVE_MODES;
   193	    const selectedMode = await selectInteractiveMode(
   194	      lang,
   195	      workflowDesc.interactiveMode,
   196	      availableInteractiveModes,
   197	    );
   198	    if (selectedMode === null) {
   199	      info(getLabel('interactive.ui.cancelled', lang));
   200	      return;
   201	    }
   202	
   203	    const workflowContext = {
   204	      name: workflowDesc.name,
   205	      description: workflowDesc.description,
   206	      workflowStructure: workflowDesc.workflowStructure,
   207	      stepPreviews: workflowDesc.stepPreviews,
   208	      taskHistory: loadTaskHistory(resolvedCwd, lang),
   209	    };
   210	    const interactiveSeed = directTask || sourceContext
   211	      ? {
   212	        ...(directTask ? { userMessage: directTask } : {}),
   213	        ...(sourceContext ? { sourceContext } : {}),
   214	        ...(prAttachments ? { attachments: prAttachments } : {}),
   215	      }
   216	      : undefined;
   217	    let result: InteractiveModeResult;
   218	    const assistantOverrideProvider = agentOverrides?.provider;
   219	
   220	    switch (selectedMode) {
   221	    case 'assistant':
   222	    case 'grill-me': {
   223	      const assistantMode = selectedMode;
   224	      let selectedSessionId: string | undefined;
   225	      if (opts.continue === true) {
   226	        const { provider } = resolveAssistantProviderModel(resolvedCwd, {
   227	          provider: assistantOverrideProvider,
   228	          model: agentOverrides?.model,
   229	        });
   230	        if (!provider) {
   231	          throw new Error('Provider is not configured.');
   232	        }
   233	        const savedSessions = loadPersonaSessions(resolvedCwd, provider);
   234	        const savedSessionId = resolvePersonaSessionId(
   235	          savedSessions,
   236	          getAssistantSessionPersona(assistantMode),
   237	          provider,
   238	        );
   239	        if (savedSessionId) {
   240	          selectedSessionId = savedSessionId;
   241	        } else {
   242	          info(getLabel('interactive.continueNoSession', lang));
   243	        }
   244	      }
   245	      const interactiveOpts = prBranch ? { excludeActions: ['create_issue'] as const } : undefined;
   246	      const assistantModeOptions = {
   247	        ...interactiveOpts,
   248	        ...(assistantOverrideProvider ? { provider: assistantOverrideProvider } : {}),
   249	        ...(agentOverrides?.model ? { model: agentOverrides.model } : {}),
   250	        ...(assistantMode === 'grill-me' ? { assistantMode } : {}),
   251	      };
   252	      result = await interactiveMode(
   253	        resolvedCwd,
   254	        interactiveSeed,
   255	        workflowContext,
   256	        selectedSessionId,
   257	        undefined,
   258	        Object.keys(assistantModeOptions).length > 0 ? assistantModeOptions : undefined,
   259	      );
   260	      break;
   261	    }
   262	
   263	    case 'passthrough':
   264	      result = await passthroughMode(lang, directTask);
   265	      break;
   266	
   267	    case 'quiet':
   268	      result = await quietMode(resolvedCwd, interactiveSeed, workflowContext);
   269	      break;
   270	
   271	    case 'persona': {
   272	      if (!workflowDesc.firstStep) {
   273	        info(getLabel('interactive.ui.personaFallback', lang));
   274	        result = await interactiveMode(resolvedCwd, interactiveSeed, workflowContext);
   275	      } else {
   276	        result = await personaMode(resolvedCwd, workflowDesc.firstStep, interactiveSeed, workflowContext);
   277	      }
   278	      break;
   279	    }
   280	  }
   281	
   282	  try {
   283	    await dispatchConversationAction(result, {
   284	      execute: async ({ task: confirmedTask }) => {
   285	        if (prBranch) {
   286	          info(`Fetching and checking out PR branch: ${prBranch}`);
   287	          checkoutBranch(resolvedCwd, prBranch);
   288	          if (selectOptions.prContext) {
   289	            selectOptions.prContext = createPullRequestContext({
   290	              ...selectOptions.prContext,
   291	              baseDiffRef: materializePullRequestBase(
   292	                resolvedCwd,
   293	                resolvedCwd,
   294	                selectOptions.prContext.baseBranch,
   295	              ),
   296	              headDiffRef: toLocalBranchRef(prBranch),
   297	            });
   298	          }
   299	          success(`Checked out PR branch: ${prBranch}`);
   300	        }
   301	        selectOptions.interactiveUserInput = true;
   302	        selectOptions.workflow = workflowId;
   303	        selectOptions.interactiveMetadata = { confirmed: true, task: confirmedTask };
   304	        selectOptions.skipTaskList = true;
   305	        if (result.attachments) {
   306	          selectOptions.attachments = result.attachments;
   307	        }
   308	        await selectAndExecuteTask(resolvedCwd, confirmedTask, selectOptions, agentOverrides);
   309	      },
   310	      create_issue: async ({ task: confirmedTask }) => {
   311	        const labels = await promptLabelSelection(lang);
   312	        await createIssueAndSaveTask(resolvedCwd, confirmedTask, workflowId, {
   313	          confirmAtEndMessage: 'Add this issue to tasks?',
   314	          labels,
   315	          ...(result.attachments ? { attachments: result.attachments } : {}),
   316	        });
   317	      },
   318	      save_task: async ({ task: confirmedTask }) => {
   319	        if (prNumber !== undefined) {
   320	          if (prBranch === undefined) {
   321	            throw new Error('Fetched PR head branch is required when saving a PR review task.');
   322	          }
   323	          await saveTaskFromInteractive(resolvedCwd, confirmedTask, workflowId, {
   324	            prNumber,
   325	            presetSettings: {
   326	              worktree: true,
   327	              branch: prBranch,
   328	              autoPr: true,
   329	              ...(prBaseBranch ? { baseBranch: prBaseBranch } : {}),
   330	            },
   331	            ...(result.attachments ? { attachments: result.attachments } : {}),
   332	          });
   333	          return;
   334	        }
   335	        await saveTaskFromInteractive(resolvedCwd, confirmedTask, workflowId, {
   336	          ...(sourceIssueNumber !== undefined ? { issue: sourceIssueNumber } : {}),
   337	          ...(result.attachments ? { attachments: result.attachments } : {}),
   338	        });
   339	      },
   340	      cancel: () => undefined,
   341	    });
   342	  } finally {
   343	    cleanupInteractiveResultAttachments(result);
   344	  }
   345	  } finally {
   346	    prImageResource?.cleanup();
   347	  }
   348	}
     1	/**
     2	 * add command implementation
     3	 *
     4	 * Appends a task record to .takt/tasks.yaml.
     5	 */
     6	
     7	import { promptInput, confirm, selectOption } from '../../../shared/prompt/index.js';
     8	import { info, error, withProgress } from '../../../shared/ui/index.js';
     9	import { getLabel } from '../../../shared/i18n/index.js';
    10	import { DEFAULT_WORKFLOW_NAME } from '../../../shared/constants.js';
    11	import type { Language } from '../../../core/models/types.js';
    12	import { saveEnqueuedTaskFile } from '../../../infra/task/enqueuedTaskFile.js';
    13	import { determineWorkflow } from '../execute/selectAndExecute.js';
    14	import { createLogger, getErrorMessage } from '../../../shared/utils/index.js';
    15	import { isIssueReference, resolveIssueTask, parseIssueNumbers, formatPrReviewAsTask, getGitProvider } from '../../../infra/git/index.js';
    16	import type { PrReviewData } from '../../../infra/git/index.js';
    17	import {
    18	  prepareGitHubPrTask,
    19	  type GitHubPrImageResource,
    20	} from '../../../infra/github/pr-images.js';
    21	import { extractTitle, createIssueFromTask, createIssueFromTaskResult } from '../../../infra/task/issueTask.js';
    22	import { displayTaskCreationResult, promptWorktreeSettings, type WorktreeSettings } from './worktree-settings.js';
    23	import {
    24	  createIssueAndEnqueueTask,
    25	  formatIssueEnqueueFailure,
    26	  IssueEnqueueCancelledError,
    27	  type PrepareEnqueuedTaskSpec,
    28	  type SaveEnqueuedTaskFile,
    29	  type SaveEnqueuedTaskFileOptions,
    30	} from '../../../infra/task/enqueueService.js';
    31	import {
    32	  prepareTaskSpecDirectory,
    33	  type TaskAttachment,
    34	} from '../attachments.js';
    35	export { extractTitle, createIssueFromTask, createIssueFromTaskResult };
    36	
    37	const log = createLogger('add-task');
    38	
    39	export type SaveTaskOptions = SaveEnqueuedTaskFileOptions & {
    40	  attachments?: TaskAttachment[];
    41	};
    42	
    43	export async function saveTaskFile(
    44	  cwd: string,
    45	  taskContent: string,
    46	  options?: SaveTaskOptions,
    47	  prepareTaskSpec?: PrepareEnqueuedTaskSpec,
    48	  abortSignal?: AbortSignal,
    49	): Promise<{ taskName: string; tasksFile: string }> {
    50	  const { attachments, ...saveOptions } = options ?? {};
    51	  const attachmentPrepareTaskSpec = attachments !== undefined
    52	    ? (saveCwd: string, saveTaskContent: string) => prepareTaskSpecDirectory(saveCwd, saveTaskContent, attachments)
    53	    : prepareTaskSpec;
    54	  return saveEnqueuedTaskFile(cwd, taskContent, saveOptions, attachmentPrepareTaskSpec, abortSignal);
    55	}
    56	
    57	
    58	/**
    59	 * Prompt user to select a label for the issue.
    60	 *
    61	 * Presents 4 fixed options: None, bug, enhancement, custom input.
    62	 * Returns an array of selected labels (empty if none selected).
    63	 */
    64	export async function promptLabelSelection(lang: Language): Promise<string[]> {
    65	  const selected = await selectOption<string>(
    66	    getLabel('issue.labelSelection.prompt', lang),
    67	    [
    68	      { label: getLabel('issue.labelSelection.none', lang), value: 'none' },
    69	      { label: 'bug', value: 'bug' },
    70	      { label: 'enhancement', value: 'enhancement' },
    71	      { label: getLabel('issue.labelSelection.custom', lang), value: 'custom' },
    72	    ],
    73	  );
    74	
    75	  if (selected === null || selected === 'none') return [];
    76	  if (selected === 'custom') {
    77	    const customLabel = await promptInput(getLabel('issue.labelSelection.customPrompt', lang));
    78	    return customLabel?.split(',').map((l) => l.trim()).filter((l) => l.length > 0) ?? [];
    79	  }
    80	  return [selected];
    81	}
    82	
    83	
    84	/**
    85	 * Save a task from interactive mode result.
    86	 * Prompts for worktree/branch/auto_pr settings before saving.
    87	 * If presetSettings is provided, skips the prompt and uses those settings directly.
    88	 */
    89	export async function saveTaskFromInteractive(
    90	  cwd: string,
    91	  task: string,
    92	  workflow?: string,
    93	  options?: {
    94	    issue?: number;
    95	    prNumber?: number;
    96	    confirmAtEndMessage?: string;
    97	    presetSettings?: WorktreeSettings;
    98	    attachments?: TaskAttachment[];
    99	  },
   100	): Promise<{ taskName: string; tasksFile: string } | undefined> {
   101	  if (options?.confirmAtEndMessage) {
   102	    const approved = await confirm(options.confirmAtEndMessage, true);
   103	    if (!approved) {
   104	      return undefined;
   105	    }
   106	  }
   107	  const settings = options?.presetSettings ?? await promptWorktreeSettings(cwd);
   108	  const created = await saveTaskFile(cwd, task, {
   109	    workflow,
   110	    issue: options?.issue,
   111	    prNumber: options?.prNumber,
   112	    ...settings,
   113	    ...(options?.attachments ? { attachments: options.attachments } : {}),
   114	  });
   115	  displayTaskCreationResult(created, settings, workflow);
   116	  return created;
   117	}
   118	
   119	export async function createIssueAndSaveTask(
   120	  cwd: string,
   121	  task: string,
   122	  workflow?: string,
   123	  options?: { confirmAtEndMessage?: string; labels?: string[]; attachments?: TaskAttachment[] },
   124	): Promise<void> {
   125	  const gitProvider = getGitProvider();
   126	  const saveInteractiveTask: SaveEnqueuedTaskFile = async (saveCwd, taskContent, saveOptions) => {
   127	    const created = await saveTaskFromInteractive(saveCwd, taskContent, saveOptions?.workflow, {
   128	      issue: saveOptions?.issue,
   129	      confirmAtEndMessage: options?.confirmAtEndMessage,
   130	      ...(options?.attachments ? { attachments: options.attachments } : {}),
   131	    });
   132	    if (created === undefined) {
   133	      throw new IssueEnqueueCancelledError();
   134	    }
   135	    return created;
   136	  };
   137	  const result = await createIssueAndEnqueueTask({
   138	    cwd,
   139	    task,
   140	    workflow: workflow ?? DEFAULT_WORKFLOW_NAME,
   141	    worktree: true,
   142	    autoPr: false,
   143	    labels: options?.labels,
   144	    gitProvider,
   145	    issueOutputMode: 'terminal',
   146	  }, {
   147	    saveTaskFile: saveInteractiveTask,
   148	    createIssueFromTaskResult,
   149	  });
   150	  if (!result.success) {
   151	    if (result.failure.stage !== 'issue_creation') {
   152	      error(formatIssueEnqueueFailure(result.failure, getErrorMessage));
   153	    }
   154	    return;
   155	  }
   156	}
   157	
   158	/**
   159	 * add command handler
   160	 *
   161	 * Flow:
   162	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   163	 *   B) 引数なし: Usage表示して終了
   164	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   165	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   166	 */
   167	export async function addTask(
   168	  cwd: string,
   169	  task?: string,
   170	  opts?: { prNumber?: number; workflow?: string },
   171	): Promise<void> {
   172	  const rawTask = task ?? '';
   173	  const trimmedTask = rawTask.trim();
   174	  const prNumber = opts?.prNumber;
   175	
   176	  if (prNumber !== undefined) {
   177	    const provider = getGitProvider();
   178	    const cliStatus = provider.checkCliStatus(cwd);
   179	    if (!cliStatus.available) {
   180	      error(cliStatus.error);
   181	      return;
   182	    }
   183	
   184	    let prReview: PrReviewData;
   185	    let imageResource: GitHubPrImageResource | undefined;
   186	    try {
   187	      const fetchedPrReview = await withProgress(
   188	        'Fetching PR review comments...',
   189	        (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   190	        async () => provider.fetchPrReviewComments(prNumber, cwd),
   191	      );
   192	      const prepared = await prepareGitHubPrTask(fetchedPrReview, cwd);
   193	      prReview = prepared.review;
   194	      imageResource = prepared.imageResource;
   195	    } catch (e) {
   196	      const msg = getErrorMessage(e);
   197	      error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   198	      return;
   199	    }
   200	
   201	    try {
   202	      if (prReview.reviews.length === 0 && prReview.comments.length === 0 && !imageResource?.attachments.length) {
   203	        error(`PR #${prNumber} has no review comments`);
   204	        return;
   205	      }
   206	
   207	      const taskContent = formatPrReviewAsTask(prReview);
   208	      const workflow = await determineWorkflow(cwd, opts?.workflow);
   209	      if (workflow === null) {
   210	        info('Cancelled.');
   211	        return;
   212	      }
   213	
   214	      const settings = {
   215	        worktree: true,
   216	        branch: prReview.headRefName,
   217	        baseBranch: prReview.baseRefName,
   218	        autoPr: false,
   219	        shouldPublishBranchToOrigin: true,
   220	      };
   221	      const created = await saveTaskFile(cwd, taskContent, {
   222	        workflow,
   223	        ...settings,
   224	        prNumber,
   225	        ...(imageResource ? { attachments: [...imageResource.attachments] } : {}),
   226	      });
   227	      displayTaskCreationResult(created, settings, workflow);
   228	    } finally {
   229	      imageResource?.cleanup();
   230	    }
   231	    return;
   232	  }
   233	
   234	  if (!trimmedTask) {
   235	    info('Usage: takt add <task>');
   236	    return;
   237	  }
   238	
   239	  let taskContent: string;
   240	  let issueNumber: number | undefined;
   241	
   242	  if (isIssueReference(trimmedTask)) {
   243	    try {
   244	      const numbers = parseIssueNumbers([trimmedTask]);
   245	      const primaryIssueNumber = numbers[0];
   246	      taskContent = await withProgress(
   247	        'Fetching issue...',
   248	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   249	        async () => resolveIssueTask(trimmedTask, cwd),
   250	      );
   251	      if (numbers.length > 0) {
   252	        issueNumber = numbers[0];
   253	      }
   254	    } catch (e) {
   255	      const msg = getErrorMessage(e);
   256	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   257	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   258	      return;
