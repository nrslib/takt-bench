    39	export function parseIssueNumberFromUrl(url: string): number {
    40	  if (url.endsWith('/')) {
    41	    throw new Error(`Issue URL must end with a positive issue number: ${url}`);
    42	  }
    43	
    44	  let parsed: URL;
    45	  try {
    46	    parsed = new URL(url);
    47	  } catch {
    48	    throw new Error(`Issue URL is invalid: ${url}`);
    49	  }
    50	
    51	  const lastSegment = parsed.pathname.split('/').pop();
    52	  if (lastSegment === undefined || !/^[1-9]\d*$/u.test(lastSegment)) {
    53	    throw new Error(`Issue URL must end with a positive issue number: ${url}`);
    54	  }
    55	
    56	  const issueNumber = Number(lastSegment);
    57	  if (!Number.isSafeInteger(issueNumber)) {
    58	    throw new Error(`Issue number must be a positive safe integer: ${lastSegment}`);
    59	  }
    60	  return issueNumber;
    61	}
