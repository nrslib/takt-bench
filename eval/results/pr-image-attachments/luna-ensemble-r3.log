    12	export function parseGitHubRepositoryFromPrUrl(prUrl: string): GitHubRepository {
    13	  const parsed = new URL(prUrl);
    14	  if (
    15	    parsed.protocol !== 'https:'
    16	    || !['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase())
    17	    || parsed.username.length > 0
    18	    || parsed.password.length > 0
    19	    || parsed.port.length > 0
    20	  ) {
    21	    throw new Error(`Unexpected pull request URL format: ${prUrl}`);
    22	  }
    23	
    24	  const pathSegments = parsed.pathname.split('/').filter(Boolean);
    25	  if (pathSegments.length < 4 || pathSegments[2] !== 'pull') {
    26	    throw new Error(`Unexpected pull request URL format: ${prUrl}`);
    27	  }
    28	
    29	  const [owner, repo] = pathSegments;
    30	  if (!owner || !repo) {
    31	    throw new Error(`Repository owner/repo is missing in pull request URL: ${prUrl}`);
    32	  }
    33	
    34	  return { owner, repo };
    35	}
