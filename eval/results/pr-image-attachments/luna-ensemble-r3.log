   382	      projectCwd,
   383	      agentOverrides,
   384	      ...(taskSpec ? { taskSpec } : {}),
   385	      ...(reportDirName ? { reportDirName } : {}),
   386	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   387	      ...(context.prContext ? { prContext: context.prContext } : {}),
   388	    });
