    43	  const repo = JSON.parse(output) as GhRepoViewResponse;
    44	  if (!repo.nameWithOwner) {
    45	    throw new Error('gh repo view did not return nameWithOwner');
    46	  }
    47	  return repo.nameWithOwner;
    48	}
