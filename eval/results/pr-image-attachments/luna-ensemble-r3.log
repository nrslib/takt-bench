    59	
    60	function normalizeTaskAttachmentReferences(
    61	  taskContent: string,
    62	  attachments: readonly TaskAttachment[],
    63	): string {
    64	  return attachments.reduce((content, attachment) => {
    65	    const relativePath = getTaskAttachmentRelativePath(attachment);
    66	    const pathVariants = new Set([
    67	      attachment.tempPath,
    68	      attachment.tempPath.replace(/\\/g, '/'),
    69	    ]);
    70	    let normalized = content;
    71	    for (const tempPath of pathVariants) {
    72	      normalized = normalized
    73	        .split(`\`${tempPath}\``).join(`\`${relativePath}\``)
    74	        .split(tempPath).join(`\`${relativePath}\``);
    75	    }
    76	    return normalized;
    77	  }, taskContent);
    78	}
