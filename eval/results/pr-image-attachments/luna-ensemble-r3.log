     7	  it('should cleanup the temp directory when the process exits during image use', () => {
     8	    const probe = `
     9	      import { writeSync } from 'node:fs';
    10	      import { downloadGitHubPrImages } from './src/infra/github/pr-images.ts';
    11	
    12	      globalThis.fetch = async () => new Response(
    13	        Buffer.from([0x89, 0x50, 0x4e, 0x47]),
    14	        { status: 200, headers: { 'content-type': 'image/png' } },
    15	      );
    16	      const resource = await downloadGitHubPrImages(
    17	        [{ placeholder: '[Image #1]', url: 'https://github.com/user-attachments/assets/exit' }],
    18	        process.cwd(),
    19	        'https://github.com/org/repo/pull/42',
    20	      );
    21	      writeSync(1, resource.attachments[0].tempPath);
    22	      process.exit(17);
    23	    `;
    24	    const result = spawnSync(
    25	      process.execPath,
    26	      ['--import', 'tsx/esm', '--input-type=module', '--eval', probe],
    27	      { cwd: process.cwd(), encoding: 'utf8' },
    28	    );
    29	
    30	    expect(result.status).toBe(17);
    31	    expect(result.stderr).toBe('');
    32	    const tempPath = result.stdout;
    33	    expect(tempPath).not.toBe('');
    34	    expect(existsSync(tempPath)).toBe(false);
    35	    expect(existsSync(dirname(tempPath))).toBe(false);
    36	  });
    37	});
