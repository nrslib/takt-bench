   122	export function createImageAttachmentStore(
   123	  options: ImageAttachmentStoreOptions,
   124	): ImageAttachmentStore {
   125	  if (options.tmpRoot.length === 0) {
   126	    throw new Error('Image attachment tmpRoot is required.');
   127	  }
   128	  validateImageAttachmentSessionId(options.sessionId);
   129	
   130	  let attachments: InteractiveImageAttachment[] = options.initialAttachments
   131	    ? [...options.initialAttachments]
   132	    : [];
   133	  const sessionDir = path.join(options.tmpRoot, 'takt', options.sessionId);
   134	  const taktTmpDir = path.dirname(sessionDir);
   135	  const attachmentDir = path.join(sessionDir, 'attachments');
   136	
   137	  return {
   138	    async saveImage(data: Buffer, mimeType: string): Promise<InteractiveImageAttachment> {
   139	      const usedIndexes = attachments.flatMap((attachment) => {
   140	        const placeholderIndex = attachment.placeholder.match(/^\[Image #(\d+)\]$/)?.[1];
   141	        const fileIndex = attachment.fileName.match(/^image-(\d+)\./)?.[1];
   142	        return [placeholderIndex, fileIndex]
   143	          .filter((value): value is string => value !== undefined)
   144	          .map(Number);
   145	      });
   146	      const index = Math.max(0, ...usedIndexes) + 1;
   147	      const fileName = `image-${index}.${extensionForMimeType(mimeType)}`;
   148	      const tempPath = path.join(attachmentDir, fileName);
   149	      const attachment: InteractiveImageAttachment = {
   150	        placeholder: `[Image #${index}]`,
   151	        tempPath,
   152	        fileName,
   153	      };
   154	
   155	      ensurePrivateDirectory(taktTmpDir);
   156	      ensurePrivateDirectory(sessionDir);
   157	      ensurePrivateDirectory(attachmentDir);
   158	      writeNewPrivateFileWithMode(tempPath, data, PRIVATE_FILE_MODE);
   159	      attachments = [...attachments, attachment];
   160	      return attachment;
   161	    },
   162	
   163	    listAttachments(): InteractiveImageAttachment[] {
   164	      return [...attachments];
   165	    },
   166	
   167	    cleanup(): void {
   168	      fs.rmSync(sessionDir, { recursive: true, force: true });
   169	    },
   170	  };
   171	}
