diff --git a/src/app/cli/processExitCleanup.ts b/src/app/cli/processExitCleanup.ts
new file mode 100644
index 00000000..2b35b636
--- /dev/null
+++ b/src/app/cli/processExitCleanup.ts
@@ -0,0 +1,15 @@
+export function registerProcessExitCleanup(cleanup: () => void): () => void {
+  let finished = false;
+
+  const finish = (): void => {
+    if (finished) {
+      return;
+    }
+    finished = true;
+    process.removeListener('exit', finish);
+    cleanup();
+  };
+
+  process.once('exit', finish);
+  return finish;
+}
