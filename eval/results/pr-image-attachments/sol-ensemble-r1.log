    23	
    24	function getTaskSpecPath(projectCwd: string, taskDir: string): string {
    25	  return path.join(projectCwd, taskDir, 'order.md');
    26	}
    27	
    28	function rewriteAttachmentPathsForRunContext(orderContent: string, contextTaskRel: string): string {
    29	  const contextTaskRelPosix = contextTaskRel.replace(/\\/g, '/');
    30	  const toRunContextPath = (attachmentPath: string): string => {
    31	    const segments = attachmentPath.split('/');
    32	    if (segments.some((segment) => segment === '..' || segment.length === 0)) {
    33	      throw new Error(`Invalid task attachment path: attachments/${attachmentPath}`);
    34	    }
    35	    return path.posix.join(contextTaskRelPosix, 'attachments', attachmentPath);
    36	  };
    37	  const splitTrailingPunctuation = (attachmentPath: string): { pathPart: string; suffix: string } => {
    38	    const match = attachmentPath.match(/^(.+?)([.!?,;:]*)$/);
    39	    return {
    40	      pathPart: match?.[1] ?? attachmentPath,
    41	      suffix: match?.[2] ?? '',
    42	    };
    43	  };
    44	  const backticked = orderContent.replace(/`attachments\/([^`\r\n]+)`/g, (_match, attachmentPath: string) =>
    45	    `\`${toRunContextPath(attachmentPath)}\``,
    46	  );
    47	  return backticked.replace(/(^|[\s([:])attachments\/([A-Za-z0-9._/-]+)/g, (
    48	    _match,
    49	    prefix: string,
    50	    attachmentPath: string,
    51	  ) => {
    52	    const { pathPart, suffix } = splitTrailingPunctuation(attachmentPath);
    53	    return `${prefix}\`${toRunContextPath(pathPart)}\`${suffix}`;
    54	  });
    55	}
