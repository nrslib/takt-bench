diff --git a/src/infra/github/attachmentUrl.ts b/src/infra/github/attachmentUrl.ts
new file mode 100644
index 00000000..e3add806
--- /dev/null
+++ b/src/infra/github/attachmentUrl.ts
@@ -0,0 +1,21 @@
+export const GITHUB_ATTACHMENT_HOST = 'github.com';
+
+export function isGitHubAttachmentUrl(value: string): boolean {
+  if (!URL.canParse(value)) {
+    return false;
+  }
+
+  const url = new URL(value);
+  if (
+    url.protocol !== 'https:'
+    || url.hostname !== GITHUB_ATTACHMENT_HOST
+    || url.port !== ''
+    || url.username !== ''
+    || url.password !== ''
+  ) {
+    return false;
+  }
+
+  return /^\/user-attachments\/assets\/[^/]+$/.test(url.pathname)
+    || /^\/[^/]+\/[^/]+\/assets\/[^/]+(?:\/[^/]+)*$/.test(url.pathname);
+}
