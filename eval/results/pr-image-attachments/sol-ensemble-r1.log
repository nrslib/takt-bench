   275	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   276	  if (!fs.existsSync(sourceAttachmentsDir)) {
   277	    return;
   278	  }
   279	
   280	  const stats = fs.lstatSync(sourceAttachmentsDir);
   281	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   282	    throw new Error(`Task attachments must be a regular directory: ${sourceAttachmentsDir}`);
   283	  }
   284	
   285	  copyAttachmentEntry(sourceAttachmentsDir, path.join(taskDir, 'attachments'));
   286	}
   287	
   288	export function prepareTaskSpecDirectory(
   289	  cwd: string,
   290	  taskContent: string,
   291	  attachments?: readonly TaskAttachment[],
   292	  options?: PrepareTaskSpecOptions,
   293	): PreparedTaskSpec {
   294	  const orderContent = buildTaskOrderContent(taskContent, attachments);
   295	  return prepareEnqueuedTaskSpecDirectory(cwd, taskContent, {
   296	    orderContent,
   297	    beforeWrite: (taskDir) => {
   298	      if (options?.sourceTaskDir) {
   299	        copyExistingTaskAttachments(options.sourceTaskDir, taskDir);
   300	      }
   301	      promoteTaskAttachments(taskDir, attachments);
   302	    },
   303	  });
   304	}
   305	
   306	export function copyTaskAttachmentsToRunContext(
   307	  sourceTaskDir: string,
   308	  runContextTaskDir: string,
   309	  expectedManifest: TaskAttachmentManifest,
   310	): void {
   311	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   312	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   313	  if (expectedManifest.length !== 0) {
   314	    copyAttachmentEntry(sourceAttachmentsDir, path.join(runContextTaskDir, 'attachments'));
   315	  }
   316	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   317	  assertTaskAttachmentsMatchManifest(runContextTaskDir, expectedManifest);
   318	}

