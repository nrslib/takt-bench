    41	/**
    42	 * Run quiet mode: collect user input and generate instructions without questions.
    43	 *
    44	 * Flow:
    45	 * 1. If initialInput is provided, use it; otherwise prompt for input
    46	 * 2. Build summary prompt from the user input
    47	 * 3. Call AI to generate task instructions (best-effort, no questions)
    48	 * 4. Present the result and let user choose action
    49	 *
    50	 * @param cwd - Working directory
    51	 * @param initialInput - Pre-filled input (e.g., from issue reference)
    52	 * @param workflowContext - Workflow context for template rendering
    53	 * @returns Result with generated task instructions
    54	 */
    55	export async function quietMode(
    56	  cwd: string,
    57	  initialInput?: InteractiveSeedInput,
    58	  workflowContext?: WorkflowContext,
    59	): Promise<InteractiveModeResult> {
    60	  const ctx = initializeSession(cwd, 'interactive');
    61	  const sourceContext = initialInput?.sourceContext;
    62	  const attachmentStore = createSessionImageAttachmentStore(
    63	    initialInput?.attachments,
    64	    sourceContext,
    65	  );
    66	  const history: ConversationMessage[] = initialInput?.userMessage
    67	    ? [{ role: 'user', content: initialInput.userMessage }]
    68	    : [];
    69	
    70	  try {
    71	  if (history.length === 0 && !sourceContext) {
    72	    info(getLabel('interactive.ui.introQuiet', ctx.lang));
    73	    blankLine();
    74	
    75	    const input = await readMultilineInput(chalk.green('> '), {
    76	      onImagePaste: createImagePasteHandler(attachmentStore),
    77	      onClipboardImagePaste: createClipboardImagePasteHandler(attachmentStore),
    78	      onClipboardImagePasteError: reportClipboardImagePasteError,
    79	    });
    80	    if (input === null) {
    81	      blankLine();
    82	      info(getLabel('interactive.ui.cancelled', ctx.lang));
    83	      return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
    84	    }
    85	    const trimmed = input.trim();
    86	    if (!trimmed) {
    87	      info(getLabel('interactive.ui.cancelled', ctx.lang));
    88	      return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
    89	    }
    90	    history.push({ role: 'user', content: trimmed });
    91	  }
    92	
    93	  const conversationLabel = getLabel('interactive.conversationLabel', ctx.lang);
    94	  const noTranscript = getLabel('interactive.noTranscript', ctx.lang);
    95	
    96	  const summaryPrompt = buildSummaryPrompt(
    97	    history, !!ctx.sessionId, ctx.lang, noTranscript, conversationLabel, workflowContext, sourceContext,
    98	    undefined,
    99	    shouldUseGherkinTaskInstructions(cwd),
   100	  );
   101	
   102	  if (!summaryPrompt) {
   103	    info(getLabel('interactive.ui.noConversation', ctx.lang));
   104	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   105	  }
   106	
   107	  let imageAttachments: ReturnType<typeof resolvePromptImageAttachments>;
   108	  try {
   109	    imageAttachments = resolvePromptImageAttachments(summaryPrompt, attachmentStore.listAttachments());
   110	  } catch (caught) {
   111	    error(sanitizeTerminalText(caught instanceof Error ? caught.message : String(caught)));
   112	    blankLine();
   113	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   114	  }
   115	
   116	  const { result } = await callAIWithRetry(
   117	    summaryPrompt, summaryPrompt, DEFAULT_INTERACTIVE_TOOLS, cwd,
   118	    { ...ctx, sessionId: undefined },
   119	    { imageAttachments, persistSession: false },
   120	  );
   121	
   122	  if (!result) {
   123	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   124	  }
   125	
   126	  if (!result.success) {
   127	    error(result.content);
   128	    blankLine();
   129	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   130	  }
   131	
   132	  const task = result.content.trim();
   133	  const ui = getLabelObject<InteractiveUIText>('interactive.ui', ctx.lang);
   134	
   135	  const selectedAction = await selectPostSummaryAction(task, ui.proposed, ui);
   136	  if (selectedAction === 'continue' || selectedAction === null) {
   137	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   138	  }
   139	
   140	  log.info('Quiet mode action selected', { action: selectedAction });
   141	  return buildInteractiveResultWithAttachments({ action: selectedAction, task }, attachmentStore);
   142	  } catch (caught) {
   143	    cleanupImageAttachmentStore(attachmentStore);
   144	    throw caught;
   145	  }
   146	}

