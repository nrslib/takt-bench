@@ -0,0 +1,13 @@
+import { mkdirSync, rmSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { registerProcessExitCleanup } from '../../app/cli/processExitCleanup.ts';
+
+const [sessionDir, imagePath] = process.argv.slice(2);
+if (sessionDir === undefined || imagePath === undefined) {
+  throw new Error('sessionDir and imagePath are required.');
+}
+
+mkdirSync(dirname(imagePath), { recursive: true });
+writeFileSync(imagePath, 'private image');
+registerProcessExitCleanup(() => rmSync(sessionDir, { recursive: true, force: true }));
+process.exit(23);
