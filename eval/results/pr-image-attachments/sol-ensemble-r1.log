+export function createImageAttachmentIndexAssigner(
+  references: readonly string[],
+): (attachment: TaskAttachment) => TaskAttachment {
+  const allocateImageAttachmentIndex = createImageAttachmentIndexAllocator(references);
+
+  return (attachment) => {
+    const extension = path.extname(attachment.fileName);
+    if (extension === '') {
+      throw new Error(`Task attachment file must have an extension: ${attachment.fileName}`);
+    }
+
+    const assignedIndex = allocateImageAttachmentIndex();
+
+    return {
+      ...attachment,
+      placeholder: `[Image #${assignedIndex}]`,
+      fileName: `image-${assignedIndex}${extension}`,
+    };
+  };
+}
