   161	function resolveExecutionBaseBranch(cwd: string, preferredBaseBranch?: string): string {
   162	  const { branch } = resolveBaseBranch(cwd, preferredBaseBranch);
   163	  return requireBaseBranch(branch, 'execution context');
   164	}
   165	
   166	function resolveReadOnlyBaseBranch(cwd: string): string {
   167	  return requireBaseBranch(resolveBaseBranchName(cwd), 'skip-git execution');
   168	}
   169	
   170	function tryResolveCurrentBranch(cwd: string): string | undefined {
   171	  try {
   172	    const branch = getCurrentBranch(cwd);
   173	    return branch || undefined;
   174	  } catch {
   175	    return undefined;
   176	  }
   177	}
   178	
   179	function resolveSkipGitExecutionContext(
   180	  cwd: string,
   181	  prBranch: string | undefined,
   182	  prBaseBranch: string | undefined,
   183	): SkipGitExecutionContext {
   184	  if (prBranch) {
   185	    const baseBranch = prBaseBranch ?? resolveReadOnlyBaseBranch(cwd);
   186	    return {
   187	      execCwd: cwd,
   188	      isWorktree: false,
   189	      branch: prBranch,
   190	      baseBranch,
   191	    };
   192	  }
   193	  const branch = tryResolveCurrentBranch(cwd);
   194	  const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   195	  return {
   196	    execCwd: cwd,
   197	    isWorktree: false,
   198	    branch,
   199	    baseBranch,
   200	  };
   201	}
