   144	export function buildCommitMessage(
   145	  pipelineConfig: PipelineConfig | undefined,
   146	  issue: Issue | undefined,
   147	  taskText: string | undefined,
   148	): string {
   149	  const template = pipelineConfig?.commitMessageTemplate;
   150	  if (template && issue) {
   151	    return expandPipelineTemplate(template, {
   152	      title: issue.title,
   153	      issue: String(issue.number),
   154	    });
   155	  }
   156	  return issue
   157	    ? `feat: ${issue.title} (#${issue.number})`
   158	    : `takt: ${taskText ?? 'pipeline task'}`;
   159	}
