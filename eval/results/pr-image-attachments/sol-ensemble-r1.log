    57	export function resolveTaskSpecForExecution(
    58	  projectCwd: string,
    59	  execCwd: string,
    60	  taskDir: string,
    61	  reportDirName: string,
    62	): ResolvedTaskSpec {
    63	  const sourceTaskDir = path.join(projectCwd, taskDir);
    64	  const sourceOrderPath = getTaskSpecPath(projectCwd, taskDir);
    65	  const orderContent = readTaskSpecFile(sourceOrderPath);
    66	  const runPaths = buildRunPaths(execCwd, reportDirName);
    67	  const stagedOrderContent = rewriteAttachmentPathsForRunContext(orderContent, runPaths.contextTaskRel);
    68	  const attachmentManifest = resolveTaskAttachmentManifest(sourceTaskDir);
    69	
    70	  return Object.freeze({
    71	    runSlug: runPaths.slug,
    72	    sourceTaskDir,
    73	    attachmentManifest,
    74	    taskPrompt: buildTaskInstruction(runPaths.contextTaskRel, runPaths.contextTaskOrderRel),
    75	    orderContent,
    76	    stagedOrderContent,
    77	  });
    78	}
    79	
    80	export function stageTaskSpecForExecution(
    81	  taskSpec: ResolvedTaskSpec,
    82	  runPaths: RunPaths,
    83	): void {
    84	  if (taskSpec.runSlug !== runPaths.slug) {
    85	    throw new Error(
    86	      `Task spec run "${taskSpec.runSlug}" does not match reserved run "${runPaths.slug}"`,
    87	    );
    88	  }
    89	  try {
    90	    fs.mkdirSync(runPaths.contextTaskAbs, { recursive: true });
    91	    fs.writeFileSync(
    92	      runPaths.contextTaskOrderAbs,
    93	      taskSpec.stagedOrderContent,
    94	      'utf-8',
    95	    );
    96	    copyTaskAttachmentsToRunContext(
    97	      taskSpec.sourceTaskDir,
    98	      runPaths.contextTaskAbs,
    99	      taskSpec.attachmentManifest,
   100	    );
   101	  } catch (error) {
   102	    fs.rmSync(runPaths.contextTaskAbs, { recursive: true, force: true });
   103	    throw error;
   104	  }
   105	}

