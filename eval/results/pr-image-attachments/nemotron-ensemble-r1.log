+/**
+ * Save image attachments to the task directory and update order.md
+ * @param taskDir The task directory
+ * @param taskContent The original task content
+ * @param attachments The attachments to save
+ */
+export async function saveImageAttachments(
+  taskDir: string,
+  taskContent: string,
+  attachments: readonly TaskAttachment[],
+): Promise<void> {
+  if (!hasAttachments(attachments)) {
+    return;
+  }
+
+  const attachmentsDir = path.join(taskDir, 'attachments');
+  await fs.promises.mkdir(attachmentsDir, { recursive: true });
+
+  // Copy each attachment file
+  for (const attachment of attachments) {
+    validateTaskAttachment(attachment);
+    validateTaskAttachmentTempFile(attachment);
+    const destinationPath = path.join(taskDir, getTaskAttachmentRelativePath(attachment));
+    if (await fs.promises.access(destinationPath).then(() => true).catch(() => false)) {
+      throw new Error(`Task attachment destination already exists: ${destinationPath}`);
+    }
+    await fs.promises.copyFile(attachment.tempPath, destinationPath);
+  }
+
+  // Build the updated task content with normalized attachment references
+  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
+  
+  // Build the attachment section for order.md
+  const attachmentLines = attachments.map((attachment) =>
+    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
+  );
+  
+  const attachmentSection = [
+    '',
+    '## 添付画像',
+    '',
+    ...attachmentLines,
+  ].join('\n');
+
+  // Write the updated order.md file
+  const orderContent = [normalizedTaskContent.trimEnd(), attachmentSection].join('\n');
+  await fs.promises.writeFile(path.join(taskDir, '.takt', 'order.md'), orderContent, 'utf-8');
+}
