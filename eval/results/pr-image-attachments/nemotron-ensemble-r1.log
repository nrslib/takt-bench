   134	
   135	export function reserveTaskSpecDirectory(cwd: string, taskContent: string): PreparedTaskSpecDirectory {
   136	  const tasksDir = path.join(cwd, '.takt', 'tasks');
   137	  fs.mkdirSync(tasksDir, { recursive: true });
   138	  const baseSlug = generateReportDir(taskContent);
   139	  let sequence = 1;
   140	
   141	  while (true) {
   142	    const taskDirSlug = sequence === 1 ? baseSlug : `${baseSlug}-${sequence}`;
   143	    const taskDir = path.join(tasksDir, taskDirSlug);
   144	    try {
   145	      fs.mkdirSync(taskDir);
   146	      return {
   147	        taskDir,
   148	        taskDirRelative: `.takt/tasks/${taskDirSlug}`,
   149	      };
   150	    } catch (error) {
   151	      if (isFileExistsError(error)) {
   152	        sequence += 1;
   153	        continue;
   154	      }
   155	      throw error;
   156	    }
   157	  }
   158	}
   159	
   160	export function cleanupTaskSpecDirectory(taskDir: string): void {
   161	  fs.rmSync(taskDir, { recursive: true, force: true });
   162	  const tasksDir = path.dirname(taskDir);
   163	  try {
   164	    if (fs.existsSync(tasksDir) && fs.readdirSync(tasksDir).length === 0) {
   165	      fs.rmdirSync(tasksDir);
   166	    }
   167	  } catch {
   168	    // Parent cleanup is best-effort; concurrent enqueue can recreate tasksDir.
   169	  }
   170	}
   171	
   172	export function prepareTaskSpecDirectory(
   173	  cwd: string,
   174	  taskContent: string,
   175	  options: PrepareTaskSpecDirectoryOptions = {},
   176	): PreparedTaskSpecDirectory {
   177	  const preparedSpec = reserveTaskSpecDirectory(cwd, taskContent);
   178	  try {
   179	    options.beforeWrite?.(preparedSpec.taskDir);
   180	    fs.writeFileSync(path.join(preparedSpec.taskDir, 'order.md'), options.orderContent ?? taskContent, {
   181	      encoding: 'utf-8',
   182	      flag: 'wx',
   183	    });
   184	  } catch (error) {
   185	    cleanupTaskSpecDirectory(preparedSpec.taskDir);
   186	    throw error;
   187	  }
   188	  return preparedSpec;
   189	}
   190	
   191	export function formatIssueEnqueueFailure(
   192	  failure: IssueEnqueueFailure,
   193	  formatError: (error: unknown) => string,
   194	): string {
   195	  if (failure.stage === 'issue_creation') {
   196	    return formatError(failure.error);
   197	  }
   198	  const issueUrl = failure.issueUrl === undefined ? '' : ` Issue URL: ${failure.issueUrl}.`;
   199	  if (failure.stage === 'issue_number_parsing') {
   200	    return `An issue was created, but its number could not be extracted: ${formatError(failure.error)}.${issueUrl}`;
   201	  }
   202	  if (failure.stage === 'cancelled_after_issue_creation') {
   203	    return `Issue #${failure.issueNumber} was created and remains open, but task enqueue was cancelled: ${formatError(failure.error)}${issueUrl}`;
   204	  }
   205	  return `Issue #${failure.issueNumber} was created, but task saving failed: ${formatError(failure.error)}.${issueUrl} The issue remains open for retry.`;
   206	}
