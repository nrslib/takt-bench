+/**
+ * Extract image URLs from text using common markdown and HTML patterns.
+ */
+export function extractImageUrls(text: string | undefined): string[] {
+  const imageUrls: string[] = [];
+  const strText = text ?? '';
+  
+  // Markdown image pattern: ![alt](url)
+  const markdownPattern = /!\[[^\]]*\]\(([^)]+)\)/g;
+  let match;
+  while ((match = markdownPattern.exec(strText)) !== null) {
+    imageUrls.push(match[1] as string);
+  }
+  
+  // HTML img tag pattern: <img src="url" /> or <img src='url' />
+  const htmlPattern = /<img[^>]*src=["']([^"']+)["'][^>]*\/>/g;
+  while ((match = htmlPattern.exec(strText)) !== null) {
+    imageUrls.push(match[1] as string);
+  }
+  
+  return imageUrls;
+}
