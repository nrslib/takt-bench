   402	function parseRepositoryFromPrUrl(prUrl: string): { owner: string; repo: string } {
   403	  const parsed = new URL(prUrl);
   404	  const pathSegments = parsed.pathname.split('/').filter(Boolean);
   405	
   406	  if (pathSegments.length < 4 || pathSegments[2] !== 'pull') {
   407	    throw new Error(`Unexpected pull request URL format: ${prUrl}`);
   408	  }
   409	
   410	  const [owner, repo] = pathSegments;
   411	  if (!owner || !repo) {
   412	    throw new Error(`Repository owner/repo is missing in pull request URL: ${prUrl}`);
   413	  }
   414	
   415	  return { owner, repo };
   416	}
