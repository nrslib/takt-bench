diff --git a/src/infra/github/image-downloader.ts b/src/infra/github/image-downloader.ts
new file mode 100644
index 00000000..72cc5c7b
--- /dev/null
+++ b/src/infra/github/image-downloader.ts
@@ -0,0 +1,59 @@
+import { createLogger, getErrorMessage } from '../../shared/utils/index.js';
+import { execFileSync } from 'node:child_process';
+
+const log = createLogger('github-image-downloader');
+
+const GITHUB_ATTACHMENT_URL_PREFIX = 'https://github.com/user-attachments/assets/';
+const GITLAB_ATTACHMENT_URL_PREFIX = 'https://gitlab.com/uploads/-/system/project/';
+const SUPPORTED_IMAGE_TYPES = ['image/png', 'image/jpeg', 'image/gif', 'image/webp'];
+const MAX_IMAGE_SIZE_BYTES = 10 * 1024 * 1024; // 10MB
+
+/**
+ * Validate and download an image from a GitHub attachment URL.
+ * @param url The image URL to download
+ * @param options Options for authentication
+ * @returns The image buffer
+ * @throws Error if validation fails or download encounters an error
+ */
+export function validateAndDownloadImage(url: string, options: { auth: boolean } = { auth: false }): Buffer {
+  // Validate URL is a GitHub or GitLab attachment URL
+  if (!url.startsWith(GITHUB_ATTACHMENT_URL_PREFIX) && !url.startsWith(GITLAB_ATTACHMENT_URL_PREFIX)) {
+    throw new Error('Only GitHub or GitLab attachment URLs are allowed');
+  }
+
+  try {
+    // If authentication is requested, use gh api to check the URL
+    if (options.auth) {
+      const response = execFileSync(
+        'gh',
+        ['api', '--method', 'GET', '-H', 'Accept: application/vnd.github.v3+json', url],
+        { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
+      );
+      
+      const metadata = JSON.parse(response);
+      
+      // Check content type
+      if (!metadata['content-type'] || !SUPPORTED_IMAGE_TYPES.includes(metadata['content-type'])) {
+        throw new Error(`Unsupported image type: ${metadata['content-type']}`);
+      }
+      
+      // Check size
+      if (metadata.size && metadata.size > MAX_IMAGE_SIZE_BYTES) {
+        throw new Error('Image size exceeds limit');
+      }
+    }
+    
+    // Download the image using gh api
+    const imageBuffer = execFileSync(
+      'gh',
+      ['api', '--method', 'GET', '-H', 'Accept: application/octet-stream', url],
+      { encoding: null } // This ensures we get a Buffer
+    );
+    
+    return imageBuffer;
+  } catch (err) {
+    const errorMessage = getErrorMessage(err);
+    log.error('Failed to validate and download image', { url, error: errorMessage });
+    throw new Error(`Failed to download image: ${errorMessage}`);
+  }
+}
