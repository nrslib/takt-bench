+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { extractImageUrls } from '../infra/github/image-extraction.js';
+import { validateAndDownloadImage } from '../infra/github/image-downloader.js';
+import { saveImageAttachments } from '../features/tasks/attachments.js';
+import * as fs from 'node:fs/promises';
+import * as path from 'node:path';
+import * as os from 'node:os';
+
+describe('extractImageUrls', () => {
+  it('should extract markdown image URLs', () => {
+    const text = '![screenshot](https://github.com/user-attachments/assets/abc123)';
+    expect(extractImageUrls(text)).toEqual(['https://github.com/user-attachments/assets/abc123']);
+  });
+
+  it('should extract HTML image URLs', () => {
+    const text = '<img src="https://github.com/user-attachments/assets/def456" />';
+    expect(extractImageUrls(text)).toEqual(['https://github.com/user-attachments/assets/def456']);
+  });
+
+  it('should extract multiple image URLs', () => {
+    const text = '![img1](https://github.com/user-attachments/assets/111) and <img src="https://github.com/user-attachments/assets/222" />';
+    expect(extractImageUrls(text)).toEqual([
+      'https://github.com/user-attachments/assets/111',
+      'https://github.com/user-attachments/assets/222'
+    ]);
+  });
+
+  it('should return empty array for no images', () => {
+    const text = 'No images here';
+    expect(extractImageUrls(text)).toEqual([]);
+  });
+
+  it('should handle undefined input', () => {
+    expect(extractImageUrls(undefined)).toEqual([]);
+  });
+});
+
+describe('validateAndDownloadImage', () => {
+  const originalEnv = process.env;
+
+  beforeEach(() => {
+    vi.resetModules();
+    process.env = { ...originalEnv };
+  });
+
+  afterEach(() => {
+    process.env = originalEnv;
+    vi.restoreAllMocks();
+  });
+
+  it('should reject non-GitHub/GitLab URLs', async () => {
+    try {
+      await validateAndDownloadImage('https://example.com/image.png');
+      fail('Expected function to throw');
+    } catch (err) {
+      expect(err).toBeInstanceOf(Error);
+      expect(err.message).toBe('Only GitHub or GitLab attachment URLs are allowed');
+    }
+  });
+
+  it('should reject GitHub URLs without attachments path', async () => {
+    try {
+      await validateAndDownloadImage('https://github.com/user/repo/blob/main/image.png');
+      fail('Expected function to throw');
+    } catch (err) {
+      expect(err).toBeInstanceOf(Error);
+      expect(err.message).toBe('Only GitHub or GitLab attachment URLs are allowed');
+    }
+  });
+
+  it('should reject GitLab URLs without uploads path', async () => {
+    try {
+      await validateAndDownloadImage('https://gitlab.com/user/project/-/raw/main/image.png');
+      fail('Expected function to throw');
+    } catch (err) {
+      expect(err).toBeInstanceOf(Error);
+      expect(err.message).toBe('Only GitHub or GitLab attachment URLs are allowed');
+    }
+  });
+});
+
+describe('saveImageAttachments', () => {
+  const tempDir = os.tmpdir();
+  let testTaskDir: string;
+
+  beforeEach(async () => {
+    testTaskDir = await fs.mkdtemp(path.join(tempDir, 'takt-task-test-'));
+    await fs.mkdir(path.join(testTaskDir, '.takt'), { recursive: true });
+  });
+
+  afterEach(async () => {
+    await fs.rm(testTaskDir, { recursive: true, force: true });
+  });
+
+  it('should save attachments and update order.md', async () => {
+    // Create temporary directories for the attachments
+    const tmpDir1 = await fs.mkdtemp(path.join(tempDir, 'tmp-'));
+    const tmpDir2 = await fs.mkdtemp(path.join(tempDir, 'tmp-'));
+    const attachment1Path = path.join(tmpDir1, 'test-image-1.png');
+    const attachment2Path = path.join(tmpDir2, 'test-image-2.png');
+
+    const attachments = [
+      {
+        placeholder: '[Image #1]',
+        tempPath: attachment1Path,
+        fileName: 'test-image-1.png'
+      },
+      {
+        placeholder: '[Image #2]',
+        tempPath: attachment2Path,
+        fileName: 'test-image-2.png'
+      }
+    ];
+
+    // Create temp files
+    await Promise.all([
+      fs.writeFile(attachment1Path, Buffer.from('test-image-content')),
+      fs.writeFile(attachment2Path, Buffer.from('test-image-content'))
+    ]);
+
+    const taskContent = '# Test Task\n\nSome content [Image #1] and ![alt](image-2.png)';
+
+    await saveImageAttachments(testTaskDir, taskContent, attachments);
+
+    // Check that attachments directory exists
+    const attachmentsDir = path.join(testTaskDir, 'attachments');
+    await expect(fs.stat(attachmentsDir)).resolves.toMatchObject({ 
+      mode: expect.any(Number) 
+    });
+    const stats = await fs.stat(attachmentsDir);
+    expect(stats.isDirectory()).toBe(true);
+
+    // Check that files were copied
+    const files = await fs.readdir(attachmentsDir);
+    expect(files).toHaveLength(2);
+    expect(files).toContain('test-image-1.png');
+    expect(files).toContain('test-image-2.png');
+
+    // Check that order.md was created with correct content
+    const orderMdPath = path.join(testTaskDir, '.takt', 'order.md');
+    const orderMdContent = await fs.readFile(orderMdPath, 'utf-8');
+    expect(orderMdContent).toContain('# Test Task');
+    expect(orderMdContent).toContain('Some content [Image #1] and ![alt](image-2.png)');
+    expect(orderMdContent).toContain('## 添付画像');
+    expect(orderMdContent).toContain('- [Image #1]: \`attachments/test-image-1.png\`');
+    expect(orderMdContent).toContain('- [Image #2]: \`attachments/test-image-2.png\`');
+  });
+
+  it('should handle empty attachments', async () => {
+    const taskContent = '# Test Task\n\nNo images';
+    await expect(saveImageAttachments(testTaskDir, taskContent, []))
+      .resolves
+      .toBeUndefined();
+
+    // Should not create attachments directory or order.md
+    const attachmentsDir = path.join(testTaskDir, 'attachments');
+    await expect(fs.stat(attachmentsDir)).rejects.toThrow();
+
+    const orderMdPath = path.join(testTaskDir, '.takt', 'order.md');
+    await expect(fs.stat(orderMdPath)).rejects.toThrow();
+  });
+
+  it('should normalize attachment references in task content', async () => {
+          // Create a temporary directory and a file inside it
+          const tempDirForFile = await fs.mkdtemp(path.join(tempDir, 'tmp-'));
+          const tempFilePath = path.join(tempDirForFile, 'temp.txt');
+          await fs.writeFile(tempFilePath, Buffer.from('test-content'));
+
+          const attachments = [{
+            placeholder: '[Image #1]',
+            tempPath: tempFilePath,
+            fileName: 'normalized.png'
+          }];
+
+          const taskContent = `See image: \`${tempFilePath}\` and raw: ${tempFilePath}`;
+
+    await saveImageAttachments(testTaskDir, taskContent, attachments);
+
+    const orderMdPath = path.join(testTaskDir, '.takt', 'order.md');
+    const orderMdContent = await fs.readFile(orderMdPath, 'utf-8');
+    // The normalized path should be used in the content
+    expect(orderMdContent).toContain('See image: \`attachments/normalized.png\` and raw: \`attachments/normalized.png\`');
+  });
+});
