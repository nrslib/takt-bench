+ * @param index The index of the image (for naming)
+ * @returns Promise resolving to TaskAttachment or null if failed
+ */
+export async function downloadImageAsAttachment(
+  url: string,
+  index: number,
+  auth: boolean = false
+): Promise<TaskAttachment | null> {
+  const tempDir = tmpdir();
+  const fileExtension = url.split('.').pop() ?? 'png';
+  const fileName = `image-${index + 1}-${randomUUID()}.${fileExtension}`;
+  const tempPath = path.join(tempDir, fileName);
+  
+  try {
+    const imageBuffer = await validateAndDownloadImage(url, { auth });
+    
+    // Write to temporary file
+    await fs.promises.writeFile(tempPath, imageBuffer);
+    
+    return {
+      placeholder: `[Image #${index + 1}]`,
+      tempPath,
+      fileName,
+    };
+  } catch (error) {
+    // Clean up temp file if it was created
+    try {
+      await fs.promises.unlink(tempPath);
+    } catch {
+      // Ignore unlink errors
+    }
+    
+    // Log warning but continue without this image
+    console.warn(`Failed to download image ${url}:`, error);
+    return null;
+  }
+}
