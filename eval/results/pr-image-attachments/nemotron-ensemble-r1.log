     5	const IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN = /\[Image #\d+\]/g;
     6	
     7	const IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN = /^\[Image #[1-9]\d*\]$/;
     8	const SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS = new Set(['.gif', '.jpeg', '.jpg', '.png', '.webp']);
     9	
    10	function assertNonEmptyString(value: string, fieldName: string): void {
    11	  if (value.length === 0) {
    12	    throw new Error(`${fieldName} is required.`);
    13	  }
    14	}
    15	
    16	export function isImageAttachmentPlaceholder(value: string): boolean {
    17	  return IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN.test(value);
    18	}
    19	
    20	export function validateImageAttachmentFileName(fileName: string): void {
    21	  assertNonEmptyString(fileName, 'Image attachment fileName');
    22	  if (fileName.includes('/') || fileName.includes('\\')) {
    23	    throw new Error(`Image attachment fileName must not contain path separators: ${fileName}`);
    24	  }
    25	
    26	  const extension = path.extname(fileName).toLowerCase();
    27	  if (!SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS.has(extension)) {
    28	    throw new Error(`Unsupported image attachment file extension: ${fileName}`);
    29	  }
    30	}
    31	
    32	export function validateStoredImageAttachment(attachment: StoredImageAttachment): void {
    33	  assertNonEmptyString(attachment.placeholder, 'Image attachment placeholder');
    34	  if (!isImageAttachmentPlaceholder(attachment.placeholder)) {
    35	    throw new Error(`Invalid image attachment placeholder: ${attachment.placeholder}`);
    36	  }
    37	  assertNonEmptyString(attachment.tempPath, 'Image attachment tempPath');
    38	  validateImageAttachmentFileName(attachment.fileName);
    39	}
    40	
    41	export function assertRegularImageAttachmentFile(filePath: string, subject = 'Image attachment source'): void {
    42	  assertNonEmptyString(filePath, `${subject} path`);
    43	  const stats = fs.lstatSync(filePath);
    44	  if (stats.isSymbolicLink() || !stats.isFile()) {
