+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { tmpdir } from 'node:os';
+import { parse as parseYaml } from 'yaml';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+const { mockDownloadPrImage } = vi.hoisted(() => ({
+  mockDownloadPrImage: vi.fn(),
+}));
+
+vi.mock('../infra/github/prImageDownload.js', () => ({
+  downloadPrImage: (...args: unknown[]) => mockDownloadPrImage(...args),
+}));
+
+vi.mock('../infra/task/summarize.js', () => ({
+  summarizeTaskName: vi.fn().mockResolvedValue('pr-image-dataflow'),
+}));
+
+import { buildRunPaths } from '../core/workflow/run/run-paths.js';
+import { saveTaskFile } from '../features/tasks/add/index.js';
+import {
+  resolveTaskSpecForExecution,
+  stageTaskSpecForExecution,
+} from '../features/tasks/execute/taskSpecContext.js';
+import { preparePrReviewAttachments } from '../features/tasks/prReviewAttachments.js';
+import { formatPrReviewTask, type PrReviewData } from '../infra/git/index.js';
+
+const PNG_DATA = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+let testDir: string | undefined;
+
+afterEach(() => {
+  vi.clearAllMocks();
+  if (testDir !== undefined) {
+    fs.rmSync(testDir, { recursive: true, force: true });
+    testDir = undefined;
+  }
+});
+
+describe('PR image production dataflow', () => {
+  it('should preserve the image and its reference through task saving and run-context staging', async () => {
+    testDir = fs.mkdtempSync(path.join(tmpdir(), 'takt-pr-image-dataflow-'));
+    const imageUrl = 'https://github.com/user-attachments/assets/body-image';
+    const prReview: PrReviewData = {
+      number: 42,
+      title: 'Inspect screenshot',
+      body: '```md\nThe PR description leaves this fence open.',
+      url: 'https://github.com/acme/project/pull/42',
+      headRefName: 'fix/screenshot',
+      baseRefName: 'main',
+      comments: [{ author: 'reviewer', body: `Please inspect ![screenshot](${imageUrl}).` }],
+      reviews: [],
+      files: ['src/example.ts'],
+    };
+    mockDownloadPrImage.mockResolvedValue({ data: PNG_DATA, mimeType: 'image/png' });
+    const preparedAttachments = await preparePrReviewAttachments(
+      formatPrReviewTask(prReview),
+      testDir,
+    );
+
+    try {
+      await saveTaskFile(testDir, preparedAttachments.taskContent, {
+        workflow: 'default',
+        worktree: true,
+        attachments: preparedAttachments.attachments,
+      });
+
+      const tasksFile = parseYaml(
+        fs.readFileSync(path.join(testDir, '.takt', 'tasks.yaml'), 'utf-8'),
+      ) as { tasks: Array<{ task_dir: string }> };
+      const savedTaskDirRelative = tasksFile.tasks[0]!.task_dir;
+      const savedTaskDir = path.join(testDir, savedTaskDirRelative);
+      const savedOrder = fs.readFileSync(path.join(savedTaskDir, 'order.md'), 'utf-8');
+      expect(savedOrder).toContain('[Image #1]');
+      expect(savedOrder).toContain('- [Image #1]: `attachments/image-1.png`');
+      expect(fs.readFileSync(path.join(savedTaskDir, 'attachments', 'image-1.png'))).toEqual(PNG_DATA);
+
+      const runSlug = 'run-pr-image-dataflow';
+      const resolvedTaskSpec = resolveTaskSpecForExecution(
+        testDir,
+        testDir,
+        savedTaskDirRelative,
+        runSlug,
+      );
+      const runPaths = buildRunPaths(testDir, runSlug);
+      stageTaskSpecForExecution(resolvedTaskSpec, runPaths);
+
+      const stagedOrder = fs.readFileSync(runPaths.contextTaskOrderAbs, 'utf-8');
+      expect(stagedOrder).toContain('[Image #1]');
+      expect(stagedOrder).toContain(
+        `- [Image #1]: \`${runPaths.contextTaskRel}/attachments/image-1.png\``,
+      );
+      expect(fs.readFileSync(path.join(runPaths.contextTaskAbs, 'attachments', 'image-1.png'))).toEqual(PNG_DATA);
+      expect(mockDownloadPrImage).toHaveBeenCalledOnce();
+      expect(mockDownloadPrImage).toHaveBeenCalledWith(imageUrl, testDir);
+    } finally {
+      preparedAttachments.cleanupAttachments();
+    }
+  });
+});
