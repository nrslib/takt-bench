   155	/**
   156	 * add command handler
   157	 *
   158	 * Flow:
   159	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   160	 *   B) 引数なし: Usage表示して終了
   161	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   162	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   163	 */
   164	export async function addTask(
   165	  cwd: string,
   166	  task?: string,
   167	  opts?: { prNumber?: number; workflow?: string },
   168	): Promise<void> {
   169	  const rawTask = task ?? '';
   170	  const trimmedTask = rawTask.trim();
   171	  const prNumber = opts?.prNumber;
   172	
   173	  if (prNumber !== undefined) {
   174	    const provider = getGitProvider();
   175	    const cliStatus = provider.checkCliStatus(cwd);
   176	    if (!cliStatus.available) {
   177	      error(cliStatus.error);
   178	      return;
   179	    }
   180	
   181	    let prReview: PrReviewData;
   182	    try {
   183	      prReview = await withProgress(
   184	        'Fetching PR review comments...',
   185	        (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   186	        async () => provider.fetchPrReviewComments(prNumber, cwd),
   187	      );
   188	    } catch (e) {
   189	      const msg = getErrorMessage(e);
   190	      error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   191	      return;
   192	    }
   193	
   194	    if (
   195	      prReview.body.trim().length === 0
   196	      && prReview.reviews.length === 0
   197	      && prReview.comments.length === 0
   198	    ) {
   199	      error(`PR #${prNumber} has no review comments`);
   200	      return;
   201	    }
   202	
   203	    let preparedAttachments: Awaited<ReturnType<typeof preparePrReviewAttachments>>;
   204	    try {
   205	      preparedAttachments = await preparePrReviewAttachments(formatPrReviewTask(prReview), cwd);
   206	    } catch (e) {
   207	      error(`Failed to download PR images #${prNumber}: ${getErrorMessage(e)}`);
   208	      return;
   209	    }
   210	
   211	    try {
   212	      const workflow = await determineWorkflow(cwd, opts?.workflow);
   213	      if (workflow === null) {
   214	        info('Cancelled.');
   215	        return;
   216	      }
   217	
   218	      const settings = {
   219	        worktree: true,
   220	        branch: prReview.headRefName,
   221	        baseBranch: prReview.baseRefName,
   222	        autoPr: false,
   223	        shouldPublishBranchToOrigin: true,
   224	      };
   225	      const created = await saveTaskFile(cwd, preparedAttachments.taskContent, {
   226	        workflow,
   227	        ...settings,
   228	        prNumber,
   229	        ...(preparedAttachments.attachments.length > 0
   230	          ? { attachments: preparedAttachments.attachments }
   231	          : {}),
   232	      });
   233	      displayTaskCreationResult(created, settings, workflow);
   234	      return;
   235	    } finally {
   236	      preparedAttachments.cleanupAttachments();
   237	    }
   238	  }
   239	
   240	  if (!trimmedTask) {
   241	    info('Usage: takt add <task>');
   242	    return;
   243	  }
   244	
   245	  let taskContent: string;
   246	  let issueNumber: number | undefined;
   247	
   248	  if (isIssueReference(trimmedTask)) {
   249	    try {
   250	      const numbers = parseIssueNumbers([trimmedTask]);
   251	      const primaryIssueNumber = numbers[0];
   252	      taskContent = await withProgress(
   253	        'Fetching issue...',
   254	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   255	        async () => resolveIssueTask(trimmedTask, cwd),
   256	      );
   257	      if (numbers.length > 0) {
   258	        issueNumber = numbers[0];
   259	      }
   260	    } catch (e) {
   261	      const msg = getErrorMessage(e);
   262	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   263	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   264	      return;
   265	    }
   266	  } else {
   267	    taskContent = rawTask;
   268	  }
   269	
   270	  const workflow = await determineWorkflow(cwd, opts?.workflow);
   271	  if (workflow === null) {
   272	    info('Cancelled.');
   273	    return;
   274	  }
   275	
   276	  const settings = await promptWorktreeSettings(cwd);
   277	
   278	  const created = await saveTaskFile(cwd, taskContent, {
   279	    workflow,
   280	    issue: issueNumber,
   281	    ...settings,
   282	  });
   283	
   284	  displayTaskCreationResult(created, settings, workflow);
