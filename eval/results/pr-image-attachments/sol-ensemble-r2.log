   149	      ...run.files,
   150	      ...run.vitestArgs,
   151	    ],
   152	  };
   153	}
   154	
   155	export async function runE2eMockAttempt(command, createAttemptEnvironment) {
   156	  const shardEnv = createAttemptEnvironment(command.shardNumber);
   157	
   158	  try {
   159	    return await runTeedCommand(command.executable, command.args, {
   160	      cwd: command.cwd,
   161	      env: shardEnv.env,
   162	    });
   163	  } finally {
   164	    shardEnv.cleanup();
   165	  }
   166	}
   167	
   168	function runShardAttempt(run) {
   169	  return runE2eMockAttempt(buildShardCommand(run), createShardEnv);
   170	}
   171	
   172	async function executeAttempt(run, runAttempt) {
   173	  if (run.files.length === 0) {
   174	    return { run, result: { code: 0, signal: null, output: '' } };
   175	  }
   176	
   177	  try {
   178	    return { run, result: await runAttempt(run) };
   179	  } catch (error) {
   180	    console.error(`[takt] Failed to start E2E mock shard ${run.shardNumber}: ${error.message}`);
   181	    return { run, result: { code: 1, signal: null, output: '' } };
   182	  }
   183	}
   184	
   185	function isSuccessful(result) {
   186	  return result.code === 0 && result.signal === null;
   187	}
   188	
   189	function shouldRemeasure(result, isCI) {
   190	  return result.code !== 0
   191	    && result.signal === null
   192	    && isBirpcNoiseOnlyFailure({ output: result.output, isCI });
   193	}
   194	
   195	async function remeasureBirpcNoiseShards(results, isCI, runAttempt) {
   196	  const settled = [];
   197	  for (const entry of results) {
   198	    if (!shouldRemeasure(entry.result, isCI)) {
   199	      settled.push(entry);
   200	      continue;
   201	    }
   202	
   203	    console.error(
   204	      `[takt] E2E mock shard ${entry.run.shardNumber} exited ${entry.result.code} with every test passed and only birpc noise; re-measuring this shard once`,
   205	    );
   206	    settled.push(await executeAttempt(entry.run, runAttempt));
   207	  }
   208	  return settled;
   209	}
   210	
   211	export async function runE2eMockShards(passthroughArgs, { isCI, runAttempt }) {
   212	  const { vitestArgs, positionalFilters } = splitPassthroughArgs(passthroughArgs);
   213	
   214	  if (
   215	    positionalFilters.length > 0 &&
   216	    selectFilesForFilters(mockE2eSpecs, positionalFilters).length === 0
   217	  ) {
   218	    console.error(
   219	      `[takt] No mock E2E spec matched positional filter(s): ${positionalFilters.join(', ')}`
   220	    );
   221	    return 1;
   222	  }
   223	
   224	  const initialResults = await Promise.all(
   225	    createShardRuns(positionalFilters, vitestArgs)
   226	      .map((run) => executeAttempt(run, runAttempt))
   227	  );
   228	  const settledResults = await remeasureBirpcNoiseShards(initialResults, isCI, runAttempt);
   229	  const failed = settledResults.filter(({ result }) => !isSuccessful(result));
   230	
   231	  for (const { run, result } of failed) {
   232	    const suffix = result.signal ? ` signal=${result.signal}` : '';
   233	    console.error(
   234	      `[takt] E2E mock shard ${run.shardNumber} failed with exit=${result.code}${suffix}`
   235	    );
   236	  }
   237	
   238	  return failed.length === 0 ? 0 : 1;
   239	}
   240	
   241	async function runCli() {
   242	  mkdirSync(resolve(repoRoot, 'e2e/results'), { recursive: true });
   243	  return runE2eMockShards(process.argv.slice(2), {
   244	    isCI: Boolean(process.env.CI),
   245	    runAttempt: runShardAttempt,
   246	  });
   247	}
   248	
   249	if (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) {
   250	  process.exit(await runCli());
   251	}

