import { preparePrReviewAttachments } from '../features/tasks/prReviewAttachments.js';
import {
  formatPrReviewTask,
  type FormattedPrReviewTask,
  type PrReviewData,
} from '../infra/git/index.js';

const PNG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);

function asFormattedTask(taskContent: string): FormattedPrReviewTask {
  return {
    taskContent,
    markdownFragments: [{ start: 0, end: taskContent.length }],
  };
}

describe('preparePrReviewAttachments', () => {
  const storedAttachments: Array<{
    placeholder: string;
    tempPath: string;
    fileName: string;
  }> = [];

  beforeEach(() => {
    vi.clearAllMocks();
    storedAttachments.length = 0;
    mockDownloadPrImage.mockResolvedValue({ data: PNG, mimeType: 'image/png' });
    mockSaveImage.mockImplementation(async () => {
      const index = storedAttachments.length + 1;
      const attachment = {
        placeholder: `[Image #${index}]`,
        tempPath: `/tmp/pr-images/attachments/image-${index}.png`,
        fileName: `image-${index}.png`,
      };
      storedAttachments.push(attachment);
      return attachment;
    });
    mockListAttachments.mockImplementation(() => [...storedAttachments]);
  });

  it('should isolate every PR Markdown body when an earlier body has an unclosed fence', async () => {
    const urls = [
      'https://github.com/acme/project/assets/review-summary',
      'https://github.com/user-attachments/assets/active-thread',
      'https://github.com/user-attachments/assets/outdated-thread',
      'https://github.com/user-attachments/assets/resolved-thread',
      'https://github.com/user-attachments/assets/legacy-thread',
      'https://github.com/user-attachments/assets/conversation-comment',
    ];
    const ignoredBodyUrl = 'https://github.com/user-attachments/assets/unclosed-body-literal';
    const prReview: PrReviewData = {
      number: 42,
      title: 'Images',
      body: `\`\`\`md\n![literal](${ignoredBodyUrl})`,
      url: 'https://github.com/acme/project/pull/42',
      headRefName: 'fix/images',
      baseRefName: 'main',
      reviews: [
        { author: 'summary', body: `<img src="${urls[0]}">` },
        { author: 'active', body: `![active](${urls[1]})`, threadState: 'active' },
        { author: 'outdated', body: `![outdated](${urls[2]})`, threadState: 'outdated-unresolved' },
        { author: 'resolved', body: `![resolved](${urls[3]})`, threadState: 'resolved' },
        { author: 'legacy', body: `![legacy](${urls[4]})`, path: 'src/image.ts' },
        { author: 'duplicate', body: `![duplicate](${urls[1]})`, path: 'src/duplicate.ts' },
      ],
      comments: [{ author: 'commenter', body: `<img src='${urls[5]}' />` }],
      files: [],
    };

    const result = await preparePrReviewAttachments(formatPrReviewTask(prReview), '/project');

    expect(result.taskContent).toContain(`![literal](${ignoredBodyUrl})`);
    expect(result.taskContent).toContain('**summary**: [Image #1]');
    expect(result.taskContent).toContain('**active**: [Image #2]');
    expect(result.taskContent).toContain('**outdated**: [Image #3]');
    expect(result.taskContent).toContain('**resolved**: [Image #4]');
    expect(result.taskContent).toContain('**legacy**: [Image #5]');
    expect(result.taskContent).toContain('**duplicate**: [Image #2]');
    expect(result.taskContent).toContain('**commenter**: [Image #6]');
    expect(mockDownloadPrImage.mock.calls).toEqual(urls.map((url) => [url, '/project']));
    expect(result.attachments.map((attachment) => attachment.placeholder)).toEqual([
      '[Image #1]',
      '[Image #2]',
      '[Image #3]',
      '[Image #4]',
      '[Image #5]',
      '[Image #6]',
    ]);
  });

  it('should download a repeated image once and reuse its placeholder', async () => {
    const url = 'https://github.com/user-attachments/assets/repeated';
    const taskContent = `First ![image](${url}) and again <img src="${url}">.`;

    const result = await preparePrReviewAttachments(asFormattedTask(taskContent), '/project');

    expect(result.taskContent).toBe('First [Image #1] and again [Image #1].');
    expect(mockDownloadPrImage).toHaveBeenCalledOnce();
    expect(mockSaveImage).toHaveBeenCalledOnce();
    expect(result.attachments).toHaveLength(1);
  });

  it('should reserve image indexes already referenced by the PR content', async () => {
    const url = 'https://github.com/user-attachments/assets/new-image';
    const taskContent = `Compare [Image #1] with ![actual](${url}).`;

    const result = await preparePrReviewAttachments(asFormattedTask(taskContent), '/project');

    expect(result.taskContent).toBe('Compare [Image #1] with [Image #2].');
    expect(result.attachments).toEqual([{
      placeholder: '[Image #2]',
      tempPath: '/tmp/pr-images/attachments/image-1.png',
      fileName: 'image-2.png',
    }]);
    expect(mockDownloadPrImage).toHaveBeenCalledOnce();
    expect(mockSaveImage).toHaveBeenCalledOnce();
  });

  it('should assign low unused indexes without converting reserved decimal identifiers', async () => {
    const firstUrl = 'https://github.com/user-attachments/assets/first-boundary-image';
    const secondUrl = 'https://github.com/user-attachments/assets/second-boundary-image';
    const safeIntegerLimit = '9007199254740991';
    const unsafeInteger = '9007199254740992';
    const fourHundredDigitIndex = '9'.repeat(400);
    const taskContent = [
      `Existing [Image #1], attachments/image-3.png, [Image #${safeIntegerLimit}],`,
      `attachments/image-${unsafeInteger}.png, and [Image #${fourHundredDigitIndex}].`,
      `![first](${firstUrl})`,
      `![second](${secondUrl})`,
      `![first again](${firstUrl})`,
    ].join('\n');

    const result = await preparePrReviewAttachments(asFormattedTask(taskContent), '/project');

    expect(result.taskContent).toBe([
      `Existing [Image #1], attachments/image-3.png, [Image #${safeIntegerLimit}],`,
      `attachments/image-${unsafeInteger}.png, and [Image #${fourHundredDigitIndex}].`,
      '[Image #2]',
      '[Image #4]',
      '[Image #2]',
    ].join('\n'));
    expect(result.attachments).toEqual([
      {
        placeholder: '[Image #2]',
        tempPath: '/tmp/pr-images/attachments/image-1.png',
        fileName: 'image-2.png',
      },
      {
        placeholder: '[Image #4]',
        tempPath: '/tmp/pr-images/attachments/image-2.png',
        fileName: 'image-4.png',
      },
    ]);
    expect(mockDownloadPrImage.mock.calls).toEqual([
      [firstUrl, '/project'],
      [secondUrl, '/project'],
    ]);

    result.cleanupAttachments();
    expect(mockCleanup).toHaveBeenCalledOnce();
  });

  it('should preserve image-like text in Markdown literal contexts', async () => {
    const ignoredUrls = [
      'https://github.com/user-attachments/assets/fenced',
      'https://github.com/user-attachments/assets/inline',
      'https://github.com/user-attachments/assets/comment',
    ];
    const downloadedUrl = 'https://github.com/user-attachments/assets/visible';
    const taskContent = [
      '```md',
      `![fenced](${ignoredUrls[0]})`,
      '```',
      `Use \`![inline](${ignoredUrls[1]})\` as an example.`,
      `<!-- <img src="${ignoredUrls[2]}"> -->`,
      `Visible <img src="${downloadedUrl}">`,
    ].join('\n');

    const result = await preparePrReviewAttachments(asFormattedTask(taskContent), '/project');

    expect(result.taskContent).toBe([
      '```md',
      `![fenced](${ignoredUrls[0]})`,
      '```',
      `Use \`![inline](${ignoredUrls[1]})\` as an example.`,
      `<!-- <img src="${ignoredUrls[2]}"> -->`,
      'Visible [Image #1]',
    ].join('\n'));
    expect(mockDownloadPrImage).toHaveBeenCalledOnce();
    expect(mockDownloadPrImage).toHaveBeenCalledWith(downloadedUrl, '/project');
  });

  it('should preserve Markdown image syntax inside a raw HTML pre block', async () => {
    const literalUrl = 'https://github.com/user-attachments/assets/raw-html-literal';
    const downloadedUrl = 'https://github.com/user-attachments/assets/visible-after-raw-html';
    const taskContent = [
      '<pre>',
      `![example](${literalUrl})`,
      '</pre>',
      `![visible](${downloadedUrl})`,
    ].join('\n');

