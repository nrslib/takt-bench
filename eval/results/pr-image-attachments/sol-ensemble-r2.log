   187	      execCwd: cwd,
   188	      isWorktree: false,
   189	      branch: prBranch,
   190	      baseBranch,
   191	    };
   192	  }
   193	  const branch = tryResolveCurrentBranch(cwd);
   194	  const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   195	  return {
   196	    execCwd: cwd,
   197	    isWorktree: false,
   198	    branch,
   199	    baseBranch,
   200	  };
