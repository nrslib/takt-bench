@@ -0,0 +1,31 @@
+import { describe, expect, it, vi } from 'vitest';
+import { registerProcessExitCleanup } from '../app/cli/processExitCleanup.js';
+
+describe('registerProcessExitCleanup', () => {
+  it('should cleanup once and remove the exit listener when finished normally', () => {
+    const cleanup = vi.fn();
+    const listenerCountBefore = process.listenerCount('exit');
+
+    const finish = registerProcessExitCleanup(cleanup);
+    finish();
+    finish();
+
+    expect(cleanup).toHaveBeenCalledOnce();
+    expect(process.listenerCount('exit')).toBe(listenerCountBefore);
+  });
+
+  it('should cleanup once when the registered exit listener runs before finish', () => {
+    const cleanup = vi.fn();
+    const listenersBefore = new Set(process.rawListeners('exit'));
+    const finish = registerProcessExitCleanup(cleanup);
+    const registeredListener = process.rawListeners('exit')
+      .find((listener) => !listenersBefore.has(listener));
+
+    expect(registeredListener).toBeDefined();
+    registeredListener?.(1);
+    finish();
+
+    expect(cleanup).toHaveBeenCalledOnce();
+    expect(process.rawListeners('exit')).toEqual([...listenersBefore]);
+  });
+});

