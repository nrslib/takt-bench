    55	/**
    56	 * Prompt user to select a label for the issue.
    57	 *
    58	 * Presents 4 fixed options: None, bug, enhancement, custom input.
    59	 * Returns an array of selected labels (empty if none selected).
    60	 */
    61	export async function promptLabelSelection(lang: Language): Promise<string[]> {
    62	  const selected = await selectOption<string>(
    63	    getLabel('issue.labelSelection.prompt', lang),
    64	    [
    65	      { label: getLabel('issue.labelSelection.none', lang), value: 'none' },
    66	      { label: 'bug', value: 'bug' },
    67	      { label: 'enhancement', value: 'enhancement' },
    68	      { label: getLabel('issue.labelSelection.custom', lang), value: 'custom' },
    69	    ],
    70	  );
    71	
    72	  if (selected === null || selected === 'none') return [];
    73	  if (selected === 'custom') {
    74	    const customLabel = await promptInput(getLabel('issue.labelSelection.customPrompt', lang));
    75	    return customLabel?.split(',').map((l) => l.trim()).filter((l) => l.length > 0) ?? [];
    76	  }
    77	  return [selected];
    78	}
