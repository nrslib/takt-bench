   136	function generatePipelineBranchName(pipelineConfig: PipelineConfig | undefined, issueNumber?: number): string {
   137	  const prefix = pipelineConfig?.defaultBranchPrefix ?? 'takt/';
   138	  const timestamp = Math.floor(Date.now() / 1000);
   139	  return issueNumber
   140	    ? `${prefix}issue-${issueNumber}-${timestamp}`
   141	    : `${prefix}pipeline-${timestamp}`;
   142	}
