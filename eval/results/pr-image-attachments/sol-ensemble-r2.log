     7	  EXIT_ISSUE_FETCH_FAILED,
     8	  EXIT_WORKFLOW_FAILED,
     9	  EXIT_GIT_OPERATION_FAILED,
    10	  EXIT_PR_CREATION_FAILED,
    11	} from '../../shared/exitCodes.js';
