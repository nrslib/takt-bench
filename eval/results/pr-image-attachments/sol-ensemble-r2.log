     6	export interface PastedImage {
     7	  mimeType: string;
     8	  data: Buffer;
     9	}
    10	
    11	export type ImagePasteHandler = (image: PastedImage) => Promise<string>;
    12	
    13	export const OSC_IMAGE_PREFIX = '\x1B]1337;File=';
    14	export const MAX_INLINE_IMAGE_BYTES = MAX_SUPPORTED_IMAGE_BYTES;
    15	export const MAX_PENDING_INLINE_IMAGE_CHARS = Math.ceil(MAX_INLINE_IMAGE_BYTES / 3) * 4 + 1024;
    16	
    17	export type InlineImageSequence =
    18	  | { status: 'incomplete' }
    19	  | { status: 'passthrough'; sequenceEnd: number }
    20	  | { status: 'image'; image: PastedImage; sequenceEnd: number };
    21	
    22	function getParamValue(params: string[], name: string): string | null {
    23	  const prefix = `${name}=`;
    24	  const param = params.find((value) => value.startsWith(prefix));
    25	  return param ? param.slice(prefix.length) : null;
    26	}
    27	
    28	function isBase64Encoded(value: string, decoded: string): boolean {
    29	  return Buffer.from(decoded, 'utf8').toString('base64').replace(/=+$/, '') === value.replace(/=+$/, '');
    30	}
    31	
    32	function decodeInlineFileName(value: string): string {
    33	  const decoded = Buffer.from(value, 'base64').toString('utf8');
    34	  return isBase64Encoded(value, decoded) ? decoded : value;
    35	}
    36	
    37	function inferMimeTypeFromName(nameParam: string | null): string | null {
    38	  if (!nameParam) {
    39	    return null;
    40	  }
    41	
    42	  const fileName = decodeInlineFileName(nameParam).toLowerCase();
    43	  if (fileName.endsWith('.png')) return 'image/png';
    44	  if (fileName.endsWith('.jpg') || fileName.endsWith('.jpeg')) return 'image/jpeg';
    45	  if (fileName.endsWith('.gif')) return 'image/gif';
    46	  if (fileName.endsWith('.webp')) return 'image/webp';
    47	  return null;
    48	}
    49	
    50	function validateDeclaredSize(params: string[], encodedData: string): void {
    51	  const sizeParam = getParamValue(params, 'size');
    52	  if (!sizeParam) {
    53	    return;
    54	  }
    55	
    56	  const declaredSize = Number.parseInt(sizeParam, 10);
    57	  if (!Number.isSafeInteger(declaredSize) || declaredSize < 0) {
    58	    throw new Error(`Invalid pasted inline image size: ${sizeParam}`);
    59	  }
    60	  if (declaredSize > MAX_INLINE_IMAGE_BYTES) {
    61	    throw new Error(`Pasted inline image exceeds the ${MAX_INLINE_IMAGE_BYTES} byte limit.`);
    62	  }
    63	
    64	  const maxEncodedLength = Math.ceil(declaredSize / 3) * 4 + 4;
    65	  if (encodedData.length > maxEncodedLength) {
    66	    throw new Error('Pasted inline image data is larger than its declared size.');
    67	  }
    68	}
    69	
    70	function decodeImageData(params: string[], encodedData: string): Buffer {
    71	  validateDeclaredSize(params, encodedData);
    72	  if (encodedData.length > Math.ceil(MAX_INLINE_IMAGE_BYTES / 3) * 4 + 4) {
    73	    throw new Error(`Pasted inline image exceeds the ${MAX_INLINE_IMAGE_BYTES} byte limit.`);
    74	  }
    75	
    76	  const imageData = Buffer.from(encodedData, 'base64');
    77	  if (imageData.length > MAX_INLINE_IMAGE_BYTES) {
    78	    throw new Error(`Pasted inline image exceeds the ${MAX_INLINE_IMAGE_BYTES} byte limit.`);
    79	  }
    80	
    81	  const sizeParam = getParamValue(params, 'size');
    82	  if (sizeParam && imageData.length !== Number.parseInt(sizeParam, 10)) {
    83	    throw new Error('Pasted inline image data does not match its declared size.');
    84	  }
    85	  return imageData;
    86	}
    87	
    88	function resolveInlineImageMimeType(params: string[], data: Buffer): string {
    89	  const mimeType = inferSupportedImageMimeType(data);
    90	  if (!mimeType) {
    91	    throw new Error('Unsupported pasted inline image type. Expected PNG, JPEG, GIF, or WebP data.');
    92	  }
    93	
    94	  const nameMimeType = inferMimeTypeFromName(getParamValue(params, 'name'));
    95	  if (nameMimeType && nameMimeType !== mimeType) {
    96	    throw new Error(`Pasted inline image filename type does not match image data: ${nameMimeType} !== ${mimeType}`);
    97	  }
