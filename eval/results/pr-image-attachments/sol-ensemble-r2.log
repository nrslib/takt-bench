    27	interface PipelineOutcome {
    28	  exitCode: number;
    29	  result: PipelineResult;
    30	}
    31	
    32	async function runPipeline(options: PipelineExecutionOptions): Promise<PipelineOutcome> {
    33	  const { cwd, workflow, autoPr, skipGit } = options;
    34	  const pipelineConfig = resolveConfigValues(cwd, ['pipeline']).pipeline;
    35	
    36	  const buildResult = (overrides: Partial<PipelineResult> = {}): PipelineResult => ({
    37	    success: false, workflow, issueNumber: options.issueNumber, ...overrides,
    38	  });
    39	
    40	  const taskContent = await resolveTaskContent(options);
    41	  if (!taskContent) return { exitCode: EXIT_ISSUE_FETCH_FAILED, result: buildResult() };
    42	
    43	  try {
    44	  let context: ExecutionContext;
    45	  try {
    46	    context = await resolveExecutionContext(
    47	      cwd,
    48	      taskContent.task,
    49	      options,
    50	      pipelineConfig,
    51	      taskContent.prBranch,
    52	      taskContent.prBaseBranch,
    53	    );
    54	  } catch (err) {
    55	    error(`Failed to prepare execution environment: ${getErrorMessage(err)}`);
    56	    return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult() };
    57	  }
    58	
    59	  log.info('Pipeline workflow execution starting', { workflow, branch: context.branch, skipGit, issueNumber: options.issueNumber });
    60	  const workflowOk = await runWorkflow(cwd, workflow, taskContent, context.execCwd, options, context);
    61	  if (!workflowOk) return { exitCode: EXIT_WORKFLOW_FAILED, result: buildResult({ branch: context.branch }) };
    62	
    63	  if (!skipGit && context.branch) {
    64	    const commitMessage = buildCommitMessage(pipelineConfig, taskContent.issue, options.task);
    65	    if (!await commitAndPush(context.execCwd, cwd, context.branch, commitMessage, context.isWorktree)) {
    66	      return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult({ branch: context.branch }) };
    67	    }
    68	  }
    69	
    70	  let prUrl: string | undefined;
    71	  if (autoPr && !skipGit && context.branch) {
    72	    prUrl = submitPullRequest(cwd, context.branch, context.baseBranch, taskContent, workflow, pipelineConfig, options);
    73	    if (!prUrl) return { exitCode: EXIT_PR_CREATION_FAILED, result: buildResult({ branch: context.branch }) };
    74	  } else if (autoPr && skipGit) {
    75	    info('--auto-pr is ignored when --skip-git is specified (no push was performed)');
    76	  }
    77	
    78	  blankLine();
    79	  const safeWorkflow = sanitizeTerminalText(workflow);
    80	  const issueStatus = taskContent.issue
    81	    ? `#${taskContent.issue.number} "${sanitizeTerminalText(taskContent.issue.title)}"`
    82	    : 'N/A';
    83	  const branchStatus = context.branch ? sanitizeTerminalText(context.branch) : '(current)';
    84	  status('Issue', issueStatus);
    85	  status('Branch', branchStatus);
    86	  status('Workflow', safeWorkflow);
    87	  status('Result', 'Success', 'green');
    88	
    89	  return { exitCode: 0, result: buildResult({ success: true, branch: context.branch, prUrl }) };
    90	  } finally {
    91	    taskContent.cleanupAttachments?.();
    92	  }
    93	}
    94	export async function executePipeline(options: PipelineExecutionOptions): Promise<number> {
    95	  const startTime = Date.now();
    96	  const runId = generateRunId();
    97	  let pipelineResult: PipelineResult = { success: false, workflow: options.workflow, issueNumber: options.issueNumber };
    98	
    99	  try {
   100	    const outcome = await runPipeline(options);
   101	    pipelineResult = outcome.result;
   102	    return outcome.exitCode;
   103	  } finally {
   104	    await notifySlack(runId, startTime, pipelineResult);
   105	  }
   106	}
   107	
   108	interface PipelineResult {
   109	  success: boolean;
   110	  workflow: string;
   111	  issueNumber?: number;
   112	  branch?: string;
   113	  prUrl?: string;
   114	}
   115	
   116	async function notifySlack(runId: string, startTime: number, result: PipelineResult): Promise<void> {
   117	  const webhookUrl = getSlackWebhookUrl();
   118	  if (!webhookUrl) return;
   119	
   120	  const durationSec = Math.round((Date.now() - startTime) / 1000);
   121	  const task: SlackTaskDetail = {
   122	    name: 'pipeline',
   123	    success: result.success,
   124	    workflow: result.workflow,
   125	    issueNumber: result.issueNumber,
   126	    durationSec,
   127	    branch: result.branch,
   128	    prUrl: result.prUrl,
   129	  };
   130	  const message = buildSlackRunSummary({
   131	    runId,
   132	    total: 1,
   133	    success: result.success ? 1 : 0,
   134	    failed: result.success ? 0 : 1,
   135	    durationSec,
   136	    concurrency: 1,
   137	    tasks: [task],
   138	  });
   139	
   140	  await sendSlackNotification(webhookUrl, message);
   141	}
