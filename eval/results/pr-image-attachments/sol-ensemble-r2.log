   329	/**
   330	 * Build PR body from issues and execution report.
   331	 * Supports multiple issues (adds "Closes #N" for each).
   332	 */
   333	export function buildPrBody(issues: Issue[] | undefined, report: string, orderContent?: string): string {
   334	  const parts: string[] = [];
   335	  const summary = issues && issues.length > 0
   336	    ? issues[0]!.body || issues[0]!.title
   337	    : orderContent?.trim()
   338	      ? orderContent
   339	      : undefined;
   340	
   341	  parts.push('## Summary');
   342	  if (summary) {
   343	    parts.push('');
   344	    parts.push(summary);
   345	  }
   346	
   347	  parts.push('');
   348	  parts.push('## Execution Report');
   349	  parts.push('');
   350	  parts.push(report);
   351	
   352	  if (issues && issues.length > 0) {
   353	    parts.push('');
   354	    parts.push(issues.map((issue) => `Closes #${issue.number}`).join('\n'));
   355	  }
   356	
   357	  return parts.join('\n');
   358	}

