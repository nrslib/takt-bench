   130	  }
   131	
   132	  const payload = input.slice(payloadStart, terminator.index);
   133	  const sequenceEnd = terminator.index + terminator.length;
   134	  const separatorIndex = payload.indexOf(':');
   135	  if (separatorIndex === -1) {
   136	    return { status: 'passthrough', sequenceEnd };
   137	  }
   138	
   139	  const params = payload.slice(0, separatorIndex).split(';');
   140	  if (!params.includes('inline=1')) {
   141	    return { status: 'passthrough', sequenceEnd };
   142	  }
   143	
   144	  const encodedData = payload.slice(separatorIndex + 1);
   145	  const imageData = decodeImageData(params, encodedData);
   146	  return {
   147	    status: 'image',
   148	    image: {
   149	      mimeType: resolveInlineImageMimeType(params, imageData),
   150	      data: imageData,
   151	    },
   152	    sequenceEnd,
   153	  };
   154	}

