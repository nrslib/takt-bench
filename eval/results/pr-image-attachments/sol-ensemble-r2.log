   102	  if (!summaryPrompt) {
   103	    info(getLabel('interactive.ui.noConversation', ctx.lang));
   104	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   105	  }
   106	
   107	  let imageAttachments: ReturnType<typeof resolvePromptImageAttachments>;
   108	  try {
   109	    imageAttachments = resolvePromptImageAttachments(summaryPrompt, attachmentStore.listAttachments());
   110	  } catch (caught) {
