   179	function resolveSkipGitExecutionContext(
   180	  cwd: string,
   181	  prBranch: string | undefined,
   182	  prBaseBranch: string | undefined,
   183	): SkipGitExecutionContext {
   184	  if (prBranch) {
   185	    const baseBranch = prBaseBranch ?? resolveReadOnlyBaseBranch(cwd);
