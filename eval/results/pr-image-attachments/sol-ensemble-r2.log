   144	export function buildCommitMessage(
   145	  pipelineConfig: PipelineConfig | undefined,
   146	  issue: Issue | undefined,
   147	  taskText: string | undefined,
   148	): string {
   149	  const template = pipelineConfig?.commitMessageTemplate;
