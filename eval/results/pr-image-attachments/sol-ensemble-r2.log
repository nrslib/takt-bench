    84	    }
    85	    const trimmed = input.trim();
    86	    if (!trimmed) {
    87	      info(getLabel('interactive.ui.cancelled', ctx.lang));
    88	      return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
    89	    }
    90	    history.push({ role: 'user', content: trimmed });
    91	  }
    92	
    93	  const conversationLabel = getLabel('interactive.conversationLabel', ctx.lang);
    94	  const noTranscript = getLabel('interactive.noTranscript', ctx.lang);
    95	
