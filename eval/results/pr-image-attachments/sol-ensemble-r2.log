   102	function findTerminator(input: string, start: number): { index: number; length: number } | null {
   103	  const belIndex = input.indexOf('\x07', start);
   104	  const stIndex = input.indexOf('\x1B\\', start);
   105	  if (belIndex === -1 && stIndex === -1) {
   106	    return null;
   107	  }
   108	  if (belIndex !== -1 && (stIndex === -1 || belIndex < stIndex)) {
   109	    return { index: belIndex, length: 1 };
   110	  }
   111	  return { index: stIndex, length: 2 };
   112	}
   113	
   114	export function assertPendingInlineImageWithinLimit(pendingInput: string): void {
   115	  if (pendingInput.length > MAX_PENDING_INLINE_IMAGE_CHARS) {
