   106	/** Regex to match `#N` patterns (issue numbers) */
   107	const ISSUE_NUMBER_REGEX = /^#(\d+)$/;
   108	
   109	/**
   110	 * Parse `#N` patterns from argument strings.
   111	 * Returns issue numbers found, or empty array if none.
   112	 *
   113	 * Each argument must be exactly `#N` (no mixed text).
   114	 * Examples:
   115	 *   ['#6'] → [6]
   116	 *   ['#6', '#7'] → [6, 7]
   117	 *   ['Fix bug'] → []
   118	 *   ['#6', 'and', '#7'] → [] (mixed, not all are issue refs)
   119	 */
   120	export function parseIssueNumbers(args: string[]): number[] {
   121	  if (args.length === 0) return [];
   122	
   123	  const numbers: number[] = [];
   124	  for (const arg of args) {
   125	    const match = arg.match(ISSUE_NUMBER_REGEX);
   126	    if (!match?.[1]) return []; // Not all args are issue refs
   127	    numbers.push(Number.parseInt(match[1], 10));
   128	  }
   129	
   130	  return numbers;
   131	}
   132	
   133	/**
   134	 * Check if a single task string is an issue reference (`#N`).
   135	 */
   136	export function isIssueReference(task: string): boolean {
   137	  return ISSUE_NUMBER_REGEX.test(task.trim());
   138	}
