import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { MAX_INLINE_IMAGE_BYTES } from '../features/interactive/inlineImagePaste.js';

const { mockExecFileSync } = vi.hoisted(() => ({
  mockExecFileSync: vi.fn(),
}));

vi.mock('node:child_process', () => ({
  execFileSync: mockExecFileSync,
}));

import { downloadPrImage } from '../infra/github/prImageDownload.js';

const imageCases = [
  ['image/png', Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])],
  ['image/jpeg', Buffer.from([0xff, 0xd8, 0xff, 0xe0])],
  ['image/gif', Buffer.from('GIF89a')],
  ['image/webp', Buffer.from('RIFF0000WEBP')],
] as const;

const PNG_BYTES = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);

function responseWithImage(data: Buffer, contentType: string, contentLength?: number): Response {
  return new Response(data, {
    status: 200,
    headers: {
      'content-type': contentType,
      ...(contentLength === undefined ? {} : { 'content-length': String(contentLength) }),
    },
  });
}

describe('downloadPrImage', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockExecFileSync.mockReturnValue('github-token\n');
  });

  afterEach(() => {
    vi.unstubAllGlobals();
    vi.unstubAllEnvs();
  });

  it.each(imageCases)('should accept %s when Content-Type and magic bytes agree', async (mimeType, data) => {
    const fetchMock = vi.fn().mockResolvedValue(responseWithImage(data, mimeType));
    vi.stubGlobal('fetch', fetchMock);
    const url = 'https://github.com/user-attachments/assets/asset-id';

    const result = await downloadPrImage(url, '/project');

    expect(result).toEqual({ data, mimeType });
    expect(mockExecFileSync).toHaveBeenCalledWith(
      'gh',
      ['auth', 'token', '--hostname', 'github.com'],
      expect.objectContaining({ cwd: '/project' }),
    );
    expect(fetchMock).toHaveBeenCalledWith(
      url,
      expect.objectContaining({
        headers: expect.objectContaining({
          Authorization: 'Bearer github-token',
        }),
      }),
    );
  });

  it('should select github.com credentials when GH_HOST names an enterprise host', async () => {
    vi.stubEnv('GH_HOST', 'enterprise.example');
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(responseWithImage(PNG_BYTES, 'image/png')));

    await downloadPrImage(
      'https://github.com/user-attachments/assets/asset-id',
      '/project',
    );

    expect(mockExecFileSync).toHaveBeenCalledWith(
      'gh',
      ['auth', 'token', '--hostname', 'github.com'],
      expect.objectContaining({ cwd: '/project' }),
    );
  });

  it.each([
    'http://github.com/user-attachments/assets/asset-id',
    'https://example.com/user-attachments/assets/asset-id',
    'https://user:password@github.com/user-attachments/assets/asset-id',
    'https://github.com/acme/project/issues/1',
  ])('should reject a non-attachment URL before authentication or download: %s', async (url) => {
    const fetchMock = vi.fn();
    vi.stubGlobal('fetch', fetchMock);

    await expect(downloadPrImage(url, '/project')).rejects.toThrow();

    expect(mockExecFileSync).not.toHaveBeenCalled();
    expect(fetchMock).not.toHaveBeenCalled();
  });

  it('should reject a response whose Content-Type disagrees with its magic bytes', async () => {
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(
      responseWithImage(PNG_BYTES, 'image/jpeg'),
    ));

    await expect(downloadPrImage(
      'https://github.com/acme/project/assets/asset-id',
      '/project',
    )).rejects.toThrow();
  });

  it.each([
    Buffer.from([0x89, 0x50, 0x4e, 0x47]),
    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x00]),
  ])('should reject an incomplete PNG signature', async (data) => {
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(responseWithImage(data, 'image/png')));

    await expect(downloadPrImage(
      'https://github.com/user-attachments/assets/asset-id',
      '/project',
    )).rejects.toThrow('Unsupported PR image data');
  });

  it('should reject unsupported Content-Type and unknown magic bytes', async () => {
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(
      responseWithImage(Buffer.from('<svg></svg>'), 'image/svg+xml'),
    ));

    await expect(downloadPrImage(
      'https://github.com/user-attachments/assets/asset-id',
      '/project',
    )).rejects.toThrow();
  });

  it('should reject Content-Length above the image size limit', async () => {
    const cancel = vi.fn();
    const body = new ReadableStream<Uint8Array>({
      start(controller) {
        controller.enqueue(PNG_BYTES);
      },
      cancel,
    });
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(
      new Response(body, {
        status: 200,
        headers: {
          'content-type': 'image/png',
