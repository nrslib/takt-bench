    73	    blankLine();
    74	
    75	    const input = await readMultilineInput(chalk.green('> '), {
    76	      onImagePaste: createImagePasteHandler(attachmentStore),
    77	      onClipboardImagePaste: createClipboardImagePasteHandler(attachmentStore),
    78	      onClipboardImagePasteError: reportClipboardImagePasteError,
    79	    });
    80	    if (input === null) {
    81	      blankLine();
    82	      info(getLabel('interactive.ui.cancelled', ctx.lang));
