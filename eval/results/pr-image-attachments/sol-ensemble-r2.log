+registerProcessExitCleanup(() => rmSync(sessionDir, { recursive: true, force: true }));
+process.exit(23);
diff --git a/src/__tests__/it-e2e-mock-runner-attempt.test.ts b/src/__tests__/it-e2e-mock-runner-attempt.test.ts
new file mode 100644
index 00000000..995105be
--- /dev/null
+++ b/src/__tests__/it-e2e-mock-runner-attempt.test.ts
@@ -0,0 +1,155 @@
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { tmpdir } from 'node:os';
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  createShardEnv,
+  runE2eMockAttempt,
+  runE2eMockShards,
+} from '../../scripts/run-e2e-mock-shards.mjs';
+
+interface ShardRun {
+  readonly shardNumber: number;
+}
+
+const birpcNoiseOutput = [
+  ' ✓ e2e/example.test.ts (3 tests) 1200ms',
+  '',
+  '⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯ Unhandled Error ⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯',
+  'Error: [vitest-worker]: Timeout calling "onTaskUpdate"',
+  ' ❯ Timeout.<anonymous> node_modules/vitest/dist/chunks/rpc.js:49:10',
+  '',
+  ' Test Files  1 passed (1)',
+  '      Tests  3 passed (3)',
+  '     Errors  1 error',
+  '   Duration  62.00s',
+].join('\n');
+const observedEnvKeys = [
+  'HOME',
+  'XDG_CONFIG_HOME',
+  'XDG_CACHE_HOME',
+  'XDG_STATE_HOME',
+  'TMPDIR',
+  'TAKT_CONFIG_DIR',
+  'TAKT_E2E_PROVIDER',
+  'TAKT_NO_TTY',
+];
+
+let testDir: string | undefined;
+
+afterEach(() => {
+  if (testDir !== undefined) {
+    fs.rmSync(testDir, { recursive: true, force: true });
+    testDir = undefined;
+  }
+});
+
+function createObservedEnvironmentFactory(roots: string[]) {
+  return (shardNumber: number) => {
+    const environment = createShardEnv(shardNumber);
+    roots.push(path.dirname(environment.env.HOME));
+    return environment;
+  };
+}
+
+function createObservationCommand(cwd: string, shardNumber: number) {
+  const script = [
+    `const keys = ${JSON.stringify(observedEnvKeys)}`,
+    'const env = Object.fromEntries(keys.map((key) => [key, process.env[key]]))',
+    'process.stdout.write(JSON.stringify({ cwd: process.cwd(), env }))',
+  ].join('\n');
+  return {
+    shardNumber,
+    executable: process.execPath,
+    args: ['-e', script],
+    cwd,
+  };
+}
+
+describe('E2E mock attempt process boundary', () => {
+  it('should pass cwd and a fresh isolated environment to every real child then cleanup', async () => {
+    testDir = fs.mkdtempSync(path.join(tmpdir(), 'takt-e2e-attempt-cwd-'));
+    const roots: string[] = [];
+    const createAttemptEnvironment = createObservedEnvironmentFactory(roots);
+
+    const first = await runE2eMockAttempt(
+      createObservationCommand(testDir, 1),
+      createAttemptEnvironment,
+    );
+    const second = await runE2eMockAttempt(
+      createObservationCommand(testDir, 1),
+      createAttemptEnvironment,
+    );
+
+    const observations = [first, second].map((result) => JSON.parse(result.output) as {
+      cwd: string;
+      env: Record<string, string>;
+    });
+    expect(observations.map(({ cwd }) => cwd)).toEqual([
+      fs.realpathSync(testDir),
+      fs.realpathSync(testDir),
+    ]);
+    expect(new Set(roots).size).toBe(2);
+    for (const [index, observation] of observations.entries()) {
+      const root = roots[index]!;
+      expect(observation.env).toEqual({
+        HOME: path.join(root, 'home'),
+        XDG_CONFIG_HOME: path.join(root, 'xdg-config'),
+        XDG_CACHE_HOME: path.join(root, 'xdg-cache'),
+        XDG_STATE_HOME: path.join(root, 'xdg-state'),
+        TMPDIR: path.join(root, 'tmp'),
+        TAKT_CONFIG_DIR: path.join(root, '.takt'),
+        TAKT_E2E_PROVIDER: 'mock',
+        TAKT_NO_TTY: '1',
+      });
+      expect(fs.existsSync(root)).toBe(false);
+    }
+  });
+
+  it('should cleanup the isolated environment when the child cannot be spawned', async () => {
+    testDir = fs.mkdtempSync(path.join(tmpdir(), 'takt-e2e-attempt-spawn-'));
+    const roots: string[] = [];
+    const createAttemptEnvironment = createObservedEnvironmentFactory(roots);
+
+    await expect(runE2eMockAttempt({
+      shardNumber: 2,
+      executable: path.join(testDir, 'missing-executable'),
+      args: [],
+      cwd: testDir,
+    }, createAttemptEnvironment)).rejects.toMatchObject({ code: 'ENOENT' });
+
+    expect(roots).toHaveLength(1);
+    expect(fs.existsSync(roots[0]!)).toBe(false);
+  });
+
+  it('should use the isolated real-child executor for initial and re-measured attempts', async () => {
+    testDir = fs.mkdtempSync(path.join(tmpdir(), 'takt-e2e-attempt-remeasure-'));
+    const roots: string[] = [];
+    const createAttemptEnvironment = createObservedEnvironmentFactory(roots);
+    const attemptedShards: number[] = [];
+    let attempt = 0;
+
+    const runAttempt = async (run: ShardRun) => {
+      attemptedShards.push(run.shardNumber);
+      const currentAttempt = attempt;
+      attempt += 1;
+      const output = currentAttempt === 1 ? birpcNoiseOutput : `attempt-${currentAttempt}`;
+      const exitCode = currentAttempt === 1 ? 1 : 0;
+      const script = `process.stdout.write(${JSON.stringify(output)}, () => process.exit(${exitCode}))`;
+      return runE2eMockAttempt({
+        shardNumber: run.shardNumber,
+        executable: process.execPath,
+        args: ['-e', script],
+        cwd: testDir,
+      }, createAttemptEnvironment);
+    };
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(code).toBe(0);
+    expect(attempt).toBe(5);
+    expect(attemptedShards).toEqual([1, 2, 3, 4, 2]);
+    expect(new Set(roots).size).toBe(5);
+    expect(roots.every((root) => !fs.existsSync(root))).toBe(true);
+  });
+});
