   222	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   223	  const { cwd } = options;
   224	  if (options.prNumber) {
   225	    info(`Fetching PR #${options.prNumber} review comments...`);
   226	    const prReview = fetchVcsResource(
   227	      `PR #${options.prNumber}`,
   228	      cwd,
   229	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   230	    );
   231	    if (!prReview) return undefined;
   232	    let preparedAttachments: Awaited<ReturnType<typeof preparePrReviewAttachments>>;
   233	    try {
   234	      preparedAttachments = await preparePrReviewAttachments(formatPrReviewTask(prReview), cwd);
   235	    } catch (err) {
   236	      error(`Failed to download PR images #${options.prNumber}: ${getErrorMessage(err)}`);
   237	      return undefined;
   238	    }
   239	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   240	    return {
   241	      task: preparedAttachments.taskContent,
   242	      prBranch: prReview.headRefName,
   243	      prBaseBranch: prReview.baseRefName,
   244	      ...(preparedAttachments.attachments.length > 0
   245	        ? { attachments: preparedAttachments.attachments }
   246	        : {}),
   247	      cleanupAttachments: preparedAttachments.cleanupAttachments,
   248	    };
   249	  }
   250	  if (options.issueNumber) {
   251	    info(`Fetching issue #${options.issueNumber}...`);
   252	    const issue = fetchVcsResource(
   253	      `issue #${options.issueNumber}`,
   254	      cwd,
   255	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   256	    );
   257	    if (!issue) return undefined;
   258	    const task = formatIssueAsTask(issue);
   259	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   260	    return { task, issue };
   261	  }
   262	  if (options.task) {
   263	    return { task: options.task };
   264	  }
   265	  error('Either --issue, --pr, or --task must be specified');
   266	  return undefined;
   267	}
   268	
   269	export async function resolveExecutionContext(
   270	  cwd: string,
   271	  task: string,
   272	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   273	  pipelineConfig: PipelineConfig | undefined,
   274	  prBranch?: string,
   275	  prBaseBranch?: string,
   276	): Promise<ExecutionContext> {
   277	  if (options.prNumber !== undefined) {
   278	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   279	  }
   280	  if (options.createWorktree) {
   281	    const result = await confirmAndCreateWorktree(
   282	      cwd,
   283	      task,
   284	      options.createWorktree,
   285	      prBranch,
   286	      prBaseBranch,
   287	      options.prNumber !== undefined,
   288	    );
   289	    const branch = requireBranch(result.branch, 'worktree execution');
   290	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   291	    if (result.isWorktree) {
   292	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   293	    }
   294	    if (
   295	      options.prNumber !== undefined
   296	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   297	    ) {
   298	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   299	    }
   300	    return attachPipelinePrContext(
   301	      options.prNumber,
   302	      prBaseBranch,
   303	      {
   304	        execCwd: result.execCwd,
   305	        branch,
   306	        baseBranch,
   307	        isWorktree: result.isWorktree,
   308	        taskSlug: result.taskSlug,
   309	      },
   310	      {
   311	        baseRef: result.pullRequestBaseRef,
   312	        headRef: result.pullRequestHeadRef,
   313	      },
   314	    );
   315	  }
   316	  if (options.skipGit) {
   317	    return attachPipelinePrContext(
   318	      options.prNumber,
   319	      prBaseBranch,
   320	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   321	    );
   322	  }
   323	  if (prBranch) {
   324	    const safePrBranch = sanitizeTerminalText(prBranch);
   325	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   326	    checkoutBranch(cwd, prBranch);
   327	    success(`Checked out PR branch: ${safePrBranch}`);
   328	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   329	    return attachPipelinePrContext(
   330	      options.prNumber,
   331	      prBaseBranch,
   332	      {
   333	        execCwd: cwd,
   334	        branch: prBranch,
   335	        baseBranch,
   336	        isWorktree: false,
   337	      },
   338	      {
   339	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   340	        headRef: toLocalBranchRef(prBranch),
   341	      },
   342	    );
   343	  }
   344	  const baseBranch = resolveExecutionBaseBranch(cwd);
   345	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   346	  const safeBranch = sanitizeTerminalText(branch);
   347	  info(`Creating branch: ${safeBranch}`);
   348	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   349	  success(`Branch created: ${safeBranch}`);
   350	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   351	}
   352	
   353	export async function runWorkflow(
   354	  projectCwd: string,
   355	  workflow: string,
   356	  taskContent: TaskContent,
   357	  execCwd: string,
   358	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   359	  context: ExecutionContext,
   360	): Promise<boolean> {
   361	  const safeWorkflow = sanitizeTerminalText(workflow);
   362	  info(`Running workflow: ${safeWorkflow}`);
   363	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   364	    ? {
   365	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   366	        ...(options.model !== undefined ? { model: options.model } : {}),
   367	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   368	      }
   369	    : undefined;
   370	
   371	  let preparedSpec: ReturnType<typeof prepareTaskSpecDirectory> | undefined;
   372	  try {
   373	    preparedSpec = taskContent.attachments
   374	      ? prepareTaskSpecDirectory(projectCwd, taskContent.task, taskContent.attachments)
   375	      : undefined;
   376	    const reportDirName = preparedSpec
   377	      ? generateExecutionReportDir(execCwd, taskContent.task)
   378	      : undefined;
   379	    const taskSpec = preparedSpec && reportDirName
   380	      ? resolveTaskSpecForExecution(
   381	        projectCwd,
   382	        execCwd,
   383	        preparedSpec.taskDirRelative,
   384	        reportDirName,
   385	      )
   386	      : undefined;
   387	
   388	    statusLine.start('Running...');
   389	    let taskSuccess: boolean;
   390	    try {
   391	      taskSuccess = await executeTask({
   392	        task: taskSpec?.taskPrompt ?? taskContent.task,
   393	        ...(taskSpec && reportDirName ? { taskSpec, reportDirName } : {}),
   394	        cwd: execCwd,
   395	        workflowIdentifier: workflow,
   396	        projectCwd,
   397	        agentOverrides,
   398	        traceTaskContext: buildPipelineTraceTaskContext(options, context),
   399	        ...(context.prContext ? { prContext: context.prContext } : {}),
   400	      });
   401	    } finally {
   402	      statusLine.stop();
   403	    }
   404	
   405	    if (!taskSuccess) {
   406	      error(`Workflow '${safeWorkflow}' failed`);
   407	      return false;
   408	    }
   409	    success(`Workflow '${safeWorkflow}' completed`);
   410	    return true;
   411	  } finally {
   412	    if (preparedSpec) {
   413	      try {
   414	        cleanupPreparedTaskSpec(preparedSpec.taskDir);
   415	      } catch (cleanupError) {
   416	        error(`Failed to cleanup temporary task spec: ${getErrorMessage(cleanupError)}`);
   417	      }
   418	    }
   419	  }
   420	}
   421	
   422	function buildPipelineTraceTaskContext(
   423	  options: Pick<PipelineExecutionOptions, 'issueNumber' | 'prNumber'>,
   424	  context: ExecutionContext,
   425	): PipelineTraceTaskContext {
   426	  return {
   427	    issueNumber: options.issueNumber,
   428	    prNumber: options.prNumber,
   429	    branch: context.branch,
   430	    baseBranch: context.baseBranch,
   431	    taskSlug: context.isWorktree ? context.taskSlug : undefined,
   432	    worktreePath: context.isWorktree ? context.execCwd : undefined,
   433	  };
   434	}
   435	
   436	export async function commitAndPush(
   437	  execCwd: string,
   438	  projectCwd: string,
   439	  branch: string,
   440	  commitMessage: string,
   441	  isWorktree: boolean,
   442	): Promise<boolean> {
   443	  const safeBranch = sanitizeTerminalText(branch);
