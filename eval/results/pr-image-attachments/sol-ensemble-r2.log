+import { spawnSync } from 'node:child_process';
+import { existsSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, it } from 'vitest';
+
+const childFixturePath = fileURLToPath(
+  new URL('./fixtures/pr-attachment-process-exit-cleanup.mjs', import.meta.url),
+);
+
+describe('PR attachment process exit cleanup', () => {
+  it('should remove the temporary image and session directory before a non-zero child exit', () => {
+    const testRoot = mkdtempSync(join(tmpdir(), 'takt-pr-exit-cleanup-'));
+    const sessionDir = join(testRoot, 'session');
+    const imagePath = join(sessionDir, 'attachments', 'image-1.png');
+
+    try {
+      const result = spawnSync(
+        process.execPath,
+        [childFixturePath, sessionDir, imagePath],
+        { encoding: 'utf8' },
+      );
+
+      expect(result.error).toBeUndefined();
+      expect(result.signal).toBeNull();
+      expect(result.status).toBe(23);
+      expect(existsSync(imagePath)).toBe(false);
+      expect(existsSync(sessionDir)).toBe(false);
+    } finally {
+      rmSync(testRoot, { recursive: true, force: true });
+    }
+  });
+});

