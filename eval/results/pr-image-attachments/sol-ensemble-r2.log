     7	
     8	export async function resolveIssueInput(
     9	  issueOption: number | undefined,
    10	  task: string | undefined,
    11	  cwd?: string,
    12	): Promise<{ initialInput: string; issueNumber?: number } | null> {
    13	  if (issueOption) {
    14	    const provider = getGitProvider();
    15	    const cliStatus = provider.checkCliStatus(cwd);
    16	    if (!cliStatus.available) {
    17	      throw new Error(cliStatus.error);
    18	    }
    19	    const issue = await withProgress(
    20	      'Fetching issue...',
    21	      (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
    22	      async () => provider.fetchIssue(issueOption, cwd),
    23	    );
    24	    return { initialInput: formatIssueAsTask(issue), issueNumber: issueOption };
    25	  }
    26	
    27	  if (task && isDirectTask(task)) {
    28	    const provider = getGitProvider();
    29	    const cliStatus = provider.checkCliStatus(cwd);
    30	    if (!cliStatus.available) {
    31	      throw new Error(cliStatus.error);
    32	    }
    33	    const tokens = task.trim().split(/\s+/);
    34	    const issueNumbers = parseIssueNumbers(tokens);
    35	    if (issueNumbers.length === 0) {
    36	      throw new Error(`Invalid issue reference: ${task}`);
    37	    }
    38	    const issues = await withProgress(
    39	      'Fetching issues...',
    40	      (fetchedIssues) => `Issues fetched: ${fetchedIssues.map((issue) => `#${issue.number}`).join(', ')}`,
    41	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    42	    );
    43	    return {
    44	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    45	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
    46	    };
    47	  }
    48	
    49	  return null;
    50	}
    51	
    52	export async function resolvePrInput(
    53	  prNumber: number,
    54	  cwd: string,
    55	): Promise<{
    56	  initialInput: string;
    57	  prBranch: string;
    58	  baseBranch?: string;
    59	  attachments: TaskAttachment[];
    60	  cleanupAttachments: () => void;
    61	}> {
    62	  const provider = getGitProvider();
    63	  const cliStatus = provider.checkCliStatus(cwd);
    64	  if (!cliStatus.available) {
    65	    throw new Error(cliStatus.error);
    66	  }
    67	
    68	  const prReview = await withProgress(
    69	    'Fetching PR review comments...',
    70	    (pr: PrReviewData) => `PR fetched: #${pr.number} ${pr.title}`,
    71	    async () => provider.fetchPrReviewComments(prNumber, cwd),
    72	  );
    73	  const preparedAttachments = await preparePrReviewAttachments(
    74	    formatPrReviewTask(prReview),
    75	    cwd,
    76	  );
    77	
    78	  return {
    79	    initialInput: preparedAttachments.taskContent,
    80	    prBranch: prReview.headRefName,
    81	    baseBranch: prReview.baseRefName,
    82	    attachments: preparedAttachments.attachments,
    83	    cleanupAttachments: preparedAttachments.cleanupAttachments,
    84	  };
    85	}

