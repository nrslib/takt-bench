   105	function attachPipelinePrContext(
   106	  prNumber: number | undefined,
   107	  prBaseBranch: string | undefined,
   108	  context: ExecutionContext,
   109	  materializedDiffRefs?: { baseRef?: string; headRef?: string },
   110	): ExecutionContext {
   111	  if (prNumber === undefined) {
   112	    return context;
   113	  }
   114	  const branch = requireBranch(context.branch, `PR #${prNumber} execution`);
   115	  const baseBranch = requireBaseBranch(context.baseBranch, `PR #${prNumber} execution`);
   116	  return {
   117	    ...context,
   118	    prContext: createPullRequestContext({
   119	      source: 'pr_review',
   120	      prNumber,
   121	      baseBranch,
   122	      headBranch: branch,
   123	      baseBranchSource: prBaseBranch === undefined
   124	        ? 'default_branch_fallback'
   125	        : 'pull_request',
   126	      ...(materializedDiffRefs?.baseRef && materializedDiffRefs.headRef
   127	        ? {
   128	          baseDiffRef: materializedDiffRefs.baseRef,
   129	          headDiffRef: materializedDiffRefs.headRef,
   130	        }
   131	        : {}),
   132	    }),
   133	  };
   134	}
