+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { runE2eMockShards } from '../../scripts/run-e2e-mock-shards.mjs';
+
+type ShardRun = {
+  shardNumber: number;
+  files: string[];
+  vitestArgs: string[];
+};
+
+type ShardResult = {
+  code: number;
+  signal: NodeJS.Signals | null;
+  output: string;
+};
+
+const successfulResult: ShardResult = {
+  code: 0,
+  signal: null,
+  output: '',
+};
+
+const birpcNoiseOutput = [
+  ' ✓ e2e/example.test.ts (3 tests) 1200ms',
+  '',
+  '⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯ Unhandled Error ⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯',
+  'Error: [vitest-worker]: Timeout calling "onTaskUpdate"',
+  ' ❯ Timeout.<anonymous> node_modules/vitest/dist/chunks/rpc.js:49:10',
+  '',
+  ' Test Files  1 passed (1)',
+  '      Tests  3 passed (3)',
+  '     Errors  1 error',
+  '   Duration  62.00s',
+].join('\n');
+
+const birpcNoiseResult: ShardResult = {
+  code: 1,
+  signal: null,
+  output: birpcNoiseOutput,
+};
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+function quietErrors(): void {
+  vi.spyOn(console, 'error').mockImplementation(() => undefined);
+}
+
+describe('mock E2E shard runner', () => {
+  it('should re-measure a noisy shard once after every initial shard finishes', async () => {
+    quietErrors();
+    const events: string[] = [];
+    let attempt = 0;
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> => {
+      const currentAttempt = attempt;
+      attempt += 1;
+      events.push(`start:${currentAttempt}:${run.shardNumber}`);
+      await Promise.resolve();
+      await Promise.resolve();
+      events.push(`finish:${currentAttempt}:${run.shardNumber}`);
+      return currentAttempt === 1 ? birpcNoiseResult : successfulResult;
+    });
+
+    const code = await runE2eMockShards(['--reporter', 'verbose'], {
+      isCI: false,
+      runAttempt,
+    });
+
+    expect(runAttempt).toHaveBeenCalledTimes(5);
+    expect(events.slice(0, 8)).toEqual([
+      'start:0:1',
+      'start:1:2',
+      'start:2:3',
+      'start:3:4',
+      'finish:0:1',
+      'finish:1:2',
+      'finish:2:3',
+      'finish:3:4',
+    ]);
+    expect(events.slice(8)).toEqual(['start:4:2', 'finish:4:2']);
+    expect(runAttempt.mock.calls[4]?.[0]).toEqual(runAttempt.mock.calls[1]?.[0]);
+    expect(runAttempt.mock.calls[4]?.[0].vitestArgs).toEqual(['--reporter', 'verbose']);
+    expect(code).toBe(0);
+  });
+
+  it('should keep the failure when the re-measured shard fails', async () => {
+    quietErrors();
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> =>
+      run.shardNumber === 2 ? birpcNoiseResult : successfulResult
+    );
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(5);
+    expect(code).toBe(1);
+  });
+
+  it('should not re-measure an ordinary test failure', async () => {
+    quietErrors();
+    const failedResult: ShardResult = {
+      code: 1,
+      signal: null,
+      output: birpcNoiseOutput
+        .replace('      Tests  3 passed (3)', '      Tests  1 failed | 2 passed (3)')
+        .replace(
+          ' ❯ Timeout.<anonymous> node_modules/vitest/dist/chunks/rpc.js:49:10',
+          'AssertionError: expected 1 to be 2',
+        ),
+    };
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> =>
+      run.shardNumber === 2 ? failedResult : successfulResult
+    );
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(4);
+    expect(code).toBe(1);
+  });
+
+  it('should not re-measure a shard carrying another error', async () => {
+    quietErrors();
+    const failedResult: ShardResult = {
+      code: 1,
+      signal: null,
+      output: birpcNoiseOutput.replace(
+        'Error: [vitest-worker]: Timeout calling "onTaskUpdate"',
+        'Error: connect ECONNREFUSED 127.0.0.1:5432',
+      ),
+    };
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> =>
+      run.shardNumber === 2 ? failedResult : successfulResult
+    );
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(4);
+    expect(code).toBe(1);
+  });
+
+  it('should not re-measure birpc noise on CI', async () => {
+    quietErrors();
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> =>
+      run.shardNumber === 2 ? birpcNoiseResult : successfulResult
+    );
+
+    const code = await runE2eMockShards([], { isCI: true, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(4);
+    expect(code).toBe(1);
+  });
+
+  it('should not re-measure a signaled shard', async () => {
+    quietErrors();
+    const signaledResult: ShardResult = {
+      ...birpcNoiseResult,
+      signal: 'SIGTERM',
+    };
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> =>
+      run.shardNumber === 2 ? signaledResult : successfulResult
+    );
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(4);
+    expect(code).toBe(1);
+  });
+
+  it('should keep a shard startup failure', async () => {
+    quietErrors();
+    const runAttempt = vi.fn(async (run: ShardRun): Promise<ShardResult> => {
+      if (run.shardNumber === 2) {
+        throw new Error('spawn failed');
+      }
+      return successfulResult;
+    });
+
+    const code = await runE2eMockShards([], { isCI: false, runAttempt });
+
+    expect(runAttempt).toHaveBeenCalledTimes(4);
+    expect(code).toBe(1);
+  });
+});
