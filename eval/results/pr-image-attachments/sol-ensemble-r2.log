+
+const [sessionDir, imagePath] = process.argv.slice(2);
+if (sessionDir === undefined || imagePath === undefined) {
+  throw new Error('sessionDir and imagePath are required.');
+}
+
+mkdirSync(dirname(imagePath), { recursive: true });
