    85	function validatePrBranches(
    86	  prNumber: number,
    87	  prBranch: string | undefined,
    88	  prBaseBranch: string | undefined,
    89	): void {
    90	  if (prBranch === undefined) {
    91	    throw new Error(`PR #${prNumber} head branch is required.`);
    92	  }
    93	  assertValidLocalBranchName(prBranch, {
    94	    branchLabel: `PR #${prNumber} head branch`,
    95	    invalidBranchLabel: `Invalid PR #${prNumber} head branch`,
    96	  });
    97	  if (prBaseBranch !== undefined) {
    98	    assertValidLocalBranchName(prBaseBranch, {
    99	      branchLabel: `PR #${prNumber} base branch`,
   100	      invalidBranchLabel: `Invalid PR #${prNumber} base branch`,
   101	    });
   102	  }
   103	}
