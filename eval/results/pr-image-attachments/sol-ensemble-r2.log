   203	function fetchVcsResource<T>(
   204	  label: string,
   205	  cwd: string,
   206	  fetch: (provider: ReturnType<typeof getGitProvider>) => T,
   207	): T | undefined {
   208	  const gitProvider = getGitProvider();
   209	  const cliStatus = gitProvider.checkCliStatus(cwd);
   210	  if (!cliStatus.available) {
   211	    error(cliStatus.error);
   212	    return undefined;
   213	  }
   214	  try {
   215	    return fetch(gitProvider);
   216	  } catch (err) {
   217	    error(`Failed to fetch ${label}: ${getErrorMessage(err)}`);
   218	    return undefined;
   219	  }
   220	}
