   122	    throw new Error(`Expected OSC 1337 inline image sequence at offset ${start}.`);
   123	  }
   124	
   125	  const payloadStart = start + OSC_IMAGE_PREFIX.length;
   126	  const terminator = findTerminator(input, payloadStart);
   127	  if (!terminator) {
   128	    assertPendingInlineImageWithinLimit(input.slice(start));
