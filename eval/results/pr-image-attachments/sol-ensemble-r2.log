   168	}
   169	
   170	function tryResolveCurrentBranch(cwd: string): string | undefined {
   171	  try {
   172	    const branch = getCurrentBranch(cwd);
   173	    return branch || undefined;
   174	  } catch {
   175	    return undefined;
   176	  }
   177	}
