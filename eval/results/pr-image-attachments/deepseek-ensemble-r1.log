   168	    ...prReview,
   169	    body: replaceText(prReview.body),
   170	    comments: prReview.comments.map((comment) => ({ ...comment, body: replaceText(comment.body) })),
   171	    reviews: prReview.reviews.map((review) => ({ ...review, body: replaceText(review.body) })),
