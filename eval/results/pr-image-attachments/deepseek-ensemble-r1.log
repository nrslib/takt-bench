   220	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   221	  const { cwd } = options;
   222	  if (options.prNumber) {
   223	    info(`Fetching PR #${options.prNumber} review comments...`);
   224	    const prReview = fetchVcsResource(
   225	      `PR #${options.prNumber}`,
   226	      cwd,
   227	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   228	    );
   229	    if (!prReview) return undefined;
   230	    const gitProvider = getGitProvider();
   231	    const resolved = await resolvePrImages(gitProvider, prReview, cwd);
   232	    const task = formatPrReviewAsTask(resolved.prReview);
   233	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   234	    return {
   235	      task,
   236	      prBranch: prReview.headRefName,
   237	      prBaseBranch: prReview.baseRefName,
   238	      ...(resolved.attachments.length > 0 ? { attachments: resolved.attachments } : {}),
   239	      attachmentCleanup: resolved.cleanup,
   240	    };
   241	  }
   242	  if (options.issueNumber) {
   243	    info(`Fetching issue #${options.issueNumber}...`);
   244	    const issue = fetchVcsResource(
   245	      `issue #${options.issueNumber}`,
   246	      cwd,
   247	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   248	    );
   249	    if (!issue) return undefined;
   250	    const task = formatIssueAsTask(issue);
   251	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   252	    return { task, issue };
   253	  }
   254	  if (options.task) {
   255	    return { task: options.task };
   256	  }
   257	  error('Either --issue, --pr, or --task must be specified');
   258	  return undefined;
   259	}
