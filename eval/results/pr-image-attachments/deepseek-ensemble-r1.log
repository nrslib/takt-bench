   211	function splitTextSegments(text: string): TextSegment[] {
   212	  const segments: TextSegment[] = [];
   213	  let current = '';
   214	  let currentIsCode = false;
   215	  let inFence = false;
   216	  let inInlineCode = false;
   217	  let inHtmlComment = false;
   218	  let index = 0;
   219	  const flush = (): void => {
   220	    if (current.length > 0) {
   221	      segments.push({ text: current, isCode: currentIsCode });
   222	      current = '';
   223	    }
   224	  };
   225	  const setCode = (isCode: boolean): void => {
   226	    if (currentIsCode !== isCode) {
   227	      flush();
   228	      currentIsCode = isCode;
   229	    }
   230	  };
   231	  while (index < text.length) {
   232	    const rest = text.slice(index);
   233	    if (inHtmlComment) {
   234	      const end = rest.indexOf('-->');
   235	      if (end === -1) {
   236	        break;
   237	      }
   238	      current += rest.slice(0, end + 3);
   239	      index += end + 3;
   240	      inHtmlComment = false;
   241	      continue;
   242	    }
   243	    if (inFence) {
   244	      const end = rest.indexOf('```');
   245	      if (end === -1) {
   246	        current += rest;
   247	        break;
   248	      }
   249	      current += rest.slice(0, end + 3);
   250	      index += end + 3;
   251	      inFence = false;
   252	      continue;
   253	    }
   254	    if (inInlineCode) {
   255	      const end = rest.indexOf('`');
   256	      if (end === -1) {
   257	        current += rest;
   258	        break;
   259	      }
   260	      current += rest.slice(0, end + 1);
   261	      index += end + 1;
   262	      inInlineCode = false;
   263	      continue;
   264	    }
   265	    if (rest.startsWith('```')) {
   266	      setCode(true);
   267	      current += '```';
   268	      index += 3;
   269	      inFence = true;
   270	      continue;
   271	    }
   272	    if (rest.startsWith('<!--')) {
   273	      setCode(true);
   274	      current += '<!--';
   275	      index += 4;
   276	      inHtmlComment = true;
   277	      continue;
   278	    }
   279	    if (rest.startsWith('`')) {
   280	      setCode(true);
   281	      current += '`';
   282	      index += 1;
   283	      inInlineCode = true;
   284	      continue;
   285	    }
   286	    setCode(false);
   287	    current += rest[0];
   288	    index += 1;
   289	  }
   290	  flush();
   291	  return segments;
   292	}
