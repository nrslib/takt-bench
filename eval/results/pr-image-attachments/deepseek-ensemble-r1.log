   434	async function getGhAuthToken(): Promise<string> {
   435	  const token = execFileSync('gh', ['auth', 'token'], {
   436	    encoding: 'utf-8',
   437	    stdio: ['pipe', 'pipe', 'pipe'],
   438	  }).trim();
   439	  if (token.length === 0) {
   440	    throw new Error('Failed to obtain a GitHub authentication token.');
   441	  }
   442	  return token;
   443	}
