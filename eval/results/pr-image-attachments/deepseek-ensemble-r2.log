   460	export function createPullRequest(options: CreatePrOptions, cwd: string): CreatePrResult {
   461	  const ghStatus = checkGhCli(cwd);
   462	  if (!ghStatus.available) {
   463	    return { success: false, error: ghStatus.error };
   464	  }
   465	
   466	  const args = [
   467	    'pr', 'create',
   468	    '--title', options.title,
   469	    '--body', options.body,
   470	    '--head', options.branch,
   471	  ];
   472	
   473	  if (options.base) {
   474	    args.push('--base', options.base);
   475	  }
   476	
   477	  if (options.repo) {
   478	    args.push('--repo', options.repo);
   479	  }
   480	
   481	  if (options.draft) {
   482	    args.push('--draft');
   483	  }
   484	
   485	  for (const label of options.labels ?? []) {
   486	    args.push('--label', label);
   487	  }
   488	
   489	  log.info('Creating PR', { branch: options.branch, title: options.title, draft: options.draft });
   490	
   491	  try {
   492	    const output = execFileSync('gh', args, {
   493	      cwd,
   494	      encoding: 'utf-8',
   495	      stdio: ['pipe', 'pipe', 'pipe'],
   496	    });
   497	
   498	    const url = output.trim();
   499	    log.info('PR created', { url });
   500	
   501	    return { success: true, url };
   502	  } catch (err) {
   503	    const errorMessage = getErrorMessage(err);
   504	    log.error('PR creation failed', { error: errorMessage });
   505	    return { success: false, error: errorMessage };
