    72	    const customLabel = await promptInput(getLabel('issue.labelSelection.customPrompt', lang));
    73	    return customLabel?.split(',').map((l) => l.trim()).filter((l) => l.length > 0) ?? [];
    74	  }
    75	  return [selected];
