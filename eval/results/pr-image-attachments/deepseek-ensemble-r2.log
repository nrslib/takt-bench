   399	
   400	  if (!taskSuccess) {
   401	    error(`Workflow '${safeWorkflow}' failed`);
   402	    return false;
   403	  }
   404	  success(`Workflow '${safeWorkflow}' completed`);
   405	  return true;
   406	}
