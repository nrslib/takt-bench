    76	export function normalizePublicIssueUrl(url: string | undefined): string | undefined {
    77	  if (url === undefined || containsControlCharacter(url)) {
    78	    return undefined;
    79	  }
    80	
    81	  let parsed: URL;
    82	  try {
    83	    parsed = new URL(url);
    84	  } catch {
    85	    return undefined;
    86	  }
    87	
    88	  if ((parsed.protocol !== 'http:' && parsed.protocol !== 'https:') || parsed.hostname.length === 0) {
    89	    return undefined;
    90	  }
    91	
    92	  return `${parsed.protocol}//${parsed.host}${parsed.pathname}`;
    93	}
    94	
    95	function containsControlCharacter(value: string): boolean {
    96	  for (const character of value) {
    97	    const code = character.charCodeAt(0);
    98	    if (code <= 31 || code === 127) {
    99	      return true;
   100	    }
   101	  }
   102	  return false;
   103	}
