   140	      const index = nextAttachmentNumber(attachments);
   141	      const fileName = `image-${index}.${extensionForImageMimeType(mimeType)}`;
   142	      const tempPath = path.join(attachmentDir, fileName);
   143	      const attachment: InteractiveImageAttachment = {
   144	        placeholder: createImageAttachmentPlaceholder(index),
   145	        tempPath,
   146	        fileName,
   147	      };
