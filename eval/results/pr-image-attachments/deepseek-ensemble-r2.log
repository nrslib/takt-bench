    88	export function createPullRequestSafely(
    89	  gitProvider: GitProvider,
    90	  options: CreatePrOptions,
    91	  cwd?: string,
    92	): CreatePrResult {
    93	  try {
    94	    return gitProvider.createPullRequest(options, cwd);
    95	  } catch (createPrError) {
    96	    return {
    97	      success: false,
    98	      error: getErrorMessage(createPrError),
    99	    };
   100	  }
   101	}
