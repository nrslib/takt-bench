   140	  if (!terminator) {
   141	    assertPendingInlineImageWithinLimit(input.slice(start));
   142	    return { status: 'incomplete' };
   143	  }
   144	
   145	  const payload = input.slice(payloadStart, terminator.index);
   146	  const sequenceEnd = terminator.index + terminator.length;
   147	  const separatorIndex = payload.indexOf(':');
   148	  if (separatorIndex === -1) {
   149	    return { status: 'passthrough', sequenceEnd };
   150	  }
   151	
   152	  const params = payload.slice(0, separatorIndex).split(';');
   153	  if (!params.includes('inline=1')) {
   154	    return { status: 'passthrough', sequenceEnd };
   155	  }
   156	
   157	  const encodedData = payload.slice(separatorIndex + 1);
   158	  const imageData = decodeImageData(params, encodedData);
   159	  return {
   160	    status: 'image',
   161	    image: {
   162	      mimeType: resolveInlineImageMimeType(params, imageData),
   163	      data: imageData,
   164	    },
   165	    sequenceEnd,
   166	  };
   167	}
