   367	  let preparedSpecTaskDir: string | undefined;
   368	  let reportDirName: string | undefined;
   369	  try {
   370	    const hasAttachments = attachments !== undefined && attachments.length > 0;
   371	    if (hasAttachments) {
   372	      const preparedSpec = prepareTaskSpecDirectory(execCwd, task, attachments);
   373	      preparedSpecTaskDir = preparedSpec.taskDir;
   374	      reportDirName = generateExecutionReportDir(execCwd, task);
   375	      taskSpec = resolveTaskSpecForExecution(
   376	        projectCwd,
   377	        execCwd,
   378	        preparedSpec.taskDirRelative,
   379	        reportDirName,
   380	      );
   381	    }
   382	    taskSuccess = await executeTask({
   383	      task: taskSpec?.taskPrompt ?? task,
   384	      ...(taskSpec === undefined ? {} : { taskSpec }),
   385	      cwd: execCwd,
   386	      workflowIdentifier: workflow,
   387	      projectCwd,
   388	      agentOverrides,
   389	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   390	      ...(reportDirName ? { reportDirName } : {}),
   391	      ...(context.prContext ? { prContext: context.prContext } : {}),
   392	    });
   393	  } finally {
   394	    if (preparedSpecTaskDir) {
   395	      cleanupPreparedTaskSpec(preparedSpecTaskDir);
