     3	export const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
     4	
     5	export function detectImageMimeType(data: Buffer): string | null {
     6	  if (data.length >= 8
     7	    && data[0] === 0x89
     8	    && data[1] === 0x50
     9	    && data[2] === 0x4e
    10	    && data[3] === 0x47
    11	    && data[4] === 0x0d
    12	    && data[5] === 0x0a
    13	    && data[6] === 0x1a
    14	    && data[7] === 0x0a) {
    15	    return 'image/png';
    16	  }
    17	  if (data.length >= 3 && data[0] === 0xff && data[1] === 0xd8 && data[2] === 0xff) {
    18	    return 'image/jpeg';
    19	  }
    20	  if (data.subarray(0, 6).equals(Buffer.from('GIF87a')) || data.subarray(0, 6).equals(Buffer.from('GIF89a'))) {
    21	    return 'image/gif';
    22	  }
    23	  if (data.length >= 12
    24	    && data.subarray(0, 4).equals(Buffer.from('RIFF'))
    25	    && data.subarray(8, 12).equals(Buffer.from('WEBP'))) {
    26	    return 'image/webp';
    27	  }
    28	  return null;
    29	}
    30	
    31	export function extensionForImageMimeType(mimeType: string): string {
    32	  switch (mimeType) {
    33	    case 'image/png':
    34	      return 'png';
    35	    case 'image/jpeg':
    36	      return 'jpg';
    37	    case 'image/gif':
    38	      return 'gif';
    39	    case 'image/webp':
    40	      return 'webp';
    41	    default:
    42	      throw new Error(`Unsupported image MIME type: ${mimeType}`);
    43	  }
    44	}
