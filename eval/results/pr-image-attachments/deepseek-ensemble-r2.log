     1	/**
     2	 * Quiet interactive mode.
     3	 *
     4	 * Generates task instructions without asking clarifying questions.
     5	 * Uses the same summarization logic as assistant mode but skips
     6	 * the conversational loop — goes directly to summary generation.
     7	 */
     8	
     9	import chalk from 'chalk';
    10	import { createLogger, sanitizeTerminalText } from '../../shared/utils/index.js';
    11	import { info, error, blankLine } from '../../shared/ui/index.js';
    12	import { getLabel, getLabelObject } from '../../shared/i18n/index.js';
    13	import { readMultilineInput } from './lineEditor.js';
    14	import {
    15	  type WorkflowContext,
    16	  type InteractiveModeResult,
    17	  type InteractiveUIText,
    18	  type ConversationMessage,
    19	  type InteractiveSeedInput,
    20	  DEFAULT_INTERACTIVE_TOOLS,
    21	  buildSummaryPrompt,
    22	  selectPostSummaryAction,
    23	} from './interactive.js';
    24	import {
    25	  callAIWithRetry,
    26	} from './conversationLoop.js';
    27	import { initializeSession } from './sessionInitialization.js';
    28	import {
    29	  buildInteractiveResultWithAttachments,
    30	  cleanupImageAttachmentStore,
    31	  createClipboardImagePasteHandler,
    32	  createImagePasteHandler,
    33	  createSessionImageAttachmentStore,
    34	  resolvePromptImageAttachments,
    35	} from './imageAttachments.js';
    36	import { reportClipboardImagePasteError } from './clipboardImageFeedback.js';
    37	import { shouldUseGherkinTaskInstructions } from './taskInstructionFormat.js';
    38	
    39	const log = createLogger('quiet-mode');
    40	
    41	/**
    42	 * Run quiet mode: collect user input and generate instructions without questions.
    43	 *
    44	 * Flow:
    45	 * 1. If initialInput is provided, use it; otherwise prompt for input
    46	 * 2. Build summary prompt from the user input
    47	 * 3. Call AI to generate task instructions (best-effort, no questions)
    48	 * 4. Present the result and let user choose action
    49	 *
    50	 * @param cwd - Working directory
    51	 * @param initialInput - Pre-filled input (e.g., from issue reference)
    52	 * @param workflowContext - Workflow context for template rendering
    53	 * @returns Result with generated task instructions
    54	 */
    55	export async function quietMode(
    56	  cwd: string,
    57	  initialInput?: InteractiveSeedInput,
    58	  workflowContext?: WorkflowContext,
    59	): Promise<InteractiveModeResult> {
    60	  const ctx = initializeSession(cwd, 'interactive');
    61	  const sourceContext = initialInput?.sourceContext;
    62	  const attachmentStore = createSessionImageAttachmentStore(initialInput?.attachments);
    63	  const history: ConversationMessage[] = initialInput?.userMessage
    64	    ? [{ role: 'user', content: initialInput.userMessage }]
    65	    : [];
    66	
    67	  try {
    68	  if (history.length === 0 && !sourceContext) {
    69	    info(getLabel('interactive.ui.introQuiet', ctx.lang));
    70	    blankLine();
    71	
    72	    const input = await readMultilineInput(chalk.green('> '), {
    73	      onImagePaste: createImagePasteHandler(attachmentStore),
    74	      onClipboardImagePaste: createClipboardImagePasteHandler(attachmentStore),
    75	      onClipboardImagePasteError: reportClipboardImagePasteError,
    76	    });
    77	    if (input === null) {
    78	      blankLine();
    79	      info(getLabel('interactive.ui.cancelled', ctx.lang));
    80	      return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
    81	    }
    82	    const trimmed = input.trim();
    83	    if (!trimmed) {
    84	      info(getLabel('interactive.ui.cancelled', ctx.lang));
    85	      return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
    86	    }
    87	    history.push({ role: 'user', content: trimmed });
    88	  }
    89	
    90	  const conversationLabel = getLabel('interactive.conversationLabel', ctx.lang);
    91	  const noTranscript = getLabel('interactive.noTranscript', ctx.lang);
    92	
    93	  const summaryPrompt = buildSummaryPrompt(
    94	    history, !!ctx.sessionId, ctx.lang, noTranscript, conversationLabel, workflowContext, sourceContext,
    95	    undefined,
    96	    shouldUseGherkinTaskInstructions(cwd),
    97	  );
    98	
    99	  if (!summaryPrompt) {
   100	    info(getLabel('interactive.ui.noConversation', ctx.lang));
   101	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   102	  }
   103	
   104	  let imageAttachments: ReturnType<typeof resolvePromptImageAttachments>;
   105	  try {
   106	    imageAttachments = resolvePromptImageAttachments(summaryPrompt, attachmentStore.listAttachments());
   107	  } catch (caught) {
   108	    error(sanitizeTerminalText(caught instanceof Error ? caught.message : String(caught)));
   109	    blankLine();
   110	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   111	  }
   112	
   113	  const { result } = await callAIWithRetry(
   114	    summaryPrompt, summaryPrompt, DEFAULT_INTERACTIVE_TOOLS, cwd,
   115	    { ...ctx, sessionId: undefined },
   116	    { imageAttachments, persistSession: false },
   117	  );
   118	
   119	  if (!result) {
   120	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   121	  }
   122	
   123	  if (!result.success) {
   124	    error(result.content);
   125	    blankLine();
   126	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   127	  }
   128	
   129	  const task = result.content.trim();
   130	  const ui = getLabelObject<InteractiveUIText>('interactive.ui', ctx.lang);
   131	
   132	  const selectedAction = await selectPostSummaryAction(task, ui.proposed, ui);
   133	  if (selectedAction === 'continue' || selectedAction === null) {
   134	    return buildInteractiveResultWithAttachments({ action: 'cancel', task: '' }, attachmentStore);
   135	  }
   136	
   137	  log.info('Quiet mode action selected', { action: selectedAction });
   138	  return buildInteractiveResultWithAttachments({ action: selectedAction, task }, attachmentStore);
   139	  } catch (caught) {
   140	    cleanupImageAttachmentStore(attachmentStore);
   141	    throw caught;
   142	  }
   143	}
     1	/**
     2	 * Persona interactive mode.
     3	 *
     4	 * Uses the first step's persona and tools for the interactive
     5	 * conversation. The persona acts as the conversational agent,
     6	 * performing code exploration and analysis while discussing the task.
     7	 * The conversation result is passed as the task to the workflow.
     8	 */
     9	
    10	import type { FirstStepInfo } from '../../infra/config/index.js';
    11	import { getLabel } from '../../shared/i18n/index.js';
    12	import {
    13	  type WorkflowContext,
    14	  type InteractiveModeResult,
    15	  type InteractiveSeedInput,
    16	  DEFAULT_INTERACTIVE_TOOLS,
    17	} from './interactive.js';
    18	import {
    19	  displayAndClearSessionState,
    20	  runConversationLoop,
    21	} from './conversationLoop.js';
    22	import {
    23	  prependSourceContext,
    24	  prependSourceContextGuardToSystemPrompt,
    25	} from './promptSections.js';
    26	import { initializeSession } from './sessionInitialization.js';
    27	
    28	/**
    29	 * Run persona mode: converse as the first step's persona.
    30	 *
    31	 * The persona's system prompt is used for all AI calls.
    32	 * The first step's allowed tools are made available.
    33	 * After the conversation, the result is summarized as a task.
    34	 *
    35	 * @param cwd - Working directory
    36	 * @param firstStep - First step's persona and tool info
    37	 * @param initialInput - Pre-filled input
    38	 * @param workflowContext - Workflow context for summary generation
    39	 * @returns Result with conversation-derived task
    40	 */
    41	export async function personaMode(
    42	  cwd: string,
    43	  firstStep: FirstStepInfo,
    44	  initialInput?: InteractiveSeedInput,
    45	  workflowContext?: WorkflowContext,
    46	): Promise<InteractiveModeResult> {
    47	  const ctx = initializeSession(cwd, 'persona-interactive');
    48	
    49	  displayAndClearSessionState(cwd, ctx.lang);
    50	
    51	  const allowedTools = firstStep.allowedTools.length > 0
    52	    ? firstStep.allowedTools
    53	    : DEFAULT_INTERACTIVE_TOOLS;
    54	
    55	  const introMessage = `${getLabel('interactive.ui.intro', ctx.lang)} [${firstStep.personaDisplayName}]`;
    56	
    57	  return runConversationLoop(cwd, ctx, {
    58	    systemPrompt: prependSourceContextGuardToSystemPrompt(ctx.lang, firstStep.personaContent),
    59	    allowedTools,
    60	    transformPrompt: (msg, sourceContext) => prependSourceContext(ctx.lang, msg, sourceContext),
    61	    introMessage,
    62	  }, workflowContext, initialInput);
    63	}

