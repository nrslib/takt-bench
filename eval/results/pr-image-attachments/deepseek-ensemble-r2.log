   103	/**
   104	 * Resolve issue references in a task string using the singleton GitProvider.
   105	 *
   106	 * If task contains `#N` patterns (space-separated), fetches issues and returns formatted text.
   107	 * Otherwise returns the task string as-is.
   108	 * Throws if VCS CLI is not available or issue fetch fails.
   109	 */
   110	export function resolveIssueTask(task: string, cwd?: string): string {
   111	  const tokens = task.trim().split(/\s+/);
   112	  const issueNumbers = parseIssueNumbers(tokens);
   113	
   114	  if (issueNumbers.length === 0) {
   115	    return task;
   116	  }
   117	
   118	  const gitProvider = getGitProvider();
   119	  const cliStatus = gitProvider.checkCliStatus(cwd);
   120	  if (!cliStatus.available) {
   121	    throw new Error(cliStatus.error);
   122	  }
   123	
   124	  const issues = issueNumbers.map((n) => gitProvider.fetchIssue(n, cwd));
   125	  return issues.map(formatIssueAsTask).join('\n\n---\n\n');
   126	}
