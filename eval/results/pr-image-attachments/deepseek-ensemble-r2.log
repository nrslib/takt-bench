   300	async function fetchImageWithRedirects(
   301	  url: string,
   302	  token: string,
   303	  fetch: typeof globalThis.fetch,
   304	): Promise<ImageDownloadResponse> {
   305	  let currentUrl = url;
   306	  let redirectCount = 0;
   307	  while (true) {
   308	    if (!isAllowedRedirectTarget(currentUrl)) {
   309	      throw new Error(`Unsafe redirect target for image download: ${currentUrl}`);
   310	    }
   311	    const response = await fetch(currentUrl, {
   312	      headers: { authorization: `Bearer ${token}` },
   313	      redirect: 'manual',
   314	    });
   315	    if (response.status >= 300 && response.status < 400) {
   316	      const location = readResponseHeader(response.headers, 'location');
   317	      if (!location) {
   318	        throw new Error(`Redirect without location for image download: ${currentUrl}`);
   319	      }
   320	      redirectCount += 1;
   321	      if (redirectCount > MAX_REDIRECTS) {
   322	        throw new Error('Too many redirects while downloading image.');
   323	      }
   324	      currentUrl = new URL(location, currentUrl).toString();
   325	      continue;
   326	    }
   327	    if (response.status !== 200) {
   328	      throw new Error(`Image download failed with status ${response.status}.`);
   329	    }
   330	    const contentType = readResponseHeader(response.headers, 'content-type');
   331	    const contentLength = readResponseHeader(response.headers, 'content-length');
   332	    if (contentLength !== undefined) {
   333	      const parsedLength = Number.parseInt(contentLength, 10);
   334	      if (Number.isSafeInteger(parsedLength) && parsedLength > MAX_IMAGE_BYTES) {
   335	        throw new Error(`Image exceeds the ${MAX_IMAGE_BYTES} byte limit.`);
   336	      }
   337	    }
   338	    const body = await readResponseBody(response);
   339	    return {
   340	      status: response.status,
   341	      headers: { 'content-type': contentType, 'content-length': contentLength },
   342	      body,
   343	    };
   344	  }
   345	}
   346	
   347	async function readResponseBody(response: globalThis.Response): Promise<Buffer> {
   348	  const body = (response as unknown as { body?: Buffer | ReadableStream }).body;
   349	  if (Buffer.isBuffer(body)) {
   350	    if (body.length > MAX_IMAGE_BYTES) {
   351	      throw new Error(`Image exceeds the ${MAX_IMAGE_BYTES} byte limit.`);
   352	    }
   353	    return body;
   354	  }
   355	  if (body === undefined || typeof (body as ReadableStream).getReader !== 'function') {
   356	    throw new Error('Image download response has no readable body.');
   357	  }
   358	  const reader = (body as ReadableStream).getReader();
   359	  const chunks: Buffer[] = [];
   360	  let total = 0;
   361	  try {
   362	    while (true) {
   363	      const { done, value } = await reader.read();
   364	      if (done) {
   365	        break;
   366	      }
   367	      total += value.byteLength;
   368	      if (total > MAX_IMAGE_BYTES) {
   369	        await reader.cancel();
   370	        throw new Error(`Image exceeds the ${MAX_IMAGE_BYTES} byte limit.`);
   371	      }
   372	      chunks.push(Buffer.from(value));
   373	    }
   374	  } finally {
   375	    reader.releaseLock();
   376	  }
   377	  return Buffer.concat(chunks, total);
   378	}
