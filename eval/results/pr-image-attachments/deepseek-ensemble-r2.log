     7	export async function resolveIssueInput(
     8	  issueOption: number | undefined,
     9	  task: string | undefined,
    10	  cwd?: string,
    11	): Promise<{ initialInput: string; issueNumber?: number } | null> {
    12	  if (issueOption) {
    13	    const provider = getGitProvider();
    14	    const cliStatus = provider.checkCliStatus(cwd);
    15	    if (!cliStatus.available) {
    16	      throw new Error(cliStatus.error);
    17	    }
    18	    const issue = await withProgress(
    19	      'Fetching issue...',
    20	      (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
    21	      async () => provider.fetchIssue(issueOption, cwd),
    22	    );
    23	    return { initialInput: formatIssueAsTask(issue), issueNumber: issueOption };
    24	  }
    25	
    26	  if (task && isDirectTask(task)) {
    27	    const provider = getGitProvider();
    28	    const cliStatus = provider.checkCliStatus(cwd);
    29	    if (!cliStatus.available) {
    30	      throw new Error(cliStatus.error);
    31	    }
    32	    const tokens = task.trim().split(/\s+/);
    33	    const issueNumbers = parseIssueNumbers(tokens);
    34	    if (issueNumbers.length === 0) {
    35	      throw new Error(`Invalid issue reference: ${task}`);
    36	    }
    37	    const issues = await withProgress(
    38	      'Fetching issues...',
    39	      (fetchedIssues) => `Issues fetched: ${fetchedIssues.map((issue) => `#${issue.number}`).join(', ')}`,
    40	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    41	    );
    42	    return {
    43	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    44	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
    45	    };
    46	  }
    47	
    48	  return null;
    49	}
    50	
    51	export async function resolvePrInput(
    52	  prNumber: number,
    53	  cwd?: string,
    54	): Promise<{ initialInput: string; prBranch: string; baseBranch?: string; attachments?: StoredImageAttachment[]; cleanup: () => void }> {
    55	  const provider = getGitProvider();
    56	  const cliStatus = provider.checkCliStatus(cwd);
    57	  if (!cliStatus.available) {
    58	    throw new Error(cliStatus.error);
    59	  }
    60	
    61	  const prReview = await withProgress(
    62	    'Fetching PR review comments...',
    63	    (pr: PrReviewData) => `PR fetched: #${pr.number} ${pr.title}`,
    64	    async () => provider.fetchPrReviewComments(prNumber, cwd),
    65	  );
    66	
    67	  const resolved = await resolvePrImages(provider, prReview, cwd);
    68	
    69	  return {
    70	    initialInput: formatPrReviewAsTask(resolved.prReview),
    71	    prBranch: prReview.headRefName,
    72	    baseBranch: prReview.baseRefName,
    73	    ...(resolved.attachments.length > 0 ? { attachments: resolved.attachments } : {}),
    74	    cleanup: resolved.cleanup,
    75	  };
    76	}

