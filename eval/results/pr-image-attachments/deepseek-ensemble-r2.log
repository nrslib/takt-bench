     4	
     5	const IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN = /\[Image #\d+\]/g;
     6	
     7	const IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN = /^\[Image #[1-9]\d*\]$/;
     8	const SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS = new Set(['.gif', '.jpeg', '.jpg', '.png', '.webp']);
     9	
    10	function assertNonEmptyString(value: string, fieldName: string): void {
    11	  if (value.length === 0) {
    12	    throw new Error(`${fieldName} is required.`);
    13	  }
    14	}
    15	
    16	export function isImageAttachmentPlaceholder(value: string): boolean {
    17	  return IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN.test(value);
    18	}
    19	
    20	export function extractImagePlaceholderNumber(placeholder: string): number | undefined {
    21	  if (!isImageAttachmentPlaceholder(placeholder)) {
    22	    return undefined;
    23	  }
    24	  return Number.parseInt(placeholder.slice('[Image #'.length, -1), 10);
    25	}
    26	
    27	export function createImageAttachmentPlaceholder(number: number): string {
    28	  if (!Number.isSafeInteger(number) || number < 1) {
    29	    throw new Error(`Image attachment placeholder number must be a positive integer: ${number}`);
    30	  }
    31	  return `[Image #${number}]`;
    32	}
    33	
    34	export function findImageAttachmentPlaceholders(text: string): string[] {
    35	  return text.match(IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN) ?? [];
    36	}
    37	
    38	export function replaceImageAttachmentPlaceholders(
    39	  text: string,
    40	  replacements: ReadonlyMap<string, string>,
    41	): string {
    42	  return text.replace(IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN, (placeholder) => {
    43	    return replacements.get(placeholder) ?? placeholder;
    44	  });
    45	}
    46	
    47	export function validateImageAttachmentFileName(fileName: string): void {
    48	  assertNonEmptyString(fileName, 'Image attachment fileName');
    49	  if (fileName.includes('/') || fileName.includes('\\')) {
    50	    throw new Error(`Image attachment fileName must not contain path separators: ${fileName}`);
    51	  }
    52	
    53	  const extension = path.extname(fileName).toLowerCase();
    54	  if (!SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS.has(extension)) {
    55	    throw new Error(`Unsupported image attachment file extension: ${fileName}`);
    56	  }
    57	}
    58	
    59	export function validateStoredImageAttachment(attachment: StoredImageAttachment): void {
    60	  assertNonEmptyString(attachment.placeholder, 'Image attachment placeholder');
    61	  if (!isImageAttachmentPlaceholder(attachment.placeholder)) {
    62	    throw new Error(`Invalid image attachment placeholder: ${attachment.placeholder}`);
    63	  }
    64	  assertNonEmptyString(attachment.tempPath, 'Image attachment tempPath');
    65	  validateImageAttachmentFileName(attachment.fileName);
    66	}
    67	
    68	export function assertRegularImageAttachmentFile(filePath: string, subject = 'Image attachment source'): void {
    69	  assertNonEmptyString(filePath, `${subject} path`);
    70	  const stats = fs.lstatSync(filePath);
    71	  if (stats.isSymbolicLink() || !stats.isFile()) {
    72	    throw new Error(`${subject} must be a regular file: ${filePath}`);
    73	  }
    74	}
    75	
    76	export function resolveReferencedImageAttachments(
    77	  prompt: string,
    78	  attachments: readonly StoredImageAttachment[],
    79	): ImageAttachmentReference[] {
    80	  const referencedPlaceholders = [...new Set(prompt.match(IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN) ?? [])];
    81	  if (referencedPlaceholders.length === 0) {
    82	    return [];
    83	  }
    84	
    85	  const attachmentByPlaceholder = new Map<string, StoredImageAttachment>();
    86	  for (const attachment of attachments) {
    87	    if (attachmentByPlaceholder.has(attachment.placeholder)) {
    88	      throw new Error(`Duplicate image attachment placeholder: ${attachment.placeholder}`);
    89	    }
    90	    attachmentByPlaceholder.set(attachment.placeholder, attachment);
    91	  }
    92	
    93	  return referencedPlaceholders.flatMap((placeholder): ImageAttachmentReference[] => {
    94	    const attachment = attachmentByPlaceholder.get(placeholder);
    95	    if (attachment === undefined) {
    96	      return [];
    97	    }
    98	    validateStoredImageAttachment(attachment);
    99	    assertRegularImageAttachmentFile(attachment.tempPath);
   100	    return [{
   101	      placeholder: attachment.placeholder,
   102	      path: attachment.tempPath,
   103	    }];
   104	  });
   105	}
