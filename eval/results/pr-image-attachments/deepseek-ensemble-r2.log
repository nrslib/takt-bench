   261	export async function resolveExecutionContext(
   262	  cwd: string,
   263	  task: string,
   264	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   265	  pipelineConfig: PipelineConfig | undefined,
   266	  prBranch?: string,
   267	  prBaseBranch?: string,
   268	): Promise<ExecutionContext> {
   269	  if (options.prNumber !== undefined) {
   270	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   271	  }
   272	  if (options.createWorktree) {
   273	    const result = await confirmAndCreateWorktree(
   274	      cwd,
   275	      task,
   276	      options.createWorktree,
   277	      prBranch,
   278	      prBaseBranch,
   279	      options.prNumber !== undefined,
   280	    );
   281	    const branch = requireBranch(result.branch, 'worktree execution');
   282	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   283	    if (result.isWorktree) {
   284	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   285	    }
   286	    if (
   287	      options.prNumber !== undefined
   288	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   289	    ) {
   290	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   291	    }
   292	    return attachPipelinePrContext(
   293	      options.prNumber,
   294	      prBaseBranch,
   295	      {
   296	        execCwd: result.execCwd,
   297	        branch,
   298	        baseBranch,
   299	        isWorktree: result.isWorktree,
   300	        taskSlug: result.taskSlug,
   301	      },
   302	      {
   303	        baseRef: result.pullRequestBaseRef,
   304	        headRef: result.pullRequestHeadRef,
   305	      },
   306	    );
   307	  }
   308	  if (options.skipGit) {
   309	    return attachPipelinePrContext(
   310	      options.prNumber,
   311	      prBaseBranch,
   312	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   313	    );
   314	  }
   315	  if (prBranch) {
   316	    const safePrBranch = sanitizeTerminalText(prBranch);
   317	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   318	    checkoutBranch(cwd, prBranch);
   319	    success(`Checked out PR branch: ${safePrBranch}`);
   320	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   321	    return attachPipelinePrContext(
   322	      options.prNumber,
   323	      prBaseBranch,
   324	      {
   325	        execCwd: cwd,
   326	        branch: prBranch,
   327	        baseBranch,
   328	        isWorktree: false,
   329	      },
   330	      {
   331	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   332	        headRef: toLocalBranchRef(prBranch),
   333	      },
   334	    );
   335	  }
   336	  const baseBranch = resolveExecutionBaseBranch(cwd);
   337	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   338	  const safeBranch = sanitizeTerminalText(branch);
   339	  info(`Creating branch: ${safeBranch}`);
   340	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   341	  success(`Branch created: ${safeBranch}`);
   342	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   343	}
