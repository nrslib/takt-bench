    32	let provider: GitProvider | undefined;
    33	let currentProviderType: VcsProviderType | undefined;
    34	
    35	function createProvider(type: VcsProviderType): GitProvider {
    36	  switch (type) {
    37	    case 'gitlab':
    38	      return new GitLabProvider();
    39	    case 'github':
    40	      return new GitHubProvider();
    41	  }
    42	}
    43	
    44	function resolveProviderType(configValue: VcsProviderType | undefined, cwd?: string): VcsProviderType {
    45	  if (configValue) {
    46	    return configValue;
    47	  }
    48	  return detectVcsProvider(cwd) ?? 'github';
    49	}
