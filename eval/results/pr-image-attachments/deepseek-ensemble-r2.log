   345	export async function runWorkflow(
   346	  projectCwd: string,
   347	  workflow: string,
   348	  task: string,
   349	  execCwd: string,
   350	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   351	  context: ExecutionContext,
   352	  attachments?: readonly TaskAttachment[],
   353	): Promise<boolean> {
   354	  const safeWorkflow = sanitizeTerminalText(workflow);
   355	  info(`Running workflow: ${safeWorkflow}`);
   356	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   357	    ? {
   358	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   359	        ...(options.model !== undefined ? { model: options.model } : {}),
   360	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   361	      }
