   114	export async function createIssueAndSaveTask(
   115	  cwd: string,
   116	  task: string,
   117	  workflow?: string,
   118	  options?: { confirmAtEndMessage?: string; labels?: string[]; attachments?: TaskAttachment[] },
   119	): Promise<void> {
   120	  const gitProvider = getGitProvider();
   121	  const saveInteractiveTask: SaveEnqueuedTaskFile = async (saveCwd, taskContent, saveOptions) => {
   122	    const created = await saveTaskFromInteractive(saveCwd, taskContent, saveOptions?.workflow, {
   123	      issue: saveOptions?.issue,
   124	      confirmAtEndMessage: options?.confirmAtEndMessage,
   125	      ...(options?.attachments ? { attachments: options.attachments } : {}),
   126	    });
   127	    if (created === undefined) {
   128	      throw new IssueEnqueueCancelledError();
   129	    }
   130	    return created;
   131	  };
   132	  const result = await createIssueAndEnqueueTask({
   133	    cwd,
   134	    task,
   135	    workflow: workflow ?? DEFAULT_WORKFLOW_NAME,
   136	    worktree: true,
   137	    autoPr: false,
   138	    labels: options?.labels,
   139	    gitProvider,
   140	    issueOutputMode: 'terminal',
   141	  }, {
   142	    saveTaskFile: saveInteractiveTask,
   143	    createIssueFromTaskResult,
   144	  });
   145	  if (!result.success) {
   146	    if (result.failure.stage !== 'issue_creation') {
   147	      error(formatIssueEnqueueFailure(result.failure, getErrorMessage));
   148	    }
   149	    return;
   150	  }
   151	}
