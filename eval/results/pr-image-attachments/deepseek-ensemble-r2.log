    51	/**
    52	 * Initialize the git provider from project configuration.
    53	 *
    54	 * Reads `vcs_provider` from the resolved config (project → global).
    55	 * If not set, falls back to auto-detection from git remote URL.
    56	 * If auto-detection also fails, defaults to GitHub.
    57	 *
    58	 * Safe to call multiple times: the singleton is only re-created
    59	 * when the resolved provider type actually changes.
    60	 */
    61	export function initGitProvider(projectDir: string): void {
    62	  const configValue = resolveConfigValue(projectDir, 'vcsProvider') as VcsProviderType | undefined;
    63	  const resolved = resolveProviderType(configValue, projectDir);
    64	
    65	  if (provider && currentProviderType === resolved) {
    66	    return;
    67	  }
    68	
    69	  provider = createProvider(resolved);
    70	  currentProviderType = resolved;
    71	}
    72	
    73	/**
    74	 * Get the singleton GitProvider instance.
    75	 *
    76	 * If `initGitProvider` has not been called, falls back to
    77	 * auto-detection → GitHub default.
    78	 */
    79	export function getGitProvider(): GitProvider {
    80	  if (!provider) {
    81	    const resolved = resolveProviderType(undefined);
    82	    provider = createProvider(resolved);
    83	    currentProviderType = resolved;
    84	  }
    85	  return provider;
    86	}
