   314	function fetchReviewThreadComments(
   315	  thread: GhGraphqlReviewThread,
   316	  prNumber: number,
   317	  cwd: string,
   318	): GhGraphqlReviewThreadComment[] {
   319	  const comments = [...thread.comments.nodes];
   320	  let pageInfo = thread.comments.pageInfo;
   321	
   322	  for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP && pageInfo.hasNextPage; page += 1) {
   323	    if (!pageInfo.endCursor) {
