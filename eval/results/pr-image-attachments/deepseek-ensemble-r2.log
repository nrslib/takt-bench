   153	/**
   154	 * add command handler
   155	 *
   156	 * Flow:
   157	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   158	 *   B) 引数なし: Usage表示して終了
   159	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   160	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   161	 */
   162	export async function addTask(
   163	  cwd: string,
   164	  task?: string,
   165	  opts?: { prNumber?: number; workflow?: string },
   166	): Promise<void> {
   167	  const rawTask = task ?? '';
   168	  const trimmedTask = rawTask.trim();
   169	  const prNumber = opts?.prNumber;
   170	
   171	  if (prNumber !== undefined) {
   172	    const provider = getGitProvider();
   173	    const cliStatus = provider.checkCliStatus(cwd);
   174	    if (!cliStatus.available) {
   175	      error(cliStatus.error);
   176	      return;
   177	    }
   178	
   179	    let prReview: PrReviewData;
   180	    try {
   181	      prReview = await withProgress(
   182	        'Fetching PR review comments...',
   183	        (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   184	        async () => provider.fetchPrReviewComments(prNumber, cwd),
   185	      );
   186	    } catch (e) {
   187	      const msg = getErrorMessage(e);
   188	      error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   189	      return;
   190	    }
   191	
   192	    let resolved: {
   193	      prReview: PrReviewData;
   194	      attachments: TaskAttachment[];
   195	      cleanup: () => void;
   196	    };
   197	    try {
   198	      resolved = await resolvePrImages(provider, prReview, cwd);
   199	    } catch (e) {
   200	      const msg = getErrorMessage(e);
   201	      error(`Failed to resolve PR review images #${prNumber}: ${msg}`);
   202	      return;
   203	    }
   204	
   205	    if (prReview.reviews.length === 0 && prReview.comments.length === 0 && resolved.attachments.length === 0) {
   206	      error(`PR #${prNumber} has no review comments`);
   207	      return;
   208	    }
   209	
   210	    const taskContent = formatPrReviewAsTask(resolved.prReview);
   211	    let workflow: string | null;
   212	    try {
   213	      workflow = await determineWorkflow(cwd, opts?.workflow);
   214	    } catch (e) {
   215	      const msg = getErrorMessage(e);
   216	      error(`Failed to determine workflow #${prNumber}: ${msg}`);
   217	      resolved.cleanup();
   218	      return;
   219	    }
   220	    if (workflow === null) {
   221	      info('Cancelled.');
   222	      resolved.cleanup();
   223	      return;
   224	    }
   225	
   226	    const settings = {
   227	      worktree: true,
   228	      branch: prReview.headRefName,
   229	      baseBranch: prReview.baseRefName,
   230	      autoPr: false,
   231	      shouldPublishBranchToOrigin: true,
   232	    };
   233	    try {
   234	      const created = await saveTaskFile(cwd, taskContent, {
   235	        workflow,
   236	        ...settings,
   237	        prNumber,
   238	        ...(resolved.attachments.length > 0 ? { attachments: resolved.attachments } : {}),
   239	      });
   240	      displayTaskCreationResult(created, settings, workflow);
   241	    } finally {
   242	      resolved.cleanup();
   243	    }
   244	    return;
   245	  }
   246	
   247	  if (!trimmedTask) {
   248	    info('Usage: takt add <task>');
   249	    return;
   250	  }
   251	
   252	  let taskContent: string;
   253	  let issueNumber: number | undefined;
   254	
   255	  if (isIssueReference(trimmedTask)) {
   256	    try {
   257	      const numbers = parseIssueNumbers([trimmedTask]);
   258	      const primaryIssueNumber = numbers[0];
   259	      taskContent = await withProgress(
   260	        'Fetching issue...',
   261	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   262	        async () => resolveIssueTask(trimmedTask, cwd),
   263	      );
   264	      if (numbers.length > 0) {
   265	        issueNumber = numbers[0];
   266	      }
   267	    } catch (e) {
   268	      const msg = getErrorMessage(e);
   269	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   270	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   271	      return;
   272	    }
   273	  } else {
   274	    taskContent = rawTask;
   275	  }
   276	
   277	  const workflow = await determineWorkflow(cwd, opts?.workflow);
   278	  if (workflow === null) {
   279	    info('Cancelled.');
   280	    return;
   281	  }
   282	
   283	  const settings = await promptWorktreeSettings(cwd);
   284	
   285	  const created = await saveTaskFile(cwd, taskContent, {
   286	    workflow,
   287	    issue: issueNumber,
   288	    ...settings,
   289	  });
   290	
   291	  displayTaskCreationResult(created, settings, workflow);
   292	}
