   430	  info('Committing changes...');
   431	  try {
   432	    const commitHash = await stageAndCommit(execCwd, commitMessage, {
   433	      allowGitHooks: resolveConfigValue(projectCwd, 'allowGitHooks') ?? false,
   434	      allowGitFilters: resolveConfigValue(projectCwd, 'allowGitFilters') ?? false,
   435	    });
