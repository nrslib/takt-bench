    49	export function resolveReferencedImageAttachments(
    50	  prompt: string,
    51	  attachments: readonly StoredImageAttachment[],
    52	): ImageAttachmentReference[] {
    53	  const referencedPlaceholders = [...new Set(prompt.match(IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN) ?? [])];
    54	  if (referencedPlaceholders.length === 0) {
    55	    return [];
    56	  }
    57	
    58	  const attachmentByPlaceholder = new Map<string, StoredImageAttachment>();
    59	  for (const attachment of attachments) {
    60	    if (attachmentByPlaceholder.has(attachment.placeholder)) {
