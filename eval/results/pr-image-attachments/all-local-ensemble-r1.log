   155	/**
   156	 * add command handler
   157	 *
   158	 * Flow:
   159	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   160	 *   B) 引数なし: Usage表示して終了
   161	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   162	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   163	 */
   164	export async function addTask(
   165	  cwd: string,
   166	  task?: string,
   167	  opts?: { prNumber?: number; workflow?: string },
   168	): Promise<void> {
   169	  const rawTask = task ?? '';
   170	  const trimmedTask = rawTask.trim();
   171	  const prNumber = opts?.prNumber;
   172	
   173	  if (prNumber !== undefined) {
   174	    const provider = getGitProvider();
   175	    const cliStatus = provider.checkCliStatus(cwd);
   176	    if (!cliStatus.available) {
   177	      error(cliStatus.error);
   178	      return;
   179	    }
   180	
   181	    let prReview: PrReviewData;
   182	    try {
   183	      prReview = await withProgress(
   184	        'Fetching PR review comments...',
   185	        (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   186	        async () => provider.fetchPrReviewComments(prNumber, cwd),
   187	      );
   188	    } catch (e) {
   189	      const msg = getErrorMessage(e);
   190	      error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   191	      return;
   192	    }
   193	
   194	    if (prReview.reviews.length === 0 && prReview.comments.length === 0) {
   195	      error(`PR #${prNumber} has no review comments`);
   196	      return;
   197	    }
   198	
   199	    const { prReview: prReviewWithImages, attachments } = downloadPrImages(prReview, cwd);
   200	    const taskContent = formatPrReviewAsTask(prReviewWithImages);
   201	    const workflow = await determineWorkflow(cwd, opts?.workflow);
   202	    if (workflow === null) {
   203	      info('Cancelled.');
   204	      return;
   205	    }
   206	
   207	    const settings = {
   208	      worktree: true,
   209	      branch: prReview.headRefName,
   210	      baseBranch: prReview.baseRefName,
   211	      autoPr: false,
   212	      shouldPublishBranchToOrigin: true,
   213	    };
   214	    const created = await saveTaskFile(cwd, taskContent, {
   215	      workflow,
   216	      ...settings,
   217	      prNumber,
   218	      ...(attachments.length > 0 ? { attachments } : {}),
   219	    });
   220	    displayTaskCreationResult(created, settings, workflow);
   221	    return;
   222	  }
   223	
   224	  if (!trimmedTask) {
   225	    info('Usage: takt add <task>');
   226	    return;
   227	  }
   228	
   229	  let taskContent: string;
   230	  let issueNumber: number | undefined;
   231	
   232	  if (isIssueReference(trimmedTask)) {
   233	    try {
   234	      const numbers = parseIssueNumbers([trimmedTask]);
   235	      const primaryIssueNumber = numbers[0];
   236	      taskContent = await withProgress(
   237	        'Fetching issue...',
   238	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   239	        async () => resolveIssueTask(trimmedTask, cwd),
   240	      );
   241	      if (numbers.length > 0) {
   242	        issueNumber = numbers[0];
   243	      }
   244	    } catch (e) {
   245	      const msg = getErrorMessage(e);
   246	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   247	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   248	      return;
   249	    }
   250	  } else {
   251	    taskContent = rawTask;
   252	  }
   253	
   254	  const workflow = await determineWorkflow(cwd, opts?.workflow);
   255	  if (workflow === null) {
   256	    info('Cancelled.');
   257	    return;
   258	  }
   259	
   260	  const settings = await promptWorktreeSettings(cwd);
   261	
   262	  const created = await saveTaskFile(cwd, taskContent, {
   263	    workflow,
   264	    issue: issueNumber,
   265	    ...settings,
   266	  });
   267	
   268	  displayTaskCreationResult(created, settings, workflow);
   269	}
