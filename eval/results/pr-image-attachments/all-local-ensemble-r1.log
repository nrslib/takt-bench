   417	/**
   418	 * Fetch PR review comments and metadata via `gh pr view`.
   419	 * Throws on failure (PR not found, network error, etc.).
   420	 */
   421	export function fetchPrReviewComments(prNumber: number, cwd: string): PrReviewData {
   422	  log.debug('Fetching PR review comments', { prNumber });
   423	
   424	  const raw = execFileSync(
   425	    'gh',
   426	    ['pr', 'view', String(prNumber), '--json', PR_REVIEW_JSON_FIELDS],
   427	    { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   428	  );
   429	
   430	  const data = JSON.parse(raw) as GhPrViewReviewResponse;
   431	  const { owner, repo } = parseRepositoryFromPrUrl(data.url);
   432	  const threadReviewComments = fetchPrReviewThreads(owner, repo, prNumber, cwd);
   433	
   434	  const comments: PrReviewComment[] = data.comments.map((c) => ({
   435	    author: c.author.login,
   436	    body: c.body,
   437	  }));
   438	
   439	  const reviews: PrReviewComment[] = [];
   440	  for (const review of data.reviews) {
   441	    if (review.body) {
   442	      reviews.push({ author: review.author.login, body: review.body });
   443	    }
   444	  }
   445	  reviews.push(...threadReviewComments);
   446	
   447	  return {
   448	    number: data.number,
   449	    title: data.title,
   450	    body: data.body,
   451	    url: data.url,
   452	    headRefName: data.headRefName,
   453	    baseRefName: data.baseRefName,
   454	    comments,
   455	    reviews,
   456	    files: data.files.map((f) => f.path),
   457	  };
   458	}
