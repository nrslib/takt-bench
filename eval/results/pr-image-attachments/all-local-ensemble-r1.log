diff --git a/src/infra/git/imageExtraction.ts b/src/infra/git/imageExtraction.ts
new file mode 100644
index 00000000..1d2b3a82
--- /dev/null
+++ b/src/infra/git/imageExtraction.ts
@@ -0,0 +1,48 @@
+/**
+ * Image reference extraction and replacement for Markdown / HTML bodies.
+ *
+ * These functions are provider-neutral and operate on plain text bodies.
+ */
+
+const FENCED_CODE_BLOCK = /```[\s\S]*?```/g;
+const INLINE_CODE = /`[^`\n]*`/g;
+const IMAGE_SYNTAX = /!\[[^\]]*\]\(([^)\s]+)\)|<img[^>]*\bsrc="([^"]+)"[^>]*\/?>/gi;
+
+function stripCode(body: string): string {
+  return body.replace(FENCED_CODE_BLOCK, '').replace(INLINE_CODE, '');
+}
+
+/**
+ * Extract image URLs from a body in document order.
+ *
+ * Supports Markdown image syntax (`![alt](url)`) and HTML `<img src="...">`.
+ * URLs inside fenced code blocks and inline code spans are ignored.
+ */
+export function extractImageUrls(body: string): string[] {
+  const sanitized = stripCode(body);
+  const urls: string[] = [];
+  for (const match of sanitized.matchAll(IMAGE_SYNTAX)) {
+    const url = match[1] ?? match[2];
+    if (url) {
+      urls.push(url);
+    }
+  }
+  return urls;
+}
+
+/**
+ * Replace image references in a body with mapped placeholders.
+ *
+ * Each Markdown image or HTML `<img>` whose URL is present in `urlToPlaceholder`
+ * is replaced with the mapped placeholder. Unmapped image syntax is left unchanged.
+ */
+export function replaceImageReferences(
+  body: string,
+  urlToPlaceholder: ReadonlyMap<string, string>,
+): string {
+  return body.replace(IMAGE_SYNTAX, (match, markdownUrl: string | undefined, htmlUrl: string | undefined) => {
+    const url = markdownUrl ?? htmlUrl;
+    const placeholder = url === undefined ? undefined : urlToPlaceholder.get(url);
+    return placeholder ?? match;
+  });
+}
diff --git a/src/infra/github/imageDownload.ts b/src/infra/github/imageDownload.ts
new file mode 100644
index 00000000..21b496fc
--- /dev/null
+++ b/src/infra/github/imageDownload.ts
@@ -0,0 +1,152 @@
+/**
+ * PR image download utilities.
+ *
+ * Extracts image URLs from PR review data, downloads GitHub attachment images
+ * via the authenticated `gh` CLI, validates them, and stores them as task
+ * attachments with placeholder references.
+ */
+
+import { execFileSync } from 'node:child_process';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import type { PrReviewData } from '../git/types.js';
+import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
+import { extractImageUrls, replaceImageReferences } from '../git/imageExtraction.js';
+
+const GITHUB_ATTACHMENT_URL = /^https:\/\/github\.com\/(?:user-attachments\/assets\/[^/]+|[^/]+\/[^/]+\/assets\/[^/]+)$/;
+
+const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
+
+const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+const JPEG_MAGIC = Buffer.from([0xff, 0xd8, 0xff]);
+const GIF_MAGIC_89A = Buffer.from('GIF89a');
+const GIF_MAGIC_87A = Buffer.from('GIF87a');
+const RIFF_MAGIC = Buffer.from('RIFF');
+const WEBP_MAGIC = Buffer.from('WEBP');
+
+/**
+ * Return true when the URL is a GitHub-hosted attachment asset URL.
+ *
+ * Accepts `https://github.com/user-attachments/assets/<id>` and
+ * `https://github.com/<org>/<repo>/assets/<id>`. Rejects external and
+ * non-https URLs.
+ */
+export function isGitHubAttachmentUrl(url: string): boolean {
+  return GITHUB_ATTACHMENT_URL.test(url);
+}
+
+function detectImageFormat(data: Buffer): string | undefined {
+  if (data.length >= PNG_MAGIC.length && data.subarray(0, PNG_MAGIC.length).equals(PNG_MAGIC)) {
+    return 'png';
+  }
+  if (data.length >= JPEG_MAGIC.length && data.subarray(0, JPEG_MAGIC.length).equals(JPEG_MAGIC)) {
+    return 'jpeg';
+  }
+  if (
+    data.length >= GIF_MAGIC_89A.length
+    && (data.subarray(0, GIF_MAGIC_89A.length).equals(GIF_MAGIC_89A)
+      || data.subarray(0, GIF_MAGIC_87A.length).equals(GIF_MAGIC_87A))
+  ) {
+    return 'gif';
+  }
+  if (
+    data.length >= 12
+    && data.subarray(0, 4).equals(RIFF_MAGIC)
+    && data.subarray(8, 12).equals(WEBP_MAGIC)
+  ) {
+    return 'webp';
+  }
+  return undefined;
+}
+
+const SUPPORTED_CONTENT_TYPES = new Set(['image/png', 'image/jpeg', 'image/gif', 'image/webp']);
+
+function downloadImage(url: string, cwd: string): { contentType: string | undefined; data: Buffer } {
+  const raw = execFileSync('gh', ['api', '--include', url], {
+    cwd,
+    encoding: null,
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  const separator = raw.indexOf(Buffer.from('\r\n\r\n'));
+  if (separator === -1) {
+    return { contentType: undefined, data: raw };
+  }
+  const headerBlock = raw.subarray(0, separator).toString('utf8');
+  const data = raw.subarray(separator + 4);
+  const contentType = headerBlock
+    .split('\r\n')
+    .find((line) => line.toLowerCase().startsWith('content-type:'))
+    ?.split(':')
+    .slice(1)
+    .join(':')
+    .trim();
+  return { contentType, data };
+}
+
+interface MutableBody {
+  body: string;
+  set: (body: string) => void;
+}
+
+/**
+ * Download GitHub attachment images referenced in PR review data and return
+ * stored task attachments with image references replaced by placeholders.
+ *
+ * Only GitHub attachment URLs are downloaded. Each downloaded image is
+ * validated against supported magic bytes and a size limit. The returned
+ * `prReview` has image references in the PR body, conversation comments, and
+ * review comments replaced with `[Image #N]` placeholders.
+ */
+export function downloadPrImages(
+  prReview: PrReviewData,
+  cwd: string,
+): { prReview: PrReviewData; attachments: StoredImageAttachment[] } {
+  const attachments: StoredImageAttachment[] = [];
+  const urlToPlaceholder = new Map<string, string>();
+  const tmpDir = path.join(cwd, '.takt', 'tmp', 'pr-images');
+  fs.mkdirSync(tmpDir, { recursive: true });
+
+  const bodies: MutableBody[] = [
+    { body: prReview.body, set: (body) => { prReview.body = body; } },
+    ...prReview.comments.map((comment) => ({
+      body: comment.body,
+      set: (body: string) => { comment.body = body; },
+    })),
+    ...prReview.reviews.map((review) => ({
+      body: review.body,
+      set: (body: string) => { review.body = body; },
+    })),
+  ];
+
+  for (const { body } of bodies) {
+    for (const url of extractImageUrls(body)) {
+      if (!isGitHubAttachmentUrl(url) || urlToPlaceholder.has(url)) {
+        continue;
+      }
+      const { contentType, data } = downloadImage(url, cwd);
+      if (contentType === undefined || !SUPPORTED_CONTENT_TYPES.has(contentType)) {
+        throw new Error(`Unsupported Content-Type for ${url}`);
+      }
+      const format = detectImageFormat(data);
+      if (format === undefined) {
+        throw new Error(`Unsupported image format for ${url}`);
+      }
+      if (data.length > MAX_IMAGE_BYTES) {
+        throw new Error(`Image exceeds size limit for ${url}`);
+      }
+      const index = attachments.length + 1;
+      const fileName = `image-${index}.${format}`;
+      const tempPath = path.join(tmpDir, fileName);
+      fs.writeFileSync(tempPath, data);
+      const placeholder = `[Image #${index}]`;
+      attachments.push({ placeholder, tempPath, fileName });
+      urlToPlaceholder.set(url, placeholder);
+    }
+  }
+
+  for (const { body, set } of bodies) {
+    set(replaceImageReferences(body, urlToPlaceholder));
+  }
+
+  return { prReview, attachments };
+}

