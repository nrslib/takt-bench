    50	
    51	  const execFileAsync = promisify(childProcess.execFile) as (
    52	    command: string,
    53	    commandArgs: string[],
    54	    options: { timeout: number; maxBuffer: number },
    55	  ) => Promise<{ stdout: string; stderr: string }>;
    56	
    57	  return execFileAsync(file, args, {
    58	    timeout: CLIPBOARD_COMMAND_TIMEOUT_MS,
    59	    maxBuffer: CLIPBOARD_COMMAND_MAX_BUFFER,
    60	  });
    61	}
