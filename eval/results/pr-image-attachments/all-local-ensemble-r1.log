    32	async function runPipeline(options: PipelineExecutionOptions): Promise<PipelineOutcome> {
    33	  const { cwd, workflow, autoPr, skipGit } = options;
    34	  const pipelineConfig = resolveConfigValues(cwd, ['pipeline']).pipeline;
    35	
    36	  const buildResult = (overrides: Partial<PipelineResult> = {}): PipelineResult => ({
    37	    success: false, workflow, issueNumber: options.issueNumber, ...overrides,
    38	  });
    39	
    40	  const taskContent = resolveTaskContent(options);
    41	  if (!taskContent) return { exitCode: EXIT_ISSUE_FETCH_FAILED, result: buildResult() };
    42	
    43	  let context: ExecutionContext;
    44	  try {
    45	    context = await resolveExecutionContext(
    46	      cwd,
    47	      taskContent.task,
    48	      options,
    49	      pipelineConfig,
    50	      taskContent.prBranch,
    51	      taskContent.prBaseBranch,
    52	    );
    53	  } catch (err) {
    54	    error(`Failed to prepare execution environment: ${getErrorMessage(err)}`);
    55	    return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult() };
    56	  }
    57	
    58	  log.info('Pipeline workflow execution starting', { workflow, branch: context.branch, skipGit, issueNumber: options.issueNumber });
    59	  const workflowOk = await runWorkflow(cwd, workflow, taskContent.task, context.execCwd, options, context, taskContent.attachments);
    60	  if (!workflowOk) return { exitCode: EXIT_WORKFLOW_FAILED, result: buildResult({ branch: context.branch }) };
    61	
    62	  if (!skipGit && context.branch) {
    63	    const commitMessage = buildCommitMessage(pipelineConfig, taskContent.issue, options.task);
    64	    if (!await commitAndPush(context.execCwd, cwd, context.branch, commitMessage, context.isWorktree)) {
    65	      return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult({ branch: context.branch }) };
    66	    }
    67	  }
    68	
    69	  let prUrl: string | undefined;
    70	  if (autoPr && !skipGit && context.branch) {
    71	    prUrl = submitPullRequest(cwd, context.branch, context.baseBranch, taskContent, workflow, pipelineConfig, options);
    72	    if (!prUrl) return { exitCode: EXIT_PR_CREATION_FAILED, result: buildResult({ branch: context.branch }) };
    73	  } else if (autoPr && skipGit) {
    74	    info('--auto-pr is ignored when --skip-git is specified (no push was performed)');
    75	  }
    76	
    77	  blankLine();
    78	  const safeWorkflow = sanitizeTerminalText(workflow);
    79	  const issueStatus = taskContent.issue
    80	    ? `#${taskContent.issue.number} "${sanitizeTerminalText(taskContent.issue.title)}"`
    81	    : 'N/A';
    82	  const branchStatus = context.branch ? sanitizeTerminalText(context.branch) : '(current)';
    83	  status('Issue', issueStatus);
    84	  status('Branch', branchStatus);
    85	  status('Workflow', safeWorkflow);
    86	  status('Result', 'Success', 'green');
    87	
    88	  return { exitCode: 0, result: buildResult({ success: true, branch: context.branch, prUrl }) };
    89	}
    90	export async function executePipeline(options: PipelineExecutionOptions): Promise<number> {
    91	  const startTime = Date.now();
    92	  const runId = generateRunId();
    93	  let pipelineResult: PipelineResult = { success: false, workflow: options.workflow, issueNumber: options.issueNumber };
    94	
    95	  try {
    96	    const outcome = await runPipeline(options);
    97	    pipelineResult = outcome.result;
    98	    return outcome.exitCode;
    99	  } finally {
   100	    await notifySlack(runId, startTime, pipelineResult);
   101	  }
   102	}
