    36	 * Each Markdown image or HTML `<img>` whose URL is present in `urlToPlaceholder`
    37	 * is replaced with the mapped placeholder. Unmapped image syntax is left unchanged.
    38	 */
    39	export function replaceImageReferences(
    40	  body: string,
    41	  urlToPlaceholder: ReadonlyMap<string, string>,
    42	): string {
    43	  return body.replace(IMAGE_SYNTAX, (match, markdownUrl: string | undefined, htmlUrl: string | undefined) => {
    44	    const url = markdownUrl ?? htmlUrl;
    45	    const placeholder = url === undefined ? undefined : urlToPlaceholder.get(url);
    46	    return placeholder ?? match;
    47	  });
    48	}
     1	/**
     2	 * PR image download utilities.
     3	 *
     4	 * Extracts image URLs from PR review data, downloads GitHub attachment images
     5	 * via the authenticated `gh` CLI, validates them, and stores them as task
     6	 * attachments with placeholder references.
     7	 */
     8	
     9	import { execFileSync } from 'node:child_process';
    10	import * as fs from 'node:fs';
    11	import * as path from 'node:path';
    12	import type { PrReviewData } from '../git/types.js';
    13	import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
    14	import { extractImageUrls, replaceImageReferences } from '../git/imageExtraction.js';
    15	
    16	const GITHUB_ATTACHMENT_URL = /^https:\/\/github\.com\/(?:user-attachments\/assets\/[^/]+|[^/]+\/[^/]+\/assets\/[^/]+)$/;
    17	
    18	const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
    19	
    20	const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
    21	const JPEG_MAGIC = Buffer.from([0xff, 0xd8, 0xff]);
    22	const GIF_MAGIC_89A = Buffer.from('GIF89a');
    23	const GIF_MAGIC_87A = Buffer.from('GIF87a');
    24	const RIFF_MAGIC = Buffer.from('RIFF');
    25	const WEBP_MAGIC = Buffer.from('WEBP');
    26	
    27	/**
    28	 * Return true when the URL is a GitHub-hosted attachment asset URL.
    29	 *
    30	 * Accepts `https://github.com/user-attachments/assets/<id>` and
    31	 * `https://github.com/<org>/<repo>/assets/<id>`. Rejects external and
    32	 * non-https URLs.
    33	 */
    34	export function isGitHubAttachmentUrl(url: string): boolean {
    35	  return GITHUB_ATTACHMENT_URL.test(url);
    36	}
    37	
    38	function detectImageFormat(data: Buffer): string | undefined {
    39	  if (data.length >= PNG_MAGIC.length && data.subarray(0, PNG_MAGIC.length).equals(PNG_MAGIC)) {
    40	    return 'png';
    41	  }
    42	  if (data.length >= JPEG_MAGIC.length && data.subarray(0, JPEG_MAGIC.length).equals(JPEG_MAGIC)) {
    43	    return 'jpeg';
    44	  }
    45	  if (
    46	    data.length >= GIF_MAGIC_89A.length
    47	    && (data.subarray(0, GIF_MAGIC_89A.length).equals(GIF_MAGIC_89A)
    48	      || data.subarray(0, GIF_MAGIC_87A.length).equals(GIF_MAGIC_87A))
    49	  ) {
    50	    return 'gif';
    51	  }
    52	  if (
    53	    data.length >= 12
    54	    && data.subarray(0, 4).equals(RIFF_MAGIC)
    55	    && data.subarray(8, 12).equals(WEBP_MAGIC)
    56	  ) {
    57	    return 'webp';
    58	  }
    59	  return undefined;
    60	}
    61	
    62	const SUPPORTED_CONTENT_TYPES = new Set(['image/png', 'image/jpeg', 'image/gif', 'image/webp']);
    63	
    64	function downloadImage(url: string, cwd: string): { contentType: string | undefined; data: Buffer } {
    65	  const raw = execFileSync('gh', ['api', '--include', url], {
    66	    cwd,
    67	    encoding: null,
    68	    stdio: ['pipe', 'pipe', 'pipe'],
    69	  });
    70	  const separator = raw.indexOf(Buffer.from('\r\n\r\n'));
    71	  if (separator === -1) {
    72	    return { contentType: undefined, data: raw };
    73	  }
    74	  const headerBlock = raw.subarray(0, separator).toString('utf8');
    75	  const data = raw.subarray(separator + 4);
    76	  const contentType = headerBlock
    77	    .split('\r\n')
    78	    .find((line) => line.toLowerCase().startsWith('content-type:'))
    79	    ?.split(':')
    80	    .slice(1)
    81	    .join(':')
    82	    .trim();
    83	  return { contentType, data };
    84	}
    85	
    86	interface MutableBody {
    87	  body: string;
    88	  set: (body: string) => void;
    89	}
    90	
    91	/**
    92	 * Download GitHub attachment images referenced in PR review data and return
    93	 * stored task attachments with image references replaced by placeholders.
    94	 *
    95	 * Only GitHub attachment URLs are downloaded. Each downloaded image is
    96	 * validated against supported magic bytes and a size limit. The returned
    97	 * `prReview` has image references in the PR body, conversation comments, and
    98	 * review comments replaced with `[Image #N]` placeholders.
    99	 */
   100	export function downloadPrImages(
   101	  prReview: PrReviewData,
   102	  cwd: string,
   103	): { prReview: PrReviewData; attachments: StoredImageAttachment[] } {
   104	  const attachments: StoredImageAttachment[] = [];
   105	  const urlToPlaceholder = new Map<string, string>();
   106	  const tmpDir = path.join(cwd, '.takt', 'tmp', 'pr-images');
   107	  fs.mkdirSync(tmpDir, { recursive: true });
   108	
   109	  const bodies: MutableBody[] = [
   110	    { body: prReview.body, set: (body) => { prReview.body = body; } },
   111	    ...prReview.comments.map((comment) => ({
   112	      body: comment.body,
   113	      set: (body: string) => { comment.body = body; },
   114	    })),
   115	    ...prReview.reviews.map((review) => ({
   116	      body: review.body,
   117	      set: (body: string) => { review.body = body; },
   118	    })),
   119	  ];
   120	
   121	  for (const { body } of bodies) {
   122	    for (const url of extractImageUrls(body)) {
   123	      if (!isGitHubAttachmentUrl(url) || urlToPlaceholder.has(url)) {
   124	        continue;
   125	      }
   126	      const { contentType, data } = downloadImage(url, cwd);
   127	      if (contentType === undefined || !SUPPORTED_CONTENT_TYPES.has(contentType)) {
   128	        throw new Error(`Unsupported Content-Type for ${url}`);
   129	      }
   130	      const format = detectImageFormat(data);
   131	      if (format === undefined) {
   132	        throw new Error(`Unsupported image format for ${url}`);
   133	      }
   134	      if (data.length > MAX_IMAGE_BYTES) {
   135	        throw new Error(`Image exceeds size limit for ${url}`);
   136	      }
   137	      const index = attachments.length + 1;
   138	      const fileName = `image-${index}.${format}`;
   139	      const tempPath = path.join(tmpDir, fileName);
   140	      fs.writeFileSync(tempPath, data);
   141	      const placeholder = `[Image #${index}]`;
   142	      attachments.push({ placeholder, tempPath, fileName });
   143	      urlToPlaceholder.set(url, placeholder);
   144	    }
   145	  }
   146	
   147	  for (const { body, set } of bodies) {
   148	    set(replaceImageReferences(body, urlToPlaceholder));
   149	  }
   150	
   151	  return { prReview, attachments };
   152	}
