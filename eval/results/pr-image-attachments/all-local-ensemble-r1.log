   111	
   112	async function notifySlack(runId: string, startTime: number, result: PipelineResult): Promise<void> {
   113	  const webhookUrl = getSlackWebhookUrl();
   114	  if (!webhookUrl) return;
   115	
   116	  const durationSec = Math.round((Date.now() - startTime) / 1000);
   117	  const task: SlackTaskDetail = {
   118	    name: 'pipeline',
   119	    success: result.success,
   120	    workflow: result.workflow,
   121	    issueNumber: result.issueNumber,
   122	    durationSec,
   123	    branch: result.branch,
   124	    prUrl: result.prUrl,
   125	  };
   126	  const message = buildSlackRunSummary({
   127	    runId,
   128	    total: 1,
   129	    success: result.success ? 1 : 0,
   130	    failed: result.success ? 0 : 1,
   131	    durationSec,
   132	    concurrency: 1,
   133	    tasks: [task],
   134	  });
   135	
   136	  await sendSlackNotification(webhookUrl, message);
   137	}

