     1	/**
     2	 * Image reference extraction and replacement for Markdown / HTML bodies.
     3	 *
     4	 * These functions are provider-neutral and operate on plain text bodies.
     5	 */
     6	
     7	const FENCED_CODE_BLOCK = /```[\s\S]*?```/g;
     8	const INLINE_CODE = /`[^`\n]*`/g;
     9	const IMAGE_SYNTAX = /!\[[^\]]*\]\(([^)\s]+)\)|<img[^>]*\bsrc="([^"]+)"[^>]*\/?>/gi;
    10	
    11	function stripCode(body: string): string {
    12	  return body.replace(FENCED_CODE_BLOCK, '').replace(INLINE_CODE, '');
    13	}
    14	
    15	/**
    16	 * Extract image URLs from a body in document order.
    17	 *
    18	 * Supports Markdown image syntax (`![alt](url)`) and HTML `<img src="...">`.
    19	 * URLs inside fenced code blocks and inline code spans are ignored.
    20	 */
    21	export function extractImageUrls(body: string): string[] {
    22	  const sanitized = stripCode(body);
    23	  const urls: string[] = [];
    24	  for (const match of sanitized.matchAll(IMAGE_SYNTAX)) {
    25	    const url = match[1] ?? match[2];
    26	    if (url) {
    27	      urls.push(url);
    28	    }
    29	  }
    30	  return urls;
    31	}
