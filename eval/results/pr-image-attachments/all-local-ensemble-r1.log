    88	export function commentOnPr(prNumber: number, body: string, cwd: string): CommentResult {
    89	  const ghStatus = checkGhCli(cwd);
    90	  if (!ghStatus.available) {
    91	    return { success: false, error: ghStatus.error };
    92	  }
    93	
    94	  try {
    95	    execFileSync('gh', ['pr', 'comment', String(prNumber), '--body', body], {
    96	      cwd,
    97	      encoding: 'utf-8',
    98	      stdio: ['pipe', 'pipe', 'pipe'],
    99	    });
   100	    return { success: true };
   101	  } catch (err) {
   102	    const errorMessage = getErrorMessage(err);
   103	    log.error('PR comment failed', { error: errorMessage });
   104	    return { success: false, error: errorMessage };
   105	  }
   106	}
