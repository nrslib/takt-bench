    27	/**
    28	 * Find an open PR for the given branch.
    29	 * Returns undefined if no PR exists.
    30	 */
    31	export function findExistingPr(branch: string, cwd: string): ExistingPr | undefined {
    32	  const ghStatus = checkGhCli(cwd);
    33	  if (!ghStatus.available) return undefined;
    34	
    35	  try {
    36	    const output = execFileSync(
    37	      'gh', ['pr', 'list', '--head', branch, '--state', 'open', '--json', 'number,url', '--limit', '1'],
    38	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
    39	    );
    40	    const prs = JSON.parse(output) as ExistingPr[];
    41	    return prs[0];
    42	  } catch (e) {
    43	    log.debug('gh pr list failed, treating as no PR', { error: getErrorMessage(e) });
    44	    return undefined;
    45	  }
    46	}
    47	
    48	interface GhPrListResponseItem {
    49	  number: number;
    50	  user: { login: string };
    51	  base: { ref: string; repo: { full_name: string } | null };
    52	  head: { ref: string; repo: { full_name: string } | null };
    53	  body: string | null;
    54	  labels: Array<{ name: string }>;
    55	  draft: boolean;
    56	  updated_at: string;
    57	}
    58	
    59	const OPEN_PRS_PER_PAGE = 100;
    60	const REVIEW_THREADS_PER_PAGE = 100;
    61	const REVIEW_THREAD_COMMENTS_PER_PAGE = 100;
    62	const GRAPHQL_PAGINATION_HARD_CAP = 100;
    63	const DELETED_GITHUB_USER_AUTHOR = 'deleted GitHub user';
    64	
    65	export function listOpenPrs(cwd: string): PrListItem[] {
    66	  const repo = resolveRepositoryNameWithOwner(cwd);
    67	  const prs = fetchPaginatedApi<GhPrListResponseItem>({
    68	    command: 'gh',
    69	    cwd,
    70	    context: 'open pull request list',
    71	    initialEndpoint: `repos/${repo}/pulls?state=open&per_page=${OPEN_PRS_PER_PAGE}&page=1`,
    72	    parsePage: (body) => JSON.parse(body) as GhPrListResponseItem[],
    73	  });
    74	
    75	  return prs.map((pr) => ({
    76	    number: pr.number,
    77	    author: pr.user.login,
    78	    base_branch: pr.base.ref,
    79	    head_branch: pr.head.ref,
    80	    managed_by_takt: isTaktManagedPrBody(pr.body),
    81	    labels: pr.labels.map((label) => label.name),
    82	    same_repository: pr.head.repo?.full_name === pr.base.repo?.full_name,
    83	    draft: pr.draft,
    84	    updated_at: pr.updated_at,
    85	  }));
    86	}
