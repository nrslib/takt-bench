   351	  return comments.map((comment) => {
   352	    const line = comment.line ?? comment.originalLine ?? undefined;
   353	    return {
   354	      author: resolveReviewThreadCommentAuthor(comment),
   355	      body: comment.body,
   356	      path: comment.path,
   357	      ...(line !== undefined ? { line } : {}),
   358	      url: comment.url,
   359	      threadState,
   360	      ...(thread.resolvedBy ? { resolvedBy: thread.resolvedBy.login } : {}),
   361	      isOutdated: thread.isOutdated,
   362	    };
   363	  });
   364	}
