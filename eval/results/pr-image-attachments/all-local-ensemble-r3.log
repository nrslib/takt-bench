   218	export function resolveTaskContent(options: PipelineExecutionOptions): TaskContent | undefined {
   219	  const { cwd } = options;
   220	  if (options.prNumber) {
   221	    info(`Fetching PR #${options.prNumber} review comments...`);
   222	    const prReview = fetchVcsResource(
   223	      `PR #${options.prNumber}`,
   224	      cwd,
   225	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   226	    );
   227	    if (!prReview) return undefined;
   228	    const { prReview: prReviewWithImages, attachments } = downloadPrImages(prReview, cwd);
   229	    const task = formatPrReviewAsTask(prReviewWithImages);
   230	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   231	    return {
   232	      task,
   233	      prBranch: prReview.headRefName,
   234	      prBaseBranch: prReview.baseRefName,
   235	      ...(attachments.length > 0 ? { attachments } : {}),
   236	    };
   237	  }
   238	  if (options.issueNumber) {
   239	    info(`Fetching issue #${options.issueNumber}...`);
   240	    const issue = fetchVcsResource(
   241	      `issue #${options.issueNumber}`,
   242	      cwd,
   243	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   244	    );
   245	    if (!issue) return undefined;
   246	    const task = formatIssueAsTask(issue);
   247	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   248	    return { task, issue };
   249	  }
   250	  if (options.task) {
   251	    return { task: options.task };
   252	  }
   253	  error('Either --issue, --pr, or --task must be specified');
   254	  return undefined;
   255	}
