   217	function assertTaskAttachmentsMatchManifest(
   218	  taskDir: string,
   219	  expectedManifest: TaskAttachmentManifest,
   220	): void {
   221	  const actualManifest = resolveTaskAttachmentManifest(taskDir);
   222	  const expectedByPath = new Map(
   223	    expectedManifest.map((entry) => [entry.relativePath, entry]),
   224	  );
   225	  const actualByPath = new Map(
   226	    actualManifest.map((entry) => [entry.relativePath, entry]),
   227	  );
   228	
   229	  for (const expected of expectedManifest) {
   230	    if (!actualByPath.has(expected.relativePath)) {
   231	      throw new Error(
   232	        `Task attachment is missing: ${path.join(taskDir, expected.relativePath)}`,
   233	      );
   234	    }
   235	  }
   236	  for (const actual of actualManifest) {
   237	    if (!expectedByPath.has(actual.relativePath)) {
   238	      throw new Error(
   239	        `Task attachment was added after resolution: ${path.join(taskDir, actual.relativePath)}`,
   240	      );
   241	    }
   242	  }
   243	  for (const expected of expectedManifest) {
   244	    assertTaskAttachmentManifestEntry(
   245	      taskDir,
   246	      expected,
   247	      actualByPath.get(expected.relativePath),
   248	    );
   249	  }
   250	}
