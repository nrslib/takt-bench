   406	    throw new Error(`Unexpected pull request URL format: ${prUrl}`);
   407	  }
   408	
   409	  const [owner, repo] = pathSegments;
   410	  if (!owner || !repo) {
   411	    throw new Error(`Repository owner/repo is missing in pull request URL: ${prUrl}`);
   412	  }
   413	
   414	  return { owner, repo };
   415	}
