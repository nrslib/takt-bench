   116	export async function createIssueAndSaveTask(
   117	  cwd: string,
   118	  task: string,
   119	  workflow?: string,
   120	  options?: { confirmAtEndMessage?: string; labels?: string[]; attachments?: TaskAttachment[] },
   121	): Promise<void> {
