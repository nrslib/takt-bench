   314	function fetchReviewThreadComments(
   315	  thread: GhGraphqlReviewThread,
   316	  prNumber: number,
   317	  cwd: string,
   318	): GhGraphqlReviewThreadComment[] {
   319	  const comments = [...thread.comments.nodes];
   320	  let pageInfo = thread.comments.pageInfo;
   321	
   322	  for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP && pageInfo.hasNextPage; page += 1) {
   323	    if (!pageInfo.endCursor) {
   324	      throw new Error(`Missing review thread comments endCursor for next page in pull request #${prNumber}`);
   325	    }
   326	
   327	    const raw = execFileSync(
   328	      'gh',
   329	      buildReviewThreadCommentsGraphqlArgs(thread.id, pageInfo.endCursor),
   330	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   331	    );
   332	    const nextComments = parseReviewThreadCommentsResponse(raw);
   333	    comments.push(...nextComments.nodes);
   334	    pageInfo = nextComments.pageInfo;
   335	  }
   336	
   337	  if (pageInfo.hasNextPage) {
   338	    throw new Error(
   339	      `Pagination limit exceeded while fetching pull request #${prNumber} review thread comments (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   340	    );
   341	  }
   342	
   343	  return comments;
   344	}
