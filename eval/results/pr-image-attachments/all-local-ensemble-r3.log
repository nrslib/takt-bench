    63	async function readMacOSClipboardImage(): Promise<PastedImage> {
    64	  const tempDir = await mkdtemp(path.join(ensureCurrentTmpDirExists(), 'takt-clipboard-image-'));
    65	  const pngPath = path.join(tempDir, 'clipboard.png');
    66	  const tiffPath = path.join(tempDir, 'clipboard.tiff');
    67	
    68	  try {
    69	    const { stdout } = await execClipboardCommand('osascript', [
    70	      '-l',
    71	      'JavaScript',
    72	      '-e',
    73	      MACOS_CLIPBOARD_IMAGE_SCRIPT,
    74	      pngPath,
    75	      tiffPath,
    76	    ]);
    77	
    78	    if (stdout.trim() === 'tiff') {
    79	      await execClipboardCommand('sips', [
    80	        '-s',
    81	        'format',
    82	        'png',
    83	        tiffPath,
    84	        '--out',
    85	        pngPath,
    86	      ]);
    87	    }
    88	
    89	    await assertClipboardImageWithinLimit(pngPath);
    90	    return {
    91	      mimeType: 'image/png',
    92	      data: await readFile(pngPath),
    93	    };
    94	  } finally {
    95	    await rm(tempDir, { recursive: true, force: true });
    96	  }
    97	}
