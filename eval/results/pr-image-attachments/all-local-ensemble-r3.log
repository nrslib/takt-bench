   255	    return;
   256	  }
   257	
   258	  const stats = fs.lstatSync(sourceAttachmentsDir);
   259	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   260	    throw new Error(`Task attachments must be a regular directory: ${sourceAttachmentsDir}`);
   261	  }
