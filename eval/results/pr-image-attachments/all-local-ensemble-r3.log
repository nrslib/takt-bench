    50	export async function resolvePrInput(
    51	  prNumber: number,
    52	  cwd?: string,
    53	): Promise<{ initialInput: string; prBranch: string; baseBranch?: string }> {
    54	  const provider = getGitProvider();
    55	  const cliStatus = provider.checkCliStatus(cwd);
    56	  if (!cliStatus.available) {
    57	    throw new Error(cliStatus.error);
    58	  }
    59	
    60	  const prReview = await withProgress(
    61	    'Fetching PR review comments...',
    62	    (pr: PrReviewData) => `PR fetched: #${pr.number} ${pr.title}`,
