   162	function resolveReadOnlyBaseBranch(cwd: string): string {
   163	  return requireBaseBranch(resolveBaseBranchName(cwd), 'skip-git execution');
   164	}
   165	
   166	function tryResolveCurrentBranch(cwd: string): string | undefined {
   167	  try {
   168	    const branch = getCurrentBranch(cwd);
   169	    return branch || undefined;
   170	  } catch {
   171	    return undefined;
   172	  }
