   140	export function buildCommitMessage(
   141	  pipelineConfig: PipelineConfig | undefined,
   142	  issue: Issue | undefined,
   143	  taskText: string | undefined,
   144	): string {
   145	  const template = pipelineConfig?.commitMessageTemplate;
   146	  if (template && issue) {
