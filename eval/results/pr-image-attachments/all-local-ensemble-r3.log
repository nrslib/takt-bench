   257	export async function resolveExecutionContext(
   258	  cwd: string,
   259	  task: string,
   260	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   261	  pipelineConfig: PipelineConfig | undefined,
