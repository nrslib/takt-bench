    35	export function buildTaskOrderContent(
    36	  taskContent: string,
    37	  attachments?: readonly TaskAttachment[],
    38	): string {
    39	  if (!hasAttachments(attachments)) {
    40	    return taskContent;
    41	  }
    42	
    43	  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
    44	  const attachmentLines = attachments.map((attachment) =>
    45	    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
    46	  );
    47	  return [
    48	    normalizedTaskContent.trimEnd(),
    49	    '',
    50	    '## 添付画像',
    51	    '',
    52	    ...attachmentLines,
    53	  ].join('\n');
