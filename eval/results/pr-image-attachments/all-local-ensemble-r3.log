   101	function attachPipelinePrContext(
   102	  prNumber: number | undefined,
   103	  prBaseBranch: string | undefined,
   104	  context: ExecutionContext,
   105	  materializedDiffRefs?: { baseRef?: string; headRef?: string },
   106	): ExecutionContext {
   107	  if (prNumber === undefined) {
   108	    return context;
   109	  }
   110	  const branch = requireBranch(context.branch, `PR #${prNumber} execution`);
   111	  const baseBranch = requireBaseBranch(context.baseBranch, `PR #${prNumber} execution`);
   112	  return {
   113	    ...context,
   114	    prContext: createPullRequestContext({
   115	      source: 'pr_review',
   116	      prNumber,
   117	      baseBranch,
   118	      headBranch: branch,
   119	      baseBranchSource: prBaseBranch === undefined
   120	        ? 'default_branch_fallback'
   121	        : 'pull_request',
   122	      ...(materializedDiffRefs?.baseRef && materializedDiffRefs.headRef
   123	        ? {
   124	          baseDiffRef: materializedDiffRefs.baseRef,
   125	          headDiffRef: materializedDiffRefs.headRef,
   126	        }
   127	        : {}),
   128	    }),
   129	  };
   130	}
