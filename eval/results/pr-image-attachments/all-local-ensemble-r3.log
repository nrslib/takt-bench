   199	function fetchVcsResource<T>(
   200	  label: string,
   201	  cwd: string,
   202	  fetch: (provider: ReturnType<typeof getGitProvider>) => T,
   203	): T | undefined {
   204	  const gitProvider = getGitProvider();
   205	  const cliStatus = gitProvider.checkCliStatus(cwd);
   206	  if (!cliStatus.available) {
   207	    error(cliStatus.error);
   208	    return undefined;
   209	  }
   210	  try {
   211	    return fetch(gitProvider);
   212	  } catch (err) {
   213	    error(`Failed to fetch ${label}: ${getErrorMessage(err)}`);
   214	    return undefined;
   215	  }
   216	}
