    41	export function assertRegularImageAttachmentFile(filePath: string, subject = 'Image attachment source'): void {
    42	  assertNonEmptyString(filePath, `${subject} path`);
    43	  const stats = fs.lstatSync(filePath);
    44	  if (stats.isSymbolicLink() || !stats.isFile()) {
    45	    throw new Error(`${subject} must be a regular file: ${filePath}`);
