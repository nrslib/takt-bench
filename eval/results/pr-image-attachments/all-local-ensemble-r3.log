   341	export async function runWorkflow(
   342	  projectCwd: string,
   343	  workflow: string,
   344	  task: string,
   345	  execCwd: string,
   346	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   347	  context: ExecutionContext,
   348	  attachments?: TaskAttachment[],
   349	): Promise<boolean> {
   350	  const safeWorkflow = sanitizeTerminalText(workflow);
   351	  info(`Running workflow: ${safeWorkflow}`);
   352	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   353	    ? {
   354	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   355	        ...(options.model !== undefined ? { model: options.model } : {}),
   356	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   357	      }
   358	    : undefined;
   359	
   360	  let taskSpec: ResolvedTaskSpec | undefined;
   361	  let preparedSpecTaskDir: string | undefined;
   362	  if (attachments !== undefined && attachments.length > 0) {
   363	    const preparedSpec = prepareTaskSpecDirectory(projectCwd, task, attachments);
   364	    preparedSpecTaskDir = preparedSpec.taskDir;
   365	    const reportDirName = generateExecutionReportDir(execCwd, task);
   366	    taskSpec = resolveTaskSpecForExecution(
   367	      projectCwd,
   368	      execCwd,
   369	      preparedSpec.taskDirRelative,
   370	      reportDirName,
   371	    );
   372	  }
   373	
   374	  statusLine.start('Running...');
   375	  let taskSuccess: boolean;
   376	  try {
   377	    taskSuccess = await executeTask({
   378	      task: taskSpec?.taskPrompt ?? task,
   379	      ...(taskSpec === undefined ? {} : { taskSpec }),
   380	      ...(taskSpec === undefined ? {} : { reportDirName: taskSpec.runSlug }),
   381	      cwd: execCwd,
   382	      workflowIdentifier: workflow,
   383	      projectCwd,
   384	      agentOverrides,
   385	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   386	      ...(context.prContext ? { prContext: context.prContext } : {}),
   387	    });
   388	  } finally {
   389	    statusLine.stop();
   390	    if (preparedSpecTaskDir !== undefined) {
   391	      cleanupPreparedTaskSpec(preparedSpecTaskDir);
   392	    }
   393	  }
   394	
   395	  if (!taskSuccess) {
   396	    error(`Workflow '${safeWorkflow}' failed`);
   397	    return false;
   398	  }
   399	  success(`Workflow '${safeWorkflow}' completed`);
   400	  return true;
   401	}
