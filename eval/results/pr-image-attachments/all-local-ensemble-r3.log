   124	    const created = await saveTaskFromInteractive(saveCwd, taskContent, saveOptions?.workflow, {
   125	      issue: saveOptions?.issue,
   126	      confirmAtEndMessage: options?.confirmAtEndMessage,
   127	      ...(options?.attachments ? { attachments: options.attachments } : {}),
   128	    });
   129	    if (created === undefined) {
   130	      throw new IssueEnqueueCancelledError();
   131	    }
   132	    return created;
   133	  };
   134	  const result = await createIssueAndEnqueueTask({
   135	    cwd,
   136	    task,
   137	    workflow: workflow ?? DEFAULT_WORKFLOW_NAME,
   138	    worktree: true,
   139	    autoPr: false,
   140	    labels: options?.labels,
   141	    gitProvider,
   142	    issueOutputMode: 'terminal',
   143	  }, {
   144	    saveTaskFile: saveInteractiveTask,
   145	    createIssueFromTaskResult,
   146	  });
   147	  if (!result.success) {
   148	    if (result.failure.stage !== 'issue_creation') {
   149	      error(formatIssueEnqueueFailure(result.failure, getErrorMessage));
   150	    }
   151	    return;
   152	  }
   153	}
