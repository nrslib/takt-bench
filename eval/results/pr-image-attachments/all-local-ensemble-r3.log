    20	export function validateImageAttachmentFileName(fileName: string): void {
    21	  assertNonEmptyString(fileName, 'Image attachment fileName');
    22	  if (fileName.includes('/') || fileName.includes('\\')) {
    23	    throw new Error(`Image attachment fileName must not contain path separators: ${fileName}`);
    24	  }
    25	
    26	  const extension = path.extname(fileName).toLowerCase();
    27	  if (!SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS.has(extension)) {
    28	    throw new Error(`Unsupported image attachment file extension: ${fileName}`);
    29	  }
    30	}
