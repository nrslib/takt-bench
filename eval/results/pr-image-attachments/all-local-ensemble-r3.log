   316	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   317	    return attachPipelinePrContext(
   318	      options.prNumber,
   319	      prBaseBranch,
   320	      {
   321	        execCwd: cwd,
   322	        branch: prBranch,
   323	        baseBranch,
   324	        isWorktree: false,
   325	      },
