   175	function resolveSkipGitExecutionContext(
   176	  cwd: string,
   177	  prBranch: string | undefined,
   178	  prBaseBranch: string | undefined,
   179	): SkipGitExecutionContext {
   180	  if (prBranch) {
   181	    const baseBranch = prBaseBranch ?? resolveReadOnlyBaseBranch(cwd);
   182	    return {
   183	      execCwd: cwd,
   184	      isWorktree: false,
   185	      branch: prBranch,
   186	      baseBranch,
   187	    };
   188	  }
   189	  const branch = tryResolveCurrentBranch(cwd);
   190	  const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   191	  return {
   192	    execCwd: cwd,
   193	    isWorktree: false,
   194	    branch,
   195	    baseBranch,
   196	  };
   197	}
