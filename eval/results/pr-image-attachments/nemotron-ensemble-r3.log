   348	
   349	export async function runWorkflow(
   350	  projectCwd: string,
   351	  workflow: string,
   352	  task: string,
   353	  execCwd: string,
   354	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   355	  context: ExecutionContext,
   356	): Promise<boolean> {
   357	  const safeWorkflow = sanitizeTerminalText(workflow);
   358	  info(`Running workflow: ${safeWorkflow}`);
   359	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   360	    ? {
   361	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   362	        ...(options.model !== undefined ? { model: options.model } : {}),
   363	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   364	      }
   365	    : undefined;
   366	
   367	  statusLine.start('Running...');
   368	  let taskSuccess: boolean;
   369	  try {
   370	    taskSuccess = await executeTask({
   371	      task,
   372	      cwd: execCwd,
   373	      workflowIdentifier: workflow,
   374	      projectCwd,
   375	      agentOverrides,
   376	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   377	      ...(context.prContext ? { prContext: context.prContext } : {}),
   378	    });
   379	  } finally {
   380	    statusLine.stop();
   381	  }
   382	
   383	  if (!taskSuccess) {
   384	    error(`Workflow '${safeWorkflow}' failed`);
   385	    return false;
   386	  }
   387	  success(`Workflow '${safeWorkflow}' completed`);
   388	  return true;
   389	}
   390	
   390	
   391	function buildPipelineTraceTaskContext(
   392	  options: Pick<PipelineExecutionOptions, 'issueNumber' | 'prNumber'>,
   393	  context: ExecutionContext,
   394	): PipelineTraceTaskContext {
   395	  return {
   396	    issueNumber: options.issueNumber,
   397	    prNumber: options.prNumber,
   398	    branch: context.branch,
   399	    baseBranch: context.baseBranch,
   400	    taskSlug: context.isWorktree ? context.taskSlug : undefined,
   401	    worktreePath: context.isWorktree ? context.execCwd : undefined,
   402	  };
   403	}
   404	
   405	export async function commitAndPush(
   406	  execCwd: string,
   407	  projectCwd: string,
   408	  branch: string,
   409	  commitMessage: string,
   410	  isWorktree: boolean,
   411	): Promise<boolean> {
   412	  const safeBranch = sanitizeTerminalText(branch);
   413	  info('Committing changes...');
   414	  try {
   415	    const commitHash = await stageAndCommit(execCwd, commitMessage, {
   416	      allowGitHooks: resolveConfigValue(projectCwd, 'allowGitHooks') ?? false,
   417	      allowGitFilters: resolveConfigValue(projectCwd, 'allowGitFilters') ?? false,
   418	    });
   419	    if (commitHash) {
   420	      success(`Changes committed: ${commitHash}`);
   421	    } else {
   422	      info('No changes to commit');
   423	    }
   424	
   425	    if (isWorktree) {
   426	      execFileSync('git', ['push', projectCwd, 'HEAD'], { cwd: execCwd, stdio: 'pipe' });
   427	    }
   428	
   429	    info(`Pushing to origin/${safeBranch}...`);
   430	    pushBranch(projectCwd, branch);
   431	    success(`Pushed to origin/${safeBranch}`);
   432	    return true;
   433	  } catch (err) {
   434	    error(`Git operation failed: ${getErrorMessage(err)}`);
   435	    return false;
   436	  }
   437	}
