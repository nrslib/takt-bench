    18	export function validateAndDownloadImage(url: string, options: { auth: boolean } = { auth: false }): Buffer {
    19	  // Validate URL is a GitHub or GitLab attachment URL
    20	  if (!url.startsWith(GITHUB_ATTACHMENT_URL_PREFIX) && !url.startsWith(GITLAB_ATTACHMENT_URL_PREFIX)) {
    21	    throw new Error('Only GitHub or GitLab attachment URLs are allowed');
    22	  }
    23	
    24	  try {
    25	    // If authentication is requested, use gh api to check the URL
    26	    if (options.auth) {
    27	      const response = execFileSync(
    28	        'gh',
    29	        ['api', '--method', 'GET', '-H', 'Accept: application/vnd.github.v3+json', url],
    30	        { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
    31	      );
    32	      
    33	      const metadata = JSON.parse(response);
    34	      
    35	      // Check content type
    36	      if (!metadata['content-type'] || !SUPPORTED_IMAGE_TYPES.includes(metadata['content-type'])) {
    37	        throw new Error(`Unsupported image type: ${metadata['content-type']}`);
    38	      }
    39	      
    40	      // Check size
    41	      if (metadata.size && metadata.size > MAX_IMAGE_SIZE_BYTES) {
    42	        throw new Error('Image size exceeds limit');
    43	      }
    44	    }
    45	    
    46	    // Download the image using gh api
    47	    const imageBuffer = execFileSync(
    48	      'gh',
    49	      ['api', '--method', 'GET', '-H', 'Accept: application/octet-stream', url],
    50	      { encoding: null } // This ensures we get a Buffer
    51	    );
    52	    
    53	    return imageBuffer;
    54	  } catch (err) {
    55	    const errorMessage = getErrorMessage(err);
    56	    log.error('Failed to validate and download image', { url, error: errorMessage });
    57	    throw new Error(`Failed to download image: ${errorMessage}`);
    58	  }
