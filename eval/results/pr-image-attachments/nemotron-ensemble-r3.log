   104	
   105	function normalizeTaskAttachmentReferences(
   106	  taskContent: string,
   107	  attachments: readonly TaskAttachment[],
   108	): string {
   109	  return attachments.reduce((content, attachment) => {
   110	    const relativePath = getTaskAttachmentRelativePath(attachment);
   111	    const pathVariants = new Set([
   112	      attachment.tempPath,
   113	      attachment.tempPath.replace(/\\/g, '/'),
   114	    ]);
   115	    let normalized = content;
   116	    for (const tempPath of pathVariants) {
   117	      normalized = normalized
   118	        .split(`\`${tempPath}\``).join(`\`${relativePath}\``)
   119	        .split(tempPath).join(`\`${relativePath}\``);
   120	    }
   121	    return normalized;
   122	  }, taskContent);
   123	}
