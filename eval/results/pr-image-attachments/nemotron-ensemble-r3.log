    29	export async function downloadImageAsAttachment(
    30	  url: string,
    31	  index: number,
    32	  auth: boolean = false
    33	): Promise<TaskAttachment | null> {
    34	  const tempDir = tmpdir();
    35	  const fileExtension = url.split('.').pop() ?? 'png';
    36	  const fileName = `image-${index + 1}-${randomUUID()}.${fileExtension}`;
    37	  const tempPath = path.join(tempDir, fileName);
    38	  
    39	  try {
    40	    const imageBuffer = await validateAndDownloadImage(url, { auth });
    41	    
    42	    // Write to temporary file
    43	    await fs.promises.writeFile(tempPath, imageBuffer);
    44	    
    45	    return {
    46	      placeholder: `[Image #${index + 1}]`,
    47	      tempPath,
    48	      fileName,
    49	    };
    50	  } catch (error) {
    51	    // Clean up temp file if it was created
    52	    try {
    53	      await fs.promises.unlink(tempPath);
    54	    } catch {
    55	      // Ignore unlink errors
    56	    }
    57	    
    58	    // Log warning but continue without this image
    59	    console.warn(`Failed to download image ${url}:`, error);
    60	    return null;
    61	  }
    62	}
