   156	/**
   157	 * add command handler
   158	 *
   159	 * Flow:
   160	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   161	 *   B) 引数なし: Usage表示して終了
   162	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   163	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   164	 */
   165	export async function addTask(
   166	  cwd: string,
   167	  task?: string,
   168	  opts?: { prNumber?: number; workflow?: string },
   169	): Promise<void> {
   170	  const rawTask = task ?? '';
   171	  const trimmedTask = rawTask.trim();
   172	  const prNumber = opts?.prNumber;
   173	
   174	  if (prNumber !== undefined) {
   175	    const provider = getGitProvider();
   176	    const cliStatus = provider.checkCliStatus(cwd);
   177	    if (!cliStatus.available) {
   178	      error(cliStatus.error);
   179	      return;
   180	    }
   181	
   182	     let prReview: PrReviewData;
   183	     try {
   184	       prReview = await withProgress(
   185	         'Fetching PR review comments...',
   186	         (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   187	         async () => provider.fetchPrReviewComments(prNumber, cwd),
   188	       );
   189	     } catch (e) {
   190	       const msg = getErrorMessage(e);
   191	       error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   192	       return;
   193	     }
   194	
   195	     if (prReview.reviews.length === 0 && prReview.comments.length === 0) {
   196	       error(`PR #${prNumber} has no review comments`);
   197	       return;
   198	     }
   199	
   200	      // Extract and download images from PR review data
   201	      let attachments: TaskAttachment[] = [];
   202	      if (prReview.images && prReview.images.length > 0) {
   203	        attachments = await withProgress(
   204	          'Downloading PR images...',
   205	          (_: TaskAttachment[]) => `Downloaded ${prReview.images.length} image(s)`,
   206	          async () => {
   207	            const downloadPromises = prReview.images.map(async (imageUrl, index) => {
   208	              return await downloadImageAsAttachment(imageUrl, index, true);
   209	            });
   210	            const results = await Promise.all(downloadPromises);
   211	            return results.filter((result): result is TaskAttachment => result !== null);
   212	          }
   213	        );
   214	      }
   215	
   216	     const taskContent = formatPrReviewAsTask(prReview);
   217	     const workflow = await determineWorkflow(cwd, opts?.workflow);
   218	     if (workflow === null) {
   219	       info('Cancelled.');
   220	       return;
   221	     }
   222	
   223	     const settings = {
   224	       worktree: true,
   225	       branch: prReview.headRefName,
   226	       baseBranch: prReview.baseRefName,
   227	       autoPr: false,
   228	       shouldPublishBranchToOrigin: true,
   229	     };
   230	     const created = await saveTaskFile(cwd, taskContent, { workflow, ...settings, prNumber, attachments });
   231	     displayTaskCreationResult(created, settings, workflow);
   232	     return;
   233	  }
   234	
   235	  if (!trimmedTask) {
   236	    info('Usage: takt add <task>');
   237	    return;
   238	  }
   239	
   240	  let taskContent: string;
   241	  let issueNumber: number | undefined;
   242	
   243	  if (isIssueReference(trimmedTask)) {
   244	    try {
   245	      const numbers = parseIssueNumbers([trimmedTask]);
   246	      const primaryIssueNumber = numbers[0];
   247	      taskContent = await withProgress(
   248	        'Fetching issue...',
   249	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   250	        async () => resolveIssueTask(trimmedTask, cwd),
   251	      );
   252	      if (numbers.length > 0) {
   253	        issueNumber = numbers[0];
   254	      }
   255	    } catch (e) {
   256	      const msg = getErrorMessage(e);
   257	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   258	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   259	      return;
   260	    }
   261	  } else {
   262	    taskContent = rawTask;
   263	  }
   264	
   265	  const workflow = await determineWorkflow(cwd, opts?.workflow);
   266	  if (workflow === null) {
   267	    info('Cancelled.');
   268	    return;
   269	  }
   270	
   271	  const settings = await promptWorktreeSettings(cwd);
   272	
   273	  const created = await saveTaskFile(cwd, taskContent, {
   274	    workflow,
   275	    issue: issueNumber,
   276	    ...settings,
   277	  });
   278	
   279	  displayTaskCreationResult(created, settings, workflow);
   280	}
