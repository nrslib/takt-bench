   117	export async function createIssueAndSaveTask(
   118	  cwd: string,
   119	  task: string,
   120	  workflow?: string,
   121	  options?: { confirmAtEndMessage?: string; labels?: string[]; attachments?: TaskAttachment[] },
   122	): Promise<void> {
   123	  const gitProvider = getGitProvider();
   124	  const saveInteractiveTask: SaveEnqueuedTaskFile = async (saveCwd, taskContent, saveOptions) => {
   125	    const created = await saveTaskFromInteractive(saveCwd, taskContent, saveOptions?.workflow, {
   126	      issue: saveOptions?.issue,
   127	      confirmAtEndMessage: options?.confirmAtEndMessage,
   128	      ...(options?.attachments ? { attachments: options.attachments } : {}),
   129	    });
   130	    if (created === undefined) {
   131	      throw new IssueEnqueueCancelledError();
   132	    }
   133	    return created;
   134	  };
   135	  const result = await createIssueAndEnqueueTask({
   136	    cwd,
   137	    task,
   138	    workflow: workflow ?? DEFAULT_WORKFLOW_NAME,
   139	    worktree: true,
   140	    autoPr: false,
   141	    labels: options?.labels,
   142	    gitProvider,
   143	    issueOutputMode: 'terminal',
   144	  }, {
   145	    saveTaskFile: saveInteractiveTask,
   146	    createIssueFromTaskResult,
   147	  });
   148	  if (!result.success) {
   149	    if (result.failure.stage !== 'issue_creation') {
   150	      error(formatIssueEnqueueFailure(result.failure, getErrorMessage));
   151	    }
   152	    return;
   153	  }
   154	}
