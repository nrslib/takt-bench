   232	function buildReviewThreadsGraphqlArgs(
   233	  owner: string,
   234	  repo: string,
   235	  prNumber: number,
   236	  endCursor: string | undefined,
   237	): string[] {
   238	  const args = [
   239	    'api',
   240	    'graphql',
   241	    '-f',
   242	    `owner=${owner}`,
   243	    '-f',
   244	    `repo=${repo}`,
   245	    '-F',
   246	    `number=${prNumber}`,
   247	  ];
   248	
   249	  if (endCursor !== undefined) {
   250	    args.push('-f', `endCursor=${endCursor}`);
   251	  }
   252	
   253	  args.push('-f', `query=${REVIEW_THREADS_QUERY}`);
   254	  return args;
   255	}
   256	
   257	function buildReviewThreadCommentsGraphqlArgs(threadId: string, commentsEndCursor: string): string[] {
   258	  return [
   259	    'api',
   260	    'graphql',
   261	    '-f',
   262	    `threadId=${threadId}`,
   263	    '-f',
   264	    `commentsEndCursor=${commentsEndCursor}`,
   265	    '-f',
   266	    `query=${REVIEW_THREAD_COMMENTS_QUERY}`,
   267	  ];
