   229	export function resolveTaskAttachmentManifest(
   230	  taskDir: string,
   231	): TaskAttachmentManifest {
   232	  const attachmentsDir = path.join(taskDir, 'attachments');
   233	  if (!fs.existsSync(attachmentsDir)) {
   234	    return Object.freeze([]);
   235	  }
   236	
   237	  const stats = fs.lstatSync(attachmentsDir);
   238	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   239	    throw new Error(`Task attachments must be a regular directory: ${attachmentsDir}`);
   240	  }
   241	
   242	  return readAttachmentTreeManifest(attachmentsDir, 'attachments').entries;
   243	}
