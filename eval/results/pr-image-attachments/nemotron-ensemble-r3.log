   485	export function createPullRequest(options: CreatePrOptions, cwd: string): CreatePrResult {
   486	  const ghStatus = checkGhCli(cwd);
   487	  if (!ghStatus.available) {
   488	    return { success: false, error: ghStatus.error };
   489	  }
   490	
   491	  const args = [
   492	    'pr', 'create',
   493	    '--title', options.title,
   494	    '--body', options.body,
   495	    '--head', options.branch,
   496	  ];
   497	
   498	  if (options.base) {
   499	    args.push('--base', options.base);
   500	  }
   500	  }
   501	
   502	  if (options.repo) {
   503	    args.push('--repo', options.repo);
   504	  }
   505	
   506	  if (options.draft) {
   507	    args.push('--draft');
   508	  }
   509	
   510	  for (const label of options.labels ?? []) {
   511	    args.push('--label', label);
   512	  }
   513	
   514	  log.info('Creating PR', { branch: options.branch, title: options.title, draft: options.draft });
   515	
   516	  try {
   517	    const output = execFileSync('gh', args, {
   518	      cwd,
   519	      encoding: 'utf-8',
   520	      stdio: ['pipe', 'pipe', 'pipe'],
   521	    });
   522	
   523	    const url = output.trim();
   524	    log.info('PR created', { url });
   525	
   526	    return { success: true, url };
   527	  } catch (err) {
   528	    const errorMessage = getErrorMessage(err);
   529	    log.error('PR creation failed', { error: errorMessage });
   530	    return { success: false, error: errorMessage };
   531	  }
