   159	function copyAttachmentEntry(sourcePath: string, destinationPath: string): void {
   160	  const stats = fs.lstatSync(sourcePath);
   161	  if (stats.isSymbolicLink()) {
   162	    throw new Error(`Task attachments must not contain symlinks: ${sourcePath}`);
   163	  }
   164	  if (stats.isDirectory()) {
   165	    fs.mkdirSync(destinationPath, { recursive: true });
   166	    for (const entry of fs.readdirSync(sourcePath)) {
   167	      copyAttachmentEntry(path.join(sourcePath, entry), path.join(destinationPath, entry));
   168	    }
   169	    return;
   170	  }
   171	  if (!stats.isFile()) {
   172	    throw new Error(`Task attachments must be regular files or directories: ${sourcePath}`);
   173	  }
   174	  fs.mkdirSync(path.dirname(destinationPath), { recursive: true });
   175	  fs.copyFileSync(sourcePath, destinationPath);
   176	}
