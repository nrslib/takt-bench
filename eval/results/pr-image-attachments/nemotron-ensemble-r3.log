   146	        workflow: workflowIdentifier,
   147	        ...(preparedSpec ? { task_dir: preparedSpec.taskDirRelative } : {}),
   148	      });
   149	    } catch (error) {
   150	      cleanupTransientTaskSpecs(preparedSpec?.taskDir);
   151	      throw error;
   152	    }
   153	  }
