    74	/**
    75	 * Create a GitLab Merge Request via `glab mr create`.
    76	 */
    77	export function createMergeRequest(options: CreatePrOptions, cwd: string): CreatePrResult {
    78	  if (options.repo) {
    79	    throw new Error('--repo is not supported with GitLab provider. Use cwd context instead.');
    80	  }
    81	
    82	  const glabStatus = checkGlabCli(cwd);
    83	  if (!glabStatus.available) {
    84	    return { success: false, error: glabStatus.error };
    85	  }
    86	
    87	  const args = [
    88	    'mr', 'create',
    89	    '--title', options.title,
    90	    '--description', options.body,
    91	    '--source-branch', options.branch,
    92	  ];
    93	
    94	  if (options.base) {
    95	    args.push('--target-branch', options.base);
    96	  }
    97	
    98	  if (options.draft) {
    99	    args.push('--draft');
   100	  }
   101	
   102	  for (const label of options.labels ?? []) {
   103	    args.push('--label', label);
   104	  }
   105	
   106	  log.info('Creating MR', { branch: options.branch, title: options.title, draft: options.draft });
   107	
   108	  try {
   109	    const output = execFileSync('glab', args, {
   110	      cwd,
   111	      encoding: 'utf-8',
   112	      stdio: ['pipe', 'pipe', 'pipe'],
   113	    });
   114	
   115	    const url = output.trim();
   116	    log.info('MR created', { url });
   117	
   118	    return { success: true, url };
   119	  } catch (err) {
   120	    const errorMessage = getErrorMessage(err);
   121	    log.error('MR creation failed', { error: errorMessage });
   122	    return { success: false, error: errorMessage };
   123	  }
   124	}
