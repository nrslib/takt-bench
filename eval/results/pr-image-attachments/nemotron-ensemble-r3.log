   216	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   217	  const { cwd } = options;
   218	  if (options.prNumber) {
   219	    info(`Fetching PR #${options.prNumber} review comments...`);
   220	    const prReview = fetchVcsResource(
   221	      `PR #${options.prNumber}`,
   222	      cwd,
   223	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   224	    );
   225	    if (!prReview) return undefined;
   226	    
   227	    // Extract and download images from PR review data
   228	    let attachments: TaskAttachment[] = [];
   229	    if (prReview.images && prReview.images.length > 0) {
   230	      const downloadPromises = prReview.images.map(async (imageUrl, index) => {
   231	        return await downloadImageAsAttachment(imageUrl, index, true);
   232	      });
   233	      const results = await Promise.all(downloadPromises);
   234	      attachments = results.filter((attachment): attachment is TaskAttachment => attachment !== null);
   235	    }
   236	
   237	    const task = formatPrReviewAsTask(prReview);
   238	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   239	    return {
   240	      task,
   241	      prBranch: prReview.headRefName,
   242	      prBaseBranch: prReview.baseRefName,
   243	      attachments,
   244	    };
   245	  }
   246	  if (options.issueNumber) {
   247	    info(`Fetching issue #${options.issueNumber}...`);
   248	    const issue = fetchVcsResource(
   249	      `issue #${options.issueNumber}`,
   250	      cwd,
   251	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   252	    );
   253	    if (!issue) return undefined;
   254	    const task = formatIssueAsTask(issue);
   255	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   256	    return { task, issue };
   257	  }
   258	  if (options.task) {
   259	    return { task: options.task };
   260	  }
   261	  error('Either --issue, --pr, or --task must be specified');
   262	  return undefined;
   263	}
   264	
   265	export async function resolveExecutionContext(
   266	  cwd: string,
   267	  task: string,
   268	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   269	  pipelineConfig: PipelineConfig | undefined,
   270	  prBranch?: string,
   271	  prBaseBranch?: string,
   272	): Promise<ExecutionContext> {
   273	  if (options.prNumber !== undefined) {
   274	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   275	  }
   276	  if (options.createWorktree) {
   277	    const result = await confirmAndCreateWorktree(
   278	      cwd,
   279	      task,
   280	      options.createWorktree,
   281	      prBranch,
   282	      prBaseBranch,
   283	      options.prNumber !== undefined,
   284	    );
   285	    const branch = requireBranch(result.branch, 'worktree execution');
   286	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   287	    if (result.isWorktree) {
   288	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   289	    }
   290	    if (
   291	      options.prNumber !== undefined
   292	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   293	    ) {
   294	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   295	    }
   296	    return attachPipelinePrContext(
   297	      options.prNumber,
   298	      prBaseBranch,
   299	      {
   300	        execCwd: result.execCwd,
   300	        execCwd: result.execCwd,
   301	        branch,
   302	        baseBranch,
   303	        isWorktree: result.isWorktree,
   304	        taskSlug: result.taskSlug,
   305	      },
   306	      {
   307	        baseRef: result.pullRequestBaseRef,
   308	        headRef: result.pullRequestHeadRef,
   309	      },
   310	    );
   311	  }
   312	  if (options.skipGit) {
   313	    return attachPipelinePrContext(
   314	      options.prNumber,
   315	      prBaseBranch,
   316	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   317	    );
   318	  }
   319	  if (prBranch) {
   320	    const safePrBranch = sanitizeTerminalText(prBranch);
   321	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   322	    checkoutBranch(cwd, prBranch);
   323	    success(`Checked out PR branch: ${safePrBranch}`);
   324	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   325	    return attachPipelinePrContext(
   326	      options.prNumber,
   327	      prBaseBranch,
   328	      {
   329	        execCwd: cwd,
   330	        branch: prBranch,
   331	        baseBranch,
   332	        isWorktree: false,
   333	      },
   334	      {
   335	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   336	        headRef: toLocalBranchRef(prBranch),
   337	      },
   338	    );
   339	  }
   340	  const baseBranch = resolveExecutionBaseBranch(cwd);
   341	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   342	  const safeBranch = sanitizeTerminalText(branch);
   343	  info(`Creating branch: ${safeBranch}`);
   344	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   345	  success(`Branch created: ${safeBranch}`);
   346	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   347	}
   348	
   349	export async function runWorkflow(
   350	  projectCwd: string,
   351	  workflow: string,
   352	  task: string,
   353	  execCwd: string,
   354	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   355	  context: ExecutionContext,
   356	): Promise<boolean> {
   357	  const safeWorkflow = sanitizeTerminalText(workflow);
   358	  info(`Running workflow: ${safeWorkflow}`);
   359	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   360	    ? {
   361	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   362	        ...(options.model !== undefined ? { model: options.model } : {}),
   363	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   364	      }
   365	    : undefined;
   366	
   367	  statusLine.start('Running...');
   368	  let taskSuccess: boolean;
   369	  try {
   370	    taskSuccess = await executeTask({
   371	      task,
   372	      cwd: execCwd,
   373	      workflowIdentifier: workflow,
   374	      projectCwd,
   375	      agentOverrides,
   376	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   377	      ...(context.prContext ? { prContext: context.prContext } : {}),
   378	    });
   379	  } finally {
   380	    statusLine.stop();
   381	  }
   382	
   383	  if (!taskSuccess) {
   384	    error(`Workflow '${safeWorkflow}' failed`);
   385	    return false;
   386	  }
   387	  success(`Workflow '${safeWorkflow}' completed`);
   388	  return true;
   389	}
   390	
   391	function buildPipelineTraceTaskContext(
   392	  options: Pick<PipelineExecutionOptions, 'issueNumber' | 'prNumber'>,
   393	  context: ExecutionContext,
   394	): PipelineTraceTaskContext {
   395	  return {
   396	    issueNumber: options.issueNumber,
   397	    prNumber: options.prNumber,
   398	    branch: context.branch,
   399	    baseBranch: context.baseBranch,
   400	    taskSlug: context.isWorktree ? context.taskSlug : undefined,
   401	    worktreePath: context.isWorktree ? context.execCwd : undefined,
   402	  };
   403	}
   404	
   405	export async function commitAndPush(
   406	  execCwd: string,
   407	  projectCwd: string,
   408	  branch: string,
   409	  commitMessage: string,
   410	  isWorktree: boolean,
   411	): Promise<boolean> {
   412	  const safeBranch = sanitizeTerminalText(branch);
   413	  info('Committing changes...');
   414	  try {
   415	    const commitHash = await stageAndCommit(execCwd, commitMessage, {
   416	      allowGitHooks: resolveConfigValue(projectCwd, 'allowGitHooks') ?? false,
   417	      allowGitFilters: resolveConfigValue(projectCwd, 'allowGitFilters') ?? false,
   418	    });
   419	    if (commitHash) {
   420	      success(`Changes committed: ${commitHash}`);
   421	    } else {
   422	      info('No changes to commit');
   423	    }
   424	
   425	    if (isWorktree) {
   426	      execFileSync('git', ['push', projectCwd, 'HEAD'], { cwd: execCwd, stdio: 'pipe' });
   427	    }
   428	
   429	    info(`Pushing to origin/${safeBranch}...`);
   430	    pushBranch(projectCwd, branch);
   431	    success(`Pushed to origin/${safeBranch}`);
   432	    return true;
   433	  } catch (err) {
   434	    error(`Git operation failed: ${getErrorMessage(err)}`);
   435	    return false;
   436	  }
   437	}
