    99	function attachPipelinePrContext(
   100	  prNumber: number | undefined,
   101	  prBaseBranch: string | undefined,
   102	  context: ExecutionContext,
   103	  materializedDiffRefs?: { baseRef?: string; headRef?: string },
   104	): ExecutionContext {
   105	  if (prNumber === undefined) {
   106	    return context;
   107	  }
   108	  const branch = requireBranch(context.branch, `PR #${prNumber} execution`);
   109	  const baseBranch = requireBaseBranch(context.baseBranch, `PR #${prNumber} execution`);
   110	  return {
   111	    ...context,
   112	    prContext: createPullRequestContext({
   113	      source: 'pr_review',
   114	      prNumber,
   115	      baseBranch,
   116	      headBranch: branch,
   117	      baseBranchSource: prBaseBranch === undefined
   118	        ? 'default_branch_fallback'
   119	        : 'pull_request',
   120	      ...(materializedDiffRefs?.baseRef && materializedDiffRefs.headRef
   121	        ? {
   122	          baseDiffRef: materializedDiffRefs.baseRef,
   123	          headDiffRef: materializedDiffRefs.headRef,
   124	        }
   125	        : {}),
   126	    }),
   127	  };
   128	}
   129	
   130	function generatePipelineBranchName(pipelineConfig: PipelineConfig | undefined, issueNumber?: number): string {
   131	  const prefix = pipelineConfig?.defaultBranchPrefix ?? 'takt/';
   132	  const timestamp = Math.floor(Date.now() / 1000);
   133	  return issueNumber
   134	    ? `${prefix}issue-${issueNumber}-${timestamp}`
   135	    : `${prefix}pipeline-${timestamp}`;
   136	}
