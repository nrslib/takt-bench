   308	function resolveReviewThreadCommentAuthor(comment: GhGraphqlReviewThreadComment): string {
   309	  if (comment.author) {
   310	    return comment.author.login;
   311	  }
   312	  return DELETED_GITHUB_USER_AUTHOR;
   313	}
