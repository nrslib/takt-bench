    65	function requireBaseBranch(baseBranch: string | undefined, context: string): string {
    66	  if (!baseBranch) {
    67	    throw new Error(`Base branch is required (${context})`);
    68	  }
    69	  return baseBranch;
    70	}
    71	
    72	function requireBranch(branch: string | undefined, context: string): string {
    73	  if (!branch) {
    74	    throw new Error(`Branch is required (${context})`);
    75	  }
    76	  return branch;
    77	}
    78	
    79	function validatePrBranches(
    80	  prNumber: number,
    81	  prBranch: string | undefined,
    82	  prBaseBranch: string | undefined,
    83	): void {
    84	  if (prBranch === undefined) {
    85	    throw new Error(`PR #${prNumber} head branch is required.`);
    86	  }
    87	  assertValidLocalBranchName(prBranch, {
    88	    branchLabel: `PR #${prNumber} head branch`,
    89	    invalidBranchLabel: `Invalid PR #${prNumber} head branch`,
    90	  });
    91	  if (prBaseBranch !== undefined) {
    92	    assertValidLocalBranchName(prBaseBranch, {
    93	      branchLabel: `PR #${prNumber} base branch`,
    94	      invalidBranchLabel: `Invalid PR #${prNumber} base branch`,
    95	    });
    96	  }
    97	}
