   298	function resolveThreadState(thread: GhGraphqlReviewThread): PrReviewThreadState {
   299	  if (thread.isResolved) {
   300	    return 'resolved';
   301	  }
   302	  if (thread.isOutdated) {
   303	    return 'outdated-unresolved';
   304	  }
   305	  return 'active';
   306	}
