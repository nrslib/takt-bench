   269	
   270	function parseReviewThreadsResponse(raw: string): GhGraphqlReviewThreadsConnection {
   271	  const parsed = JSON.parse(raw) as GhGraphqlReviewThreadsResponse;
   272	  if (parsed.errors && parsed.errors.length > 0) {
   273	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   274	  }
   275	
   276	  const pullRequest = parsed.data?.repository?.pullRequest;
   277	  if (!pullRequest) {
   278	    throw new Error('Missing pull request reviewThreads in GraphQL response');
   279	  }
   280	
   281	  return pullRequest.reviewThreads;
   282	}
   283	
   284	function parseReviewThreadCommentsResponse(raw: string): GhGraphqlReviewThreadCommentsConnection {
   285	  const parsed = JSON.parse(raw) as GhGraphqlReviewThreadCommentsResponse;
   286	  if (parsed.errors && parsed.errors.length > 0) {
   287	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   288	  }
   289	
   290	  const thread = parsed.data?.node;
   291	  if (!thread?.comments) {
   292	    throw new Error('Missing pull request review thread comments in GraphQL response');
   293	  }
   294	
   295	  return thread.comments;
   296	}
