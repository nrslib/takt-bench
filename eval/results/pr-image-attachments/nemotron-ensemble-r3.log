    37	    const output = execFileSync(
    38	      'gh', ['pr', 'list', '--head', branch, '--state', 'open', '--json', 'number,url', '--limit', '1'],
    39	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
    40	    );
    41	    const prs = JSON.parse(output) as ExistingPr[];
    42	    return prs[0];
    43	  } catch (e) {
    44	    log.debug('gh pr list failed, treating as no PR', { error: getErrorMessage(e) });
    45	    return undefined;
    46	  }
    47	}
