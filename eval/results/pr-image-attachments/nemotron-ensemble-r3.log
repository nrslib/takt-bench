   216	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   217	  const { cwd } = options;
   218	  if (options.prNumber) {
   219	    info(`Fetching PR #${options.prNumber} review comments...`);
   220	    const prReview = fetchVcsResource(
   221	      `PR #${options.prNumber}`,
   222	      cwd,
   223	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   224	    );
   225	    if (!prReview) return undefined;
   226	    
   227	    // Extract and download images from PR review data
   228	    let attachments: TaskAttachment[] = [];
   229	    if (prReview.images && prReview.images.length > 0) {
   230	      const downloadPromises = prReview.images.map(async (imageUrl, index) => {
   231	        return await downloadImageAsAttachment(imageUrl, index, true);
   232	      });
   233	      const results = await Promise.all(downloadPromises);
   234	      attachments = results.filter((attachment): attachment is TaskAttachment => attachment !== null);
   235	    }
   236	
   237	    const task = formatPrReviewAsTask(prReview);
   238	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   239	    return {
   240	      task,
   241	      prBranch: prReview.headRefName,
   242	      prBaseBranch: prReview.baseRefName,
   243	      attachments,
   244	    };
   245	  }
   246	  if (options.issueNumber) {
   247	    info(`Fetching issue #${options.issueNumber}...`);
   248	    const issue = fetchVcsResource(
   249	      `issue #${options.issueNumber}`,
   250	      cwd,
   251	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   252	    );
   253	    if (!issue) return undefined;
   254	    const task = formatIssueAsTask(issue);
   255	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   256	    return { task, issue };
   257	  }
   258	  if (options.task) {
   259	    return { task: options.task };
   260	  }
   261	  error('Either --issue, --pr, or --task must be specified');
   262	  return undefined;
   263	}
