   178	interface AttachmentTreeManifest {
   179	  readonly root: TaskAttachmentManifestEntry;
   180	  readonly entries: readonly TaskAttachmentManifestEntry[];
   181	}
   182	
   183	function hashAttachmentContent(content: string | Buffer): string {
   184	  return createHash('sha256').update(content).digest('hex');
   185	}
   186	
   187	function readAttachmentTreeManifest(
   188	  absolutePath: string,
   189	  relativePath: string,
   190	): AttachmentTreeManifest {
   191	  const stats = fs.lstatSync(absolutePath);
   192	  if (stats.isSymbolicLink()) {
   193	    throw new Error(`Task attachments must not contain symlinks: ${absolutePath}`);
   194	  }
   195	  if (stats.isFile()) {
   196	    const root = Object.freeze({
   197	      relativePath,
   198	      kind: 'file' as const,
   199	      contentSha256: hashAttachmentContent(fs.readFileSync(absolutePath)),
   200	    });
   201	    return Object.freeze({ root, entries: Object.freeze([root]) });
   202	  }
   203	  if (!stats.isDirectory()) {
   204	    throw new Error(`Task attachments must be regular files or directories: ${absolutePath}`);
   205	  }
   206	
   207	  const children = fs.readdirSync(absolutePath)
   208	    .sort()
   209	    .map((entry) => readAttachmentTreeManifest(
   210	      path.join(absolutePath, entry),
   211	      path.posix.join(relativePath, entry),
   212	    ));
   213	  const root = Object.freeze({
   214	    relativePath,
   215	    kind: 'directory' as const,
   216	    contentSha256: hashAttachmentContent(JSON.stringify(
   217	      children.map((child) => child.root),
   218	    )),
   219	  });
   220	  return Object.freeze({
   221	    root,
   222	    entries: Object.freeze([
   223	      root,
   224	      ...children.flatMap((child) => child.entries),
   225	    ]),
   226	  });
   227	}
