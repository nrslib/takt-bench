    16	/**
    17	 * Find an open MR for the given branch.
    18	 * Returns undefined if no MR exists.
    19	 */
    20	export function findExistingMr(branch: string, cwd: string): ExistingPr | undefined {
    21	  const glabStatus = checkGlabCli(cwd);
    22	  if (!glabStatus.available) return undefined;
    23	
    24	  try {
    25	    const output = execFileSync(
    26	      'glab',
    27	      ['mr', 'list', '--source-branch', branch, '--state', 'opened', '--output', 'json'],
    28	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
    29	    );
    30	    const mrs = parseJson<Array<{ iid: number; web_url: string }>>(output, 'mr list');
    31	    const first = mrs[0];
    32	    if (!first) return undefined;
    33	    return { number: first.iid, url: first.web_url };
    34	  } catch (e) {
    35	    log.debug('glab mr list failed, treating as no MR', { error: getErrorMessage(e) });
    36	    return undefined;
    37	  }
    38	}
