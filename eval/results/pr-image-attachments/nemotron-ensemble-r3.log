   180	/**
   181	 * Fetch MR review comments and metadata.
   182	 * Uses `glab mr view` for metadata and `glab api` (paginated) for diffs, notes, and discussions.
   183	 *
   184	 * Throws on failure (MR not found, network error, etc.).
   185	 */
   186	export function fetchMrReviewComments(mrNumber: number, cwd: string): PrReviewData {
   187	  log.debug('Fetching MR review comments', { mrNumber });
   188	
   189	  const rawMr = execFileSync(
   190	    'glab',
   191	    ['mr', 'view', String(mrNumber), '--output', 'json'],
   192	    { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   193	  );
   194	  const mrData = parseJson<GlabMrViewResponse>(rawMr, `mr view #${mrNumber}`);
   195	
   196	  const diffs = fetchAllPages<{ new_path: string }>(
   197	    `projects/:id/merge_requests/${mrNumber}/diffs`,
   198	    ITEMS_PER_PAGE,
   199	    `mr #${mrNumber} diffs`,
   200	    cwd,
   201	  );
   202	  const files = diffs.map(d => d.new_path);
   203	
   204	  const allNotes = fetchAllPages<GlabNote>(
   205	    `projects/:id/merge_requests/${mrNumber}/notes`,
   206	    ITEMS_PER_PAGE,
   207	    `mr #${mrNumber} notes`,
   208	    cwd,
   209	  );
   210	
   211	  const comments: PrReviewComment[] = [];
   212	  for (const note of allNotes) {
   213	    if (!note.system && !note.position) {
   214	      comments.push({ author: note.author.username, body: note.body });
   215	    }
   216	  }
   217	
   218	  const allDiscussions = fetchAllPages<GlabDiscussion>(
   219	    `projects/:id/merge_requests/${mrNumber}/discussions`,
   220	    ITEMS_PER_PAGE,
   221	    `mr #${mrNumber} discussions`,
   222	    cwd,
   223	  );
   224	
   225	  const reviews: PrReviewComment[] = [];
   226	  for (const discussion of allDiscussions) {
   227	    for (const note of discussion.notes) {
   228	      if (note.position) {
   229	        reviews.push({
   230	          author: note.author.username,
   231	          body: note.body,
   232	          path: note.position.new_path,
   233	          line: note.position.new_line,
   234	        });
   235	      }
   236	    }
   237	  }
   238	
   239	  // Extract images from MR description, notes, and discussions
   240	  const imageUrls: string[] = [];
   241	  
   242	  // Extract from MR description
   243	  imageUrls.push(...extractImageUrls(mrData.description ?? ''));
   244	  
   245	  // Extract from notes
   246	  for (const note of allNotes) {
   247	    imageUrls.push(...extractImageUrls(note.body));
   248	  }
   249	  
   250	  // Extract from discussions
   251	  for (const discussion of allDiscussions) {
   252	    for (const note of discussion.notes) {
   253	      imageUrls.push(...extractImageUrls(note.body));
   254	    }
   255	  }
   256	
   257	  return {
   258	    number: mrData.iid,
   259	    title: mrData.title,
   260	    body: mrData.description ?? '',
   261	    url: mrData.web_url,
   262	    headRefName: mrData.source_branch,
   263	    baseRefName: mrData.target_branch,
   264	    comments,
   265	    reviews,
   266	    files,
   267	    images: [...new Set(imageUrls)], // Remove duplicates while preserving order
   268	  };
   269	}
