    64	    base_branch: mr.target_branch,
    65	    head_branch: mr.source_branch,
    66	    managed_by_takt: isTaktManagedPrBody(mr.description),
    67	    labels: mr.labels,
    68	    same_repository: mr.source_project_id === mr.target_project_id,
    69	    draft: mr.draft,
