   315	function fetchReviewThreadComments(
   316	  thread: GhGraphqlReviewThread,
   317	  prNumber: number,
   318	  cwd: string,
   319	): GhGraphqlReviewThreadComment[] {
   320	  const comments = [...thread.comments.nodes];
   321	  let pageInfo = thread.comments.pageInfo;
   322	
   323	  for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP && pageInfo.hasNextPage; page += 1) {
   324	    if (!pageInfo.endCursor) {
   325	      throw new Error(`Missing review thread comments endCursor for next page in pull request #${prNumber}`);
   326	    }
   327	
   328	    const raw = execFileSync(
   329	      'gh',
   330	      buildReviewThreadCommentsGraphqlArgs(thread.id, pageInfo.endCursor),
   331	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   332	    );
   333	    const nextComments = parseReviewThreadCommentsResponse(raw);
   334	    comments.push(...nextComments.nodes);
   335	    pageInfo = nextComments.pageInfo;
   336	  }
   337	
   338	  if (pageInfo.hasNextPage) {
   339	    throw new Error(
   340	      `Pagination limit exceeded while fetching pull request #${prNumber} review thread comments (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   341	    );
   342	  }
   343	
   344	  return comments;
   345	}
   346	
   347	function mapReviewThreadComments(
   348	  thread: GhGraphqlReviewThread,
   349	  comments: GhGraphqlReviewThreadComment[],
   350	): PrReviewComment[] {
   351	  const threadState = resolveThreadState(thread);
   352	  return comments.map((comment) => {
   353	    const line = comment.line ?? comment.originalLine ?? undefined;
   354	    return {
   355	      author: resolveReviewThreadCommentAuthor(comment),
   356	      body: comment.body,
   357	      path: comment.path,
   358	      ...(line !== undefined ? { line } : {}),
   359	      url: comment.url,
   360	      threadState,
   361	      ...(thread.resolvedBy ? { resolvedBy: thread.resolvedBy.login } : {}),
   362	      isOutdated: thread.isOutdated,
   363	    };
   364	  });
   365	}
   366	
   367	function fetchPrReviewThreads(owner: string, repo: string, prNumber: number, cwd: string): PrReviewComment[] {
   368	  try {
   369	    const comments: PrReviewComment[] = [];
   370	    let endCursor: string | undefined;
   371	
   372	    for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP; page += 1) {
   373	      const raw = execFileSync(
   374	        'gh',
   375	        buildReviewThreadsGraphqlArgs(owner, repo, prNumber, endCursor),
   376	        { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   377	      );
   378	      const reviewThreads = parseReviewThreadsResponse(raw);
   379	
   380	      for (const thread of reviewThreads.nodes) {
   381	        const threadComments = fetchReviewThreadComments(thread, prNumber, cwd);
   382	        comments.push(...mapReviewThreadComments(thread, threadComments));
   383	      }
   384	
   385	      if (!reviewThreads.pageInfo.hasNextPage) {
   386	        return comments;
   387	      }
   388	      if (!reviewThreads.pageInfo.endCursor) {
   389	        throw new Error('Missing reviewThreads endCursor for next page');
   390	      }
   391	      endCursor = reviewThreads.pageInfo.endCursor;
   392	    }
   393	
   394	    throw new Error(
   395	      `Pagination limit exceeded while fetching pull request #${prNumber} review threads (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   396	    );
   397	  } catch (err) {
   398	    throw new Error(`GraphQL reviewThreads failed: ${getErrorMessage(err)}`);
   399	  }
   400	}
