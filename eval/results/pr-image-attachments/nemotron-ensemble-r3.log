   197	function fetchVcsResource<T>(
   198	  label: string,
   199	  cwd: string,
   200	  fetch: (provider: ReturnType<typeof getGitProvider>) => T,
   201	): T | undefined {
   202	  const gitProvider = getGitProvider();
   203	  const cliStatus = gitProvider.checkCliStatus(cwd);
   204	  if (!cliStatus.available) {
   205	    error(cliStatus.error);
   206	    return undefined;
   207	  }
   208	  try {
   209	    return fetch(gitProvider);
   210	  } catch (err) {
   211	    error(`Failed to fetch ${label}: ${getErrorMessage(err)}`);
   212	    return undefined;
   213	  }
   214	}
