   138	export function buildCommitMessage(
   139	  pipelineConfig: PipelineConfig | undefined,
   140	  issue: Issue | undefined,
   141	  taskText: string | undefined,
   142	): string {
   143	  const template = pipelineConfig?.commitMessageTemplate;
   144	  if (template && issue) {
   145	    return expandPipelineTemplate(template, {
   146	      title: issue.title,
   147	      issue: String(issue.number),
   148	    });
   149	  }
   150	  return issue
   151	    ? `feat: ${issue.title} (#${issue.number})`
   152	    : `takt: ${taskText ?? 'pipeline task'}`;
   153	}
   154	
   155	function resolveExecutionBaseBranch(cwd: string, preferredBaseBranch?: string): string {
   156	  const { branch } = resolveBaseBranch(cwd, preferredBaseBranch);
   157	  return requireBaseBranch(branch, 'execution context');
   158	}
   159	
   160	function resolveReadOnlyBaseBranch(cwd: string): string {
   161	  return requireBaseBranch(resolveBaseBranchName(cwd), 'skip-git execution');
   162	}
   163	
   164	function tryResolveCurrentBranch(cwd: string): string | undefined {
   165	  try {
   166	    const branch = getCurrentBranch(cwd);
   167	    return branch || undefined;
   168	  } catch {
   169	    return undefined;
   170	  }
   171	}
   172	
   173	function resolveSkipGitExecutionContext(
   174	  cwd: string,
   175	  prBranch: string | undefined,
   176	  prBaseBranch: string | undefined,
   177	): SkipGitExecutionContext {
   178	  if (prBranch) {
   179	    const baseBranch = prBaseBranch ?? resolveReadOnlyBaseBranch(cwd);
   180	    return {
   181	      execCwd: cwd,
   182	      isWorktree: false,
   183	      branch: prBranch,
   184	      baseBranch,
   185	    };
   186	  }
   187	  const branch = tryResolveCurrentBranch(cwd);
   188	  const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   189	  return {
   190	    execCwd: cwd,
   191	    isWorktree: false,
   192	    branch,
   193	    baseBranch,
   194	  };
   195	}
