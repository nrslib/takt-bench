   418	/**
   419	 * Fetch PR review comments and metadata via `gh pr view`.
   420	 * Throws on failure (PR not found, network error, etc.).
   421	 */
   422	export function fetchPrReviewComments(prNumber: number, cwd: string): PrReviewData {
   423	  log.debug('Fetching PR review comments', { prNumber });
   424	
   425	  const raw = execFileSync(
   426	    'gh',
   427	    ['pr', 'view', String(prNumber), '--json', PR_REVIEW_JSON_FIELDS],
   428	    { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   429	  );
   430	
   431	  const data = JSON.parse(raw) as GhPrViewReviewResponse;
   432	  const { owner, repo } = parseRepositoryFromPrUrl(data.url);
   433	  const threadReviewComments = fetchPrReviewThreads(owner, repo, prNumber, cwd);
   434	
   435	  // Extract images from PR body, comments, and review threads
   436	  const imageUrls: string[] = [];
   437	  
   438	  // Extract from PR body
   439	  imageUrls.push(...extractImageUrls(data.body ?? ''));
   440	  
   441	  // Extract from regular comments
   442	  for (const comment of data.comments) {
   443	    imageUrls.push(...extractImageUrls(comment.body));
   444	  }
   445	  
   446	  // Extract from reviews
   447	  for (const review of data.reviews) {
   448	    if (review.body) {
   449	      imageUrls.push(...extractImageUrls(review.body));
   450	    }
   451	  }
   452	  
   453	  // Extract from review thread comments
   454	  for (const threadComment of threadReviewComments) {
   455	    imageUrls.push(...extractImageUrls(threadComment.body));
   456	  }
   457	
   458	  const comments: PrReviewComment[] = data.comments.map((c) => ({
   459	    author: c.author.login,
   460	    body: c.body,
   461	  }));
   462	
   463	  const reviews: PrReviewComment[] = [];
   464	  for (const review of data.reviews) {
   465	    if (review.body) {
   466	      reviews.push({ author: review.author.login, body: review.body });
   467	    }
   468	  }
   469	  reviews.push(...threadReviewComments);
   470	
   471	  return {
   472	    number: data.number,
   473	    title: data.title,
   474	    body: data.body,
   475	    url: data.url,
   476	    headRefName: data.headRefName,
   477	    baseRefName: data.baseRefName,
   478	    comments,
   479	    reviews,
   480	    files: data.files.map((f) => f.path),
   481	    images: [...new Set(imageUrls)], // Remove duplicates while preserving order
   482	  };
   483	}
