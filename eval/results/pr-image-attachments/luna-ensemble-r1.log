   272	function parseReviewThreadsResponse(raw: string): GhGraphqlReviewThreadsConnection {
   273	  const parsed = JSON.parse(raw) as GhGraphqlReviewThreadsResponse;
   274	  if (parsed.errors && parsed.errors.length > 0) {
   275	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   276	  }
   277	
   278	  const pullRequest = parsed.data?.repository?.pullRequest;
   279	  if (!pullRequest) {
   280	    throw new Error('Missing pull request reviewThreads in GraphQL response');
   281	  }
   282	
   283	  return pullRequest.reviewThreads;
   284	}
