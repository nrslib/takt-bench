    84	function validatePrBranches(
    85	  prNumber: number,
    86	  prBranch: string | undefined,
    87	  prBaseBranch: string | undefined,
    88	): void {
    89	  if (prBranch === undefined) {
    90	    throw new Error(`PR #${prNumber} head branch is required.`);
    91	  }
    92	  assertValidLocalBranchName(prBranch, {
    93	    branchLabel: `PR #${prNumber} head branch`,
    94	    invalidBranchLabel: `Invalid PR #${prNumber} head branch`,
    95	  });
    96	  if (prBaseBranch !== undefined) {
    97	    assertValidLocalBranchName(prBaseBranch, {
    98	      branchLabel: `PR #${prNumber} base branch`,
    99	      invalidBranchLabel: `Invalid PR #${prNumber} base branch`,
   100	    });
   101	  }
   102	}
