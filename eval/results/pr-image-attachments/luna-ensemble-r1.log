   131	export function parseInlineImageSequence(input: string, start: number): InlineImageSequence {
   132	  if (!input.startsWith(OSC_IMAGE_PREFIX, start)) {
   133	    throw new Error(`Expected OSC 1337 inline image sequence at offset ${start}.`);
   134	  }
   135	
   136	  const payloadStart = start + OSC_IMAGE_PREFIX.length;
   137	  const terminator = findTerminator(input, payloadStart);
   138	  if (!terminator) {
   139	    assertPendingInlineImageWithinLimit(input.slice(start));
   140	    return { status: 'incomplete' };
   141	  }
   142	
   143	  const payload = input.slice(payloadStart, terminator.index);
   144	  const sequenceEnd = terminator.index + terminator.length;
   145	  const separatorIndex = payload.indexOf(':');
   146	  if (separatorIndex === -1) {
   147	    return { status: 'passthrough', sequenceEnd };
   148	  }
   149	
   150	  const params = payload.slice(0, separatorIndex).split(';');
   151	  if (!params.includes('inline=1')) {
   152	    return { status: 'passthrough', sequenceEnd };
   153	  }
   154	
   155	  const encodedData = payload.slice(separatorIndex + 1);
   156	  const imageData = decodeImageData(params, encodedData);
   157	  return {
   158	    status: 'image',
   159	    image: {
   160	      mimeType: resolveInlineImageMimeType(params, imageData),
   161	      data: imageData,
   162	    },
   163	    sequenceEnd,
   164	  };
   165	}
