    69	    throw new Error(`Invalid pasted inline image size: ${sizeParam}`);
    70	  }
    71	  if (declaredSize > MAX_INLINE_IMAGE_BYTES) {
    72	    throw new Error(`Pasted inline image exceeds the ${MAX_INLINE_IMAGE_BYTES} byte limit.`);
    73	  }
    74	
