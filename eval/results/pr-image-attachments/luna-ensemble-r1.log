   125	export function assertPendingInlineImageWithinLimit(pendingInput: string): void {
   126	  if (pendingInput.length > MAX_PENDING_INLINE_IMAGE_CHARS) {
   127	    throw new Error(`Pasted inline image sequence exceeds the ${MAX_PENDING_INLINE_IMAGE_CHARS} character pending limit.`);
   128	  }
   129	}
