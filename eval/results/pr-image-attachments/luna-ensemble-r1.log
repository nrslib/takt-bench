   165	function resolveReadOnlyBaseBranch(cwd: string): string {
   166	  return requireBaseBranch(resolveBaseBranchName(cwd), 'skip-git execution');
   167	}
   168	
   169	function tryResolveCurrentBranch(cwd: string): string | undefined {
   170	  try {
   171	    const branch = getCurrentBranch(cwd);
   172	    return branch || undefined;
   173	  } catch {
   174	    return undefined;
   175	  }
   176	}
