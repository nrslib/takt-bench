   101	  if (!mimeType) {
   102	    throw new Error('Unsupported pasted inline image type. Expected PNG, JPEG, GIF, or WebP data.');
   103	  }
   104	
   105	  const nameMimeType = inferMimeTypeFromName(getParamValue(params, 'name'));
   106	  if (nameMimeType && nameMimeType !== mimeType) {
   107	    throw new Error(`Pasted inline image filename type does not match image data: ${nameMimeType} !== ${mimeType}`);
   108	  }
