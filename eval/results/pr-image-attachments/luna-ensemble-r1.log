   288	  if (parsed.errors && parsed.errors.length > 0) {
   289	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   290	  }
   291	
   292	  const thread = parsed.data?.node;
   293	  if (!thread?.comments) {
