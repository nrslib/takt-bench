    31	const log = createLogger('pipeline');
    32	
    33	interface PipelineOutcome {
    34	  exitCode: number;
    35	  result: PipelineResult;
    36	}
    37	
    38	async function runPipeline(options: PipelineExecutionOptions): Promise<PipelineOutcome> {
    39	  const { cwd, workflow, autoPr, skipGit } = options;
    40	  const pipelineConfig = resolveConfigValues(cwd, ['pipeline']).pipeline;
    41	
    42	  const buildResult = (overrides: Partial<PipelineResult> = {}): PipelineResult => ({
    43	    success: false, workflow, issueNumber: options.issueNumber, ...overrides,
    44	  });
    45	
    46	  const taskContent = await resolveTaskContent(options);
    47	  if (!taskContent) return { exitCode: EXIT_ISSUE_FETCH_FAILED, result: buildResult() };
    48	
    49	  let context: ExecutionContext;
    50	  try {
    51	    context = await resolveExecutionContext(
    52	      cwd,
    53	      taskContent.task,
    54	      options,
    55	      pipelineConfig,
    56	      taskContent.prBranch,
    57	      taskContent.prBaseBranch,
    58	    );
    59	  } catch (err) {
    60	    error(`Failed to prepare execution environment: ${getErrorMessage(err)}`);
    61	    taskContent.imageResource?.cleanup();
    62	    return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult() };
    63	  }
    64	
    65	  let preparedSpec: ReturnType<typeof prepareTaskSpecDirectory> | undefined;
    66	  try {
    67	    if (taskContent.attachments && taskContent.attachments.length > 0) {
    68	      preparedSpec = prepareTaskSpecDirectory(cwd, taskContent.task, taskContent.attachments);
    69	    }
    70	  } catch (err) {
    71	    taskContent.imageResource?.cleanup();
    72	    error(`Failed to prepare task attachments: ${getErrorMessage(err)}`);
    73	    return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult({ branch: context.branch }) };
    74	  }
    75	
    76	  let workflowOk: boolean;
    77	  try {
    78	    let reportDirName: string | undefined;
    79	    let taskSpec: ResolvedTaskSpec | undefined;
    80	    if (preparedSpec) {
    81	      reportDirName = generateExecutionReportDir(context.execCwd, taskContent.task);
    82	      taskSpec = resolveTaskSpecForExecution(
    83	        cwd,
    84	        context.execCwd,
    85	        preparedSpec.taskDirRelative,
    86	        reportDirName,
    87	      );
    88	    }
    89	    log.info('Pipeline workflow execution starting', { workflow, branch: context.branch, skipGit, issueNumber: options.issueNumber });
    90	    workflowOk = await runWorkflow(
    91	      cwd,
    92	      workflow,
    93	      taskContent.task,
    94	      context.execCwd,
    95	      options,
    96	      context,
    97	      taskSpec,
    98	      reportDirName,
    99	    );
   100	  } finally {
   101	    try {
   102	      if (preparedSpec) {
   103	        cleanupPreparedTaskSpec(preparedSpec.taskDir);
   104	      }
   105	    } finally {
   106	      taskContent.imageResource?.cleanup();
   107	    }
   108	  }
   109	  if (!workflowOk) return { exitCode: EXIT_WORKFLOW_FAILED, result: buildResult({ branch: context.branch }) };
   110	
   111	  if (!skipGit && context.branch) {
   112	    const commitMessage = buildCommitMessage(pipelineConfig, taskContent.issue, options.task);
   113	    if (!await commitAndPush(context.execCwd, cwd, context.branch, commitMessage, context.isWorktree)) {
   114	      return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult({ branch: context.branch }) };
   115	    }
   116	  }
   117	
   118	  let prUrl: string | undefined;
   119	  if (autoPr && !skipGit && context.branch) {
   120	    prUrl = submitPullRequest(cwd, context.branch, context.baseBranch, taskContent, workflow, pipelineConfig, options);
   121	    if (!prUrl) return { exitCode: EXIT_PR_CREATION_FAILED, result: buildResult({ branch: context.branch }) };
   122	  } else if (autoPr && skipGit) {
   123	    info('--auto-pr is ignored when --skip-git is specified (no push was performed)');
   124	  }
   125	
   126	  blankLine();
   127	  const safeWorkflow = sanitizeTerminalText(workflow);
   128	  const issueStatus = taskContent.issue
   129	    ? `#${taskContent.issue.number} "${sanitizeTerminalText(taskContent.issue.title)}"`
   130	    : 'N/A';
   131	  const branchStatus = context.branch ? sanitizeTerminalText(context.branch) : '(current)';
   132	  status('Issue', issueStatus);
   133	  status('Branch', branchStatus);
   134	  status('Workflow', safeWorkflow);
   135	  status('Result', 'Success', 'green');
   136	
   137	  return { exitCode: 0, result: buildResult({ success: true, branch: context.branch, prUrl }) };
   138	}
   139	export async function executePipeline(options: PipelineExecutionOptions): Promise<number> {
   140	  const startTime = Date.now();
   141	  const runId = generateRunId();
   142	  let pipelineResult: PipelineResult = { success: false, workflow: options.workflow, issueNumber: options.issueNumber };
   143	
   144	  try {
   145	    const outcome = await runPipeline(options);
   146	    pipelineResult = outcome.result;
   147	    return outcome.exitCode;
   148	  } finally {
   149	    await notifySlack(runId, startTime, pipelineResult);
   150	  }
   151	}
   152	
   153	interface PipelineResult {
   154	  success: boolean;
   155	  workflow: string;
   156	  issueNumber?: number;
   157	  branch?: string;
   158	  prUrl?: string;
   159	}
   160	
   161	async function notifySlack(runId: string, startTime: number, result: PipelineResult): Promise<void> {
   162	  const webhookUrl = getSlackWebhookUrl();
   163	  if (!webhookUrl) return;
   164	
   165	  const durationSec = Math.round((Date.now() - startTime) / 1000);
   166	  const task: SlackTaskDetail = {
   167	    name: 'pipeline',
   168	    success: result.success,
   169	    workflow: result.workflow,
   170	    issueNumber: result.issueNumber,
   171	    durationSec,
   172	    branch: result.branch,
   173	    prUrl: result.prUrl,
   174	  };
   175	  const message = buildSlackRunSummary({
   176	    runId,
   177	    total: 1,
   178	    success: result.success ? 1 : 0,
   179	    failed: result.success ? 0 : 1,
   180	    durationSec,
   181	    concurrency: 1,
   182	    tasks: [task],
   183	  });
   184	
   185	  await sendSlackNotification(webhookUrl, message);
   186	}
