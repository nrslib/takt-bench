   178	function resolveSkipGitExecutionContext(
   179	  cwd: string,
   180	  prBranch: string | undefined,
   181	  prBaseBranch: string | undefined,
   182	): SkipGitExecutionContext {
   183	  if (prBranch) {
   184	    const baseBranch = prBaseBranch ?? resolveReadOnlyBaseBranch(cwd);
   185	    return {
   186	      execCwd: cwd,
   187	      isWorktree: false,
   188	      branch: prBranch,
   189	      baseBranch,
   190	    };
   191	  }
   192	  const branch = tryResolveCurrentBranch(cwd);
   193	  const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   194	  return {
   195	    execCwd: cwd,
   196	    isWorktree: false,
   197	    branch,
   198	    baseBranch,
   199	  };
   200	}
