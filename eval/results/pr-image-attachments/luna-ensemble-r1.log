    35	export function buildTaskOrderContent(
    36	  taskContent: string,
    37	  attachments?: readonly TaskAttachment[],
    38	): string {
    39	  if (!hasAttachments(attachments)) {
    40	    return taskContent;
    41	  }
    42	
    43	  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
    44	  const attachmentLines = attachments.map((attachment) =>
    45	    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
    46	  );
    47	  return [
    48	    normalizedTaskContent.trimEnd(),
    49	    '',
    50	    '## 添付画像',
    51	    '',
    52	    ...attachmentLines,
    53	  ].join('\n');
    54	}
    55	
    56	function getTaskAttachmentRelativePath(attachment: TaskAttachment): string {
    57	  return path.posix.join('attachments', attachment.fileName);
    58	}
    59	
    60	function normalizeTaskAttachmentReferences(
    61	  taskContent: string,
    62	  attachments: readonly TaskAttachment[],
    63	): string {
    64	  return attachments.reduce((content, attachment) => {
    65	    const relativePath = getTaskAttachmentRelativePath(attachment);
    66	    const pathVariants = new Set([
    67	      attachment.tempPath,
    68	      attachment.tempPath.replace(/\\/g, '/'),
    69	    ]);
    70	    let normalized = content;
    71	    for (const tempPath of pathVariants) {
    72	      normalized = normalized
    73	        .split(`\`${tempPath}\``).join(`\`${relativePath}\``)
    74	        .split(tempPath).join(`\`${relativePath}\``);
    75	    }
    76	    return normalized;
    77	  }, taskContent);
    78	}
