   113	function findTerminator(input: string, start: number): { index: number; length: number } | null {
   114	  const belIndex = input.indexOf('\x07', start);
   115	  const stIndex = input.indexOf('\x1B\\', start);
   116	  if (belIndex === -1 && stIndex === -1) {
   117	    return null;
   118	  }
   119	  if (belIndex !== -1 && (stIndex === -1 || belIndex < stIndex)) {
   120	    return { index: belIndex, length: 1 };
   121	  }
   122	  return { index: stIndex, length: 2 };
   123	}
