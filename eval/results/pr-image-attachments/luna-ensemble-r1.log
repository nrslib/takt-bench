   143	export function buildCommitMessage(
   144	  pipelineConfig: PipelineConfig | undefined,
   145	  issue: Issue | undefined,
   146	  taskText: string | undefined,
   147	): string {
   148	  const template = pipelineConfig?.commitMessageTemplate;
