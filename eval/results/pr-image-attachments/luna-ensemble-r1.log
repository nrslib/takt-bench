   317	function fetchReviewThreadComments(
   318	  thread: GhGraphqlReviewThread,
   319	  prNumber: number,
   320	  cwd: string,
   321	): GhGraphqlReviewThreadComment[] {
   322	  const comments = [...thread.comments.nodes];
   323	  let pageInfo = thread.comments.pageInfo;
   324	
   325	  for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP && pageInfo.hasNextPage; page += 1) {
   326	    if (!pageInfo.endCursor) {
   327	      throw new Error(`Missing review thread comments endCursor for next page in pull request #${prNumber}`);
   328	    }
   329	
   330	    const raw = execFileSync(
   331	      'gh',
   332	      buildReviewThreadCommentsGraphqlArgs(thread.id, pageInfo.endCursor),
   333	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   334	    );
   335	    const nextComments = parseReviewThreadCommentsResponse(raw);
   336	    comments.push(...nextComments.nodes);
   337	    pageInfo = nextComments.pageInfo;
   338	  }
   339	
   340	  if (pageInfo.hasNextPage) {
   341	    throw new Error(
   342	      `Pagination limit exceeded while fetching pull request #${prNumber} review thread comments (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   343	    );
   344	  }
   345	
   346	  return comments;
   347	}
   348	
   349	function mapReviewThreadComments(
   350	  thread: GhGraphqlReviewThread,
   351	  comments: GhGraphqlReviewThreadComment[],
   352	): PrReviewComment[] {
   353	  const threadState = resolveThreadState(thread);
   354	  return comments.map((comment) => {
   355	    const line = comment.line ?? comment.originalLine ?? undefined;
   356	    return {
   357	      author: resolveReviewThreadCommentAuthor(comment),
   358	      body: comment.body,
   359	      path: comment.path,
   360	      ...(line !== undefined ? { line } : {}),
   361	      url: comment.url,
   362	      threadState,
   363	      ...(thread.resolvedBy ? { resolvedBy: thread.resolvedBy.login } : {}),
   364	      isOutdated: thread.isOutdated,
   365	    };
   366	  });
   367	}
   368	
   369	function fetchPrReviewThreads(owner: string, repo: string, prNumber: number, cwd: string): PrReviewComment[] {
   370	  try {
   371	    const comments: PrReviewComment[] = [];
   372	    let endCursor: string | undefined;
   373	
   374	    for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP; page += 1) {
   375	      const raw = execFileSync(
   376	        'gh',
   377	        buildReviewThreadsGraphqlArgs(owner, repo, prNumber, endCursor),
   378	        { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   379	      );
   380	      const reviewThreads = parseReviewThreadsResponse(raw);
   381	
   382	      for (const thread of reviewThreads.nodes) {
   383	        const threadComments = fetchReviewThreadComments(thread, prNumber, cwd);
   384	        comments.push(...mapReviewThreadComments(thread, threadComments));
   385	      }
   386	
   387	      if (!reviewThreads.pageInfo.hasNextPage) {
   388	        return comments;
   389	      }
   390	      if (!reviewThreads.pageInfo.endCursor) {
   391	        throw new Error('Missing reviewThreads endCursor for next page');
   392	      }
   393	      endCursor = reviewThreads.pageInfo.endCursor;
   394	    }
   395	
   396	    throw new Error(
   397	      `Pagination limit exceeded while fetching pull request #${prNumber} review threads (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   398	    );
   399	  } catch (err) {
   400	    throw new Error(`GraphQL reviewThreads failed: ${getErrorMessage(err)}`);
   401	  }
   402	}
