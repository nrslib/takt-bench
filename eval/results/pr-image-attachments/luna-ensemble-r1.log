    38	  if (fileName.endsWith('.png')) return 'image/png';
    39	  if (fileName.endsWith('.jpg') || fileName.endsWith('.jpeg')) return 'image/jpeg';
    40	  if (fileName.endsWith('.gif')) return 'image/gif';
