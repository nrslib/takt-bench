   135	function generatePipelineBranchName(pipelineConfig: PipelineConfig | undefined, issueNumber?: number): string {
   136	  const prefix = pipelineConfig?.defaultBranchPrefix ?? 'takt/';
   137	  const timestamp = Math.floor(Date.now() / 1000);
   138	  return issueNumber
   139	    ? `${prefix}issue-${issueNumber}-${timestamp}`
   140	    : `${prefix}pipeline-${timestamp}`;
   141	}
