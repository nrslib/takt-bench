    88	export function promoteTaskAttachments(
    89	  taskDir: string,
    90	  attachments?: readonly TaskAttachment[],
    91	): void {
    92	  if (!hasAttachments(attachments)) {
    93	    return;
    94	  }
    95	
    96	  const attachmentsDir = path.join(taskDir, 'attachments');
    97	  fs.mkdirSync(attachmentsDir, { recursive: true });
    98	
    99	  for (const attachment of attachments) {
   100	    validateTaskAttachment(attachment);
   101	    validateTaskAttachmentTempFile(attachment);
   102	    const destinationPath = path.join(taskDir, getTaskAttachmentRelativePath(attachment));
   103	    if (fs.existsSync(destinationPath)) {
   104	      throw new Error(`Task attachment destination already exists: ${destinationPath}`);
   105	    }
   106	    fs.copyFileSync(attachment.tempPath, destinationPath);
   107	  }
   108	}
