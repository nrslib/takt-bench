     4	export function extractImageUrls(text: string | undefined): string[] {
     5	  const imageUrls: string[] = [];
     6	  const strText = text ?? '';
     7	  
     8	  // Markdown image pattern: ![alt](url)
     9	  const markdownPattern = /!\[[^\]]*\]\(([^)]+)\)/g;
    10	  let match;
    11	  while ((match = markdownPattern.exec(strText)) !== null) {
    12	    imageUrls.push(match[1] as string);
    13	  }
    14	  
    15	  // HTML img tag pattern: <img src="url" /> or <img src='url' />
    16	  const htmlPattern = /<img[^>]*src=["']([^"']+)["'][^>]*\/>/g;
    17	  while ((match = htmlPattern.exec(strText)) !== null) {
    18	    imageUrls.push(match[1] as string);
    19	  }
    20	  
    21	  return imageUrls;
