    30	        { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] }
    31	      );
    32	      
    33	      const metadata = JSON.parse(response);
    34	      
    35	      // Check content type
    36	      if (!metadata['content-type'] || !SUPPORTED_IMAGE_TYPES.includes(metadata['content-type'])) {
    37	        throw new Error(`Unsupported image type: ${metadata['content-type']}`);
    38	      }
    39	      
    40	      // Check size
