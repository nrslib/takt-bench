    50	function resolveMaxImageIndex(content: string): number {
    51	  const matches = content.matchAll(/\[Image #(\d+)\]|attachments\/image-(\d+)\.[A-Za-z0-9]+/g);
    52	  let maxIndex = 0;
    53	  for (const match of matches) {
    54	    const rawIndex = match[1] ?? match[2];
    55	    if (rawIndex === undefined) {
    56	      continue;
    57	    }
    58	    maxIndex = Math.max(maxIndex, Number(rawIndex));
    59	  }
    60	  return maxIndex;
    61	}
