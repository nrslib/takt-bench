   133	export function promoteTaskAttachments(
   134	  taskDir: string,
   135	  attachments?: readonly TaskAttachment[],
   136	): void {
   137	  if (!hasAttachments(attachments)) {
   138	    return;
   139	  }
   140	
   141	  const attachmentsDir = path.join(taskDir, 'attachments');
   142	  fs.mkdirSync(attachmentsDir, { recursive: true });
   143	
   144	  for (const attachment of attachments) {
   145	    validateTaskAttachment(attachment);
   146	    validateTaskAttachmentTempFile(attachment);
   147	    const destinationPath = path.join(taskDir, getTaskAttachmentRelativePath(attachment));
   148	    if (fs.existsSync(destinationPath)) {
   149	      throw new Error(`Task attachment destination already exists: ${destinationPath}`);
   150	    }
   151	    fs.copyFileSync(attachment.tempPath, destinationPath);
   152	  }
   153	}
