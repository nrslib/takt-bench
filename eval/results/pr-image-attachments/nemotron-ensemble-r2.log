   }
   const branch = tryResolveCurrentBranch(cwd);
   const baseBranch = branch ? resolveReadOnlyBaseBranch(cwd) : undefined;
   return {
     execCwd: cwd,
     isWorktree: false,
     branch,
     baseBranch,
   };
 }
 
 function fetchVcsResource<T>(
   label: string,
   cwd: string,
   fetch: (provider: ReturnType<typeof getGitProvider>) => T,
 ): T | undefined {
   const gitProvider = getGitProvider();
   const cliStatus = gitProvider.checkCliStatus(cwd);
   if (!cliStatus.available) {
     error(cliStatus.error);
     return undefined;
   }
   try {
     return fetch(gitProvider);
   } catch (err) {
     error(`Failed to fetch ${label}: ${getErrorMessage(err)}`);
     return undefined;
   }
 }
 
