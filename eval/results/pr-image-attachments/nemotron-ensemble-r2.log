   321	      if (options?.sourceTaskDir) {
   322	        copyExistingTaskAttachments(options.sourceTaskDir, taskDir);
   323	      }
   324	      await saveImageAttachments(taskDir, taskContent, attachments ?? []);
   325	    },
   326	  });
   327	}
   328	
   329	export function copyTaskAttachmentsToRunContext(
   330	  sourceTaskDir: string,
   331	  runContextTaskDir: string,
   332	  expectedManifest: TaskAttachmentManifest,
   333	): void {
   334	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   335	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   336	  if (expectedManifest.length !== 0) {
   337	    copyAttachmentEntry(sourceAttachmentsDir, path.join(runContextTaskDir, 'attachments'));
   338	  }
   339	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   340	  assertTaskAttachmentsMatchManifest(runContextTaskDir, expectedManifest);
   341	}
   342	
   343	/**
   344	 * Save image attachments to the task directory and update order.md
   345	 * @param taskDir The task directory
   346	 * @param taskContent The original task content
   347	 * @param attachments The attachments to save
   348	 */
   349	export async function saveImageAttachments(
   350	  taskDir: string,
   351	  taskContent: string,
   352	  attachments: readonly TaskAttachment[],
   353	): Promise<void> {
   354	  if (!hasAttachments(attachments)) {
   355	    return;
   356	  }
   357	
   358	  const attachmentsDir = path.join(taskDir, 'attachments');
   359	  await fs.promises.mkdir(attachmentsDir, { recursive: true });
   360	
   361	  // Copy each attachment file
   362	  for (const attachment of attachments) {
   363	    validateTaskAttachment(attachment);
   364	    validateTaskAttachmentTempFile(attachment);
   365	    const destinationPath = path.join(taskDir, getTaskAttachmentRelativePath(attachment));
   366	    if (await fs.promises.access(destinationPath).then(() => true).catch(() => false)) {
   367	      throw new Error(`Task attachment destination already exists: ${destinationPath}`);
   368	    }
   369	    await fs.promises.copyFile(attachment.tempPath, destinationPath);
   370	  }
   371	
   372	  // Build the updated task content with normalized attachment references
   373	  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
   374	  
   375	  // Build the attachment section for order.md
   376	  const attachmentLines = attachments.map((attachment) =>
   377	    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
   378	  );
   379	  
   380	  const attachmentSection = [
   381	    '',
   382	    '## 添付画像',
   383	    '',
   384	    ...attachmentLines,
   385	  ].join('\n');
   386	
   387	  // Write the updated order.md file
   388	  const orderContent = [normalizedTaskContent.trimEnd(), attachmentSection].join('\n');
   389	  await fs.promises.writeFile(path.join(taskDir, '.takt', 'order.md'), orderContent, 'utf-8');
   390	}

