    80	export function buildTaskOrderContent(
    81	  taskContent: string,
    82	  attachments?: readonly TaskAttachment[],
    83	): string {
    84	  if (!hasAttachments(attachments)) {
    85	    return taskContent;
    86	  }
    87	
    88	  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
    89	  const attachmentLines = attachments.map((attachment) =>
    90	    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
    91	  );
    92	  return [
    93	    normalizedTaskContent.trimEnd(),
    94	    '',
    95	    '## 添付画像',
    96	    '',
    97	    ...attachmentLines,
    98	  ].join('\n');
    99	}
   100	
   101	function getTaskAttachmentRelativePath(attachment: TaskAttachment): string {
   102	  return path.posix.join('attachments', attachment.fileName);
   103	}
   104	
   105	function normalizeTaskAttachmentReferences(
   106	  taskContent: string,
   107	  attachments: readonly TaskAttachment[],
   108	): string {
   109	  return attachments.reduce((content, attachment) => {
   110	    const relativePath = getTaskAttachmentRelativePath(attachment);
   111	    const pathVariants = new Set([
   112	      attachment.tempPath,
   113	      attachment.tempPath.replace(/\\/g, '/'),
   114	    ]);
   115	    let normalized = content;
   116	    for (const tempPath of pathVariants) {
   117	      normalized = normalized
   118	        .split(`\`${tempPath}\``).join(`\`${relativePath}\``)
   119	        .split(tempPath).join(`\`${relativePath}\``);
   120	    }
   121	    return normalized;
   122	  }, taskContent);
   123	}
