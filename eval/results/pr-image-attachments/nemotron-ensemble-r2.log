    63	function renumberRetryAttachments(
    64	  baseContent: string,
    65	  retryNote: string,
    66	  attachments: readonly TaskAttachment[],
    67	): { retryNote: string; attachments: TaskAttachment[] } {
    68	  let nextImageIndex = resolveMaxImageIndex(baseContent) + 1;
    69	  const placeholderReplacements = new Map<string, string>();
    70	  const adjustedAttachments = attachments.map((attachment) => {
    71	    const placeholder = `[Image #${nextImageIndex}]`;
    72	    const fileName = `image-${nextImageIndex}${getImageAttachmentExtension(attachment.fileName)}`;
    73	    nextImageIndex += 1;
    74	    placeholderReplacements.set(attachment.placeholder, placeholder);
    75	    return {
    76	      ...attachment,
    77	      placeholder,
    78	      fileName,
    79	    };
    80	  });
    81	  const adjustedRetryNote = retryNote.replace(/\[Image #\d+\]/g, (placeholder) =>
    82	    placeholderReplacements.get(placeholder) ?? placeholder);
    83	  return { retryNote: adjustedRetryNote, attachments: adjustedAttachments };
    84	}
