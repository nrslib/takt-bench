   157	/**
   158	 * add command handler
   159	 *
   160	 * Flow:
   161	 *   A) --pr オプション: PRレビュー取得 → ワークフロー選択 → YAML作成
   162	 *   B) 引数なし: Usage表示して終了
   163	 *   C) Issue参照の場合: issue取得 → ワークフロー選択 → ワークツリー設定 → YAML作成
   164	 *   D) 通常入力: ワークフロー選択 → ワークツリー設定 → YAML作成
   165	 */
   166	export async function addTask(
   167	  cwd: string,
   168	  task?: string,
   169	  opts?: { prNumber?: number; workflow?: string },
   170	): Promise<void> {
   171	  const rawTask = task ?? '';
   172	  const trimmedTask = rawTask.trim();
   173	  const prNumber = opts?.prNumber;
   174	
   175	    if (prNumber !== undefined) {
   176	      const tempFilesToClean: string[] = [];
   177	      try {
   178	        const provider = getGitProvider();
   179	        const cliStatus = provider.checkCliStatus(cwd);
   180	        if (!cliStatus.available) {
   181	          error(cliStatus.error);
   182	          return;
   183	        }
   184	
   185	        let prReview: PrReviewData;
   186	        try {
   187	          prReview = await withProgress(
   188	            'Fetching PR review comments...',
   189	            (fetchedPrReview: PrReviewData) => `PR fetched: #${fetchedPrReview.number} ${fetchedPrReview.title}`,
   190	            async () => provider.fetchPrReviewComments(prNumber, cwd),
   191	          );
   192	        } catch (e) {
   193	          const msg = getErrorMessage(e);
   194	          error(`Failed to fetch PR review comments #${prNumber}: ${msg}`);
   195	          return;
   196	        }
   197	
   198	        if (prReview.reviews.length === 0 && prReview.comments.length === 0) {
   199	          error(`PR #${prNumber} has no review comments`);
   200	          return;
   201	        }
   202	
   203	        // Extract image URLs from PR data
   204	        const attachments: TaskAttachment[] = [];
   205	        const urlReplacements: { sourceUrl: string; placeholder: string }[] = [];
   206	        
   207	        // Extract from PR body, review summaries, and comments
   208	        const allText = [
   209	          prReview.body,
   210	          ...prReview.reviews.map(r => r.body),
   211	          ...prReview.comments.map(c => c.body)
   212	        ].join('\n');
   213	        
   214	        const imageUrls = extractImageUrls(allText);
   215	        // Deduplicate URLs while preserving order
   216	        const seenUrls = new Set<string>();
   217	        const uniqueUrls = imageUrls.filter(url => {
   218	          if (seenUrls.has(url)) {
   219	            return false;
   220	          }
   221	          seenUrls.add(url);
   222	          return true;
   223	        });
   224	        const filteredUrls = filterGithubAttachmentUrls(uniqueUrls);
   225	        
   226	        // Download each image
   227	        const filteredUrlsSafe = filteredUrls || [];
   228	        for (const [, url] of filteredUrlsSafe.entries()) {
   229	          try {
   230	            const downloadedImage = downloadImage(url, cwd, attachments.length);
   231	            const validatedImage = validateAndSetImageExtension(downloadedImage);
   232	            attachments.push(validatedImage);
   233	            tempFilesToClean.push(validatedImage.tempPath);
   234	            urlReplacements.push({
   235	              sourceUrl: url,
   236	              placeholder: downloadedImage.placeholder,
   237	            });
   238	          } catch (downloadError) {
   239	            // Log but continue if individual image fails
   240	            log.warn(`Failed to download image ${url}: ${getErrorMessage(downloadError)}`);
   241	          }
   242	        }
   243	        
   244	        const taskContent = formatPrReviewAsTask(prReview);
   245	        let processedTaskContent = taskContent;
   246	        for (const { sourceUrl, placeholder } of urlReplacements) {
   247	          processedTaskContent = processedTaskContent.replaceAll(sourceUrl, placeholder);
   248	        }
   249	
   250	        const workflow = await determineWorkflow(cwd, opts?.workflow);
   251	        if (workflow === null) {
   252	          info('Cancelled.');
   253	          return;
   254	        }
   255	
   256	        const settings = {
   257	          worktree: true,
   258	          branch: prReview.headRefName,
   259	          baseBranch: prReview.baseRefName,
   260	          autoPr: false,
   261	          shouldPublishBranchToOrigin: true,
   262	        };
   263	        const created = await saveTaskFile(cwd, processedTaskContent, { workflow, ...settings, prNumber, attachments });
   264	        displayTaskCreationResult(created, settings, workflow);
   265	        return;
   266	        } finally {
   267	          // Clean up temporary directories (parent directories of downloaded images)
   268	          const tempDirsToClean = new Set<string>();
   269	          for (const tempFile of tempFilesToClean) {
   270	            try {
   271	              if (fs.existsSync(tempFile)) {
   272	                fs.unlinkSync(tempFile);
   273	              }
   274	              const tempDir = path.dirname(tempFile);
   275	              tempDirsToClean.add(tempDir);
   276	            } catch (cleanupError) {
   277	              log.warn(`Failed to clean up temporary file ${tempFile}: ${getErrorMessage(cleanupError)}`);
   278	            }
   279	          }
   280	          // Clean up all tracked temporary directories
   281	          for (const tempDir of tempDirsToClean) {
   282	            try {
   283	              if (fs.existsSync(tempDir)) {
   284	                fs.rmSync(tempDir, { recursive: true, force: true });
   285	              }
   286	            } catch (cleanupError) {
   287	              log.warn(`Failed to clean up temporary directory ${tempDir}: ${getErrorMessage(cleanupError)}`);
   288	            }
   289	          }
   290	        }
   291	    }
   292	
   293	  if (!trimmedTask) {
   294	    info('Usage: takt add <task>');
   295	    return;
   296	  }
   297	
   298	  let taskContent: string;
   299	  let issueNumber: number | undefined;
   300	
   301	  if (isIssueReference(trimmedTask)) {
   302	    try {
   303	      const numbers = parseIssueNumbers([trimmedTask]);
   304	      const primaryIssueNumber = numbers[0];
   305	      taskContent = await withProgress(
   306	        'Fetching issue...',
   307	        primaryIssueNumber ? `Issue fetched: #${primaryIssueNumber}` : 'Issue fetched',
   308	        async () => resolveIssueTask(trimmedTask, cwd),
   309	      );
   310	      if (numbers.length > 0) {
   311	        issueNumber = numbers[0];
   312	      }
   313	    } catch (e) {
   314	      const msg = getErrorMessage(e);
   315	      log.error('Failed to fetch issue', { task: trimmedTask, error: msg });
   316	      info(`Failed to fetch issue ${trimmedTask}: ${msg}`);
   317	      return;
   318	    }
   319	  } else {
   320	    taskContent = rawTask;
   321	  }
   322	
   323	  const workflow = await determineWorkflow(cwd, opts?.workflow);
   324	  if (workflow === null) {
   325	    info('Cancelled.');
   326	    return;
