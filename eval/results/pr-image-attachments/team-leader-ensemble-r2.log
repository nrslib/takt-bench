   213	export function resolveTaskContent(options: PipelineExecutionOptions): TaskContent | undefined {
   214	  const { cwd } = options;
   215	  if (options.prNumber) {
   216	    info(`Fetching PR #${options.prNumber} review comments...`);
   217	    const prReview = fetchVcsResource(
   218	      `PR #${options.prNumber}`,
   219	      cwd,
   220	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   221	    );
   222	    if (!prReview) return undefined;
   223	    const task = formatPrReviewAsTask(prReview);
   224	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   225	    return {
   226	      task,
   227	      prBranch: prReview.headRefName,
   228	      prBaseBranch: prReview.baseRefName,
   229	    };
   230	  }
   231	  if (options.issueNumber) {
   232	    info(`Fetching issue #${options.issueNumber}...`);
   233	    const issue = fetchVcsResource(
   234	      `issue #${options.issueNumber}`,
   235	      cwd,
   236	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   237	    );
   238	    if (!issue) return undefined;
   239	    const task = formatIssueAsTask(issue);
   240	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   241	    return { task, issue };
   242	  }
   243	  if (options.task) {
   244	    return { task: options.task };
   245	  }
   246	  error('Either --issue, --pr, or --task must be specified');
   247	  return undefined;
   248	}
