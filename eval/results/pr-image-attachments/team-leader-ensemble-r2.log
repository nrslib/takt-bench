    88	/**
    89	 * Download an image from a URL using gh CLI
    90	 * Returns a StoredImageAttachment object with temp file path and placeholder
    91	 */
    92	export function downloadImage(url: string, cwd: string, successCount: number): StoredImageAttachment {
    93	  // Create temporary directory for downloaded image
    94	  const tmpDir = mkdtempSync(path.join(ensureCurrentTmpDirExists(), 'takt-image-'));
    95	  let fileName: string = '';
    96	  let tempPath: string = '';
    97	  try {
    98	     const ghStatus = checkGhCli(cwd);
    99	     if (!ghStatus.available) {
   100	       throw new Error((ghStatus as { error: string }).error);
   101	     }
   102	
   103	    fileName = `image-${createHash('sha256').update(url).digest('hex').slice(0, 8)}.tmp`;
   104	    tempPath = path.join(tmpDir, fileName);
   105	
   106	    // Use gh api to download the image (works with authenticated requests)
   107	    const buffer = execFileSync(
   108	      'gh',
   109	      ['api', url, '--method', 'GET', '--header', 'Accept: application/octet-stream'],
   110	      { cwd, encoding: 'buffer', maxBuffer: 100 * 1024 * 1024 } // 100MB max
   111	    );
   112	    
   113	    fs.writeFileSync(tempPath, buffer);
   114	    
   115	    // Validate it's a regular image file
   116	    assertRegularImageAttachmentFile(tempPath, 'Downloaded image');
   117	    
   118	      // Now validate and set the proper extension
   119	      const imageBuffer = fs.readFileSync(tempPath);
   120	      let extension = '';
   121	      if (imageBuffer.length >= 8) {
   122	        // PNG: 89 50 4E 47 0D 0A 1A 0A
   123	        if (imageBuffer[0] === 0x89 && imageBuffer[1] === 0x50 && imageBuffer[2] === 0x4E && imageBuffer[3] === 0x47 && 
   124	            imageBuffer[4] === 0x0D && imageBuffer[5] === 0x0A && imageBuffer[6] === 0x1A && imageBuffer[7] === 0x0A) {
   125	          extension = '.png';
   126	        }
   127	        // JPEG: FF D8 FF
   128	        else if (imageBuffer.length >= 2 && imageBuffer[0] === 0xFF && imageBuffer[1] === 0xD8) {
   129	          extension = '.jpg';
   130	        }
   131	        // GIF: 47 49 46 38 37 61 or 47 49 46 38 39 61
   132	        else if (imageBuffer.length >= 6 && 
   133	                ((imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x38 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61) ||
   134	                 (imageBuffer[0] === 0x47 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x39 && imageBuffer[4] === 0x37 && imageBuffer[5] === 0x61))) {
   135	          extension = '.gif';
   136	        }
   137	        // WebP: 52 49 46 46 ?? ?? ?? ?? 57 45 42 50 (RIFF....WEBP)
   138	        else if (imageBuffer.length >= 12 && 
   139	                imageBuffer[0] === 0x52 && imageBuffer[1] === 0x49 && imageBuffer[2] === 0x46 && imageBuffer[3] === 0x46 &&
   140	                imageBuffer[8] === 0x57 && imageBuffer[9] === 0x45 && imageBuffer[10] === 0x42 && imageBuffer[11] === 0x50) {
   141	          extension = '.webp';
   142	        }
   143	      }
   144	    
   145	    if (!extension) {
   146	      throw new Error('Unsupported image format');
   147	    }
   148	    
   149	    // Update file name and temp path with proper extension
   150	    const newFileName = fileName.replace(/\.[^.]+$/, extension);
   151	    const newTempPath = tempPath.replace(/\.[^.]+$/, extension);
   152	    
   153	    // Rename the file
   154	    fs.renameSync(tempPath, newTempPath);
   155	    
   156	    return {
   157	      placeholder: `[Image #${successCount + 1}]`,
   158	      tempPath: newTempPath,
   159	      fileName: newFileName,
   160	    };
   161	  } catch (err) {
   162	    // Clean up temp file if it was created
   163	    if (tempPath && fs.existsSync(tempPath)) {
   164	      fs.unlinkSync(tempPath);
   165	    }
   166	     // Clean up temp directory
   167	     fs.rmSync(tmpDir, { recursive: true, force: true });
   168	    throw new Error(`Failed to download image from ${url}: ${getErrorMessage(err)}`);
   169	  }
   170	}
