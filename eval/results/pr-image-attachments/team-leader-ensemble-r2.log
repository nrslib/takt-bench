   118	export async function createIssueAndSaveTask(
   119	  cwd: string,
   120	  task: string,
   121	  workflow?: string,
   122	  options?: { confirmAtEndMessage?: string; labels?: string[]; attachments?: TaskAttachment[] },
   123	): Promise<void> {
   124	  const gitProvider = getGitProvider();
   125	  const saveInteractiveTask: SaveEnqueuedTaskFile = async (saveCwd, taskContent, saveOptions) => {
   126	    const created = await saveTaskFromInteractive(saveCwd, taskContent, saveOptions?.workflow, {
   127	      issue: saveOptions?.issue,
   128	      confirmAtEndMessage: options?.confirmAtEndMessage,
   129	      ...(options?.attachments ? { attachments: options.attachments } : {}),
   130	    });
   131	    if (created === undefined) {
   132	      throw new IssueEnqueueCancelledError();
   133	    }
   134	    return created;
   135	  };
   136	  const result = await createIssueAndEnqueueTask({
   137	    cwd,
   138	    task,
   139	    workflow: workflow ?? DEFAULT_WORKFLOW_NAME,
   140	    worktree: true,
   141	    autoPr: false,
   142	    labels: options?.labels,
   143	    gitProvider,
   144	    issueOutputMode: 'terminal',
   145	  }, {
   146	    saveTaskFile: saveInteractiveTask,
   147	    createIssueFromTaskResult,
   148	  });
   149	  if (!result.success) {
   150	    if (result.failure.stage !== 'issue_creation') {
   151	      error(formatIssueEnqueueFailure(result.failure, getErrorMessage));
   152	    }
   153	    return;
   154	  }
   155	}
