    42	export async function saveTaskFile(
    43	  cwd: string,
    44	  taskContent: string,
    45	  options?: SaveTaskOptions,
    46	  prepareTaskSpec?: PrepareEnqueuedTaskSpec,
    47	  abortSignal?: AbortSignal,
    48	): Promise<{ taskName: string; tasksFile: string }> {
    49	  const { attachments, ...saveOptions } = options ?? {};
    50	  const attachmentPrepareTaskSpec = attachments !== undefined
    51	    ? (saveCwd: string, saveTaskContent: string) => prepareTaskSpecDirectory(saveCwd, saveTaskContent, attachments)
    52	    : prepareTaskSpec;
    53	  return saveEnqueuedTaskFile(cwd, taskContent, saveOptions, attachmentPrepareTaskSpec, abortSignal);
