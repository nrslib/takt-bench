   231	/**
   232	 * Check if gh CLI is available
   233	 */
   234	export function checkGhCli(cwd: string = process.cwd()): { available: true } | { available: false; error: string } {
   235	  try {
   236	    execFileSync('gh', ['--version'], { cwd, stdio: 'pipe' });
   237	    return { available: true };
   238	   } catch {
   239	     return { 
   240	       available: false, 
   241	       error: '`gh` CLI がインストールされていません。https://cli.github.com からインストールしてください' 
   242	     };
   243	   }
   244	}
