   231	function buildReviewThreadsGraphqlArgs(
   232	  owner: string,
   233	  repo: string,
   234	  prNumber: number,
   235	  endCursor: string | undefined,
   236	): string[] {
   237	  const args = [
   238	    'api',
   239	    'graphql',
   240	    '-f',
   241	    `owner=${owner}`,
   242	    '-f',
   243	    `repo=${repo}`,
   244	    '-F',
   245	    `number=${prNumber}`,
   246	  ];
   247	
   248	  if (endCursor !== undefined) {
   249	    args.push('-f', `endCursor=${endCursor}`);
   250	  }
   251	
   252	  args.push('-f', `query=${REVIEW_THREADS_QUERY}`);
   253	  return args;
   254	}
   255	
   256	function buildReviewThreadCommentsGraphqlArgs(threadId: string, commentsEndCursor: string): string[] {
   257	  return [
   258	    'api',
   259	    'graphql',
   260	    '-f',
   261	    `threadId=${threadId}`,
   262	    '-f',
   263	    `commentsEndCursor=${commentsEndCursor}`,
   264	    '-f',
   265	    `query=${REVIEW_THREAD_COMMENTS_QUERY}`,
   266	  ];
   267	}
   268	
   269	function parseReviewThreadsResponse(raw: string): GhGraphqlReviewThreadsConnection {
   270	  const parsed = JSON.parse(raw) as GhGraphqlReviewThreadsResponse;
   271	  if (parsed.errors && parsed.errors.length > 0) {
   272	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   273	  }
   274	
   275	  const pullRequest = parsed.data?.repository?.pullRequest;
   276	  if (!pullRequest) {
   277	    throw new Error('Missing pull request reviewThreads in GraphQL response');
   278	  }
   279	
   280	  return pullRequest.reviewThreads;
   281	}
   282	
   283	function parseReviewThreadCommentsResponse(raw: string): GhGraphqlReviewThreadCommentsConnection {
   284	  const parsed = JSON.parse(raw) as GhGraphqlReviewThreadCommentsResponse;
   285	  if (parsed.errors && parsed.errors.length > 0) {
   286	    throw new Error(parsed.errors.map((error) => error.message).join('; '));
   287	  }
   288	
   289	  const thread = parsed.data?.node;
   290	  if (!thread?.comments) {
   291	    throw new Error('Missing pull request review thread comments in GraphQL response');
   292	  }
   293	
   294	  return thread.comments;
   295	}
   296	
   297	function resolveThreadState(thread: GhGraphqlReviewThread): PrReviewThreadState {
   298	  if (thread.isResolved) {
   299	    return 'resolved';
   300	  }
   301	  if (thread.isOutdated) {
   302	    return 'outdated-unresolved';
   303	  }
   304	  return 'active';
   305	}
   306	
   307	function resolveReviewThreadCommentAuthor(comment: GhGraphqlReviewThreadComment): string {
   308	  if (comment.author) {
   309	    return comment.author.login;
   310	  }
   311	  return DELETED_GITHUB_USER_AUTHOR;
   312	}
   313	
   314	function fetchReviewThreadComments(
   315	  thread: GhGraphqlReviewThread,
   316	  prNumber: number,
   317	  cwd: string,
   318	): GhGraphqlReviewThreadComment[] {
   319	  const comments = [...thread.comments.nodes];
   320	  let pageInfo = thread.comments.pageInfo;
   321	
   322	  for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP && pageInfo.hasNextPage; page += 1) {
   323	    if (!pageInfo.endCursor) {
   324	      throw new Error(`Missing review thread comments endCursor for next page in pull request #${prNumber}`);
   325	    }
   326	
   327	    const raw = execFileSync(
   328	      'gh',
   329	      buildReviewThreadCommentsGraphqlArgs(thread.id, pageInfo.endCursor),
   330	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   331	    );
   332	    const nextComments = parseReviewThreadCommentsResponse(raw);
   333	    comments.push(...nextComments.nodes);
   334	    pageInfo = nextComments.pageInfo;
   335	  }
   336	
   337	  if (pageInfo.hasNextPage) {
   338	    throw new Error(
   339	      `Pagination limit exceeded while fetching pull request #${prNumber} review thread comments (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   340	    );
   341	  }
   342	
   343	  return comments;
   344	}
   345	
   346	function mapReviewThreadComments(
   347	  thread: GhGraphqlReviewThread,
   348	  comments: GhGraphqlReviewThreadComment[],
   349	): PrReviewComment[] {
   350	  const threadState = resolveThreadState(thread);
   351	  return comments.map((comment) => {
   352	    const line = comment.line ?? comment.originalLine ?? undefined;
   353	    return {
   354	      author: resolveReviewThreadCommentAuthor(comment),
   355	      body: comment.body,
   356	      path: comment.path,
   357	      ...(line !== undefined ? { line } : {}),
   358	      url: comment.url,
   359	      threadState,
   360	      ...(thread.resolvedBy ? { resolvedBy: thread.resolvedBy.login } : {}),
   361	      isOutdated: thread.isOutdated,
   362	    };
   363	  });
   364	}
   365	
   366	function fetchPrReviewThreads(owner: string, repo: string, prNumber: number, cwd: string): PrReviewComment[] {
   367	  try {
   368	    const comments: PrReviewComment[] = [];
   369	    let endCursor: string | undefined;
   370	
   371	    for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP; page += 1) {
   372	      const raw = execFileSync(
   373	        'gh',
   374	        buildReviewThreadsGraphqlArgs(owner, repo, prNumber, endCursor),
   375	        { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   376	      );
   377	      const reviewThreads = parseReviewThreadsResponse(raw);
   378	
   379	      for (const thread of reviewThreads.nodes) {
   380	        const threadComments = fetchReviewThreadComments(thread, prNumber, cwd);
   381	        comments.push(...mapReviewThreadComments(thread, threadComments));
   382	      }
   383	
   384	      if (!reviewThreads.pageInfo.hasNextPage) {
   385	        return comments;
   386	      }
   387	      if (!reviewThreads.pageInfo.endCursor) {
   388	        throw new Error('Missing reviewThreads endCursor for next page');
   389	      }
   390	      endCursor = reviewThreads.pageInfo.endCursor;
   391	    }
   392	
   393	    throw new Error(
   394	      `Pagination limit exceeded while fetching pull request #${prNumber} review threads (>${GRAPHQL_PAGINATION_HARD_CAP} pages)`,
   395	    );
   396	  } catch (err) {
   397	    throw new Error(`GraphQL reviewThreads failed: ${getErrorMessage(err)}`);
   398	  }
   399	}
   400	
   401	function parseRepositoryFromPrUrl(prUrl: string): { owner: string; repo: string } {
   402	  const parsed = new URL(prUrl);
   403	  const pathSegments = parsed.pathname.split('/').filter(Boolean);
   404	
   405	  if (pathSegments.length < 4 || pathSegments[2] !== 'pull') {
   406	    throw new Error(`Unexpected pull request URL format: ${prUrl}`);
   407	  }
   408	
   409	  const [owner, repo] = pathSegments;
   410	  if (!owner || !repo) {
   411	    throw new Error(`Repository owner/repo is missing in pull request URL: ${prUrl}`);
   412	  }
   413	
   414	  return { owner, repo };
   415	}
