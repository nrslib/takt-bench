    48	
    49	export function resolveReferencedImageAttachments(
    50	  prompt: string,
    51	  attachments: readonly StoredImageAttachment[],
    52	): ImageAttachmentReference[] {
    53	  const referencedPlaceholders = [...new Set(prompt.match(IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN) ?? [])];
    54	  if (referencedPlaceholders.length === 0) {
    55	    return [];
    56	  }
    57	
    58	  const attachmentByPlaceholder = new Map<string, StoredImageAttachment>();
    59	  for (const attachment of attachments) {
    60	    if (attachmentByPlaceholder.has(attachment.placeholder)) {
    61	      throw new Error(`Duplicate image attachment placeholder: ${attachment.placeholder}`);
    62	    }
    63	    attachmentByPlaceholder.set(attachment.placeholder, attachment);
    64	  }
    65	
    66	  return referencedPlaceholders.flatMap((placeholder): ImageAttachmentReference[] => {
    67	    const attachment = attachmentByPlaceholder.get(placeholder);
    68	    if (attachment === undefined) {
    69	      return [];
    70	    }
    71	    validateStoredImageAttachment(attachment);
    72	    assertRegularImageAttachmentFile(attachment.tempPath);
    73	    return [{
    74	      placeholder: attachment.placeholder,
    75	      path: attachment.tempPath,
    76	    }];
    77	  });
    78	}
