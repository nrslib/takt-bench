    29	    }
    30	  }
    31	
    32	  // HTML img tag with double quotes: <img src="url" />
    33	  const htmlDoubleRegex = /<img\s+[^>]*src="([^"]*)"[^>]*\/?>/gi;
    34	  while ((match = htmlDoubleRegex.exec(text)) !== null) {
    35	    const captured = match[1];
    36	    if (captured !== undefined) {
    37	      matches.push({ position: match.index, url: captured });
    38	    }
    39	  }
    40	
    41	  // HTML img tag with single quotes: <img src='url' />
    42	  const htmlSingleRegex = /<img\s+[^>]*src='([^']*)'[^>]*\/?>/gi;
    43	  while ((match = htmlSingleRegex.exec(text)) !== null) {
    44	    const captured = match[1];
    45	    if (captured !== undefined) {
    46	      matches.push({ position: match.index, url: captured });
    47	    }
    48	  }
    49	
    50	  // Sort by position to maintain order of appearance
    51	  matches.sort((a, b) => a.position - b.position);
    52	
    53	  // Remove duplicates while preserving the order of first appearance
    54	  const seen = new Set<string>();
    55	  const uniqueUrls: string[] = [];
    56	  for (const match of matches) {
    57	    if (!seen.has(match.url)) {
    58	      seen.add(match.url);
    59	      uniqueUrls.push(match.url);
    60	    }
    61	  }
    62	
    63	  return uniqueUrls;
    64	}
