    57	/**
    58	 * Prompt user to select a label for the issue.
    59	 *
    60	 * Presents 4 fixed options: None, bug, enhancement, custom input.
    61	 * Returns an array of selected labels (empty if none selected).
    62	 */
    63	export async function promptLabelSelection(lang: Language): Promise<string[]> {
    64	  const selected = await selectOption<string>(
    65	    getLabel('issue.labelSelection.prompt', lang),
    66	    [
    67	      { label: getLabel('issue.labelSelection.none', lang), value: 'none' },
    68	      { label: 'bug', value: 'bug' },
    69	      { label: 'enhancement', value: 'enhancement' },
    70	      { label: getLabel('issue.labelSelection.custom', lang), value: 'custom' },
    71	    ],
    72	  );
    73	
    74	  if (selected === null || selected === 'none') return [];
    75	  if (selected === 'custom') {
    76	    const customLabel = await promptInput(getLabel('issue.labelSelection.customPrompt', lang));
    77	    return customLabel?.split(',').map((l) => l.trim()).filter((l) => l.length > 0) ?? [];
    78	  }
    79	  return [selected];
    80	}
