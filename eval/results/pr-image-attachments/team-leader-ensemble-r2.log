   267	/**
   268	 * Build PR body from issues and execution report.
   269	 * Supports multiple issues (adds "Closes #N" for each).
   270	 */
   271	export function buildPrBody(issues: Issue[] | undefined, report: string, orderContent?: string): string {
   272	  const parts: string[] = [];
   273	  const summary = issues && issues.length > 0
   274	    ? issues[0]!.body || issues[0]!.title
   275	    : orderContent?.trim()
   276	      ? orderContent
   277	      : undefined;
   278	
   279	  parts.push('## Summary');
   280	  if (summary) {
   410	  if (!owner || !repo) {
   411	    throw new Error(`Repository owner/repo is missing in pull request URL: ${prUrl}`);
   412	  }
   413	
   414	  return { owner, repo };
   415	}
