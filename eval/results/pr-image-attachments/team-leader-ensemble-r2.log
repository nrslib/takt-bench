    83	/**
    84	 * Save a task from interactive mode result.
    85	 * Prompts for worktree/branch/auto_pr settings before saving.
    86	 * If presetSettings is provided, skips the prompt and uses those settings directly.
    87	 */
    88	export async function saveTaskFromInteractive(
    89	  cwd: string,
    90	  task: string,
    91	  workflow?: string,
    92	  options?: {
    93	    issue?: number;
    94	    prNumber?: number;
    95	    confirmAtEndMessage?: string;
    96	    presetSettings?: WorktreeSettings;
    97	    attachments?: TaskAttachment[];
    98	  },
    99	): Promise<{ taskName: string; tasksFile: string } | undefined> {
   100	  if (options?.confirmAtEndMessage) {
   101	    const approved = await confirm(options.confirmAtEndMessage, true);
   102	    if (!approved) {
   103	      return undefined;
   104	    }
   105	  }
   106	  const settings = options?.presetSettings ?? await promptWorktreeSettings(cwd);
   107	  const created = await saveTaskFile(cwd, task, {
   108	    workflow,
   109	    issue: options?.issue,
   110	    prNumber: options?.prNumber,
   111	    ...settings,
   112	    ...(options?.attachments ? { attachments: options.attachments } : {}),
   113	  });
   114	  displayTaskCreationResult(created, settings, workflow);
   115	  return created;
   116	}
