    66	/**
    67	 * Filter URLs to only include GitHub attachment URLs for security
    68	 */
    69	export function filterGithubAttachmentUrls(urls: string[]): string[] {
    70	  return urls.filter(url => {
    71	    try {
    72	      const urlObj = new URL(url);
    73	      // GitHub attachment URLs typically follow patterns like:
    74	      // https://github.com/user-attachments/assets/...
    75	      // https://user-images.githubusercontent.com/...
    76	      // https://assets.githubusercontent.com/...
    77	      return (
    78	        urlObj.hostname === 'github.com' && 
    79	        urlObj.pathname.includes('/user-attachments/assets/')
    80	      ) || 
    81	      urlObj.hostname.endsWith('.githubusercontent.com');
    82	    } catch {
    83	      return false;
    84	    }
    85	  });
    86	}
