new file mode 100644
index 00000000..0797e9de
--- /dev/null
+++ b/src/__tests__/imageDownload.test.ts
@@ -0,0 +1,176 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import {
+  downloadPrImages,
+  isGitHubAttachmentUrl,
+} from '../infra/github/imageDownload.js';
+import type { PrReviewData } from '../infra/git/types.js';
+
+const execFileSync = vi.hoisted(() => vi.fn());
+
+vi.mock('node:child_process', () => ({
+  execFileSync: (...args: unknown[]) => execFileSync(...args),
+}));
+
+const tempRoots = new Set<string>();
+
+afterEach(() => {
+  for (const root of tempRoots) {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+  tempRoots.clear();
+});
+
+function createTempRoot(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'takt-image-download-test-'));
+  tempRoots.add(root);
+  return root;
+}
+
+function createPrReview(overrides: Partial<PrReviewData> = {}): PrReviewData {
+  return {
+    number: 456,
+    title: 'Fix auth bug',
+    body: 'PR description',
+    url: 'https://github.com/org/repo/pull/456',
+    headRefName: 'feature/fix-auth-bug',
+    comments: [],
+    reviews: [],
+    files: [],
+    ...overrides,
+  };
+}
+
+describe('isGitHubAttachmentUrl', () => {
+  it('should accept GitHub user-attachments asset URLs', () => {
+    expect(isGitHubAttachmentUrl('https://github.com/user-attachments/assets/abc123')).toBe(true);
+  });
+
+  it('should accept GitHub org/repo asset URLs', () => {
+    expect(isGitHubAttachmentUrl('https://github.com/org/repo/assets/def456')).toBe(true);
+  });
+
+  it('should reject external non-GitHub URLs', () => {
+    expect(isGitHubAttachmentUrl('https://example.com/image.png')).toBe(false);
+  });
+
+  it('should reject non-https GitHub URLs', () => {
+    expect(isGitHubAttachmentUrl('http://github.com/user-attachments/assets/abc123')).toBe(false);
+  });
+});
+
+function includeResponse(contentType: string, data: Buffer): Buffer {
+  return Buffer.concat([
+    Buffer.from(`HTTP/2 200 OK\r\ncontent-type: ${contentType}\r\n\r\n`),
+    data,
+  ]);
+}
+
+describe('downloadPrImages', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    execFileSync.mockReset();
+  });
+
+  it('should download GitHub attachment images and return stored attachments with replaced bodies', () => {
+    const tmpRoot = createTempRoot();
+    const pngBytes = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00]);
+    execFileSync.mockReturnValue(includeResponse('image/png', pngBytes));
+
+    const prReview = createPrReview({
+      body: 'See ![screenshot](https://github.com/user-attachments/assets/abc123) below.',
+    });
+
+    const result = downloadPrImages(prReview, tmpRoot);
+
+    expect(result.attachments).toHaveLength(1);
+    const attachment = result.attachments[0]!;
+    expect(attachment.placeholder).toBe('[Image #1]');
+    expect(attachment.fileName).toBe('image-1.png');
+    expect(fs.readFileSync(attachment.tempPath)).toEqual(pngBytes);
+    expect(result.prReview.body).toBe('See [Image #1] below.');
+  });
+
+  it('should reject a downloaded image whose Content-Type does not match a supported format', () => {
+    const tmpRoot = createTempRoot();
+    const pngBytes = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00]);
+    execFileSync.mockReturnValue(includeResponse('text/html', pngBytes));
+
+    const prReview = createPrReview({
+      body: '![screenshot](https://github.com/user-attachments/assets/abc123)',
+    });
+
+    expect(() => downloadPrImages(prReview, tmpRoot)).toThrow(/unsupported content-type/i);
+  });
+
+  it('should reject a downloaded image whose Content-Type header is missing', () => {
+    const tmpRoot = createTempRoot();
+    const pngBytes = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00]);
+    execFileSync.mockReturnValue(pngBytes);
+
+    const prReview = createPrReview({
+      body: '![screenshot](https://github.com/user-attachments/assets/abc123)',
+    });
+
+    expect(() => downloadPrImages(prReview, tmpRoot)).toThrow(/unsupported content-type/i);
+  });
+
+  it('should reject a downloaded image whose magic bytes do not match a supported format', () => {
+    const tmpRoot = createTempRoot();
+    execFileSync.mockReturnValue(includeResponse('image/png', Buffer.from('not-an-image')));
+
+    const prReview = createPrReview({
+      body: '![screenshot](https://github.com/user-attachments/assets/abc123)',
+    });
+
+    expect(() => downloadPrImages(prReview, tmpRoot)).toThrow(/unsupported image format/i);
+  });
+
+  it('should reject a downloaded image that exceeds the size limit', () => {
+    const tmpRoot = createTempRoot();
+    const oversized = Buffer.concat([
+      Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+      Buffer.alloc(11 * 1024 * 1024),
+    ]);
+    execFileSync.mockReturnValue(includeResponse('image/png', oversized));
+
+    const prReview = createPrReview({
+      body: '![screenshot](https://github.com/user-attachments/assets/abc123)',
+    });
+
+    expect(() => downloadPrImages(prReview, tmpRoot)).toThrow(/size limit/i);
+  });
+
+  it('should skip external non-GitHub URLs without downloading them', () => {
+    const tmpRoot = createTempRoot();
+    const prReview = createPrReview({
+      body: '![external](https://example.com/image.png)',
+    });
+
+    const result = downloadPrImages(prReview, tmpRoot);
+
+    expect(execFileSync).not.toHaveBeenCalled();
+    expect(result.attachments).toEqual([]);
+    expect(result.prReview.body).toBe('![external](https://example.com/image.png)');
+  });
+
+  it('should replace image references in all comment bodies with placeholders', () => {
+    const tmpRoot = createTempRoot();
+    const pngBytes = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00]);
+    execFileSync.mockReturnValue(includeResponse('image/png', pngBytes));
+
+    const prReview = createPrReview({
+      body: '![body](https://github.com/user-attachments/assets/body1)',
+      comments: [{ author: 'commenter', body: '![comment](https://github.com/user-attachments/assets/comment1)' }],
+      reviews: [{ author: 'reviewer', body: '![thread](https://github.com/user-attachments/assets/thread1)' }],
+    });
+
+    const result = downloadPrImages(prReview, tmpRoot);
+
+    expect(result.prReview.body).toBe('[Image #1]');
+    expect(result.prReview.comments[0]!.body).toBe('[Image #2]');
+    expect(result.prReview.reviews[0]!.body).toBe('[Image #3]');
+  });
+});
