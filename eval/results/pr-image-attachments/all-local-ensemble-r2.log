    18	  const args = process.argv.slice(2);
    19	  const cleanupImmediateSigintExit = installImmediateSigintExit(args[0]);
    20	
    21	  try {
    22	    try {
    23	      const { operands } = program.parseOptions(args);
    24	      const removedRootCommand = resolveRemovedRootCommand(operands);
    25	      if (removedRootCommand !== null) {
    26	        await scheduleUpdateCheck();
    27	        errorLog(`error: unknown command '${removedRootCommand}'`);
    28	        return process.exit(1);
    29	      }
    30	
    31	      const knownCommands = program.commands.map((cmd) => cmd.name());
    32	      const slashFallbackTask = resolveSlashFallbackTask(args, knownCommands);
    33	
    34	      if (slashFallbackTask !== null) {
    35	        await runPreActionHook();
    36	        const { executeDefaultAction } = await import('./routing.js');
    37	        await executeDefaultAction(slashFallbackTask);
    38	        return process.exit();
    39	      }
    40	
    41	      await program.parseAsync();
    42	    } catch (error) {
    43	      if (!(error instanceof CommanderError)) throw error;
    44	      await scheduleUpdateCheck();
    45	      return process.exit(error.exitCode);
    46	    }
    47	
    48	    const rootArg = process.argv.slice(2)[0];
    49	    if (rootArg !== 'watch') {
    50	      process.exit();
    51	    }
    52	  } finally {
    53	    cleanupImmediateSigintExit();
    54	  }
    55	})().catch((err) => {
    56	  errorLog(sanitizeTerminalText(getErrorMessage(err)));
    57	  process.exit(1);
    58	});
