    22	
    23	export function installImmediateSigintExit(
    24	  commandName: string | undefined,
    25	  runtime: ProcessLike = process as unknown as ProcessLike,
    26	): () => void {
    27	  if (!isRunLikeCommand(commandName)) {
    28	    return () => {};
    29	  }
    30	
    31	  const stdin = runtime.stdin;
    32	  const hadRawMode = stdin.isRaw === true;
    33	  let enabledRawMode = false;
    34	  let cleanedUp = false;
    35	
    36	  if (!stdin.isTTY) {
    37	    return () => {};
    38	  }
    39	
    40	  if (typeof stdin.setRawMode === 'function' && !hadRawMode) {
    41	    stdin.setRawMode(true);
    42	    enabledRawMode = true;
    43	  }
    44	
    45	  const onData = (chunk: Buffer | string): void => {
    46	    const text = typeof chunk === 'string' ? chunk : chunk.toString('utf-8');
    47	    if (text.includes('\u0003')) {
    48	      runtime.emit('SIGINT');
    49	    }
    50	  };
    51	
    52	  stdin.on('data', onData);
    53	  stdin.resume();
    54	
    55	  const cleanup = (): void => {
    56	    if (cleanedUp) {
    57	      return;
    58	    }
    59	    cleanedUp = true;
    60	    stdin.removeListener('data', onData);
    61	    stdin.pause();
    62	    if (enabledRawMode && typeof stdin.setRawMode === 'function') {
    63	      stdin.setRawMode(false);
    64	    }
    65	  };
    66	
    67	  runtime.once('exit', cleanup);
    68	  return cleanup;
    69	}
