    63	export async function callAIWithRetry(
    64	  prompt: string,
    65	  systemPrompt: string,
    66	  allowedTools: string[],
    67	  cwd: string,
    68	  ctx: SessionContext,
    69	  options: CallAIWithRetryOptions = {},
    70	): Promise<{ result: CallAIResult | null; sessionId: string | undefined }> {
    71	  const outputMode = options.outputMode ?? 'terminal';
    72	  const display = outputMode === 'terminal'
    73	    ? new StreamDisplay('assistant', isQuietMode())
    74	    : undefined;
    75	  const abortController = new AbortController();
    76	  const onExternalAbort = (): void => {
    77	    abortController.abort(options.abortSignal?.reason);
    78	  };
    79	  if (options.abortSignal?.aborted) {
    80	    onExternalAbort();
    81	  } else {
    82	    options.abortSignal?.addEventListener('abort', onExternalAbort, { once: true });
    83	  }
    84	  let sigintCount = 0;
    85	  const onSigInt = (): void => {
    86	    sigintCount += 1;
    87	    if (sigintCount === 1) {
    88	      blankLine();
    89	      info(getLabel('workflow.sigintGraceful', ctx.lang));
    90	      abortController.abort();
    91	      return;
    92	    }
    93	    blankLine();
    94	    error(getLabel('workflow.sigintForce', ctx.lang));
    95	    process.exit(EXIT_SIGINT);
    96	  };
    97	  if (outputMode === 'terminal') {
    98	    process.on('SIGINT', onSigInt);
    99	  }
   100	  let { sessionId } = ctx;
