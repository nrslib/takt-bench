   218	export function resolveTaskContent(options: PipelineExecutionOptions): TaskContent | undefined {
   219	  const { cwd } = options;
   220	  if (options.prNumber) {
   221	    info(`Fetching PR #${options.prNumber} review comments...`);
   222	    const prReview = fetchVcsResource(
   223	      `PR #${options.prNumber}`,
   224	      cwd,
   225	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   226	    );
   227	    if (!prReview) return undefined;
   228	    const { prReview: prReviewWithImages, attachments } = downloadPrImages(prReview, cwd);
   229	    const task = formatPrReviewAsTask(prReviewWithImages);
   230	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   231	    return {
   232	      task,
   233	      prBranch: prReview.headRefName,
   234	      prBaseBranch: prReview.baseRefName,
   235	      ...(attachments.length > 0 ? { attachments } : {}),
   236	    };
   237	  }
   238	  if (options.issueNumber) {
   239	    info(`Fetching issue #${options.issueNumber}...`);
   240	    const issue = fetchVcsResource(
   241	      `issue #${options.issueNumber}`,
   242	      cwd,
   243	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   244	    );
   245	    if (!issue) return undefined;
   246	    const task = formatIssueAsTask(issue);
   247	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   248	    return { task, issue };
   249	  }
   250	  if (options.task) {
   251	    return { task: options.task };
   252	  }
   253	  error('Either --issue, --pr, or --task must be specified');
   254	  return undefined;
   255	}
   256	
   257	export async function resolveExecutionContext(
   258	  cwd: string,
   259	  task: string,
   260	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   261	  pipelineConfig: PipelineConfig | undefined,
   262	  prBranch?: string,
   263	  prBaseBranch?: string,
   264	): Promise<ExecutionContext> {
   265	  if (options.prNumber !== undefined) {
   266	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   267	  }
   268	  if (options.createWorktree) {
   269	    const result = await confirmAndCreateWorktree(
   270	      cwd,
   271	      task,
   272	      options.createWorktree,
   273	      prBranch,
   274	      prBaseBranch,
   275	      options.prNumber !== undefined,
   276	    );
   277	    const branch = requireBranch(result.branch, 'worktree execution');
   278	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   279	    if (result.isWorktree) {
   280	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   281	    }
   282	    if (
   283	      options.prNumber !== undefined
   284	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   285	    ) {
   286	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   287	    }
   288	    return attachPipelinePrContext(
   289	      options.prNumber,
   290	      prBaseBranch,
   291	      {
   292	        execCwd: result.execCwd,
   293	        branch,
   294	        baseBranch,
   295	        isWorktree: result.isWorktree,
   296	        taskSlug: result.taskSlug,
   297	      },
   298	      {
   299	        baseRef: result.pullRequestBaseRef,
   300	        headRef: result.pullRequestHeadRef,
   301	      },
   302	    );
   303	  }
   304	  if (options.skipGit) {
   305	    return attachPipelinePrContext(
   306	      options.prNumber,
   307	      prBaseBranch,
   308	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   309	    );
   310	  }
   311	  if (prBranch) {
   312	    const safePrBranch = sanitizeTerminalText(prBranch);
   313	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   314	    checkoutBranch(cwd, prBranch);
   315	    success(`Checked out PR branch: ${safePrBranch}`);
   316	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   317	    return attachPipelinePrContext(
   318	      options.prNumber,
   319	      prBaseBranch,
   320	      {
   321	        execCwd: cwd,
   322	        branch: prBranch,
   323	        baseBranch,
   324	        isWorktree: false,
   325	      },
   326	      {
   327	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   328	        headRef: toLocalBranchRef(prBranch),
   329	      },
   330	    );
   331	  }
   332	  const baseBranch = resolveExecutionBaseBranch(cwd);
   333	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   334	  const safeBranch = sanitizeTerminalText(branch);
   335	  info(`Creating branch: ${safeBranch}`);
   336	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   337	  success(`Branch created: ${safeBranch}`);
   338	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   339	}
   340	
   341	export async function runWorkflow(
   342	  projectCwd: string,
   343	  workflow: string,
   344	  task: string,
   345	  execCwd: string,
   346	  options: Pick<PipelineExecutionOptions, 'provider' | 'model' | 'autoStrategy' | 'issueNumber' | 'prNumber'>,
   347	  context: ExecutionContext,
   348	  attachments?: TaskAttachment[],
   349	): Promise<boolean> {
   350	  const safeWorkflow = sanitizeTerminalText(workflow);
   351	  info(`Running workflow: ${safeWorkflow}`);
   352	  const agentOverrides: TaskExecutionOptions | undefined = (options.provider || options.model || options.autoStrategy)
   353	    ? {
   354	        ...(options.provider !== undefined ? { provider: options.provider } : {}),
   355	        ...(options.model !== undefined ? { model: options.model } : {}),
   356	        ...(options.autoStrategy !== undefined ? { autoStrategy: options.autoStrategy } : {}),
   357	      }
   358	    : undefined;
   359	
   360	  let taskSpec: ResolvedTaskSpec | undefined;
   361	  let preparedSpecTaskDir: string | undefined;
   362	  if (attachments !== undefined && attachments.length > 0) {
   363	    const preparedSpec = prepareTaskSpecDirectory(projectCwd, task, attachments);
   364	    preparedSpecTaskDir = preparedSpec.taskDir;
   365	    const reportDirName = generateExecutionReportDir(execCwd, task);
   366	    taskSpec = resolveTaskSpecForExecution(
   367	      projectCwd,
   368	      execCwd,
   369	      preparedSpec.taskDirRelative,
   370	      reportDirName,
   371	    );
   372	  }
   373	
   374	  statusLine.start('Running...');
   375	  let taskSuccess: boolean;
   376	  try {
   377	    taskSuccess = await executeTask({
   378	      task: taskSpec?.taskPrompt ?? task,
   379	      ...(taskSpec === undefined ? {} : { taskSpec }),
   380	      ...(taskSpec === undefined ? {} : { reportDirName: taskSpec.runSlug }),
   381	      cwd: execCwd,
   382	      workflowIdentifier: workflow,
   383	      projectCwd,
   384	      agentOverrides,
   385	      traceTaskContext: buildPipelineTraceTaskContext(options, context),
   386	      ...(context.prContext ? { prContext: context.prContext } : {}),
   387	    });
   388	  } finally {
   389	    statusLine.stop();
   390	    if (preparedSpecTaskDir !== undefined) {
   391	      cleanupPreparedTaskSpec(preparedSpecTaskDir);
   392	    }
   393	  }
   394	
   395	  if (!taskSuccess) {
   396	    error(`Workflow '${safeWorkflow}' failed`);
   397	    return false;
   398	  }
   399	  success(`Workflow '${safeWorkflow}' completed`);
   400	  return true;
   401	}
   402	
   403	function buildPipelineTraceTaskContext(
   404	  options: Pick<PipelineExecutionOptions, 'issueNumber' | 'prNumber'>,
   405	  context: ExecutionContext,
   406	): PipelineTraceTaskContext {
   407	  return {
   408	    issueNumber: options.issueNumber,
   409	    prNumber: options.prNumber,
   410	    branch: context.branch,
   411	    baseBranch: context.baseBranch,
   412	    taskSlug: context.isWorktree ? context.taskSlug : undefined,
   413	    worktreePath: context.isWorktree ? context.execCwd : undefined,
   414	  };
   415	}
