    15	export interface ResolvedTaskSpec {
    16	  readonly runSlug: string;
    17	  readonly sourceTaskDir: string;
    18	  readonly attachmentManifest: TaskAttachmentManifest;
    19	  readonly taskPrompt: string;
    20	  readonly orderContent: string;
    21	  readonly stagedOrderContent: string;
    22	}
    23	
    24	function getTaskSpecPath(projectCwd: string, taskDir: string): string {
    25	  return path.join(projectCwd, taskDir, 'order.md');
    26	}
    27	
    28	function rewriteAttachmentPathsForRunContext(orderContent: string, contextTaskRel: string): string {
    29	  const contextTaskRelPosix = contextTaskRel.replace(/\\/g, '/');
    30	  const toRunContextPath = (attachmentPath: string): string => {
    31	    const segments = attachmentPath.split('/');
    32	    if (segments.some((segment) => segment === '..' || segment.length === 0)) {
    33	      throw new Error(`Invalid task attachment path: attachments/${attachmentPath}`);
    34	    }
    35	    return path.posix.join(contextTaskRelPosix, 'attachments', attachmentPath);
    36	  };
    37	  const splitTrailingPunctuation = (attachmentPath: string): { pathPart: string; suffix: string } => {
    38	    const match = attachmentPath.match(/^(.+?)([.!?,;:]*)$/);
    39	    return {
    40	      pathPart: match?.[1] ?? attachmentPath,
    41	      suffix: match?.[2] ?? '',
    42	    };
    43	  };
    44	  const backticked = orderContent.replace(/`attachments\/([^`\r\n]+)`/g, (_match, attachmentPath: string) =>
    45	    `\`${toRunContextPath(attachmentPath)}\``,
    46	  );
    47	  return backticked.replace(/(^|[\s([:])attachments\/([A-Za-z0-9._/-]+)/g, (
    48	    _match,
    49	    prefix: string,
    50	    attachmentPath: string,
    51	  ) => {
    52	    const { pathPart, suffix } = splitTrailingPunctuation(attachmentPath);
    53	    return `${prefix}\`${toRunContextPath(pathPart)}\`${suffix}`;
    54	  });
    55	}
    56	
    57	export function resolveTaskSpecForExecution(
    58	  projectCwd: string,
    59	  execCwd: string,
    60	  taskDir: string,
    61	  reportDirName: string,
    62	): ResolvedTaskSpec {
    63	  const sourceTaskDir = path.join(projectCwd, taskDir);
    64	  const sourceOrderPath = getTaskSpecPath(projectCwd, taskDir);
    65	  const orderContent = readTaskSpecFile(sourceOrderPath);
    66	  const runPaths = buildRunPaths(execCwd, reportDirName);
    67	  const stagedOrderContent = rewriteAttachmentPathsForRunContext(orderContent, runPaths.contextTaskRel);
    68	  const attachmentManifest = resolveTaskAttachmentManifest(sourceTaskDir);
    69	
    70	  return Object.freeze({
    71	    runSlug: runPaths.slug,
    72	    sourceTaskDir,
    73	    attachmentManifest,
    74	    taskPrompt: buildTaskInstruction(runPaths.contextTaskRel, runPaths.contextTaskOrderRel),
    75	    orderContent,
    76	    stagedOrderContent,
    77	  });
    78	}
    79	
    80	export function stageTaskSpecForExecution(
    81	  taskSpec: ResolvedTaskSpec,
    82	  runPaths: RunPaths,
    83	): void {
    84	  if (taskSpec.runSlug !== runPaths.slug) {
    85	    throw new Error(
    86	      `Task spec run "${taskSpec.runSlug}" does not match reserved run "${runPaths.slug}"`,
    87	    );
    88	  }
    89	  try {
    90	    fs.mkdirSync(runPaths.contextTaskAbs, { recursive: true });
    91	    fs.writeFileSync(
    92	      runPaths.contextTaskOrderAbs,
    93	      taskSpec.stagedOrderContent,
    94	      'utf-8',
    95	    );
    96	    copyTaskAttachmentsToRunContext(
    97	      taskSpec.sourceTaskDir,
    98	      runPaths.contextTaskAbs,
    99	      taskSpec.attachmentManifest,
   100	    );
   101	  } catch (error) {
   102	    fs.rmSync(runPaths.contextTaskAbs, { recursive: true, force: true });
   103	    throw error;
   104	  }
   105	}
