diff --git a/src/infra/git/imageExtraction.ts b/src/infra/git/imageExtraction.ts
new file mode 100644
index 00000000..1d2b3a82
--- /dev/null
+++ b/src/infra/git/imageExtraction.ts
@@ -0,0 +1,48 @@
+/**
+ * Image reference extraction and replacement for Markdown / HTML bodies.
+ *
+ * These functions are provider-neutral and operate on plain text bodies.
+ */
+
+const FENCED_CODE_BLOCK = /```[\s\S]*?```/g;
+const INLINE_CODE = /`[^`\n]*`/g;
+const IMAGE_SYNTAX = /!\[[^\]]*\]\(([^)\s]+)\)|<img[^>]*\bsrc="([^"]+)"[^>]*\/?>/gi;
+
+function stripCode(body: string): string {
+  return body.replace(FENCED_CODE_BLOCK, '').replace(INLINE_CODE, '');
+}
+
+/**
+ * Extract image URLs from a body in document order.
+ *
+ * Supports Markdown image syntax (`![alt](url)`) and HTML `<img src="...">`.
+ * URLs inside fenced code blocks and inline code spans are ignored.
+ */
+export function extractImageUrls(body: string): string[] {
+  const sanitized = stripCode(body);
+  const urls: string[] = [];
+  for (const match of sanitized.matchAll(IMAGE_SYNTAX)) {
+    const url = match[1] ?? match[2];
+    if (url) {
+      urls.push(url);
+    }
+  }
+  return urls;
+}
+
+/**
+ * Replace image references in a body with mapped placeholders.
+ *
+ * Each Markdown image or HTML `<img>` whose URL is present in `urlToPlaceholder`
+ * is replaced with the mapped placeholder. Unmapped image syntax is left unchanged.
+ */
+export function replaceImageReferences(
+  body: string,
+  urlToPlaceholder: ReadonlyMap<string, string>,
+): string {
+  return body.replace(IMAGE_SYNTAX, (match, markdownUrl: string | undefined, htmlUrl: string | undefined) => {
+    const url = markdownUrl ?? htmlUrl;
+    const placeholder = url === undefined ? undefined : urlToPlaceholder.get(url);
+    return placeholder ?? match;
+  });
+}
diff --git a/src/infra/github/imageDownload.ts b/src/infra/github/imageDownload.ts
new file mode 100644
index 00000000..21b496fc
--- /dev/null
+++ b/src/infra/github/imageDownload.ts
@@ -0,0 +1,152 @@
+/**
+ * PR image download utilities.
+ *
+ * Extracts image URLs from PR review data, downloads GitHub attachment images
+ * via the authenticated `gh` CLI, validates them, and stores them as task
+ * attachments with placeholder references.
+ */
+
+import { execFileSync } from 'node:child_process';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import type { PrReviewData } from '../git/types.js';
+import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
+import { extractImageUrls, replaceImageReferences } from '../git/imageExtraction.js';
+
+const GITHUB_ATTACHMENT_URL = /^https:\/\/github\.com\/(?:user-attachments\/assets\/[^/]+|[^/]+\/[^/]+\/assets\/[^/]+)$/;
+
+const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
+
+const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+const JPEG_MAGIC = Buffer.from([0xff, 0xd8, 0xff]);
+const GIF_MAGIC_89A = Buffer.from('GIF89a');
+const GIF_MAGIC_87A = Buffer.from('GIF87a');
+const RIFF_MAGIC = Buffer.from('RIFF');
+const WEBP_MAGIC = Buffer.from('WEBP');
+
+/**
+ * Return true when the URL is a GitHub-hosted attachment asset URL.
+ *
+ * Accepts `https://github.com/user-attachments/assets/<id>` and
+ * `https://github.com/<org>/<repo>/assets/<id>`. Rejects external and
+ * non-https URLs.
+ */
+export function isGitHubAttachmentUrl(url: string): boolean {
+  return GITHUB_ATTACHMENT_URL.test(url);
+}
+
+function detectImageFormat(data: Buffer): string | undefined {
+  if (data.length >= PNG_MAGIC.length && data.subarray(0, PNG_MAGIC.length).equals(PNG_MAGIC)) {
+    return 'png';
+  }
+  if (data.length >= JPEG_MAGIC.length && data.subarray(0, JPEG_MAGIC.length).equals(JPEG_MAGIC)) {
+    return 'jpeg';
+  }
+  if (
+    data.length >= GIF_MAGIC_89A.length
+    && (data.subarray(0, GIF_MAGIC_89A.length).equals(GIF_MAGIC_89A)
+      || data.subarray(0, GIF_MAGIC_87A.length).equals(GIF_MAGIC_87A))
+  ) {
+    return 'gif';
+  }
+  if (
+    data.length >= 12
+    && data.subarray(0, 4).equals(RIFF_MAGIC)
+    && data.subarray(8, 12).equals(WEBP_MAGIC)
+  ) {
+    return 'webp';
+  }
+  return undefined;
+}
+
+const SUPPORTED_CONTENT_TYPES = new Set(['image/png', 'image/jpeg', 'image/gif', 'image/webp']);
+
+function downloadImage(url: string, cwd: string): { contentType: string | undefined; data: Buffer } {
+  const raw = execFileSync('gh', ['api', '--include', url], {
+    cwd,
+    encoding: null,
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  const separator = raw.indexOf(Buffer.from('\r\n\r\n'));
+  if (separator === -1) {
+    return { contentType: undefined, data: raw };
+  }
+  const headerBlock = raw.subarray(0, separator).toString('utf8');
+  const data = raw.subarray(separator + 4);
+  const contentType = headerBlock
+    .split('\r\n')
+    .find((line) => line.toLowerCase().startsWith('content-type:'))
+    ?.split(':')
+    .slice(1)
+    .join(':')
+    .trim();
+  return { contentType, data };
+}
+
+interface MutableBody {
+  body: string;
+  set: (body: string) => void;
+}
+
+/**
+ * Download GitHub attachment images referenced in PR review data and return
+ * stored task attachments with image references replaced by placeholders.
+ *
+ * Only GitHub attachment URLs are downloaded. Each downloaded image is
+ * validated against supported magic bytes and a size limit. The returned
+ * `prReview` has image references in the PR body, conversation comments, and
+ * review comments replaced with `[Image #N]` placeholders.
+ */
+export function downloadPrImages(
+  prReview: PrReviewData,
+  cwd: string,
+): { prReview: PrReviewData; attachments: StoredImageAttachment[] } {
+  const attachments: StoredImageAttachment[] = [];
+  const urlToPlaceholder = new Map<string, string>();
+  const tmpDir = path.join(cwd, '.takt', 'tmp', 'pr-images');
+  fs.mkdirSync(tmpDir, { recursive: true });
+
+  const bodies: MutableBody[] = [
+    { body: prReview.body, set: (body) => { prReview.body = body; } },
+    ...prReview.comments.map((comment) => ({
+      body: comment.body,
+      set: (body: string) => { comment.body = body; },
+    })),
+    ...prReview.reviews.map((review) => ({
+      body: review.body,
+      set: (body: string) => { review.body = body; },
+    })),
+  ];
+
+  for (const { body } of bodies) {
+    for (const url of extractImageUrls(body)) {
+      if (!isGitHubAttachmentUrl(url) || urlToPlaceholder.has(url)) {
+        continue;
+      }
+      const { contentType, data } = downloadImage(url, cwd);
+      if (contentType === undefined || !SUPPORTED_CONTENT_TYPES.has(contentType)) {
+        throw new Error(`Unsupported Content-Type for ${url}`);
+      }
+      const format = detectImageFormat(data);
+      if (format === undefined) {
+        throw new Error(`Unsupported image format for ${url}`);
+      }
+      if (data.length > MAX_IMAGE_BYTES) {
+        throw new Error(`Image exceeds size limit for ${url}`);
+      }
+      const index = attachments.length + 1;
+      const fileName = `image-${index}.${format}`;
+      const tempPath = path.join(tmpDir, fileName);
+      fs.writeFileSync(tempPath, data);
+      const placeholder = `[Image #${index}]`;
+      attachments.push({ placeholder, tempPath, fileName });
+      urlToPlaceholder.set(url, placeholder);
+    }
+  }
+
+  for (const { body, set } of bodies) {
+    set(replaceImageReferences(body, urlToPlaceholder));
+  }
+
+  return { prReview, attachments };
+}
     1	/**
     2	 * Image reference extraction and replacement for Markdown / HTML bodies.
     3	 *
     4	 * These functions are provider-neutral and operate on plain text bodies.
     5	 */
     6	
     7	const FENCED_CODE_BLOCK = /```[\s\S]*?```/g;
     8	const INLINE_CODE = /`[^`\n]*`/g;
     9	const IMAGE_SYNTAX = /!\[[^\]]*\]\(([^)\s]+)\)|<img[^>]*\bsrc="([^"]+)"[^>]*\/?>/gi;
    10	
    11	function stripCode(body: string): string {
    12	  return body.replace(FENCED_CODE_BLOCK, '').replace(INLINE_CODE, '');
    13	}
    14	
    15	/**
    16	 * Extract image URLs from a body in document order.
    17	 *
    18	 * Supports Markdown image syntax (`![alt](url)`) and HTML `<img src="...">`.
    19	 * URLs inside fenced code blocks and inline code spans are ignored.
    20	 */
    21	export function extractImageUrls(body: string): string[] {
    22	  const sanitized = stripCode(body);
    23	  const urls: string[] = [];
    24	  for (const match of sanitized.matchAll(IMAGE_SYNTAX)) {
    25	    const url = match[1] ?? match[2];
    26	    if (url) {
    27	      urls.push(url);
    28	    }
    29	  }
    30	  return urls;
    31	}
    32	
    33	/**
    34	 * Replace image references in a body with mapped placeholders.
    35	 *
    36	 * Each Markdown image or HTML `<img>` whose URL is present in `urlToPlaceholder`
    37	 * is replaced with the mapped placeholder. Unmapped image syntax is left unchanged.
    38	 */
    39	export function replaceImageReferences(
    40	  body: string,
    41	  urlToPlaceholder: ReadonlyMap<string, string>,
    42	): string {
    43	  return body.replace(IMAGE_SYNTAX, (match, markdownUrl: string | undefined, htmlUrl: string | undefined) => {
    44	    const url = markdownUrl ?? htmlUrl;
    45	    const placeholder = url === undefined ? undefined : urlToPlaceholder.get(url);
    46	    return placeholder ?? match;
    47	  });
    48	}
     1	/**
     2	 * PR image download utilities.
     3	 *
     4	 * Extracts image URLs from PR review data, downloads GitHub attachment images
     5	 * via the authenticated `gh` CLI, validates them, and stores them as task
     6	 * attachments with placeholder references.
     7	 */
     8	
     9	import { execFileSync } from 'node:child_process';
    10	import * as fs from 'node:fs';
    11	import * as path from 'node:path';
    12	import type { PrReviewData } from '../git/types.js';
    13	import type { StoredImageAttachment } from '../../shared/types/image-attachments.js';
    14	import { extractImageUrls, replaceImageReferences } from '../git/imageExtraction.js';
    15	
    16	const GITHUB_ATTACHMENT_URL = /^https:\/\/github\.com\/(?:user-attachments\/assets\/[^/]+|[^/]+\/[^/]+\/assets\/[^/]+)$/;
    17	
    18	const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
    19	
    20	const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
    21	const JPEG_MAGIC = Buffer.from([0xff, 0xd8, 0xff]);
    22	const GIF_MAGIC_89A = Buffer.from('GIF89a');
    23	const GIF_MAGIC_87A = Buffer.from('GIF87a');
    24	const RIFF_MAGIC = Buffer.from('RIFF');
    25	const WEBP_MAGIC = Buffer.from('WEBP');
    26	
    27	/**
    28	 * Return true when the URL is a GitHub-hosted attachment asset URL.
    29	 *
    30	 * Accepts `https://github.com/user-attachments/assets/<id>` and
    31	 * `https://github.com/<org>/<repo>/assets/<id>`. Rejects external and
    32	 * non-https URLs.
    33	 */
    34	export function isGitHubAttachmentUrl(url: string): boolean {
    35	  return GITHUB_ATTACHMENT_URL.test(url);
    36	}
    37	
    38	function detectImageFormat(data: Buffer): string | undefined {
    39	  if (data.length >= PNG_MAGIC.length && data.subarray(0, PNG_MAGIC.length).equals(PNG_MAGIC)) {
    40	    return 'png';
    41	  }
    42	  if (data.length >= JPEG_MAGIC.length && data.subarray(0, JPEG_MAGIC.length).equals(JPEG_MAGIC)) {
    43	    return 'jpeg';
    44	  }
    45	  if (
    46	    data.length >= GIF_MAGIC_89A.length
    47	    && (data.subarray(0, GIF_MAGIC_89A.length).equals(GIF_MAGIC_89A)
    48	      || data.subarray(0, GIF_MAGIC_87A.length).equals(GIF_MAGIC_87A))
    49	  ) {
    50	    return 'gif';
    51	  }
    52	  if (
    53	    data.length >= 12
    54	    && data.subarray(0, 4).equals(RIFF_MAGIC)
    55	    && data.subarray(8, 12).equals(WEBP_MAGIC)
    56	  ) {
    57	    return 'webp';
    58	  }
    59	  return undefined;
    60	}
    61	
    62	const SUPPORTED_CONTENT_TYPES = new Set(['image/png', 'image/jpeg', 'image/gif', 'image/webp']);
    63	
    64	function downloadImage(url: string, cwd: string): { contentType: string | undefined; data: Buffer } {
    65	  const raw = execFileSync('gh', ['api', '--include', url], {
    66	    cwd,
    67	    encoding: null,
    68	    stdio: ['pipe', 'pipe', 'pipe'],
    69	  });
    70	  const separator = raw.indexOf(Buffer.from('\r\n\r\n'));
    71	  if (separator === -1) {
    72	    return { contentType: undefined, data: raw };
    73	  }
    74	  const headerBlock = raw.subarray(0, separator).toString('utf8');
    75	  const data = raw.subarray(separator + 4);
    76	  const contentType = headerBlock
    77	    .split('\r\n')
    78	    .find((line) => line.toLowerCase().startsWith('content-type:'))
    79	    ?.split(':')
    80	    .slice(1)
    81	    .join(':')
    82	    .trim();
    83	  return { contentType, data };
    84	}
    85	
    86	interface MutableBody {
    87	  body: string;
    88	  set: (body: string) => void;
    89	}
    90	
    91	/**
    92	 * Download GitHub attachment images referenced in PR review data and return
    93	 * stored task attachments with image references replaced by placeholders.
    94	 *
    95	 * Only GitHub attachment URLs are downloaded. Each downloaded image is
    96	 * validated against supported magic bytes and a size limit. The returned
    97	 * `prReview` has image references in the PR body, conversation comments, and
    98	 * review comments replaced with `[Image #N]` placeholders.
    99	 */
   100	export function downloadPrImages(
   101	  prReview: PrReviewData,
   102	  cwd: string,
   103	): { prReview: PrReviewData; attachments: StoredImageAttachment[] } {
   104	  const attachments: StoredImageAttachment[] = [];
   105	  const urlToPlaceholder = new Map<string, string>();
   106	  const tmpDir = path.join(cwd, '.takt', 'tmp', 'pr-images');
   107	  fs.mkdirSync(tmpDir, { recursive: true });
   108	
   109	  const bodies: MutableBody[] = [
   110	    { body: prReview.body, set: (body) => { prReview.body = body; } },
   111	    ...prReview.comments.map((comment) => ({
   112	      body: comment.body,
   113	      set: (body: string) => { comment.body = body; },
   114	    })),
   115	    ...prReview.reviews.map((review) => ({
   116	      body: review.body,
   117	      set: (body: string) => { review.body = body; },
   118	    })),
   119	  ];
   120	
   121	  for (const { body } of bodies) {
   122	    for (const url of extractImageUrls(body)) {
   123	      if (!isGitHubAttachmentUrl(url) || urlToPlaceholder.has(url)) {
   124	        continue;
   125	      }
   126	      const { contentType, data } = downloadImage(url, cwd);
   127	      if (contentType === undefined || !SUPPORTED_CONTENT_TYPES.has(contentType)) {
   128	        throw new Error(`Unsupported Content-Type for ${url}`);
   129	      }
   130	      const format = detectImageFormat(data);
   131	      if (format === undefined) {
   132	        throw new Error(`Unsupported image format for ${url}`);
   133	      }
   134	      if (data.length > MAX_IMAGE_BYTES) {
   135	        throw new Error(`Image exceeds size limit for ${url}`);
   136	      }
   137	      const index = attachments.length + 1;
   138	      const fileName = `image-${index}.${format}`;
   139	      const tempPath = path.join(tmpDir, fileName);
   140	      fs.writeFileSync(tempPath, data);
   141	      const placeholder = `[Image #${index}]`;
   142	      attachments.push({ placeholder, tempPath, fileName });
   143	      urlToPlaceholder.set(url, placeholder);
   144	    }
   145	  }
   146	
   147	  for (const { body, set } of bodies) {
   148	    set(replaceImageReferences(body, urlToPlaceholder));
   149	  }
   150	
   151	  return { prReview, attachments };
   152	}

