+import { describe, expect, it } from 'vitest';
+import {
+  extractImageUrls,
+  replaceImageReferences,
+} from '../infra/git/imageExtraction.js';
+
+describe('extractImageUrls', () => {
+  it('should extract Markdown image URLs from a body', () => {
+    const body = 'See ![screenshot](https://github.com/user-attachments/assets/abc123) below.';
+
+    expect(extractImageUrls(body)).toEqual([
+      'https://github.com/user-attachments/assets/abc123',
+    ]);
+  });
+
+  it('should extract HTML img src URLs from a body', () => {
+    const body = 'See <img src="https://github.com/org/repo/assets/def456" /> below.';
+
+    expect(extractImageUrls(body)).toEqual([
+      'https://github.com/org/repo/assets/def456',
+    ]);
+  });
+
+  it('should extract both Markdown and HTML image URLs in document order', () => {
+    const body = [
+      '![screenshot](https://github.com/user-attachments/assets/abc123)',
+      '<img src="https://github.com/org/repo/assets/def456" />',
+    ].join('\n');
+
+    expect(extractImageUrls(body)).toEqual([
+      'https://github.com/user-attachments/assets/abc123',
+      'https://github.com/org/repo/assets/def456',
+    ]);
+  });
+
+  it('should not extract image URLs inside fenced code blocks', () => {
+    const body = [
+      '```',
+      '![screenshot](https://github.com/user-attachments/assets/abc123)',
+      '```',
+    ].join('\n');
+
+    expect(extractImageUrls(body)).toEqual([]);
+  });
+
+  it('should not extract image URLs inside inline code spans', () => {
+    const body = 'Use `![screenshot](https://github.com/user-attachments/assets/abc123)` here.';
+
+    expect(extractImageUrls(body)).toEqual([]);
+  });
+
+  it('should return an empty array when no image syntax is present', () => {
+    expect(extractImageUrls('plain text without images')).toEqual([]);
+  });
+});
+
+describe('replaceImageReferences', () => {
+  it('should replace Markdown image syntax with the mapped placeholder', () => {
+    const body = 'See ![screenshot](https://github.com/user-attachments/assets/abc123) below.';
+    const urlToPlaceholder = new Map([
+      ['https://github.com/user-attachments/assets/abc123', '[Image #1]'],
+    ]);
+
+    expect(replaceImageReferences(body, urlToPlaceholder)).toBe(
+      'See [Image #1] below.',
+    );
+  });
+
+  it('should replace HTML img tags with the mapped placeholder', () => {
+    const body = 'See <img src="https://github.com/org/repo/assets/def456" /> below.';
+    const urlToPlaceholder = new Map([
+      ['https://github.com/org/repo/assets/def456', '[Image #1]'],
+    ]);
+
+    expect(replaceImageReferences(body, urlToPlaceholder)).toBe(
+      'See [Image #1] below.',
+    );
+  });
+
+  it('should assign placeholders in document order without collision', () => {
+    const body = [
+      '![first](https://github.com/user-attachments/assets/abc123)',
+      '<img src="https://github.com/org/repo/assets/def456" />',
+    ].join('\n');
+    const urlToPlaceholder = new Map([
+      ['https://github.com/user-attachments/assets/abc123', '[Image #1]'],
+      ['https://github.com/org/repo/assets/def456', '[Image #2]'],
+    ]);
+
+    expect(replaceImageReferences(body, urlToPlaceholder)).toBe(
+      '[Image #1]\n[Image #2]',
+    );
+  });
+
+  it('should not collide with an existing [Image #1] placeholder in the body', () => {
+    const body = 'Existing [Image #1] then ![new](https://github.com/user-attachments/assets/abc123).';
+    const urlToPlaceholder = new Map([
+      ['https://github.com/user-attachments/assets/abc123', '[Image #2]'],
+    ]);
+
+    expect(replaceImageReferences(body, urlToPlaceholder)).toBe(
+      'Existing [Image #1] then [Image #2].',
+    );
+  });
+
+  it('should leave image syntax without a mapped placeholder unchanged', () => {
+    const body = 'See ![screenshot](https://github.com/user-attachments/assets/abc123) below.';
+
+    expect(replaceImageReferences(body, new Map())).toBe(body);
+  });
+});
