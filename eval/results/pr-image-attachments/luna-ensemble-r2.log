   104	function attachPipelinePrContext(
   105	  prNumber: number | undefined,
   106	  prBaseBranch: string | undefined,
   107	  context: ExecutionContext,
   108	  materializedDiffRefs?: { baseRef?: string; headRef?: string },
   109	): ExecutionContext {
   110	  if (prNumber === undefined) {
   111	    return context;
   112	  }
