   194	
   195	function matchesImageFormat(mimeType: string, data: Buffer): boolean {
   196	  switch (mimeType) {
   197	    case 'image/png':
   198	      return hasPrefix(data, [0x89, 0x50, 0x4e, 0x47]);
   199	    case 'image/jpeg':
   200	      return hasPrefix(data, [0xff, 0xd8, 0xff]);
   201	    case 'image/gif':
   202	      return data.subarray(0, 6).toString('ascii') === 'GIF87a'
   203	        || data.subarray(0, 6).toString('ascii') === 'GIF89a';
   204	    case 'image/webp':
   205	      return hasWebpSignature(data);
   206	  }
   207	  return false;
   208	}
