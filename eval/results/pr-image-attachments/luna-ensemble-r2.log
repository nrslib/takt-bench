   202	function fetchVcsResource<T>(
   203	  label: string,
   204	  cwd: string,
   205	  fetch: (provider: ReturnType<typeof getGitProvider>) => T,
   206	): T | undefined {
   207	  const gitProvider = getGitProvider();
