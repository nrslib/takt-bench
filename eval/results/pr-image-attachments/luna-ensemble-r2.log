   130	const REVIEW_THREADS_QUERY = `
   131	query($owner:String!, $repo:String!, $number:Int!, $endCursor:String) {
   132	  repository(owner:$owner, name:$repo) {
   133	    pullRequest(number:$number) {
   134	      reviewThreads(first:${REVIEW_THREADS_PER_PAGE}, after:$endCursor) {
   135	        pageInfo { hasNextPage endCursor }
   136	        nodes {
   137	          id
   138	          isResolved
   139	          isOutdated
   140	          resolvedBy { login }
   141	          comments(first:${REVIEW_THREAD_COMMENTS_PER_PAGE}) {
   142	            pageInfo { hasNextPage endCursor }
   143	            nodes {
   144	              path
   145	              line
   146	              originalLine
   147	              body
   148	              url
   149	              author { login }
   150	            }
   151	          }
   152	        }
   153	      }
   154	    }
   155	  }
   156	}
   157	`;
   158	
   159	const REVIEW_THREAD_COMMENTS_QUERY = `
   160	query($threadId:ID!, $commentsEndCursor:String) {
   161	  node(id:$threadId) {
   162	    ... on PullRequestReviewThread {
   163	      comments(first:${REVIEW_THREAD_COMMENTS_PER_PAGE}, after:$commentsEndCursor) {
   164	        pageInfo { hasNextPage endCursor }
   165	        nodes {
   166	          path
   167	          line
   168	          originalLine
   169	          body
   170	          url
   171	          author { login }
   172	        }
   173	      }
   174	    }
   175	  }
   176	}
   177	`;
