    91	export function commentOnPr(prNumber: number, body: string, cwd: string): CommentResult {
    92	  const ghStatus = checkGhCli(cwd);
    93	  if (!ghStatus.available) {
    94	    return { success: false, error: ghStatus.error };
    95	  }
    96	
    97	  try {
    98	    execFileSync('gh', ['pr', 'comment', String(prNumber), '--body', body], {
    99	      cwd,
   100	      encoding: 'utf-8',
   101	      stdio: ['pipe', 'pipe', 'pipe'],
   102	    });
   103	    return { success: true };
   104	  } catch (err) {
   105	    const errorMessage = getErrorMessage(err);
   106	    log.error('PR comment failed', { error: errorMessage });
   107	    return { success: false, error: errorMessage };
   108	  }
   109	}
