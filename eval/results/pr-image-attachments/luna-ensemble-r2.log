   404	/**
   405	 * Fetch PR review comments and metadata via `gh pr view`.
   406	 * Throws on failure (PR not found, network error, etc.).
   407	 */
   408	export function fetchPrReviewComments(prNumber: number, cwd: string): PrReviewData {
   409	  log.debug('Fetching PR review comments', { prNumber });
   410	
   411	  const raw = execFileSync(
   412	    'gh',
   413	    ['pr', 'view', String(prNumber), '--json', PR_REVIEW_JSON_FIELDS],
   414	    { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   415	  );
   416	
   417	  const data = JSON.parse(raw) as GhPrViewReviewResponse;
   418	  const { owner, repo } = parseGitHubRepositoryFromPrUrl(data.url);
   419	  const threadReviewComments = fetchPrReviewThreads(owner, repo, prNumber, cwd);
   420	
   421	  const comments: PrReviewComment[] = data.comments.map((c) => ({
   422	    author: c.author.login,
   423	    body: c.body,
   424	  }));
   425	
   426	  const reviews: PrReviewComment[] = [];
   427	  for (const review of data.reviews) {
   428	    if (review.body) {
   429	      reviews.push({ author: review.author.login, body: review.body });
   430	    }
   431	  }
   432	  reviews.push(...threadReviewComments);
   433	
   434	  const prReview: PrReviewData = {
   435	    number: data.number,
   436	    title: data.title,
   437	    body: data.body,
   438	    url: data.url,
   439	    headRefName: data.headRefName,
   440	    baseRefName: data.baseRefName,
   441	    comments,
   442	    reviews,
   443	    files: data.files.map((f) => f.path),
   444	  };
   445	  return prReview;
   446	}
