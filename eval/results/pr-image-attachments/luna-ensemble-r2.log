   210	export function validateGitHubImagePayload(
   211	  contentType: string,
   212	  data: Buffer,
   213	): GitHubImagePayload {
   214	  const mimeType = contentType.split(';', 1)[0]!.trim().toLowerCase();
   215	  const format = IMAGE_FORMATS[mimeType];
   216	  if (format === undefined) {
   217	    throw new Error(`Unsupported GitHub image Content-Type: ${contentType}`);
   218	  }
   219	  if (data.length > MAX_GITHUB_IMAGE_BYTES) {
   220	    throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
   221	  }
   222	  if (!matchesImageFormat(mimeType, data)) {
   223	    throw new Error(`Content-Type and image data do not match: ${contentType}`);
   224	  }
   225	  return format;
   226	}
