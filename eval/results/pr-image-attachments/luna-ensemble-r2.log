   202	function fetchVcsResource<T>(
   203	  label: string,
   204	  cwd: string,
   205	  fetch: (provider: ReturnType<typeof getGitProvider>) => T,
   206	): T | undefined {
   207	  const gitProvider = getGitProvider();
   208	  const cliStatus = gitProvider.checkCliStatus(cwd);
   209	  if (!cliStatus.available) {
   210	    error(cliStatus.error);
   211	    return undefined;
   212	  }
   213	  try {
   214	    return fetch(gitProvider);
   215	  } catch (err) {
   216	    error(`Failed to fetch ${label}: ${getErrorMessage(err)}`);
   217	    return undefined;
   218	  }
   219	}
