   221	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   222	  const { cwd } = options;
   223	  if (options.prNumber) {
   224	    info(`Fetching PR #${options.prNumber} review comments...`);
   225	    const prReview = fetchVcsResource(
   226	      `PR #${options.prNumber}`,
   227	      cwd,
   228	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   229	    );
   230	    if (!prReview) return undefined;
   231	    try {
   232	      const prepared = await prepareGitHubPrTask(prReview, cwd);
   233	      try {
   234	        const task = formatPrReviewAsTask(prepared.review);
   235	        success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prepared.review.title)}"`);
   236	        return {
   237	          task,
   238	          prBranch: prepared.review.headRefName,
   239	          prBaseBranch: prepared.review.baseRefName,
   240	          ...(prepared.imageResource ? { attachments: [...prepared.imageResource.attachments] } : {}),
   241	          ...(prepared.imageResource ? { imageResource: prepared.imageResource } : {}),
   242	        };
   243	      } catch (error) {
   244	        prepared.imageResource?.cleanup();
   245	        throw error;
   246	      }
   247	    } catch (err) {
   248	      error(`Failed to prepare PR #${options.prNumber} images: ${getErrorMessage(err)}`);
   249	      return undefined;
   250	    }
   251	  }
   252	  if (options.issueNumber) {
   253	    info(`Fetching issue #${options.issueNumber}...`);
   254	    const issue = fetchVcsResource(
   255	      `issue #${options.issueNumber}`,
   256	      cwd,
   257	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   258	    );
   259	    if (!issue) return undefined;
   260	    const task = formatIssueAsTask(issue);
   261	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   262	    return { task, issue };
   263	  }
   264	  if (options.task) {
   265	    return { task: options.task };
   266	  }
   267	  error('Either --issue, --pr, or --task must be specified');
   268	  return undefined;
   269	}
