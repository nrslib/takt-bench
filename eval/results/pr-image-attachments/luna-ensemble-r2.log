    50	function removeHtmlComments(text: string): string {
    51	  let result = '';
    52	  let cursor = 0;
    53	  while (cursor < text.length) {
    54	    const start = text.indexOf('<!--', cursor);
    55	    if (start === -1) {
    56	      result += text.slice(cursor);
    57	      break;
    58	    }
    59	    result += text.slice(cursor, start);
    60	    const end = text.indexOf('-->', start + 4);
    61	    if (end === -1) {
    62	      result += ' '.repeat(text.length - start);
    63	      break;
    64	    }
    65	    result += ' '.repeat(end + 3 - start);
    66	    cursor = end + 3;
    67	  }
    68	  return result;
    69	}
    70	
    71	function removeFencedCodeBlocks(text: string): string {
    72	  const lines = text.split('\n');
    73	  let fenceCharacter: '`' | '~' | undefined;
    74	  let fenceLength = 0;
    75	
    76	  for (let index = 0; index < lines.length; index += 1) {
    77	    const lineWithoutQuote = lines[index]!.replace(/^\s{0,3}(?:>\s?)+/, '');
    78	    const fence = lineWithoutQuote.match(/^\s{0,3}(`{3,}|~{3,})/);
    79	    if (fenceCharacter !== undefined) {
    80	      lines[index] = ' '.repeat(lines[index]!.length);
    81	      if (
    82	        fence
    83	        && fence[1]![0] === fenceCharacter
    84	        && fence[1]!.length >= fenceLength
    85	      ) {
    86	        fenceCharacter = undefined;
    87	        fenceLength = 0;
    88	      }
    89	      continue;
    90	    }
    91	    if (fence) {
    92	      fenceCharacter = fence[1]![0] as '`' | '~';
    93	      fenceLength = fence[1]!.length;
    94	      lines[index] = ' '.repeat(lines[index]!.length);
    95	    }
    96	  }
    97	
    98	  return lines.join('\n');
    99	}
