   116	    ...context,
   117	    prContext: createPullRequestContext({
   118	      source: 'pr_review',
   119	      prNumber,
   120	      baseBranch,
   121	      headBranch: branch,
   122	      baseBranchSource: prBaseBranch === undefined
   123	        ? 'default_branch_fallback'
   124	        : 'pull_request',
   125	      ...(materializedDiffRefs?.baseRef && materializedDiffRefs.headRef
   126	        ? {
   127	          baseDiffRef: materializedDiffRefs.baseRef,
   128	          headDiffRef: materializedDiffRefs.headRef,
   129	        }
   130	        : {}),
   131	    }),
   132	  };
   133	}
