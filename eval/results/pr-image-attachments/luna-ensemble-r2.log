   233	function existingImageNumbers(prReview: PrReviewData): Set<number> {
   234	  const usedNumbers = new Set<number>();
   235	  const placeholderPattern = /\[Image #(\d+)\]/g;
   236	  for (const body of getPrReviewBodiesInTaskOrder(prReview)) {
   237	    for (const match of removeNonRenderableMarkdown(body).matchAll(placeholderPattern)) {
   238	      const number = Number(match[1]);
   239	      if (Number.isSafeInteger(number) && number > 0) {
   240	        usedNumbers.add(number);
   241	      }
   242	    }
   243	  }
   244	  return usedNumbers;
   245	}
   246	
   247	function nextAvailableImageNumber(usedNumbers: Set<number>): number {
   248	  let number = 1;
   249	  while (usedNumbers.has(number)) {
   250	    number += 1;
   251	  }
   252	  usedNumbers.add(number);
   253	  return number;
   254	}
   255	
   256	export function extractGitHubPrImageReferences(prReview: PrReviewData): GitHubPrImageReference[] {
   257	  const references: GitHubPrImageReference[] = [];
   258	  const seenUrls = new Set<string>();
   259	  const usedNumbers = existingImageNumbers(prReview);
   260	  const repository = parseGitHubRepositoryFromPrUrl(prReview.url);
   261	  const markdownImagePattern = /(?<!\\)!\[[^\]]*\]\(\s*(https:\/\/[^)\s]+)(?:\s+["'][^)]*["'])?\s*\)/g;
   262	  const htmlImagePattern = /<img\b[^>]*\bsrc\s*=\s*["'](https:\/\/[^"']+)["'][^>]*>/gi;
   263	
   264	  for (const body of getPrReviewBodiesInTaskOrder(prReview)) {
   265	    const sanitizedBody = removeNonRenderableMarkdown(body);
   266	    const matches: ImageMatch[] = [
   267	      ...Array.from(sanitizedBody.matchAll(markdownImagePattern), (match) => ({
   268	        index: match.index ?? 0,
   269	        url: match[1]!,
   270	      })),
   271	      ...Array.from(sanitizedBody.matchAll(htmlImagePattern), (match) => ({
   272	        index: match.index ?? 0,
   273	        url: match[1]!,
   274	      })),
   275	    ].sort((left, right) => left.index - right.index);
   276	
   277	    for (const match of matches) {
   278	      if (
   279	        !isAllowedGitHubAttachmentUrl(match.url, repository)
   280	        || seenUrls.has(match.url)
   281	      ) {
   282	        continue;
   283	      }
   284	      seenUrls.add(match.url);
   285	      const number = nextAvailableImageNumber(usedNumbers);
   286	      references.push({
   287	        placeholder: `[Image #${number}]`,
   288	        url: match.url,
   289	      });
   290	    }
   291	  }
   292	  return references;
   293	}
   294	
   295	export function replaceGitHubPrImageReferences(
   296	  text: string,
   297	  references: readonly GitHubPrImageReference[],
   298	): string {
   299	  const renderedText = removeNonRenderableMarkdown(text);
   300	  const replacements: Array<{ start: number; end: number; value: string }> = [];
   301	  for (const reference of references) {
   302	    const escapedUrl = reference.url.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   303	    const markdownPattern = new RegExp(
   304	      `(?<!\\\\)!\\[[^\\]]*\\]\\(\\s*${escapedUrl}(?:\\s+["'][^)]*["'])?\\s*\\)`,
   305	      'g',
   306	    );
   307	    const htmlPattern = new RegExp(
   308	      `<img\\b[^>]*\\bsrc\\s*=\\s*["']${escapedUrl}["'][^>]*>`,
   309	      'gi',
   310	    );
   311	    for (const match of renderedText.matchAll(markdownPattern)) {
   312	      if (match.index !== undefined) {
   313	        replacements.push({
   314	          start: match.index,
   315	          end: match.index + match[0].length,
   316	          value: reference.placeholder,
   317	        });
   318	      }
   319	    }
   320	    for (const match of renderedText.matchAll(htmlPattern)) {
   321	      if (match.index !== undefined) {
   322	        replacements.push({
   323	          start: match.index,
   324	          end: match.index + match[0].length,
   325	          value: reference.placeholder,
   326	        });
   327	      }
   328	    }
   329	  }
   330	
   331	  return replacements
   332	    .sort((left, right) => right.start - left.start)
   333	    .reduce(
   334	      (result, replacement) => `${result.slice(0, replacement.start)}${replacement.value}${result.slice(replacement.end)}`,
   335	      text,
   336	    );
   337	}
   338	
   339	function readImageNumber(placeholder: string): number {
   340	  const number = Number(placeholder.match(/^\[Image #(\d+)\]$/)?.[1]);
   341	  if (!Number.isSafeInteger(number) || number < 1) {
   342	    throw new Error(`Invalid GitHub image placeholder: ${placeholder}`);
   343	  }
   344	  return number;
   345	}
   346	
   347	function getGitHubAuthToken(cwd: string): string {
   348	  const token = execFileSync('gh', ['auth', 'token'], {
   349	    cwd,
   350	    encoding: 'utf-8',
   351	    stdio: ['pipe', 'pipe', 'pipe'],
   352	  }).trim();
   353	  if (token.length === 0) {
   354	    throw new Error('gh auth token returned an empty token');
   355	  }
   356	  return token;
   357	}
   358	
   359	async function readResponseBody(response: Response): Promise<Buffer> {
   360	  const contentLength = response.headers.get('content-length');
   361	  if (contentLength !== null) {
   362	    const declaredLength = Number(contentLength);
   363	    if (Number.isSafeInteger(declaredLength) && declaredLength > MAX_GITHUB_IMAGE_BYTES) {
   364	      throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
   365	    }
   366	  }
   367	
   368	  if (response.body === null) {
   369	    throw new Error('GitHub image response body is missing');
   370	  }
   371	
   372	  const reader = response.body.getReader();
   373	  const chunks: Buffer[] = [];
   374	  let totalBytes = 0;
   375	  while (true) {
   376	    const chunk = await reader.read();
   377	    if (chunk.done) {
   378	      break;
   379	    }
   380	    const buffer = Buffer.from(chunk.value);
   381	    totalBytes += buffer.length;
   382	    if (totalBytes > MAX_GITHUB_IMAGE_BYTES) {
   383	      await reader.cancel();
   384	      throw new Error(`GitHub image exceeds the ${MAX_GITHUB_IMAGE_BYTES}-byte size limit`);
   385	    }
   386	    chunks.push(buffer);
   387	  }
   388	  return Buffer.concat(chunks, totalBytes);
   389	}
   390	
   391	async function fetchGitHubImage(
   392	  url: string,
   393	  token: string | undefined,
   394	): Promise<{ contentType: string; body: Buffer }> {
   395	  const headers = new Headers({ Accept: 'application/octet-stream' });
   396	  if (token !== undefined) {
   397	    headers.set('Authorization', `Bearer ${token}`);
   398	  }
   399	  const response = await fetch(url, { headers });
   400	  if (!response.ok) {
   401	    throw new Error(`GitHub image request failed with HTTP ${response.status}`);
   402	  }
   403	  const contentType = response.headers.get('content-type');
   404	  if (contentType === null || contentType.trim().length === 0) {
   405	    throw new Error('GitHub image response Content-Type is missing');
   406	  }
   407	  return { contentType, body: await readResponseBody(response) };
   408	}
   409	
   410	function createGitHubPrImageResource(
   411	  attachmentDirectory: string,
   412	  attachments: readonly StoredImageAttachment[],
   413	): GitHubPrImageResource {
   414	  let cleaned = false;
   415	  const cleanupOnExit = (): void => {
   416	    try {
   417	      cleanup();
   418	    } catch (error) {
   419	      log.debug('Failed to cleanup GitHub PR image resource on process exit', {
   420	        error: getErrorMessage(error),
   421	      });
   422	    }
   423	  };
   424	  const cleanup = (): void => {
   425	    if (cleaned) {
   426	      return;
   427	    }
   428	    rmSync(attachmentDirectory, { recursive: true, force: true });
   429	    cleaned = true;
   430	    process.removeListener('exit', cleanupOnExit);
   431	  };
   432	  process.once('exit', cleanupOnExit);
   433	  return { attachments, cleanup };
   434	}
   435	
   436	export async function downloadGitHubPrImages(
   437	  references: readonly GitHubPrImageReference[],
   438	  cwd: string,
   439	  prUrl: string,
   440	): Promise<GitHubPrImageResource> {
   441	  if (references.length === 0) {
   442	    return { attachments: [], cleanup: () => undefined };
   443	  }
   444	
   445	  const repository = parseGitHubRepositoryFromPrUrl(prUrl);
   446	  const requests = references.map((reference) => {
   447	    const request = classifyGitHubAttachmentUrl(reference.url, repository);
   448	    if (request === undefined) {
   449	      throw new Error(`GitHub image URL is outside the pull request repository scope: ${reference.url}`);
   450	    }
   451	    return request;
   452	  });
   453	  const token = requests.some((request) => request.requiresAuthentication)
   454	    ? getGitHubAuthToken(cwd)
   455	    : undefined;
   456	  const attachmentDirectory = mkdtempSync(path.join(os.tmpdir(), `takt-github-pr-${randomUUID()}-`));
   457	  const attachments: StoredImageAttachment[] = [];
   458	  const imageResource = createGitHubPrImageResource(attachmentDirectory, attachments);
   459	
   460	  try {
   461	    ensurePrivateDirectory(attachmentDirectory);
   462	    for (const [index, reference] of references.entries()) {
   463	      const response = await fetchGitHubImage(
   464	        reference.url,
   465	        requests[index]!.requiresAuthentication ? token : undefined,
   466	      );
   467	      const image = validateGitHubImagePayload(response.contentType, response.body);
   468	      const imageNumber = readImageNumber(reference.placeholder);
   469	      const fileName = `image-${imageNumber}.${image.extension}`;
   470	      const tempPath = path.join(attachmentDirectory, fileName);
   471	      writeNewPrivateFileWithMode(tempPath, response.body, 0o600);
   472	      attachments.push({ placeholder: reference.placeholder, tempPath, fileName });
   473	    }
   474	    return imageResource;
   475	  } catch (error) {
   476	    imageResource.cleanup();
   477	    throw error;
   478	  }
   479	}
   480	
   481	export async function prepareGitHubPrTask(
   482	  prReview: PrReviewData,
   483	  cwd: string,
   484	): Promise<PreparedGitHubPrTask> {
   485	  if (!isGitHubPullRequestUrl(prReview.url)) {
   486	    return { review: prReview };
   487	  }
   488	  const references = extractGitHubPrImageReferences(prReview);
   489	  if (references.length === 0) {
   490	    return { review: prReview };
   491	  }
   492	
   493	  const imageResource = await downloadGitHubPrImages(references, cwd, prReview.url);
   494	  try {
   495	    return {
   496	      review: {
   497	        ...prReview,
   498	        body: replaceGitHubPrImageReferences(prReview.body, references),
   499	        comments: prReview.comments.map((comment) => ({
   500	          ...comment,
   501	          body: replaceGitHubPrImageReferences(comment.body, references),
   502	        })),
   503	        reviews: prReview.reviews.map((review) => ({
   504	          ...review,
   505	          body: replaceGitHubPrImageReferences(review.body, references),
   506	        })),
   507	      },
   508	      imageResource,
   509	    };
   510	  } catch (error) {
   511	    imageResource.cleanup();
   512	    throw error;
   513	  }
   514	}

