   464	
   465	  if (options.repo) {
   466	    args.push('--repo', options.repo);
   467	  }
   468	
   469	  if (options.draft) {
   470	    args.push('--draft');
   471	  }
   472	
   473	  for (const label of options.labels ?? []) {
   474	    args.push('--label', label);
   475	  }
   476	
   477	  log.info('Creating PR', { branch: options.branch, title: options.title, draft: options.draft });
   478	
   479	  try {
   480	    const output = execFileSync('gh', args, {
   481	      cwd,
   482	      encoding: 'utf-8',
   483	      stdio: ['pipe', 'pipe', 'pipe'],
   484	    });
   485	
   486	    const url = output.trim();
   487	    log.info('PR created', { url });
   488	
   489	    return { success: true, url };
   490	  } catch (err) {
   491	    const errorMessage = getErrorMessage(err);
   492	    log.error('PR creation failed', { error: errorMessage });
