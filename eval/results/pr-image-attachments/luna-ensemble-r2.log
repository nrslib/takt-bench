   189	function hasWebpSignature(data: Buffer): boolean {
   190	  return hasPrefix(data, [0x52, 0x49, 0x46, 0x46])
   191	    && data.length >= 12
   192	    && data.subarray(8, 12).toString('ascii') === 'WEBP';
