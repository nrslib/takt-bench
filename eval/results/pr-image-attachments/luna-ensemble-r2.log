    10	export const TAKT_MANAGED_PR_MARKER = '<!-- takt:managed -->';
    11	
    12	export function stripTaktManagedPrMarker(body: string): string {
    13	  return body
    14	    .split(TAKT_MANAGED_PR_MARKER)
    15	    .join('')
    16	    .replace(/\n{3,}/g, '\n\n')
    17	    .trimEnd();
    18	}
    19	
    20	export function isTaktManagedPrBody(body: string | null | undefined): boolean {
    21	  if (!body) {
    22	    return false;
    23	  }
    24	  const normalizedBody = body.trimEnd();
    25	  return /(?:^|\n\n)<!-- takt:managed -->$/.test(normalizedBody);
    26	}
    27	
    28	function appendTaktManagedPrMarker(body: string): string {
    29	  const strippedBody = stripTaktManagedPrMarker(body);
    30	  return `${strippedBody}\n\n${TAKT_MANAGED_PR_MARKER}`;
    31	}
    32	
    33	export function buildTaktManagedPrOptions(body: string): Pick<CreatePrOptions, 'body'> {
    34	  return {
    35	    body: appendTaktManagedPrMarker(body),
    36	  };
    37	}
    38	
    39	export function parseIssueNumberFromUrl(url: string): number {
    40	  if (url.endsWith('/')) {
    41	    throw new Error(`Issue URL must end with a positive issue number: ${url}`);
    42	  }
    43	
    44	  let parsed: URL;
    45	  try {
    46	    parsed = new URL(url);
    47	  } catch {
    48	    throw new Error(`Issue URL is invalid: ${url}`);
    49	  }
    50	
    51	  const lastSegment = parsed.pathname.split('/').pop();
    52	  if (lastSegment === undefined || !/^[1-9]\d*$/u.test(lastSegment)) {
    53	    throw new Error(`Issue URL must end with a positive issue number: ${url}`);
    54	  }
    55	
    56	  const issueNumber = Number(lastSegment);
    57	  if (!Number.isSafeInteger(issueNumber)) {
    58	    throw new Error(`Issue number must be a positive safe integer: ${lastSegment}`);
    59	  }
    60	  return issueNumber;
    61	}
    62	
    63	/**
    64	 * Format an issue into task text for workflow execution.
    65	 *
    66	 * Output format:
    67	 * ```
    68	 * ## Issue #6: Fix authentication bug
    69	 *
    70	 * {body}
    71	 *
    72	 * ### Labels
    73	 * bug, priority:high
    74	 *
    75	 * ### Comments
    76	 * **user1**: Comment body...
    77	 * ```
    78	 */
    79	export function formatIssueAsTask(issue: Issue): string {
    80	  const parts: string[] = [];
    81	
    82	  parts.push(`## Issue #${issue.number}: ${issue.title}`);
    83	
    84	  if (issue.body) {
    85	    parts.push('');
    86	    parts.push(issue.body);
    87	  }
    88	
    89	  if (issue.labels.length > 0) {
    90	    parts.push('');
    91	    parts.push('### Labels');
    92	    parts.push(issue.labels.join(', '));
    93	  }
    94	
    95	  if (issue.comments.length > 0) {
    96	    parts.push('');
    97	    parts.push('### Comments');
    98	    for (const comment of issue.comments) {
    99	      parts.push(`**${comment.author}**: ${comment.body}`);
   100	    }
   101	  }
   102	
   103	  return parts.join('\n');
   104	}
   105	
   106	/** Regex to match `#N` patterns (issue numbers) */
   107	const ISSUE_NUMBER_REGEX = /^#(\d+)$/;
   108	
   109	/**
   110	 * Parse `#N` patterns from argument strings.
   111	 * Returns issue numbers found, or empty array if none.
   112	 *
   113	 * Each argument must be exactly `#N` (no mixed text).
   114	 * Examples:
   115	 *   ['#6'] → [6]
   116	 *   ['#6', '#7'] → [6, 7]
   117	 *   ['Fix bug'] → []
   118	 *   ['#6', 'and', '#7'] → [] (mixed, not all are issue refs)
   119	 */
   120	export function parseIssueNumbers(args: string[]): number[] {
   121	  if (args.length === 0) return [];
   122	
   123	  const numbers: number[] = [];
   124	  for (const arg of args) {
   125	    const match = arg.match(ISSUE_NUMBER_REGEX);
   126	    if (!match?.[1]) return []; // Not all args are issue refs
   127	    numbers.push(Number.parseInt(match[1], 10));
   128	  }
   129	
   130	  return numbers;
   131	}
   132	
   133	/**
   134	 * Check if a single task string is an issue reference (`#N`).
   135	 */
   136	export function isIssueReference(task: string): boolean {
   137	  return ISSUE_NUMBER_REGEX.test(task.trim());
   138	}
   139	
   140	const REVIEW_THREAD_POLICY = [
   141	  '以下のレビューコメントは review thread state ごとに分類されています。',
   142	  'Active Review Threads を主な修正対象にしてください。',
   143	  'Outdated But Unresolved Review Threads は、現在のコードにまだ当てはまるか確認し、当てはまらなければスキップ理由を明記してください。',
   144	  'Resolved / Outdated のコメントは原則として修正対象にせず、現在のコードに同じ問題が明確に残っている場合のみ報告してください。',
   145	  '各コメントについて、対応したか、スキップしたか、理由を最後に要約してください。',
   146	];
   147	
   148	function formatPrReviewComment(review: PrReviewComment): string {
   149	  const lines = [`**${review.author}**: ${review.body}`];
   150	
   151	  if (review.path) {
   152	    const location = review.line !== undefined
   153	      ? `  File: ${review.path}, Line: ${review.line}`
   154	      : `  File: ${review.path}`;
   155	    lines.push(location);
   156	  }
   157	  if (review.url) {
   158	    lines.push(`  URL: ${review.url}`);
   159	  }
   160	
   161	  return lines.join('\n');
   162	}
   163	
   164	function formatResolvedPrReviewComment(review: PrReviewComment): string {
   165	  const lines = [formatPrReviewComment(review)];
   166	
   167	  if (review.resolvedBy) {
   168	    lines.push(`  Resolved by: ${review.resolvedBy}`);
   169	  }
   170	  if (review.isOutdated !== undefined) {
   171	    lines.push(`  Outdated: ${review.isOutdated ? 'yes' : 'no'}`);
   172	  }
   173	
   174	  return lines.join('\n');
   175	}
   176	
   177	function appendReviewSection(
   178	  parts: string[],
   179	  title: string,
   180	  reviews: readonly PrReviewComment[],
   181	  formatReview: (review: PrReviewComment) => string,
   182	): void {
   183	  if (reviews.length === 0) {
   184	    return;
   185	  }
   186	
   187	  parts.push('');
   188	  parts.push(title);
   189	  for (const review of reviews) {
   190	    parts.push(formatReview(review));
   191	  }
   192	}
   193	
   194	interface PrReviewSection {
   195	  readonly title: string;
   196	  readonly reviews: readonly PrReviewComment[];
   197	  readonly hasThreadState: boolean;
   198	  readonly includeResolutionMetadata: boolean;
   199	}
   200	
   201	function getPrReviewSections(reviews: readonly PrReviewComment[]): PrReviewSection[] {
   202	  const summaries: PrReviewComment[] = [];
   203	  const active: PrReviewComment[] = [];
   204	  const outdatedUnresolved: PrReviewComment[] = [];
   205	  const resolved: PrReviewComment[] = [];
   206	  const legacyInlineComments: PrReviewComment[] = [];
   207	
   208	  for (const review of reviews) {
   209	    switch (review.threadState) {
   210	      case 'active':
   211	        active.push(review);
   212	        break;
   213	      case 'outdated-unresolved':
   214	        outdatedUnresolved.push(review);
   215	        break;
   216	      case 'resolved':
   217	        resolved.push(review);
   218	        break;
   219	      case undefined:
   220	        if (review.path === undefined) {
   221	          summaries.push(review);
   222	        } else {
   223	          legacyInlineComments.push(review);
   224	        }
   225	        break;
   226	    }
   227	  }
   228	
   229	  return [
   230	    { title: '### Review Summaries', reviews: summaries, hasThreadState: false, includeResolutionMetadata: false },
   231	    { title: '### Active Review Threads', reviews: active, hasThreadState: true, includeResolutionMetadata: false },
   232	    {
   233	      title: '### Outdated But Unresolved Review Threads',
   234	      reviews: outdatedUnresolved,
   235	      hasThreadState: true,
   236	      includeResolutionMetadata: false,
   237	    },
   238	    {
   239	      title: '### Resolved / Outdated Review Threads',
   240	      reviews: resolved,
   241	      hasThreadState: true,
   242	      includeResolutionMetadata: true,
   243	    },
   244	    { title: '### Review Comments', reviews: legacyInlineComments, hasThreadState: false, includeResolutionMetadata: false },
   245	  ];
   246	}
   247	
   248	export function getPrReviewBodiesInTaskOrder(prReview: PrReviewData): string[] {
   249	  return [
   250	    prReview.body,
   251	    ...getPrReviewSections(prReview.reviews).flatMap((section) =>
   252	      section.reviews.map((review) => review.body)),
   253	    ...prReview.comments.map((comment) => comment.body),
   254	  ];
   255	}
   256	
   257	/**
   258	 * Format PR review data into task text for workflow execution.
   259	 */
   260	export function formatPrReviewAsTask(prReview: PrReviewData): string {
   261	  const parts: string[] = [];
   262	
   263	  parts.push(`## PR #${prReview.number} Review Comments: ${prReview.title}`);
   264	
   265	  if (prReview.body) {
   266	    parts.push('');
   267	    parts.push('### PR Description');
   268	    parts.push(prReview.body);
   269	  }
   270	
   271	  const sections = getPrReviewSections(prReview.reviews);
   272	  const hasThreadState = sections.some((section) => section.hasThreadState && section.reviews.length > 0);
   273	  if (hasThreadState) {
   274	    parts.push('');
   275	    parts.push('### Review Policy');
   276	    parts.push(...REVIEW_THREAD_POLICY);
   277	  }
   278	
   279	  for (const section of sections) {
   280	    appendReviewSection(
   281	      parts,
   282	      section.title,
   283	      section.reviews,
   284	      section.includeResolutionMetadata ? formatResolvedPrReviewComment : formatPrReviewComment,
   285	    );
   286	  }
   287	
   288	  if (prReview.comments.length > 0) {
   289	    parts.push('');
   290	    parts.push('### Conversation Comments');
   291	    for (const comment of prReview.comments) {
   292	      parts.push(`**${comment.author}**: ${comment.body}`);
   293	    }
   294	  }
   295	
   296	  if (prReview.files.length > 0) {
   297	    parts.push('');
   298	    parts.push('### Changed Files');
   299	    for (const file of prReview.files) {
   300	      parts.push(`- ${file}`);
   301	    }
   302	  }
   303	
   304	  return parts.join('\n');
   305	}
   306	
   307	/**
   308	 * Build PR body from issues and execution report.
   309	 * Supports multiple issues (adds "Closes #N" for each).
   310	 */
   311	export function buildPrBody(issues: Issue[] | undefined, report: string, orderContent?: string): string {
   312	  const parts: string[] = [];
   313	  const summary = issues && issues.length > 0
   314	    ? issues[0]!.body || issues[0]!.title
   315	    : orderContent?.trim()
   316	      ? orderContent
   317	      : undefined;
   318	
   319	  parts.push('## Summary');
   320	  if (summary) {
   321	    parts.push('');
   322	    parts.push(summary);
   323	  }
   324	
   325	  parts.push('');
   326	  parts.push('## Execution Report');
   327	  parts.push('');
   328	  parts.push(report);
   329	
   330	  if (issues && issues.length > 0) {
   331	    parts.push('');
   332	    parts.push(issues.map((issue) => `Closes #${issue.number}`).join('\n'));
   333	  }
   334	
   335	  return parts.join('\n');
   336	}
