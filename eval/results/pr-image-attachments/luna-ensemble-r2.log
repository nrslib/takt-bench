    30	/**
    31	 * Find an open PR for the given branch.
    32	 * Returns undefined if no PR exists.
    33	 */
    34	export function findExistingPr(branch: string, cwd: string): ExistingPr | undefined {
    35	  const ghStatus = checkGhCli(cwd);
    36	  if (!ghStatus.available) return undefined;
    37	
    38	  try {
    39	    const output = execFileSync(
    40	      'gh', ['pr', 'list', '--head', branch, '--state', 'open', '--json', 'number,url', '--limit', '1'],
    41	      { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
    42	    );
    43	    const prs = JSON.parse(output) as ExistingPr[];
    44	    return prs[0];
    45	  } catch (e) {
    46	    log.debug('gh pr list failed, treating as no PR', { error: getErrorMessage(e) });
    47	    return undefined;
    48	  }
    49	}
    50	
    51	interface GhPrListResponseItem {
    52	  number: number;
    53	  user: { login: string };
    54	  base: { ref: string; repo: { full_name: string } | null };
    55	  head: { ref: string; repo: { full_name: string } | null };
    56	  body: string | null;
    57	  labels: Array<{ name: string }>;
    58	  draft: boolean;
    59	  updated_at: string;
    60	}
    61	
    62	const OPEN_PRS_PER_PAGE = 100;
    63	const REVIEW_THREADS_PER_PAGE = 100;
    64	const REVIEW_THREAD_COMMENTS_PER_PAGE = 100;
    65	const GRAPHQL_PAGINATION_HARD_CAP = 100;
    66	const DELETED_GITHUB_USER_AUTHOR = 'deleted GitHub user';
    67	
    68	export function listOpenPrs(cwd: string): PrListItem[] {
    69	  const repo = resolveRepositoryNameWithOwner(cwd);
    70	  const prs = fetchPaginatedApi<GhPrListResponseItem>({
    71	    command: 'gh',
    72	    cwd,
    73	    context: 'open pull request list',
    74	    initialEndpoint: `repos/${repo}/pulls?state=open&per_page=${OPEN_PRS_PER_PAGE}&page=1`,
    75	    parsePage: (body) => JSON.parse(body) as GhPrListResponseItem[],
    76	  });
    77	
    78	  return prs.map((pr) => ({
    79	    number: pr.number,
    80	    author: pr.user.login,
    81	    base_branch: pr.base.ref,
    82	    head_branch: pr.head.ref,
    83	    managed_by_takt: isTaktManagedPrBody(pr.body),
    84	    labels: pr.labels.map((label) => label.name),
    85	    same_repository: pr.head.repo?.full_name === pr.base.repo?.full_name,
    86	    draft: pr.draft,
    87	    updated_at: pr.updated_at,
    88	  }));
    89	}
