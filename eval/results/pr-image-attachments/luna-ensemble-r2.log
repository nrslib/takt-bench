   271	export async function resolveExecutionContext(
   272	  cwd: string,
   273	  task: string,
   274	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   275	  pipelineConfig: PipelineConfig | undefined,
   276	  prBranch?: string,
   277	  prBaseBranch?: string,
   278	): Promise<ExecutionContext> {
   279	  if (options.prNumber !== undefined) {
   280	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   281	  }
   282	  if (options.createWorktree) {
   283	    const result = await confirmAndCreateWorktree(
   284	      cwd,
   285	      task,
   286	      options.createWorktree,
   287	      prBranch,
   288	      prBaseBranch,
   289	      options.prNumber !== undefined,
   290	    );
   291	    const branch = requireBranch(result.branch, 'worktree execution');
   292	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   293	    if (result.isWorktree) {
   294	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   295	    }
   296	    if (
   297	      options.prNumber !== undefined
   298	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   299	    ) {
   300	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   301	    }
   302	    return attachPipelinePrContext(
   303	      options.prNumber,
   304	      prBaseBranch,
   305	      {
   306	        execCwd: result.execCwd,
   307	        branch,
   308	        baseBranch,
   309	        isWorktree: result.isWorktree,
   310	        taskSlug: result.taskSlug,
   311	      },
   312	      {
   313	        baseRef: result.pullRequestBaseRef,
   314	        headRef: result.pullRequestHeadRef,
   315	      },
   316	    );
   317	  }
   318	  if (options.skipGit) {
   319	    return attachPipelinePrContext(
   320	      options.prNumber,
   321	      prBaseBranch,
   322	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   323	    );
   324	  }
   325	  if (prBranch) {
   326	    const safePrBranch = sanitizeTerminalText(prBranch);
   327	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   328	    checkoutBranch(cwd, prBranch);
   329	    success(`Checked out PR branch: ${safePrBranch}`);
   330	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   331	    return attachPipelinePrContext(
   332	      options.prNumber,
   333	      prBaseBranch,
   334	      {
   335	        execCwd: cwd,
   336	        branch: prBranch,
   337	        baseBranch,
   338	        isWorktree: false,
   339	      },
   340	      {
   341	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   342	        headRef: toLocalBranchRef(prBranch),
   343	      },
   344	    );
   345	  }
   346	  const baseBranch = resolveExecutionBaseBranch(cwd);
   347	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   348	  const safeBranch = sanitizeTerminalText(branch);
   349	  info(`Creating branch: ${safeBranch}`);
   350	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   351	  success(`Branch created: ${safeBranch}`);
   352	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   353	}
