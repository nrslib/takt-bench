    69	export type CreateIssueResult =
    70	  | { success: true; issueNumber: number; url?: string }
    71	  | { success: false; issueCreated: true; url?: string; error: string }
    72	  | { success: false; issueCreated?: false; error: string };
    73	
    74	export function normalizePublicIssueUrl(url: string | undefined): string | undefined {
    75	  if (url === undefined || containsControlCharacter(url)) {
    76	    return undefined;
    77	  }
    78	
    79	  let parsed: URL;
    80	  try {
    81	    parsed = new URL(url);
    82	  } catch {
    83	    return undefined;
    84	  }
    85	
    86	  if ((parsed.protocol !== 'http:' && parsed.protocol !== 'https:') || parsed.hostname.length === 0) {
    87	    return undefined;
    88	  }
    89	
    90	  return `${parsed.protocol}//${parsed.host}${parsed.pathname}`;
    91	}
    92	
    93	function containsControlCharacter(value: string): boolean {
    94	  for (const character of value) {
    95	    const code = character.charCodeAt(0);
    96	    if (code <= 31 || code === 127) {
    97	      return true;
    98	    }
    99	  }
   100	  return false;
   101	}
