   101	function removeInlineCode(text: string): string {
   102	  let result = text;
   103	  let cursor = 0;
   104	  while (cursor < result.length) {
   105	    const start = result.indexOf('`', cursor);
   106	    if (start === -1) {
   107	      break;
   108	    }
   109	    let markerLength = 1;
   110	    while (result[start + markerLength] === '`') {
   111	      markerLength += 1;
   112	    }
   113	    const marker = '`'.repeat(markerLength);
   114	    const end = result.indexOf(marker, start + markerLength);
   115	    const endExclusive = end === -1 ? result.length : end + markerLength;
   116	    result = `${result.slice(0, start)}${' '.repeat(endExclusive - start)}${result.slice(endExclusive)}`;
   117	    cursor = endExclusive;
   118	  }
   119	  return result;
   120	}
