   130	function isGitHubPullRequestUrl(value: string): boolean {
   131	  try {
   132	    const parsed = new URL(value);
   133	    return parsed.protocol === 'https:'
   134	      && ['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase());
   135	  } catch {
   136	    return false;
   137	  }
   138	}
   139	
   140	function classifyGitHubAttachmentUrl(
   141	  value: string,
   142	  repository: GitHubRepository,
   143	): GitHubAttachmentRequest | undefined {
   144	  let parsed: URL;
   145	  try {
   146	    parsed = new URL(value);
   147	  } catch {
   148	    return undefined;
   149	  }
   150	
   151	  if (
   152	    parsed.protocol !== 'https:'
   153	    || !['github.com', 'www.github.com'].includes(parsed.hostname.toLowerCase())
   154	    || parsed.username.length > 0
   155	    || parsed.password.length > 0
   156	    || parsed.port.length > 0
   157	  ) {
   158	    return undefined;
   159	  }
   160	
   161	  const segments = parsed.pathname.split('/').filter(Boolean);
   162	  if (segments[0] === 'user-attachments' && segments[1] === 'assets') {
   163	    return segments.length >= 3 ? { requiresAuthentication: false } : undefined;
   164	  }
   165	
   166	  if (segments.length < 4 || segments[2] !== 'assets' || segments[3]!.length === 0) {
   167	    return undefined;
   168	  }
   169	  if (
   170	    normalizeRepositoryPart(segments[0]!) !== normalizeRepositoryPart(repository.owner)
   171	    || normalizeRepositoryPart(segments[1]!) !== normalizeRepositoryPart(repository.repo)
   172	  ) {
   173	    return undefined;
   174	  }
   175	  return { requiresAuthentication: true };
   176	}
