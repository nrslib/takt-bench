    10	export async function resolveIssueInput(
    11	  issueOption: number | undefined,
    12	  task: string | undefined,
    13	  cwd?: string,
    14	): Promise<{ initialInput: string; issueNumber?: number } | null> {
    15	  if (issueOption) {
    16	    const provider = getGitProvider();
    17	    const cliStatus = provider.checkCliStatus(cwd);
    18	    if (!cliStatus.available) {
    19	      throw new Error(cliStatus.error);
    20	    }
    21	    const issue = await withProgress(
    22	      'Fetching issue...',
    23	      (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
    24	      async () => provider.fetchIssue(issueOption, cwd),
    25	    );
    26	    return { initialInput: formatIssueAsTask(issue), issueNumber: issueOption };
    27	  }
    28	
    29	  if (task && isDirectTask(task)) {
    30	    const provider = getGitProvider();
    31	    const cliStatus = provider.checkCliStatus(cwd);
    32	    if (!cliStatus.available) {
    33	      throw new Error(cliStatus.error);
    34	    }
    35	    const tokens = task.trim().split(/\s+/);
    36	    const issueNumbers = parseIssueNumbers(tokens);
    37	    if (issueNumbers.length === 0) {
    38	      throw new Error(`Invalid issue reference: ${task}`);
    39	    }
    40	    const issues = await withProgress(
    41	      'Fetching issues...',
    42	      (fetchedIssues) => `Issues fetched: ${fetchedIssues.map((issue) => `#${issue.number}`).join(', ')}`,
    43	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    44	    );
    45	    return {
    46	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    47	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
    48	    };
    49	  }
    50	
    51	  return null;
    52	}
    53	
    54	export async function resolvePrInput(
    55	  prNumber: number,
    56	  cwd?: string,
    57	): Promise<{
    58	  initialInput: string;
    59	  prBranch: string;
    60	  baseBranch?: string;
    61	  imageResource?: GitHubPrImageResource;
    62	}> {
    63	  const provider = getGitProvider();
    64	  const cliStatus = provider.checkCliStatus(cwd);
    65	  if (!cliStatus.available) {
    66	    throw new Error(cliStatus.error);
    67	  }
    68	
    69	  const prReview = await withProgress(
    70	    'Fetching PR review comments...',
    71	    (pr: PrReviewData) => `PR fetched: #${pr.number} ${pr.title}`,
    72	    async () => provider.fetchPrReviewComments(prNumber, cwd),
    73	  );
    74	
    75	  const prepared = await prepareGitHubPrTask(prReview, cwd ?? process.cwd());
    76	  try {
    77	    return {
    78	      initialInput: formatPrReviewAsTask(prepared.review),
    79	      prBranch: prepared.review.headRefName,
    80	      baseBranch: prepared.review.baseRefName,
    81	      ...(prepared.imageResource ? { imageResource: prepared.imageResource } : {}),
    82	    };
    83	  } catch (error) {
    84	    prepared.imageResource?.cleanup();
    85	    throw error;
    86	  }
    87	}

