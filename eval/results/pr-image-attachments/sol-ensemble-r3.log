   109	export function cleanupPreparedRetryTaskSpec(preparedSpec: PreparedRetryTaskSpec | undefined): void {
   110	  if (preparedSpec) {
   111	    cleanupPreparedTaskSpec(preparedSpec.taskDir);
   112	  }
   113	}
