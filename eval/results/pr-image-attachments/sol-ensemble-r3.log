 import type { ImageAttachmentReference, StoredImageAttachment } from '../types/image-attachments.js';
 
 const IMAGE_ATTACHMENT_PLACEHOLDER_PATTERN = /\[Image #\d+\]/g;
+const IMAGE_ATTACHMENT_INDEX_PATTERN = /\[Image #(\d+)\]|(?:^|[\s("'`<])attachments[\\/]image-(\d+)\.[A-Za-z0-9]+(?=$|[\s)"'`>,.;:!?])/g;
 
 const IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN = /^\[Image #[1-9]\d*\]$/;
 const SUPPORTED_IMAGE_ATTACHMENT_EXTENSIONS = new Set(['.gif', '.jpeg', '.jpg', '.png', '.webp']);
@@ -17,6 +18,32 @@ export function isImageAttachmentPlaceholder(value: string): boolean {
   return IMAGE_ATTACHMENT_PLACEHOLDER_EXACT_PATTERN.test(value);
 }
 
+export function createImageAttachmentIndexAllocator(
+  references: readonly string[],
+): () => string {
+  const reservedIndexes = new Set<string>();
+  for (const reference of references) {
+    for (const match of reference.matchAll(IMAGE_ATTACHMENT_INDEX_PATTERN)) {
+      const rawIndex = match[1] ?? match[2];
+      if (rawIndex !== undefined) {
+        reservedIndexes.add(rawIndex);
+      }
+    }
+  }
+
+  let candidateIndex = 1n;
+  return () => {
+    let assignedIndex = candidateIndex.toString();
+    while (reservedIndexes.has(assignedIndex)) {
+      candidateIndex += 1n;
+      assignedIndex = candidateIndex.toString();
+    }
+    reservedIndexes.add(assignedIndex);
+    candidateIndex += 1n;
+    return assignedIndex;
+  };
+}
