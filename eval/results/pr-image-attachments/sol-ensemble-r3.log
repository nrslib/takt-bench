    26	interface ImageReferenceMatch {
    27	  readonly start: number;
    28	  readonly end: number;
    29	  readonly url: string;
    30	}
    31	
    32	interface SourceRange {
    33	  readonly start: number;
    34	  readonly end: number;
    35	}
