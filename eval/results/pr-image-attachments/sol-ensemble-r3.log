    56	
    57	export function buildTaskOrderContent(
    58	  taskContent: string,
    59	  attachments?: readonly TaskAttachment[],
    60	): string {
    61	  if (!hasAttachments(attachments)) {
    62	    return taskContent;
    63	  }
    64	
    65	  const normalizedTaskContent = normalizeTaskAttachmentReferences(taskContent, attachments);
    66	  const attachmentLines = attachments.map((attachment) =>
    67	    `- ${attachment.placeholder}: \`${getTaskAttachmentRelativePath(attachment)}\``,
    68	  );
    69	  return [
    70	    normalizedTaskContent.trimEnd(),
    71	    '',
    72	    '## 添付画像',
    73	    '',
    74	    ...attachmentLines,
    75	  ].join('\n');
    76	}
    77	
    78	function getTaskAttachmentRelativePath(attachment: TaskAttachment): string {
    79	  return path.posix.join('attachments', attachment.fileName);
    80	}
    81	
    82	function normalizeTaskAttachmentReferences(
    83	  taskContent: string,
    84	  attachments: readonly TaskAttachment[],
    85	): string {
    86	  return attachments.reduce((content, attachment) => {
    87	    const relativePath = getTaskAttachmentRelativePath(attachment);
    88	    const pathVariants = new Set([
    89	      attachment.tempPath,
    90	      attachment.tempPath.replace(/\\/g, '/'),
    91	    ]);
    92	    let normalized = content;
    93	    for (const tempPath of pathVariants) {
    94	      normalized = normalized
    95	        .split(`\`${tempPath}\``).join(`\`${relativePath}\``)
    96	        .split(tempPath).join(`\`${relativePath}\``);
    97	    }
    98	    return normalized;
    99	  }, taskContent);
   100	}
