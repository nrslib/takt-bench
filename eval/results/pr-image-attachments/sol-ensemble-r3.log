   139	function isInsidePre(nodeRange: SourceRange, preRanges: readonly SourceRange[]): boolean {
   140	  return preRanges.some((preRange) => (
   141	    preRange.start <= nodeRange.start && nodeRange.end <= preRange.end
   142	  ));
   143	}
