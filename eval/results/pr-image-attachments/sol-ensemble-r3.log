diff --git a/src/infra/github/prImageDownload.ts b/src/infra/github/prImageDownload.ts
new file mode 100644
index 00000000..71690d57
--- /dev/null
+++ b/src/infra/github/prImageDownload.ts
@@ -0,0 +1,148 @@
+import { execFileSync } from 'node:child_process';
+import {
+  GITHUB_ATTACHMENT_HOST,
+  isGitHubAttachmentUrl,
+} from './attachmentUrl.js';
+import { createLogger } from '../../shared/utils/debug.js';
+import { getErrorMessage } from '../../shared/utils/error.js';
+import {
+  inferSupportedImageMimeType,
+  isSupportedImageMimeType,
+  MAX_SUPPORTED_IMAGE_BYTES,
+  type SupportedImageMimeType,
+} from '../../shared/utils/imageMimeType.js';
+
+interface DownloadedPrImage {
+  readonly data: Buffer;
+  readonly mimeType: SupportedImageMimeType;
+}
+
+const log = createLogger('github-pr-image');
+
+async function abortDownload(cancelBody: () => Promise<void>, abortController: AbortController): Promise<void> {
+  try {
+    await cancelBody();
+  } catch (error) {
+    log.debug('Failed to cancel rejected PR image response body', { error: getErrorMessage(error) });
+  } finally {
+    abortController.abort();
+  }
+}
+
+async function abortResponse(response: Response, abortController: AbortController): Promise<void> {
+  if (response.body === null) {
+    abortController.abort();
+    return;
+  }
+  const body = response.body;
+  await abortDownload(() => body.cancel(), abortController);
+}
+
+function resolveGitHubToken(cwd: string): string {
+  const token = execFileSync('gh', ['auth', 'token', '--hostname', GITHUB_ATTACHMENT_HOST], {
+    cwd,
+    encoding: 'utf8',
+    stdio: ['ignore', 'pipe', 'pipe'],
+  }).trim();
+  if (token.length === 0) {
+    throw new Error('GitHub authentication token is empty.');
+  }
+  return token;
+}
+
+async function validateContentLength(response: Response, abortController: AbortController): Promise<void> {
+  const contentLength = response.headers.get('content-length');
+  if (contentLength === null) {
+    return;
+  }
+  if (!/^\d+$/.test(contentLength)) {
+    await abortResponse(response, abortController);
+    throw new Error('PR image response has an invalid Content-Length header.');
+  }
+  const length = Number(contentLength);
+  if (!Number.isSafeInteger(length)) {
+    await abortResponse(response, abortController);
+    throw new Error('PR image response has an invalid Content-Length header.');
+  }
+  if (length > MAX_SUPPORTED_IMAGE_BYTES) {
+    await abortResponse(response, abortController);
+    throw new Error(`PR image exceeds the ${MAX_SUPPORTED_IMAGE_BYTES} byte limit.`);
+  }
+}
+
+async function readImageBody(response: Response, abortController: AbortController): Promise<Buffer> {
+  if (response.body === null) {
+    return Buffer.alloc(0);
+  }
+
+  const reader = response.body.getReader();
+  const chunks: Buffer[] = [];
+  let byteLength = 0;
+  const readChunk = async () => {
+    try {
+      return await reader.read();
+    } catch {
+      throw new Error('Failed to read the PR image response.');
+    }
+  };
+  while (true) {
+    const chunk = await readChunk();
+    if (chunk.done) {
+      break;
+    }
+    byteLength += chunk.value.byteLength;
+    if (byteLength > MAX_SUPPORTED_IMAGE_BYTES) {
+      await abortDownload(() => reader.cancel(), abortController);
+      throw new Error(`PR image exceeds the ${MAX_SUPPORTED_IMAGE_BYTES} byte limit.`);
+    }
+    chunks.push(Buffer.from(chunk.value));
+  }
+  return Buffer.concat(chunks, byteLength);
+}
+
+function resolveResponseMimeType(response: Response, data: Buffer): SupportedImageMimeType {
+  const contentTypeHeader = response.headers.get('content-type');
+  const contentType = contentTypeHeader?.split(';', 1)[0]?.trim().toLowerCase();
+  if (contentType === undefined || !isSupportedImageMimeType(contentType)) {
+    throw new Error('Unsupported PR image Content-Type. Expected PNG, JPEG, GIF, or WebP.');
+  }
+
+  const detectedMimeType = inferSupportedImageMimeType(data);
+  if (detectedMimeType === undefined) {
+    throw new Error('Unsupported PR image data. Expected PNG, JPEG, GIF, or WebP magic bytes.');
+  }
+  if (detectedMimeType !== contentType) {
+    throw new Error(`PR image Content-Type does not match image data: ${contentType} !== ${detectedMimeType}`);
+  }
+  return detectedMimeType;
+}
+
+export async function downloadPrImage(url: string, cwd: string): Promise<DownloadedPrImage> {
+  if (!isGitHubAttachmentUrl(url)) {
+    throw new Error('PR image URL must be a GitHub attachment URL.');
+  }
+
+  const token = resolveGitHubToken(cwd);
+  const abortController = new AbortController();
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      headers: {
+        Accept: 'image/png, image/jpeg, image/gif, image/webp',
+        Authorization: `Bearer ${token}`,
+      },
+      signal: abortController.signal,
+    });
+  } catch {
+    throw new Error('Failed to download the PR image.');
+  }
+
+  if (!response.ok) {
+    await abortResponse(response, abortController);
+    throw new Error(`Failed to download the PR image: HTTP ${response.status}`);
+  }
+  await validateContentLength(response, abortController);
+  const data = await readImageBody(response, abortController);
+  const mimeType = resolveResponseMimeType(response, data);
+  return { data, mimeType };
+}
