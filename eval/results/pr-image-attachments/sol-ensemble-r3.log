   576	export function readPrivateFileState(filePath: string): PrivateFileReadSnapshot {
   577	  const absolute = resolve(filePath);
   578	  const inspection = inspectPrivateArtifactPath(absolute, 'file');
   579	  if (inspection.expectedStat === undefined) {
   580	    return { state: { path: absolute, exists: false } };
   581	  }
   582	  const content = readRegularFileNoFollow(absolute, inspection.expectedStat);
   583	  assertAncestorIdentities(inspection.ancestorIdentities);
   584	  const verifiedStat = lstatOrUndefined(absolute);
   585	  if (verifiedStat === undefined || !hasMatchingIdentity(inspection.expectedStat, verifiedStat)) {
   586	    throw publicationConflict(`Private artifact file identity changed while reading: ${absolute}`);
   587	  }
   588	  const state = {
   589	    path: absolute,
   590	    exists: true as const,
   591	    stat: verifiedStat,
   592	    contentSha256: contentSha256(content),
   593	  };
   594	  return { state, content };
   595	}
