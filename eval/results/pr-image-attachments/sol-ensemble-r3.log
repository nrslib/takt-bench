   274	function copyExistingTaskAttachments(sourceTaskDir: string, taskDir: string): void {
   275	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   276	  if (!fs.existsSync(sourceAttachmentsDir)) {
   277	    return;
   278	  }
   279	
   280	  const stats = fs.lstatSync(sourceAttachmentsDir);
   281	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   282	    throw new Error(`Task attachments must be a regular directory: ${sourceAttachmentsDir}`);
   283	  }
   284	
   285	  copyAttachmentEntry(sourceAttachmentsDir, path.join(taskDir, 'attachments'));
   286	}
