   500	      writeTemporaryPrivateFileContent(
   501	        temporaryPath,
   502	        createdStat,
   503	        inspection.ancestorIdentities,
   504	        content,
   505	        mode,
   506	      );
   507	
   508	      assertAncestorIdentities(inspection.ancestorIdentities);
