   222	function assertTaskAttachmentManifestEntry(
   223	  taskDir: string,
   224	  expected: TaskAttachmentManifestEntry,
   225	  actual: TaskAttachmentManifestEntry | undefined,
   226	): void {
   227	  const entryPath = path.join(taskDir, expected.relativePath);
   228	  if (actual === undefined) {
   229	    throw new Error(`Task attachment is missing: ${entryPath}`);
   230	  }
   231	  if (actual.kind !== expected.kind) {
   232	    throw new Error(`Task attachment type changed: ${entryPath}`);
   233	  }
   234	  if (actual.contentSha256 !== expected.contentSha256) {
   235	    throw new Error(`Task attachment content changed: ${entryPath}`);
   236	  }
   237	}
   238	
   239	function assertTaskAttachmentsMatchManifest(
   240	  taskDir: string,
   241	  expectedManifest: TaskAttachmentManifest,
   242	): void {
   243	  const actualManifest = resolveTaskAttachmentManifest(taskDir);
   244	  const expectedByPath = new Map(
   245	    expectedManifest.map((entry) => [entry.relativePath, entry]),
   246	  );
   247	  const actualByPath = new Map(
   248	    actualManifest.map((entry) => [entry.relativePath, entry]),
   249	  );
   250	
   251	  for (const expected of expectedManifest) {
   252	    if (!actualByPath.has(expected.relativePath)) {
   253	      throw new Error(
   254	        `Task attachment is missing: ${path.join(taskDir, expected.relativePath)}`,
   255	      );
   256	    }
   257	  }
   258	  for (const actual of actualManifest) {
   259	    if (!expectedByPath.has(actual.relativePath)) {
   260	      throw new Error(
   261	        `Task attachment was added after resolution: ${path.join(taskDir, actual.relativePath)}`,
   262	      );
   263	    }
   264	  }
   265	  for (const expected of expectedManifest) {
   266	    assertTaskAttachmentManifestEntry(
   267	      taskDir,
   268	      expected,
   269	      actualByPath.get(expected.relativePath),
   270	    );
   271	  }
   272	}
