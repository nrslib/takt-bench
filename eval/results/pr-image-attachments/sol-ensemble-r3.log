    41	
    42	function visitMarkdownNodes(node: Nodes, visitor: (node: Nodes) => void): void {
    43	  visitor(node);
    44	  if ('children' in node) {
    45	    for (const child of node.children) {
    46	      visitMarkdownNodes(child, visitor);
    47	    }
    48	  }
    49	}
    50	
    51	function markdownNodeOffsets(node: Nodes): { readonly start: number; readonly end: number } {
    52	  const start = node.position?.start.offset;
    53	  const end = node.position?.end.offset;
    54	  if (start === undefined || end === undefined) {
    55	    throw new Error(`Markdown ${node.type} node is missing source offsets.`);
    56	  }
    57	  return { start, end };
    58	}
    59	
    60	function collectImageDefinitions(tree: Root): ReadonlyMap<string, string> {
    61	  const definitions = new Map<string, string>();
    62	  visitMarkdownNodes(tree, (node) => {
    63	    if (node.type === 'definition' && !definitions.has(node.identifier)) {
    64	      definitions.set(node.identifier, node.url);
    65	    }
    66	  });
    67	  return definitions;
    68	}
    69	
    70	function maskNonHtmlMarkdown(markdown: string, htmlNodes: readonly Html[]): string {
    71	  const masked = Array<string>(markdown.length).fill(' ');
    72	  for (let index = 0; index < markdown.length; index += 1) {
    73	    const character = markdown.charAt(index);
    74	    if (character === '\n' || character === '\r') {
    75	      masked[index] = character;
    76	    }
    77	  }
    78	
    79	  for (const node of htmlNodes) {
    80	    const { start, end } = markdownNodeOffsets(node);
    81	    for (let index = start; index < end; index += 1) {
    82	      masked[index] = markdown.charAt(index);
    83	    }
    84	  }
    85	
    86	  return masked.join('');
    87	}
    88	
    89	function analyzeHtml(markdown: string, tree: Root): HtmlAnalysis {
    90	  const htmlNodes: Html[] = [];
    91	  visitMarkdownNodes(tree, (node) => {
    92	    if (node.type === 'html') {
    93	      htmlNodes.push(node);
    94	    }
    95	  });
    96	
    97	  const fragment = parseFragment(maskNonHtmlMarkdown(markdown, htmlNodes), {
    98	    sourceCodeLocationInfo: true,
    99	  });
   100	  const imageReferences: ImageReferenceMatch[] = [];
   101	  const preRanges: SourceRange[] = [];
   102	
   103	  function visitHtmlNode(htmlNode: DefaultTreeAdapterTypes.Node): void {
   104	    if (defaultTreeAdapter.isElementNode(htmlNode) && htmlNode.tagName === 'pre') {
   105	      const location = htmlNode.sourceCodeLocation;
   106	      if (location === undefined || location === null) {
   107	        throw new Error('Parsed HTML pre element is missing source offsets.');
   108	      }
   109	      preRanges.push({ start: location.startOffset, end: location.endOffset });
   110	      return;
   111	    }
   112	
   113	    if (defaultTreeAdapter.isElementNode(htmlNode) && htmlNode.tagName === 'img') {
   114	      const source = htmlNode.attrs.find((attribute) => attribute.name === 'src');
   115	      if (source !== undefined && isGitHubAttachmentUrl(source.value)) {
   116	        const location = htmlNode.sourceCodeLocation?.startTag;
   117	        if (location === undefined) {
   118	          throw new Error('Parsed HTML image is missing source offsets.');
   119	        }
   120	        imageReferences.push({
   121	          start: location.startOffset,
   122	          end: location.endOffset,
   123	          url: source.value,
   124	        });
   125	      }
   126	    }
   127	
   128	    if ('childNodes' in htmlNode) {
   129	      for (const child of htmlNode.childNodes) {
   130	        visitHtmlNode(child);
   131	      }
   132	    }
   133	  }
   134	
   135	  visitHtmlNode(fragment);
   136	  return { imageReferences, preRanges };
   137	}
   138	
   139	function isInsidePre(nodeRange: SourceRange, preRanges: readonly SourceRange[]): boolean {
   140	  return preRanges.some((preRange) => (
   141	    preRange.start <= nodeRange.start && nodeRange.end <= preRange.end
   142	  ));
   143	}
   144	
   145	function findImageReferences(markdown: string): ImageReferenceMatch[] {
   146	  const tree = fromMarkdown(markdown);
   147	  const definitions = collectImageDefinitions(tree);
   148	  const html = analyzeHtml(markdown, tree);
   149	  const references: ImageReferenceMatch[] = [...html.imageReferences];
   150	
   151	  visitMarkdownNodes(tree, (node) => {
   152	    if (node.type === 'image') {
   153	      const offsets = markdownNodeOffsets(node);
   154	      if (!isInsidePre(offsets, html.preRanges) && isGitHubAttachmentUrl(node.url)) {
   155	        references.push({ ...offsets, url: node.url });
   156	      }
   157	      return;
   158	    }
   159	
   160	    if (node.type === 'imageReference') {
   161	      const offsets = markdownNodeOffsets(node);
   162	      const url = definitions.get(node.identifier);
   163	      if (
   164	        !isInsidePre(offsets, html.preRanges)
   165	        && url !== undefined
   166	        && isGitHubAttachmentUrl(url)
   167	      ) {
   168	        references.push({ ...offsets, url });
   169	      }
   170	    }
   171	  });
   172	
   173	  return references.sort((left, right) => left.start - right.start);
   174	}
   175	
   176	function findTaskImageReferences(formattedTask: FormattedPrReviewTask): ImageReferenceMatch[] {
   177	  return formattedTask.markdownFragments.flatMap((fragment) => {
   178	    const markdown = formattedTask.taskContent.slice(fragment.start, fragment.end);
   179	    return findImageReferences(markdown).map((reference) => ({
   180	      ...reference,
   181	      start: fragment.start + reference.start,
   182	      end: fragment.start + reference.end,
   183	    }));
   184	  });
   185	}
   186	
   187	export async function preparePrReviewAttachments(
   188	  formattedTask: FormattedPrReviewTask,
   189	  cwd: string,
   190	): Promise<PreparedPrReviewAttachments> {
   191	  const { taskContent } = formattedTask;
   192	  const references = findTaskImageReferences(formattedTask);
   193	  if (references.length === 0) {
   194	    return {
   195	      taskContent,
   196	      attachments: [],
   197	      cleanupAttachments: () => undefined,
   198	    };
   199	  }
   200	
   201	  const attachmentStore = createSessionImageAttachmentStore();
   202	  const placeholderByUrl = new Map<string, string>();
   203	  const attachments: TaskAttachment[] = [];
   204	  const contentParts: string[] = [];
   205	  const assignImageAttachmentIndex = createImageAttachmentIndexAssigner([taskContent]);
   206	  let contentOffset = 0;
   207	
   208	  try {
   209	    for (const reference of references) {
   210	      let placeholder = placeholderByUrl.get(reference.url);
   211	      if (placeholder === undefined) {
   212	        const image = await downloadPrImage(reference.url, cwd);
   213	        const storedAttachment = await attachmentStore.saveImage(image.data, image.mimeType);
   214	        const attachment = assignImageAttachmentIndex(storedAttachment);
   215	        attachments.push(attachment);
   216	        placeholder = attachment.placeholder;
   217	        placeholderByUrl.set(reference.url, placeholder);
   218	      }
   219	      contentParts.push(taskContent.slice(contentOffset, reference.start), placeholder);
   220	      contentOffset = reference.end;
   221	    }
   222	  } catch (error) {
   223	    cleanupImageAttachmentStore(attachmentStore);
   224	    throw error;
   225	  }
   226	  contentParts.push(taskContent.slice(contentOffset));
   227	
   228	  return {
   229	    taskContent: contentParts.join(''),
   230	    attachments,
   231	    cleanupAttachments: () => cleanupImageAttachmentStore(attachmentStore),
   232	  };
   233	}
