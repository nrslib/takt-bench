   313	  if (expectedManifest.length !== 0) {
   314	    copyAttachmentEntry(sourceAttachmentsDir, path.join(runContextTaskDir, 'attachments'));
   315	  }
   316	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   317	  assertTaskAttachmentsMatchManifest(runContextTaskDir, expectedManifest);
   318	}
