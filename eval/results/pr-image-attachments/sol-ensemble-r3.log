   288	export function prepareTaskSpecDirectory(
   289	  cwd: string,
   290	  taskContent: string,
   291	  attachments?: readonly TaskAttachment[],
   292	  options?: PrepareTaskSpecOptions,
   293	): PreparedTaskSpec {
   294	  const orderContent = buildTaskOrderContent(taskContent, attachments);
   295	  return prepareEnqueuedTaskSpecDirectory(cwd, taskContent, {
   296	    orderContent,
   297	    beforeWrite: (taskDir) => {
   298	      if (options?.sourceTaskDir) {
   299	        copyExistingTaskAttachments(options.sourceTaskDir, taskDir);
   300	      }
   301	      promoteTaskAttachments(taskDir, attachments);
   302	    },
   303	  });
