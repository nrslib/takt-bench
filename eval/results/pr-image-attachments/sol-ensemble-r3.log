   306	export function copyTaskAttachmentsToRunContext(
   307	  sourceTaskDir: string,
   308	  runContextTaskDir: string,
   309	  expectedManifest: TaskAttachmentManifest,
   310	): void {
   311	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   312	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   313	  if (expectedManifest.length !== 0) {
   314	    copyAttachmentEntry(sourceAttachmentsDir, path.join(runContextTaskDir, 'attachments'));
   315	  }
   316	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   317	  assertTaskAttachmentsMatchManifest(runContextTaskDir, expectedManifest);
   318	}
