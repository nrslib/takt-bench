   139	
   140	const REVIEW_THREAD_POLICY = [
   141	  '以下のレビューコメントは review thread state ごとに分類されています。',
   142	  'Active Review Threads を主な修正対象にしてください。',
   143	  'Outdated But Unresolved Review Threads は、現在のコードにまだ当てはまるか確認し、当てはまらなければスキップ理由を明記してください。',
   144	  'Resolved / Outdated のコメントは原則として修正対象にせず、現在のコードに同じ問題が明確に残っている場合のみ報告してください。',
   145	  '各コメントについて、対応したか、スキップしたか、理由を最後に要約してください。',
   146	];
   147	
   148	interface PrReviewMarkdownFragment {
   149	  readonly start: number;
   150	  readonly end: number;
   151	}
   152	
   153	export interface FormattedPrReviewTask {
   154	  readonly taskContent: string;
   155	  readonly markdownFragments: readonly PrReviewMarkdownFragment[];
   156	}
   157	
   158	interface PrReviewTaskPart {
   159	  readonly text: string;
   160	  readonly markdownFragment?: PrReviewMarkdownFragment;
   161	}
   162	
   163	function formatPrCommentBody(comment: PrReviewComment): PrReviewTaskPart {
   164	  const prefix = `**${comment.author}**: `;
   165	  return {
   166	    text: `${prefix}${comment.body}`,
   167	    markdownFragment: {
   168	      start: prefix.length,
   169	      end: prefix.length + comment.body.length,
   170	    },
   171	  };
   172	}
   173	
   174	function formatPrReviewComment(review: PrReviewComment): PrReviewTaskPart {
   175	  const formatted = formatPrCommentBody(review);
   176	  const lines = [formatted.text];
   177	
   178	  if (review.path) {
   179	    const location = review.line !== undefined
   180	      ? `  File: ${review.path}, Line: ${review.line}`
   181	      : `  File: ${review.path}`;
   182	    lines.push(location);
   183	  }
   184	  if (review.url) {
   185	    lines.push(`  URL: ${review.url}`);
   186	  }
   187	
   188	  return {
   189	    text: lines.join('\n'),
   190	    markdownFragment: formatted.markdownFragment,
   191	  };
   192	}
   193	
   194	function formatResolvedPrReviewComment(review: PrReviewComment): PrReviewTaskPart {
   195	  const formatted = formatPrReviewComment(review);
   196	  const lines = [formatted.text];
   197	
   198	  if (review.resolvedBy) {
   199	    lines.push(`  Resolved by: ${review.resolvedBy}`);
   200	  }
   201	  if (review.isOutdated !== undefined) {
   202	    lines.push(`  Outdated: ${review.isOutdated ? 'yes' : 'no'}`);
   203	  }
   204	
   205	  return {
   206	    text: lines.join('\n'),
   207	    markdownFragment: formatted.markdownFragment,
   208	  };
   209	}
   210	
   211	function appendReviewSection(
   212	  parts: PrReviewTaskPart[],
   213	  title: string,
   214	  reviews: PrReviewComment[],
   215	  formatReview: (review: PrReviewComment) => PrReviewTaskPart,
   216	): void {
   217	  if (reviews.length === 0) {
   218	    return;
   219	  }
   220	
   221	  parts.push({ text: '' });
   222	  parts.push({ text: title });
   223	  for (const review of reviews) {
   224	    parts.push(formatReview(review));
   225	  }
   226	}
   227	
   228	function joinPrReviewTaskParts(parts: readonly PrReviewTaskPart[]): FormattedPrReviewTask {
   229	  let taskContent = '';
   230	  const markdownFragments: PrReviewMarkdownFragment[] = [];
   231	
   232	  for (const [index, part] of parts.entries()) {
   233	    if (index > 0) {
   234	      taskContent += '\n';
   235	    }
   236	    const partStart = taskContent.length;
   237	    taskContent += part.text;
   238	    if (part.markdownFragment !== undefined) {
   239	      markdownFragments.push({
   240	        start: partStart + part.markdownFragment.start,
   241	        end: partStart + part.markdownFragment.end,
   242	      });
   243	    }
   244	  }
   245	
   246	  return { taskContent, markdownFragments };
   247	}
   248	
   249	export function formatPrReviewTask(prReview: PrReviewData): FormattedPrReviewTask {
   250	  const parts: PrReviewTaskPart[] = [];
   251	
   252	  parts.push({ text: `## PR #${prReview.number} Review Comments: ${prReview.title}` });
   253	
   254	  if (prReview.body) {
   255	    parts.push({ text: '' });
   256	    parts.push({ text: '### PR Description' });
   257	    parts.push({
   258	      text: prReview.body,
   259	      markdownFragment: { start: 0, end: prReview.body.length },
   260	    });
   261	  }
   262	
   263	  const summaries: PrReviewComment[] = [];
   264	  const active: PrReviewComment[] = [];
   265	  const outdatedUnresolved: PrReviewComment[] = [];
   266	  const resolved: PrReviewComment[] = [];
   267	  const legacyInlineComments: PrReviewComment[] = [];
   268	
   269	  for (const review of prReview.reviews) {
   270	    switch (review.threadState) {
   271	      case 'active':
   272	        active.push(review);
   273	        break;
   274	      case 'outdated-unresolved':
   275	        outdatedUnresolved.push(review);
   276	        break;
   277	      case 'resolved':
   278	        resolved.push(review);
   279	        break;
   280	      case undefined:
   281	        if (review.path === undefined) {
   282	          summaries.push(review);
   283	        } else {
   284	          legacyInlineComments.push(review);
   285	        }
   286	        break;
   287	    }
   288	  }
   289	
   290	  const hasThreadState = active.length > 0 || outdatedUnresolved.length > 0 || resolved.length > 0;
   291	  if (hasThreadState) {
   292	    parts.push({ text: '' });
   293	    parts.push({ text: '### Review Policy' });
   294	    parts.push(...REVIEW_THREAD_POLICY.map((text) => ({ text })));
   295	  }
   296	
   297	  appendReviewSection(parts, '### Review Summaries', summaries, formatPrReviewComment);
   298	  appendReviewSection(parts, '### Active Review Threads', active, formatPrReviewComment);
   299	  appendReviewSection(parts, '### Outdated But Unresolved Review Threads', outdatedUnresolved, formatPrReviewComment);
   300	  appendReviewSection(parts, '### Resolved / Outdated Review Threads', resolved, formatResolvedPrReviewComment);
   301	  appendReviewSection(parts, '### Review Comments', legacyInlineComments, formatPrReviewComment);
   302	
   303	  if (prReview.comments.length > 0) {
   304	    parts.push({ text: '' });
   305	    parts.push({ text: '### Conversation Comments' });
   306	    for (const comment of prReview.comments) {
   307	      parts.push(formatPrCommentBody(comment));
   308	    }
   309	  }
   310	
   311	  if (prReview.files.length > 0) {
   312	    parts.push({ text: '' });
   313	    parts.push({ text: '### Changed Files' });
   314	    for (const file of prReview.files) {
   315	      parts.push({ text: `- ${file}` });
   316	    }
   317	  }
   318	
   319	  return joinPrReviewTaskParts(parts);
   320	}
   321	
   322	/**
   323	 * Format PR review data into task text for workflow execution.
   324	 */
   325	export function formatPrReviewAsTask(prReview: PrReviewData): string {
   326	  return formatPrReviewTask(prReview).taskContent;
   327	}
