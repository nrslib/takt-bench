    41	function resolveGitHubToken(cwd: string): string {
    42	  const token = execFileSync('gh', ['auth', 'token', '--hostname', GITHUB_ATTACHMENT_HOST], {
    43	    cwd,
    44	    encoding: 'utf8',
    45	    stdio: ['ignore', 'pipe', 'pipe'],
    46	  }).trim();
    47	  if (token.length === 0) {
    48	    throw new Error('GitHub authentication token is empty.');
    49	  }
    50	  return token;
    51	}
