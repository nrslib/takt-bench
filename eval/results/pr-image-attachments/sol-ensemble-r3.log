   200	function mockHardProcessExit(observeAfterExitListeners: (exitCode: number) => void) {
   201	  const existingExitListeners = new Set(process.rawListeners('exit'));
   202	  return vi.spyOn(process, 'exit').mockImplementation((code) => {
   203	    const exitCode = typeof code === 'number' ? code : 0;
   204	    for (const listener of process.rawListeners('exit')) {
   205	      if (!existingExitListeners.has(listener)) {
   206	        listener(exitCode);
   207	      }
   208	    }
   209	    observeAfterExitListeners(exitCode);
   210	    throw new Error('process.exit called');
   211	  });
   212	}
