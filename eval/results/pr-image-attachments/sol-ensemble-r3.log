   103	function resolveResponseMimeType(response: Response, data: Buffer): SupportedImageMimeType {
   104	  const contentTypeHeader = response.headers.get('content-type');
   105	  const contentType = contentTypeHeader?.split(';', 1)[0]?.trim().toLowerCase();
   106	  if (contentType === undefined || !isSupportedImageMimeType(contentType)) {
   107	    throw new Error('Unsupported PR image Content-Type. Expected PNG, JPEG, GIF, or WebP.');
   108	  }
   109	
   110	  const detectedMimeType = inferSupportedImageMimeType(data);
   111	  if (detectedMimeType === undefined) {
   112	    throw new Error('Unsupported PR image data. Expected PNG, JPEG, GIF, or WebP magic bytes.');
   113	  }
   114	  if (detectedMimeType !== contentType) {
   115	    throw new Error(`PR image Content-Type does not match image data: ${contentType} !== ${detectedMimeType}`);
   116	  }
   117	  return detectedMimeType;
   118	}
   119	
   120	export async function downloadPrImage(url: string, cwd: string): Promise<DownloadedPrImage> {
   121	  if (!isGitHubAttachmentUrl(url)) {
   122	    throw new Error('PR image URL must be a GitHub attachment URL.');
   123	  }
   124	
   125	  const token = resolveGitHubToken(cwd);
   126	  const abortController = new AbortController();
   127	  let response: Response;
   128	  try {
   129	    response = await fetch(url, {
   130	      headers: {
   131	        Accept: 'image/png, image/jpeg, image/gif, image/webp',
   132	        Authorization: `Bearer ${token}`,
   133	      },
   134	      signal: abortController.signal,
   135	    });
   136	  } catch {
   137	    throw new Error('Failed to download the PR image.');
   138	  }
   139	
   140	  if (!response.ok) {
   141	    await abortResponse(response, abortController);
   142	    throw new Error(`Failed to download the PR image: HTTP ${response.status}`);
   143	  }
   144	  await validateContentLength(response, abortController);
   145	  const data = await readImageBody(response, abortController);
   146	  const mimeType = resolveResponseMimeType(response, data);
   147	  return { data, mimeType };
   148	}

