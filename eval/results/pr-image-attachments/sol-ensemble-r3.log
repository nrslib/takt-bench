   145	function findImageReferences(markdown: string): ImageReferenceMatch[] {
   146	  const tree = fromMarkdown(markdown);
   147	  const definitions = collectImageDefinitions(tree);
   148	  const html = analyzeHtml(markdown, tree);
   149	  const references: ImageReferenceMatch[] = [...html.imageReferences];
   150	
   151	  visitMarkdownNodes(tree, (node) => {
   152	    if (node.type === 'image') {
   153	      const offsets = markdownNodeOffsets(node);
   154	      if (!isInsidePre(offsets, html.preRanges) && isGitHubAttachmentUrl(node.url)) {
   155	        references.push({ ...offsets, url: node.url });
   156	      }
   157	      return;
   158	    }
   159	
   160	    if (node.type === 'imageReference') {
   161	      const offsets = markdownNodeOffsets(node);
   162	      const url = definitions.get(node.identifier);
   163	      if (
   164	        !isInsidePre(offsets, html.preRanges)
   165	        && url !== undefined
   166	        && isGitHubAttachmentUrl(url)
   167	      ) {
   168	        references.push({ ...offsets, url });
   169	      }
   170	    }
   171	  });
   172	
   173	  return references.sort((left, right) => left.start - right.start);
   174	}
   175	
   176	function findTaskImageReferences(formattedTask: FormattedPrReviewTask): ImageReferenceMatch[] {
   177	  return formattedTask.markdownFragments.flatMap((fragment) => {
   178	    const markdown = formattedTask.taskContent.slice(fragment.start, fragment.end);
   179	    return findImageReferences(markdown).map((reference) => ({
   180	      ...reference,
   181	      start: fragment.start + reference.start,
   182	      end: fragment.start + reference.end,
   183	    }));
   184	  });
   185	}
