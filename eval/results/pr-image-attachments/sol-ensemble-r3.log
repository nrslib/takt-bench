    53	async function validateContentLength(response: Response, abortController: AbortController): Promise<void> {
    54	  const contentLength = response.headers.get('content-length');
    55	  if (contentLength === null) {
    56	    return;
    57	  }
    58	  if (!/^\d+$/.test(contentLength)) {
    59	    await abortResponse(response, abortController);
    60	    throw new Error('PR image response has an invalid Content-Length header.');
    61	  }
    62	  const length = Number(contentLength);
    63	  if (!Number.isSafeInteger(length)) {
    64	    await abortResponse(response, abortController);
    65	    throw new Error('PR image response has an invalid Content-Length header.');
    66	  }
    67	  if (length > MAX_SUPPORTED_IMAGE_BYTES) {
    68	    await abortResponse(response, abortController);
    69	    throw new Error(`PR image exceeds the ${MAX_SUPPORTED_IMAGE_BYTES} byte limit.`);
    70	  }
    71	}
    72	
    73	async function readImageBody(response: Response, abortController: AbortController): Promise<Buffer> {
    74	  if (response.body === null) {
    75	    return Buffer.alloc(0);
    76	  }
    77	
    78	  const reader = response.body.getReader();
    79	  const chunks: Buffer[] = [];
    80	  let byteLength = 0;
    81	  const readChunk = async () => {
    82	    try {
    83	      return await reader.read();
    84	    } catch {
    85	      throw new Error('Failed to read the PR image response.');
    86	    }
    87	  };
    88	  while (true) {
    89	    const chunk = await readChunk();
    90	    if (chunk.done) {
    91	      break;
    92	    }
    93	    byteLength += chunk.value.byteLength;
    94	    if (byteLength > MAX_SUPPORTED_IMAGE_BYTES) {
    95	      await abortDownload(() => reader.cancel(), abortController);
    96	      throw new Error(`PR image exceeds the ${MAX_SUPPORTED_IMAGE_BYTES} byte limit.`);
    97	    }
    98	    chunks.push(Buffer.from(chunk.value));
    99	  }
   100	  return Buffer.concat(chunks, byteLength);
   101	}
