    78	function createPrivateArtifact(
    79	  parentPath: string,
    80	  targetPath: string,
    81	  parentStat: Stats,
    82	  kind: 'directory' | 'file',
    83	  mode: number,
    84	): Stats {
    85	  const identity = createPrivateArtifactAtBoundary(parentPath, targetPath, parentStat, kind, mode);
    86	  const createdStat = lstatSync(targetPath) as Stats;
    87	  const expectedKind = kind === 'directory' ? createdStat.isDirectory() : createdStat.isFile();
    88	  if (!expectedKind || String(createdStat.dev) !== identity.dev || String(createdStat.ino) !== identity.ino) {
    89	    throw new Error(`Private artifact identity changed after creation: ${targetPath}`);
    90	  }
    91	  return createdStat;
    92	}
