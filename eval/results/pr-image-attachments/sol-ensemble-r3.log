   129	  }
   130	  // Windows はディレクトリ記述子への fchmod を持たず EPERM になる。
   131	  // private-directory-backend の openDirectory と同じく、記述子を開かずに
   132	  // lstat の同一性確認だけを行い、POSIX モードは適用しない。
   133	  if (process.platform === 'win32') {
