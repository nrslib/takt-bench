    22	async function abortDownload(cancelBody: () => Promise<void>, abortController: AbortController): Promise<void> {
    23	  try {
    24	    await cancelBody();
    25	  } catch (error) {
    26	    log.debug('Failed to cancel rejected PR image response body', { error: getErrorMessage(error) });
    27	  } finally {
    28	    abortController.abort();
    29	  }
    30	}
    31	
    32	async function abortResponse(response: Response, abortController: AbortController): Promise<void> {
    33	  if (response.body === null) {
    34	    abortController.abort();
    35	    return;
    36	  }
    37	  const body = response.body;
    38	  await abortDownload(() => body.cancel(), abortController);
    39	}
