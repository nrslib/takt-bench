    21	export function createImageAttachmentIndexAllocator(
    22	  references: readonly string[],
    23	): () => string {
    24	  const reservedIndexes = new Set<string>();
    25	  for (const reference of references) {
    26	    for (const match of reference.matchAll(IMAGE_ATTACHMENT_INDEX_PATTERN)) {
    27	      const rawIndex = match[1] ?? match[2];
