    95	export function ensurePrivateDirectory(directoryPath: string): void {
    96	  const { targetPath: absolute, trustedRoot } = artifactBoundary(directoryPath);
    97	  assertSafePath(absolute, true);
    98	  let current = trustedRoot;
    99	  for (const component of relative(trustedRoot, absolute).split(sep).filter(Boolean)) {
   100	    const parentPath = current;
   101	    const parentStat = current === trustedRoot ? statSync(current) as Stats : lstatSync(current) as Stats;
   102	    current = join(parentPath, component);
   103	    if (lstatOrUndefined(current) === undefined) {
   104	      try {
   105	        createPrivateArtifact(parentPath, current, parentStat, 'directory', PRIVATE_DIRECTORY_MODE);
   106	      } catch (error) {
   107	        if (!(error instanceof PrivateArtifactCreationConflictError)) {
   108	          throw error;
   109	        }
   110	      }
   111	    }
   112	    const stat = lstatSync(current);
   113	    if (stat.isSymbolicLink() || !stat.isDirectory()) {
   114	      throw new Error(`Private artifact directory is unsafe: ${current}`);
   115	    }
   116	  }
   117	  setPrivateDirectoryMode(absolute);
   118	}
