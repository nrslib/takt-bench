    41	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    42	    );
    43	    return {
    44	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    45	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
