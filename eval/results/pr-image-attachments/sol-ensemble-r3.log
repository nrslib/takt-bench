   136	function copyAttachmentEntry(sourcePath: string, destinationPath: string): void {
   137	  const stats = fs.lstatSync(sourcePath);
   138	  if (stats.isSymbolicLink()) {
   139	    throw new Error(`Task attachments must not contain symlinks: ${sourcePath}`);
   140	  }
   141	  if (stats.isDirectory()) {
   142	    fs.mkdirSync(destinationPath, { recursive: true });
   143	    for (const entry of fs.readdirSync(sourcePath)) {
   144	      copyAttachmentEntry(path.join(sourcePath, entry), path.join(destinationPath, entry));
   145	    }
   146	    return;
   147	  }
   148	  if (!stats.isFile()) {
   149	    throw new Error(`Task attachments must be regular files or directories: ${sourcePath}`);
   150	  }
   151	  fs.mkdirSync(path.dirname(destinationPath), { recursive: true });
   152	  fs.copyFileSync(sourcePath, destinationPath);
   153	}
   154	
   155	interface AttachmentTreeManifest {
   156	  readonly root: TaskAttachmentManifestEntry;
   157	  readonly entries: readonly TaskAttachmentManifestEntry[];
   158	}
   159	
   160	function hashAttachmentContent(content: string | Buffer): string {
   161	  return createHash('sha256').update(content).digest('hex');
   162	}
   163	
   164	function readAttachmentTreeManifest(
   165	  absolutePath: string,
   166	  relativePath: string,
   167	): AttachmentTreeManifest {
   168	  const stats = fs.lstatSync(absolutePath);
   169	  if (stats.isSymbolicLink()) {
   170	    throw new Error(`Task attachments must not contain symlinks: ${absolutePath}`);
   171	  }
   172	  if (stats.isFile()) {
   173	    const root = Object.freeze({
   174	      relativePath,
   175	      kind: 'file' as const,
   176	      contentSha256: hashAttachmentContent(fs.readFileSync(absolutePath)),
   177	    });
   178	    return Object.freeze({ root, entries: Object.freeze([root]) });
   179	  }
   180	  if (!stats.isDirectory()) {
   181	    throw new Error(`Task attachments must be regular files or directories: ${absolutePath}`);
   182	  }
   183	
   184	  const children = fs.readdirSync(absolutePath)
   185	    .sort()
   186	    .map((entry) => readAttachmentTreeManifest(
   187	      path.join(absolutePath, entry),
   188	      path.posix.join(relativePath, entry),
   189	    ));
   190	  const root = Object.freeze({
   191	    relativePath,
   192	    kind: 'directory' as const,
   193	    contentSha256: hashAttachmentContent(JSON.stringify(
   194	      children.map((child) => child.root),
   195	    )),
   196	  });
   197	  return Object.freeze({
   198	    root,
   199	    entries: Object.freeze([
   200	      root,
   201	      ...children.flatMap((child) => child.entries),
   202	    ]),
   203	  });
   204	}
   205	
   206	export function resolveTaskAttachmentManifest(
   207	  taskDir: string,
   208	): TaskAttachmentManifest {
   209	  const attachmentsDir = path.join(taskDir, 'attachments');
   210	  if (!fs.existsSync(attachmentsDir)) {
   211	    return Object.freeze([]);
   212	  }
   213	
   214	  const stats = fs.lstatSync(attachmentsDir);
   215	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   216	    throw new Error(`Task attachments must be a regular directory: ${attachmentsDir}`);
   217	  }
   218	
   219	  return readAttachmentTreeManifest(attachmentsDir, 'attachments').entries;
   220	}
   221	
   222	function assertTaskAttachmentManifestEntry(
   223	  taskDir: string,
   224	  expected: TaskAttachmentManifestEntry,
   225	  actual: TaskAttachmentManifestEntry | undefined,
   226	): void {
   227	  const entryPath = path.join(taskDir, expected.relativePath);
   228	  if (actual === undefined) {
   229	    throw new Error(`Task attachment is missing: ${entryPath}`);
   230	  }
   231	  if (actual.kind !== expected.kind) {
   232	    throw new Error(`Task attachment type changed: ${entryPath}`);
   233	  }
   234	  if (actual.contentSha256 !== expected.contentSha256) {
   235	    throw new Error(`Task attachment content changed: ${entryPath}`);
   236	  }
   237	}
   238	
   239	function assertTaskAttachmentsMatchManifest(
   240	  taskDir: string,
   241	  expectedManifest: TaskAttachmentManifest,
   242	): void {
   243	  const actualManifest = resolveTaskAttachmentManifest(taskDir);
   244	  const expectedByPath = new Map(
   245	    expectedManifest.map((entry) => [entry.relativePath, entry]),
   246	  );
   247	  const actualByPath = new Map(
   248	    actualManifest.map((entry) => [entry.relativePath, entry]),
   249	  );
   250	
   251	  for (const expected of expectedManifest) {
   252	    if (!actualByPath.has(expected.relativePath)) {
   253	      throw new Error(
   254	        `Task attachment is missing: ${path.join(taskDir, expected.relativePath)}`,
   255	      );
   256	    }
   257	  }
   258	  for (const actual of actualManifest) {
   259	    if (!expectedByPath.has(actual.relativePath)) {
   260	      throw new Error(
   261	        `Task attachment was added after resolution: ${path.join(taskDir, actual.relativePath)}`,
   262	      );
   263	    }
   264	  }
   265	  for (const expected of expectedManifest) {
   266	    assertTaskAttachmentManifestEntry(
   267	      taskDir,
   268	      expected,
   269	      actualByPath.get(expected.relativePath),
   270	    );
   271	  }
   272	}
