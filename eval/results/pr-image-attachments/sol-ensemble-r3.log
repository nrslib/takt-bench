    32	export function createImageAttachmentIndexAssigner(
    33	  references: readonly string[],
    34	): (attachment: TaskAttachment) => TaskAttachment {
    35	  const allocateImageAttachmentIndex = createImageAttachmentIndexAllocator(references);
    36	
    37	  return (attachment) => {
    38	    const extension = path.extname(attachment.fileName);
    39	    if (extension === '') {
    40	      throw new Error(`Task attachment file must have an extension: ${attachment.fileName}`);
    41	    }
    42	
    43	    const assignedIndex = allocateImageAttachmentIndex();
    44	
    45	    return {
    46	      ...attachment,
    47	      placeholder: `[Image #${assignedIndex}]`,
    48	      fileName: `image-${assignedIndex}${extension}`,
    49	    };
    50	  };
