   396	function executeWithCleanup(action: () => void, cleanup: () => void, aggregateMessage: string): void {
   397	  let actionFailed = false;
   398	  let actionError: unknown;
   399	  try {
   400	    action();
   401	  } catch (error) {
   402	    actionFailed = true;
   403	    actionError = error;
   404	  }
   405	  let cleanupFailed = false;
   406	  let cleanupError: unknown;
   407	  try {
   408	    cleanup();
   409	  } catch (error) {
   410	    cleanupFailed = true;
   411	    cleanupError = error;
   412	  }
   413	  if (actionFailed && cleanupFailed) {
   414	    throw new AggregateError([actionError, cleanupError], aggregateMessage);
   415	  }
   416	  if (actionFailed) {
   417	    throw actionError;
   418	  }
   419	  if (cleanupFailed) {
   420	    throw cleanupError;
   421	  }
