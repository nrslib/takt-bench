   306	export function copyTaskAttachmentsToRunContext(
   307	  sourceTaskDir: string,
   308	  runContextTaskDir: string,
   309	  expectedManifest: TaskAttachmentManifest,
   310	): void {
   311	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
