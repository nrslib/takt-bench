+    const second = await runE2eMockAttempt(
+      createObservationCommand(testDir, 1),
+      createAttemptEnvironment,
+    );
+
+    const observations = [first, second].map((result) => JSON.parse(result.output) as {
+      cwd: string;
+      env: Record<string, string>;
+    });
