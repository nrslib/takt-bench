   110	export function promoteTaskAttachments(
   111	  taskDir: string,
   112	  attachments?: readonly TaskAttachment[],
   113	): void {
   114	  if (!hasAttachments(attachments)) {
   115	    return;
   116	  }
   117	
   118	  const attachmentsDir = path.join(taskDir, 'attachments');
   119	  fs.mkdirSync(attachmentsDir, { recursive: true });
   120	
   121	  for (const attachment of attachments) {
   122	    validateTaskAttachment(attachment);
   123	    validateTaskAttachmentTempFile(attachment);
   124	    const destinationPath = path.join(taskDir, getTaskAttachmentRelativePath(attachment));
   125	    if (fs.existsSync(destinationPath)) {
   126	      throw new Error(`Task attachment destination already exists: ${destinationPath}`);
   127	    }
   128	    fs.copyFileSync(attachment.tempPath, destinationPath);
   129	  }
   130	}
