   562	export function readRegularFileNoFollow(filePath: string, expectedStat: Stats): Buffer {
   563	  const absolute = resolve(filePath);
   564	  const descriptor = openSync(absolute, constants.O_RDONLY | NO_FOLLOW_FLAG);
   565	  try {
   566	    const openedStat = fstatSync(descriptor);
   567	    if (!openedStat.isFile() || !hasMatchingIdentity(expectedStat, openedStat)) {
   568	      throw new Error(`File identity changed while opening: ${absolute}`);
   569	    }
   570	    return readFileSync(descriptor);
   571	  } finally {
   572	    closeSync(descriptor);
   573	  }
   574	}
