     9	
    10	export interface ImageAttachmentStore {
    11	  saveImage(data: Buffer, mimeType: string): Promise<StoredImageAttachment>;
    12	  listAttachments(): StoredImageAttachment[];
    13	  cleanup(): void;
    14	}
    15	
    16	export interface ImageAttachmentStoreOptions {
    17	  tmpRoot: string;
    18	  sessionId: string;
    19	  initialAttachments?: readonly StoredImageAttachment[];
    20	  reservedContent?: string;
    21	}
    22	
    23	const PRIVATE_FILE_MODE = 0o600;
    24	
    25	function extensionForMimeType(mimeType: string): string {
    26	  switch (mimeType) {
    27	    case 'image/png':
    28	      return 'png';
    29	    case 'image/jpeg':
    30	      return 'jpg';
    31	    case 'image/gif':
    32	      return 'gif';
    33	    case 'image/webp':
    34	      return 'webp';
    35	    default:
    36	      throw new Error(`Unsupported image attachment type: ${mimeType}`);
    37	  }
    38	}
    39	
    40	function validateImageAttachmentSessionId(sessionId: string): void {
    41	  if (sessionId.length === 0) {
    42	    throw new Error('Image attachment sessionId is required.');
    43	  }
    44	  if (
    45	    sessionId === '.'
    46	    || sessionId === '..'
    47	    || sessionId.includes('/')
    48	    || sessionId.includes('\\')
    49	    || path.isAbsolute(sessionId)
    50	    || path.win32.isAbsolute(sessionId)
    51	  ) {
    52	    throw new Error('Image attachment sessionId must be a single path segment.');
    53	  }
    54	}
    55	
    56	export function cleanupImageAttachmentStore(attachmentStore: ImageAttachmentStore): void {
    57	  try {
    58	    attachmentStore.cleanup();
    59	  } catch (error) {
    60	    debugLog('image-attachment', 'Failed to cleanup image attachment store', error instanceof Error ? error.message : String(error));
    61	  }
    62	}
    63	
    64	export function createImageAttachmentStore(
    65	  options: ImageAttachmentStoreOptions,
    66	): ImageAttachmentStore {
    67	  if (options.tmpRoot.length === 0) {
    68	    throw new Error('Image attachment tmpRoot is required.');
    69	  }
    70	  validateImageAttachmentSessionId(options.sessionId);
    71	
    72	  let attachments: StoredImageAttachment[] = options.initialAttachments
    73	    ? [...options.initialAttachments]
    74	    : [];
    75	  const attachmentIndexReferences = attachments.flatMap((attachment) => [
    76	    attachment.placeholder,
    77	    attachment.fileName,
    78	  ]);
    79	  if (options.reservedContent !== undefined) {
    80	    attachmentIndexReferences.push(options.reservedContent);
    81	  }
    82	  const allocateImageAttachmentIndex = createImageAttachmentIndexAllocator(attachmentIndexReferences);
    83	  const sessionDir = path.join(options.tmpRoot, 'takt', options.sessionId);
    84	  const taktTmpDir = path.dirname(sessionDir);
    85	  const attachmentDir = path.join(sessionDir, 'attachments');
    86	
    87	  return {
    88	    async saveImage(data: Buffer, mimeType: string): Promise<StoredImageAttachment> {
    89	      const index = allocateImageAttachmentIndex();
    90	      const fileName = `image-${index}.${extensionForMimeType(mimeType)}`;
    91	      const tempPath = path.join(attachmentDir, fileName);
    92	      const attachment: StoredImageAttachment = {
    93	        placeholder: `[Image #${index}]`,
    94	        tempPath,
    95	        fileName,
    96	      };
    97	
    98	      ensurePrivateDirectory(taktTmpDir);
    99	      ensurePrivateDirectory(sessionDir);
   100	      ensurePrivateDirectory(attachmentDir);
   101	      writeNewPrivateFileWithMode(tempPath, data, PRIVATE_FILE_MODE);
   102	      attachments = [...attachments, attachment];
   103	      return attachment;
   104	    },
   105	
   106	    listAttachments(): StoredImageAttachment[] {
   107	      return [...attachments];
   108	    },
   109	
   110	    cleanup(): void {
   111	      fs.rmSync(sessionDir, { recursive: true, force: true });
   112	    },
   113	  };
   114	}
   115	
   116	export function createSessionImageAttachmentStore(
   117	  initialAttachments?: readonly StoredImageAttachment[],
   118	  reservedContent?: string,
   119	): ImageAttachmentStore {
   120	  return createImageAttachmentStore({
   121	    tmpRoot: os.tmpdir(),
   122	    sessionId: randomUUID(),
   123	    ...(initialAttachments ? { initialAttachments } : {}),
   124	    ...(reservedContent !== undefined ? { reservedContent } : {}),
   125	  });
   126	}
