+interface PreparedPrReviewAttachments {
+  readonly taskContent: string;
+  readonly attachments: TaskAttachment[];
+  readonly cleanupAttachments: () => void;
+}
+
+interface ImageReferenceMatch {
+  readonly start: number;
+  readonly end: number;
+  readonly url: string;
+}
+
+interface SourceRange {
+  readonly start: number;
+  readonly end: number;
+}
+
+interface HtmlAnalysis {
+  readonly imageReferences: readonly ImageReferenceMatch[];
+  readonly preRanges: readonly SourceRange[];
+}
+
+function visitMarkdownNodes(node: Nodes, visitor: (node: Nodes) => void): void {
+  visitor(node);
+  if ('children' in node) {
+    for (const child of node.children) {
+      visitMarkdownNodes(child, visitor);
+    }
+  }
+}
+
+function markdownNodeOffsets(node: Nodes): { readonly start: number; readonly end: number } {
+  const start = node.position?.start.offset;
+  const end = node.position?.end.offset;
+  if (start === undefined || end === undefined) {
+    throw new Error(`Markdown ${node.type} node is missing source offsets.`);
+  }
+  return { start, end };
+}
+
+function collectImageDefinitions(tree: Root): ReadonlyMap<string, string> {
+  const definitions = new Map<string, string>();
+  visitMarkdownNodes(tree, (node) => {
+    if (node.type === 'definition' && !definitions.has(node.identifier)) {
+      definitions.set(node.identifier, node.url);
+    }
+  });
+  return definitions;
+}
+
+function maskNonHtmlMarkdown(markdown: string, htmlNodes: readonly Html[]): string {
+  const masked = Array<string>(markdown.length).fill(' ');
+  for (let index = 0; index < markdown.length; index += 1) {
+    const character = markdown.charAt(index);
+    if (character === '\n' || character === '\r') {
+      masked[index] = character;
+    }
+  }
+
+  for (const node of htmlNodes) {
+    const { start, end } = markdownNodeOffsets(node);
+    for (let index = start; index < end; index += 1) {
+      masked[index] = markdown.charAt(index);
+    }
+  }
+
+  return masked.join('');
+}
+
+function analyzeHtml(markdown: string, tree: Root): HtmlAnalysis {
+  const htmlNodes: Html[] = [];
+  visitMarkdownNodes(tree, (node) => {
+    if (node.type === 'html') {
+      htmlNodes.push(node);
+    }
+  });
+
+  const fragment = parseFragment(maskNonHtmlMarkdown(markdown, htmlNodes), {
+    sourceCodeLocationInfo: true,
+  });
+  const imageReferences: ImageReferenceMatch[] = [];
+  const preRanges: SourceRange[] = [];
+
+  function visitHtmlNode(htmlNode: DefaultTreeAdapterTypes.Node): void {
+    if (defaultTreeAdapter.isElementNode(htmlNode) && htmlNode.tagName === 'pre') {
+      const location = htmlNode.sourceCodeLocation;
+      if (location === undefined || location === null) {
+        throw new Error('Parsed HTML pre element is missing source offsets.');
+      }
+      preRanges.push({ start: location.startOffset, end: location.endOffset });
+      return;
+    }
+
+    if (defaultTreeAdapter.isElementNode(htmlNode) && htmlNode.tagName === 'img') {
+      const source = htmlNode.attrs.find((attribute) => attribute.name === 'src');
+      if (source !== undefined && isGitHubAttachmentUrl(source.value)) {
+        const location = htmlNode.sourceCodeLocation?.startTag;
+        if (location === undefined) {
+          throw new Error('Parsed HTML image is missing source offsets.');
+        }
+        imageReferences.push({
+          start: location.startOffset,
+          end: location.endOffset,
+          url: source.value,
+        });
+      }
+    }
+
+    if ('childNodes' in htmlNode) {
+      for (const child of htmlNode.childNodes) {
+        visitHtmlNode(child);
+      }
+    }
+  }
+
+  visitHtmlNode(fragment);
+  return { imageReferences, preRanges };
+}
+
+function isInsidePre(nodeRange: SourceRange, preRanges: readonly SourceRange[]): boolean {
+  return preRanges.some((preRange) => (
+    preRange.start <= nodeRange.start && nodeRange.end <= preRange.end
+  ));
+}
+
+function findImageReferences(markdown: string): ImageReferenceMatch[] {
+  const tree = fromMarkdown(markdown);
+  const definitions = collectImageDefinitions(tree);
+  const html = analyzeHtml(markdown, tree);
+  const references: ImageReferenceMatch[] = [...html.imageReferences];
+
+  visitMarkdownNodes(tree, (node) => {
+    if (node.type === 'image') {
+      const offsets = markdownNodeOffsets(node);
+      if (!isInsidePre(offsets, html.preRanges) && isGitHubAttachmentUrl(node.url)) {
+        references.push({ ...offsets, url: node.url });
+      }
+      return;
+    }
+
+    if (node.type === 'imageReference') {
+      const offsets = markdownNodeOffsets(node);
+      const url = definitions.get(node.identifier);
+      if (
+        !isInsidePre(offsets, html.preRanges)
+        && url !== undefined
+        && isGitHubAttachmentUrl(url)
+      ) {
+        references.push({ ...offsets, url });
+      }
+    }
+  });
+
+  return references.sort((left, right) => left.start - right.start);
+}
+
+function findTaskImageReferences(formattedTask: FormattedPrReviewTask): ImageReferenceMatch[] {
+  return formattedTask.markdownFragments.flatMap((fragment) => {
+    const markdown = formattedTask.taskContent.slice(fragment.start, fragment.end);
+    return findImageReferences(markdown).map((reference) => ({
+      ...reference,
+      start: fragment.start + reference.start,
+      end: fragment.start + reference.end,
+    }));
+  });
+}
+
+export async function preparePrReviewAttachments(
+  formattedTask: FormattedPrReviewTask,
+  cwd: string,
+): Promise<PreparedPrReviewAttachments> {
+  const { taskContent } = formattedTask;
+  const references = findTaskImageReferences(formattedTask);
+  if (references.length === 0) {
+    return {
+      taskContent,
+      attachments: [],
+      cleanupAttachments: () => undefined,
+    };
+  }
+
+  const attachmentStore = createSessionImageAttachmentStore();
+  const placeholderByUrl = new Map<string, string>();
+  const attachments: TaskAttachment[] = [];
+  const contentParts: string[] = [];
+  const assignImageAttachmentIndex = createImageAttachmentIndexAssigner([taskContent]);
+  let contentOffset = 0;
+
+  try {
+    for (const reference of references) {
+      let placeholder = placeholderByUrl.get(reference.url);
+      if (placeholder === undefined) {
+        const image = await downloadPrImage(reference.url, cwd);
+        const storedAttachment = await attachmentStore.saveImage(image.data, image.mimeType);
+        const attachment = assignImageAttachmentIndex(storedAttachment);
+        attachments.push(attachment);
+        placeholder = attachment.placeholder;
+        placeholderByUrl.set(reference.url, placeholder);
+      }
+      contentParts.push(taskContent.slice(contentOffset, reference.start), placeholder);
+      contentOffset = reference.end;
+    }
+  } catch (error) {
+    cleanupImageAttachmentStore(attachmentStore);
+    throw error;
+  }
+  contentParts.push(taskContent.slice(contentOffset));
+
+  return {
+    taskContent: contentParts.join(''),
+    attachments,
+    cleanupAttachments: () => cleanupImageAttachmentStore(attachmentStore),
+  };
+}
