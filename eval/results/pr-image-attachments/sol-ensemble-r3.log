     1	export function registerProcessExitCleanup(cleanup: () => void): () => void {
     2	  let finished = false;
     3	
     4	  const finish = (): void => {
     5	    if (finished) {
     6	      return;
     7	    }
     8	    finished = true;
     9	    process.removeListener('exit', finish);
    10	    cleanup();
    11	  };
    12	
    13	  process.once('exit', finish);
    14	  return finish;
    15	}

