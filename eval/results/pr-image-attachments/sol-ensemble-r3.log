    35	  return () => {
    36	    let assignedIndex = candidateIndex.toString();
    37	    while (reservedIndexes.has(assignedIndex)) {
    38	      candidateIndex += 1n;
    39	      assignedIndex = candidateIndex.toString();
    40	    }
    41	    reservedIndexes.add(assignedIndex);
    42	    candidateIndex += 1n;
    43	    return assignedIndex;
    44	  };
