    34	
    35	function resolveRetryTaskSpecBaseContent(
    36	  taskContent: string,
    37	  sourceTaskDir: string | undefined,
    38	): string {
    39	  if (!sourceTaskDir) {
    40	    return taskContent;
    41	  }
    42	
    43	  return readTaskSpecFile(path.join(sourceTaskDir, 'order.md'));
    44	}
    45	
    46	function resolveRetryAttachmentIndexReferences(
    47	  baseContent: string,
    48	  sourceTaskDir: string | undefined,
    49	): string[] {
    50	  if (!sourceTaskDir) {
    51	    return [baseContent];
    52	  }
    53	
    54	  const rootAttachmentPaths = resolveTaskAttachmentManifest(sourceTaskDir)
    55	    .filter((entry) => entry.kind === 'file' && path.posix.dirname(entry.relativePath) === 'attachments')
    56	    .map((entry) => entry.relativePath);
    57	  return [baseContent, ...rootAttachmentPaths];
    58	}
    59	
    60	function renumberRetryAttachments(
    61	  reservedReferences: readonly string[],
    62	  retryNote: string,
    63	  attachments: readonly TaskAttachment[],
    64	): { retryNote: string; attachments: TaskAttachment[] } {
    65	  const assignImageAttachmentIndex = createImageAttachmentIndexAssigner(reservedReferences);
    66	  const placeholderReplacements = new Map<string, string>();
    67	  const adjustedAttachments = attachments.map((attachment) => {
    68	    const adjustedAttachment = assignImageAttachmentIndex(attachment);
    69	    placeholderReplacements.set(attachment.placeholder, adjustedAttachment.placeholder);
    70	    return adjustedAttachment;
    71	  });
    72	  const adjustedRetryNote = retryNote.replace(/\[Image #\d+\]/g, (placeholder) =>
    73	    placeholderReplacements.get(placeholder) ?? placeholder);
    74	  return { retryNote: adjustedRetryNote, attachments: adjustedAttachments };
    75	}
    76	
    77	export function prepareRetryTaskSpecWithAttachments(
    78	  projectDir: string,
    79	  taskContent: string,
    80	  retryNote: string,
    81	  attachments: readonly TaskAttachment[] | undefined,
    82	  taskDir?: string,
    83	): PreparedRetryTaskSpec | undefined {
    84	  if (!hasAttachments(attachments)) {
    85	    return undefined;
    86	  }
    87	
    88	  const sourceTaskDir = taskDir ? resolveTaskDirPath(projectDir, taskDir) : undefined;
    89	  const taskSpecBaseContent = resolveRetryTaskSpecBaseContent(taskContent, sourceTaskDir);
    90	  const reservedReferences = resolveRetryAttachmentIndexReferences(taskSpecBaseContent, sourceTaskDir);
    91	  const adjusted = renumberRetryAttachments(reservedReferences, retryNote, attachments);
    92	  const taskSpecContent = buildRetryTaskSpecContent(taskSpecBaseContent, adjusted.retryNote);
    93	  const prepareArgs: Parameters<typeof prepareTaskSpecDirectory> = taskDir
    94	    ? [
    95	      projectDir,
    96	      taskSpecContent,
    97	      adjusted.attachments,
    98	      { sourceTaskDir },
    99	    ]
   100	    : [projectDir, taskSpecContent, adjusted.attachments];
   101	  const preparedSpec = prepareTaskSpecDirectory(...prepareArgs);
   102	  return {
   103	    taskDir: preparedSpec.taskDir,
   104	    taskDirRelative: preparedSpec.taskDirRelative,
   105	    retryNote: adjusted.retryNote,
   106	  };
   107	}
