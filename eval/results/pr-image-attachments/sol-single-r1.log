   175	function parseContentLength(response: Response): number | undefined {
   176	  const rawContentLength = response.headers.get('content-length');
   177	  if (rawContentLength === null) {
   178	    return undefined;
   179	  }
   180	  if (!/^\d+$/u.test(rawContentLength)) {
   181	    throw new Error(`Invalid image Content-Length: ${rawContentLength}`);
   182	  }
   183	  const contentLength = Number(rawContentLength);
   184	  if (!Number.isSafeInteger(contentLength)) {
   185	    throw new Error(`Invalid image Content-Length: ${rawContentLength}`);
   186	  }
   187	  return contentLength;
   188	}
   189	
   190	function parseImageContentType(response: Response): SupportedImageMimeType {
   191	  const rawContentType = response.headers.get('content-type');
   192	  const contentType = rawContentType?.split(';', 1)[0]?.trim().toLowerCase();
   193	  if (!SUPPORTED_CONTENT_TYPES.has(contentType as SupportedImageMimeType)) {
   194	    throw new Error(`Unsupported image Content-Type: ${rawContentType ?? '(missing)'}`);
   195	  }
   196	  return contentType as SupportedImageMimeType;
   197	}
   198	
   199	async function readResponseBody(response: Response): Promise<Buffer> {
   200	  const contentLength = parseContentLength(response);
   201	  if (contentLength !== undefined && contentLength > MAX_PR_IMAGE_BYTES) {
   202	    throw new Error(`PR image exceeds the ${MAX_PR_IMAGE_BYTES} byte limit.`);
   203	  }
   204	  if (response.body === null) {
   205	    throw new Error('PR image response has no body.');
   206	  }
   207	
   208	  const reader = response.body.getReader();
   209	  const chunks: Buffer[] = [];
   210	  let totalBytes = 0;
   211	  while (true) {
   212	    const { done, value } = await reader.read();
   213	    if (done) {
   214	      break;
   215	    }
   216	    totalBytes += value.byteLength;
   217	    if (totalBytes > MAX_PR_IMAGE_BYTES) {
   218	      await reader.cancel();
   219	      throw new Error(`PR image exceeds the ${MAX_PR_IMAGE_BYTES} byte limit.`);
   220	    }
   221	    chunks.push(Buffer.from(value));
   222	  }
   223	  return Buffer.concat(chunks, totalBytes);
   224	}
