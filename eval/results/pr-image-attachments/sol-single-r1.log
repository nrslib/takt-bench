import { execFileSync } from 'node:child_process';
import { formatPrReviewAsTask, type PrReviewComment, type PrReviewData } from '../../infra/git/index.js';
import { getErrorMessage } from '../../shared/utils/index.js';
import {
  inferImageMimeTypeFromMagicBytes,
  type SupportedImageMimeType,
} from '../../shared/utils/imageMimeType.js';
import {
  cleanupImageAttachmentStore,
  createSessionImageAttachmentStore,
  type ImageAttachmentStore,
} from '../interactive/imageAttachments.js';
import type { TaskAttachment } from './attachments.js';

const MARKDOWN_IMAGE_PATTERN = /!\[[^\]\r\n]*\]\(\s*<?(https:\/\/[^\s)>]+)>?(?:\s+(?:"[^"]*"|'[^']*'))?\s*\)/giu;
const HTML_IMAGE_PATTERN = /<img\b[^>]*?\bsrc\s*=\s*(?:"([^"]+)"|'([^']+)'|([^\s>]+))[^>]*>/giu;
const SUPPORTED_CONTENT_TYPES = new Set<SupportedImageMimeType>([
  'image/png',
  'image/jpeg',
  'image/gif',
  'image/webp',
]);
const MAX_PR_IMAGE_BYTES = 10 * 1024 * 1024;
const MAX_PR_IMAGE_TOTAL_BYTES = 50 * 1024 * 1024;
const MAX_PR_IMAGE_ATTACHMENTS = 20;
const DOWNLOAD_TIMEOUT_MS = 30_000;

interface ImageMarkup {
  readonly start: number;
  readonly end: number;
  readonly url: string;
}

interface DownloadedImage {
  readonly data: Buffer;
  readonly mimeType: SupportedImageMimeType;
}

export interface PreparedPrReviewTask {
  readonly task: string;
  readonly attachments?: TaskAttachment[];
  readonly cleanupAttachments?: () => void;
}

function normalizeMarkupUrl(rawUrl: string): string {
  return rawUrl.replace(/&amp;/giu, '&');
}

function isGitHubAttachmentUrl(rawUrl: string): boolean {
  let url: URL;
  try {
    url = new URL(normalizeMarkupUrl(rawUrl));
  } catch {
    return false;
  }

  if (
    url.protocol !== 'https:'
    || url.hostname !== 'github.com'
    || url.port !== ''
    || url.username !== ''
    || url.password !== ''
  ) {
    return false;
  }

  if (/^\/user-attachments\/assets\/[^/]+\/?$/u.test(url.pathname)) {
    return true;
  }
  return /^\/[^/]+\/[^/]+\/assets\/[^/]+(?:\/[^/]+)*\/?$/u.test(url.pathname);
}

function collectImageMarkups(content: string): ImageMarkup[] {
  const markups: ImageMarkup[] = [];

  for (const match of content.matchAll(MARKDOWN_IMAGE_PATTERN)) {
    const rawUrl = match[1];
    if (match.index !== undefined && rawUrl !== undefined && isGitHubAttachmentUrl(rawUrl)) {
      markups.push({
        start: match.index,
        end: match.index + match[0].length,
        url: normalizeMarkupUrl(rawUrl),
      });
    }
  }

  for (const match of content.matchAll(HTML_IMAGE_PATTERN)) {
    const rawUrl = match[1] ?? match[2] ?? match[3];
    if (match.index !== undefined && rawUrl !== undefined && isGitHubAttachmentUrl(rawUrl)) {
      markups.push({
        start: match.index,
        end: match.index + match[0].length,
        url: normalizeMarkupUrl(rawUrl),
      });
    }
  }

  return markups.sort((left, right) => left.start - right.start);
}

function collectPrImageUrls(prReview: PrReviewData): string[] {
  const uniqueUrls = new Set<string>();
  const bodies = [
    prReview.body,
    ...prReview.comments.map((comment) => comment.body),
    ...prReview.reviews.map((review) => review.body),
  ];

  for (const body of bodies) {
    for (const markup of collectImageMarkups(body)) {
      uniqueUrls.add(markup.url);
    }
  }

  return [...uniqueUrls];
}

function replaceImageMarkups(content: string, placeholders: ReadonlyMap<string, string>): string {
  const markups = collectImageMarkups(content);
  if (markups.length === 0) {
    return content;
  }

  const parts: string[] = [];
  let cursor = 0;
  for (const markup of markups) {
    if (markup.start < cursor) {
      continue;
    }
    const placeholder = placeholders.get(markup.url);
    if (placeholder === undefined) {
      continue;
    }
    parts.push(content.slice(cursor, markup.start), placeholder);
    cursor = markup.end;
  }
  parts.push(content.slice(cursor));
  return parts.join('');
}

function replaceCommentImageMarkups(
  comment: PrReviewComment,
  placeholders: ReadonlyMap<string, string>,
): PrReviewComment {
  return {
    ...comment,
    body: replaceImageMarkups(comment.body, placeholders),
  };
}

function replacePrImageMarkups(
  prReview: PrReviewData,
  placeholders: ReadonlyMap<string, string>,
): PrReviewData {
  return {
    ...prReview,
    body: replaceImageMarkups(prReview.body, placeholders),
    comments: prReview.comments.map((comment) => replaceCommentImageMarkups(comment, placeholders)),
    reviews: prReview.reviews.map((review) => replaceCommentImageMarkups(review, placeholders)),
  };
}

function readGhAuthToken(cwd: string): string {
  const token = execFileSync('gh', ['auth', 'token', '--hostname', 'github.com'], {
    cwd,
    encoding: 'utf-8',
    stdio: ['pipe', 'pipe', 'pipe'],
  }).trim();
  if (token.length === 0) {
    throw new Error('GitHub CLI returned an empty authentication token.');
  }
  return token;
}

function parseContentLength(response: Response): number | undefined {
  const rawContentLength = response.headers.get('content-length');
  if (rawContentLength === null) {
    return undefined;
  }
  if (!/^\d+$/u.test(rawContentLength)) {
    throw new Error(`Invalid image Content-Length: ${rawContentLength}`);
  }
  const contentLength = Number(rawContentLength);
  if (!Number.isSafeInteger(contentLength)) {
    throw new Error(`Invalid image Content-Length: ${rawContentLength}`);
  }
  return contentLength;
}

function parseImageContentType(response: Response): SupportedImageMimeType {
  const rawContentType = response.headers.get('content-type');
  const contentType = rawContentType?.split(';', 1)[0]?.trim().toLowerCase();
  if (!SUPPORTED_CONTENT_TYPES.has(contentType as SupportedImageMimeType)) {
    throw new Error(`Unsupported image Content-Type: ${rawContentType ?? '(missing)'}`);
  }
  return contentType as SupportedImageMimeType;
}

async function readResponseBody(response: Response): Promise<Buffer> {
  const contentLength = parseContentLength(response);
  if (contentLength !== undefined && contentLength > MAX_PR_IMAGE_BYTES) {
    throw new Error(`PR image exceeds the ${MAX_PR_IMAGE_BYTES} byte limit.`);
  }
  if (response.body === null) {
    throw new Error('PR image response has no body.');
  }

  const reader = response.body.getReader();
  const chunks: Buffer[] = [];
  let totalBytes = 0;
  while (true) {
    const { done, value } = await reader.read();
    if (done) {
      break;
    }
    totalBytes += value.byteLength;
    if (totalBytes > MAX_PR_IMAGE_BYTES) {
      await reader.cancel();
      throw new Error(`PR image exceeds the ${MAX_PR_IMAGE_BYTES} byte limit.`);
    }
    chunks.push(Buffer.from(value));
  }
  return Buffer.concat(chunks, totalBytes);
}

async function downloadImage(url: string, token: string): Promise<DownloadedImage> {
  const response = await fetch(url, {
    headers: {
      Accept: 'image/png,image/jpeg,image/gif,image/webp',
      Authorization: `Bearer ${token}`,
    },
    redirect: 'follow',
    signal: AbortSignal.timeout(DOWNLOAD_TIMEOUT_MS),
  });
  if (!response.ok) {
    throw new Error(`GitHub returned HTTP ${response.status}.`);
  }

  const contentType = parseImageContentType(response);
  const data = await readResponseBody(response);
  const detectedMimeType = inferImageMimeTypeFromMagicBytes(data);
  if (detectedMimeType === null) {
    throw new Error('Unsupported image data. Expected PNG, JPEG, GIF, or WebP magic bytes.');
  }
  if (detectedMimeType !== contentType) {
    throw new Error(`Image Content-Type does not match image data: ${contentType} !== ${detectedMimeType}`);
  }
  return { data, mimeType: detectedMimeType };
}

function describeImageUrl(rawUrl: string): string {
  const url = new URL(rawUrl);
  return `${url.origin}${url.pathname}`;
}

async function downloadPrImages(
  urls: readonly string[],
  cwd: string,
  attachmentStore: ImageAttachmentStore,
): Promise<{ attachments: TaskAttachment[]; placeholders: Map<string, string> }> {
  if (urls.length > MAX_PR_IMAGE_ATTACHMENTS) {
    throw new Error(`PR contains more than ${MAX_PR_IMAGE_ATTACHMENTS} unique image attachments.`);
  }

  const token = readGhAuthToken(cwd);
  const placeholders = new Map<string, string>();
  let totalBytes = 0;
  for (const url of urls) {
    let image: DownloadedImage;
    try {
      image = await downloadImage(url, token);
    } catch (error) {
      throw new Error(`Failed to download PR image ${describeImageUrl(url)}: ${getErrorMessage(error)}`);
    }
    totalBytes += image.data.length;
    if (totalBytes > MAX_PR_IMAGE_TOTAL_BYTES) {
      throw new Error(`PR images exceed the ${MAX_PR_IMAGE_TOTAL_BYTES} byte total limit.`);
    }
    const attachment = await attachmentStore.saveImage(image.data, image.mimeType);
    placeholders.set(url, attachment.placeholder);
  }

  return {
    attachments: attachmentStore.listAttachments(),
    placeholders,
  };
}

export async function preparePrReviewTask(
  prReview: PrReviewData,
  cwd: string,
): Promise<PreparedPrReviewTask> {
  const urls = collectPrImageUrls(prReview);
  if (urls.length === 0) {
    return { task: formatPrReviewAsTask(prReview) };
  }

  const attachmentStore = createSessionImageAttachmentStore();
  try {
    const { attachments, placeholders } = await downloadPrImages(urls, cwd, attachmentStore);
    const task = formatPrReviewAsTask(replacePrImageMarkups(prReview, placeholders));
    return {
      task,
      attachments,
      cleanupAttachments: () => cleanupImageAttachmentStore(attachmentStore),
    };
  } catch (error) {
    cleanupImageAttachmentStore(attachmentStore);
    throw error;
  }
}
export type SupportedImageMimeType = 'image/png' | 'image/jpeg' | 'image/gif' | 'image/webp';

const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
const GIF87A_SIGNATURE = Buffer.from('GIF87a');
const GIF89A_SIGNATURE = Buffer.from('GIF89a');
const RIFF_SIGNATURE = Buffer.from('RIFF');
const WEBP_SIGNATURE = Buffer.from('WEBP');

export function inferImageMimeTypeFromMagicBytes(data: Buffer): SupportedImageMimeType | null {
  if (data.subarray(0, PNG_SIGNATURE.length).equals(PNG_SIGNATURE)) {
    return 'image/png';
  }
  if (data.length >= 3 && data[0] === 0xff && data[1] === 0xd8 && data[2] === 0xff) {
    return 'image/jpeg';
  }
  if (
    data.subarray(0, GIF87A_SIGNATURE.length).equals(GIF87A_SIGNATURE)
    || data.subarray(0, GIF89A_SIGNATURE.length).equals(GIF89A_SIGNATURE)
  ) {
    return 'image/gif';
  }
  if (
    data.subarray(0, RIFF_SIGNATURE.length).equals(RIFF_SIGNATURE)
    && data.subarray(8, 12).equals(WEBP_SIGNATURE)
  ) {
    return 'image/webp';
  }
  return null;
}
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import type { PrReviewData } from '../infra/git/index.js';

const mockExecFileSync = vi.hoisted(() => vi.fn());
const mockSaveImage = vi.hoisted(() => vi.fn());
const mockListAttachments = vi.hoisted(() => vi.fn());
const mockCleanup = vi.hoisted(() => vi.fn());

vi.mock('node:child_process', async (importOriginal) => ({
  ...(await importOriginal<typeof import('node:child_process')>()),
  execFileSync: mockExecFileSync,
}));

vi.mock('../features/interactive/imageAttachments.js', () => ({
  cleanupImageAttachmentStore: (store: { cleanup: () => void }) => store.cleanup(),
  createSessionImageAttachmentStore: () => ({
    saveImage: (...args: unknown[]) => mockSaveImage(...args),
    listAttachments: () => mockListAttachments(),
    cleanup: () => mockCleanup(),
  }),
}));

const { preparePrReviewTask } = await import('../features/tasks/prReviewTask.js');

const PNG_DATA = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00]);
const JPEG_DATA = Buffer.from([0xff, 0xd8, 0xff, 0x00]);
const GIF_DATA = Buffer.from('GIF89a image');
const WEBP_DATA = Buffer.concat([
  Buffer.from('RIFF'),
  Buffer.alloc(4),
  Buffer.from('WEBP image'),
]);

function createPrReview(overrides: Partial<PrReviewData> = {}): PrReviewData {
  return {
    number: 42,
    title: 'Review images',
    body: '',
    url: 'https://github.com/org/repo/pull/42',
    headRefName: 'feature/images',
    baseRefName: 'main',
    comments: [],
    reviews: [],
    files: [],
    ...overrides,
  };
}

function imageResponse(data: Buffer, contentType: string, contentLength?: number): Response {
  return new Response(data, {
    status: 200,
    headers: {
      'content-type': contentType,
      ...(contentLength !== undefined ? { 'content-length': String(contentLength) } : {}),
    },
  });
}

beforeEach(() => {
  vi.clearAllMocks();
  mockExecFileSync.mockReturnValue('ghs_test_token\n');
  const storedAttachments: Array<{ placeholder: string; tempPath: string; fileName: string }> = [];
  mockSaveImage.mockImplementation(async (_data: Buffer, mimeType: string) => {
    const index = storedAttachments.length + 1;
    const extension = mimeType === 'image/jpeg' ? 'jpg' : mimeType.slice('image/'.length);
    const attachment = {
      placeholder: `[Image #${index}]`,
      tempPath: `/tmp/pr-images/image-${index}.${extension}`,
      fileName: `image-${index}.${extension}`,
    };
    storedAttachments.push(attachment);
    return attachment;
  });
  mockListAttachments.mockImplementation(() => [...storedAttachments]);
});

afterEach(() => {
  vi.unstubAllGlobals();
});

describe('preparePrReviewTask', () => {
  it('PR 本文・通常コメント・レビューコメントの GitHub 画像を取得して参照へ置換する', async () => {
    const firstUrl = 'https://github.com/user-attachments/assets/11111111-1111-1111-1111-111111111111';
    const secondUrl = 'https://github.com/org/repo/assets/12345/abcdef';
    const mockFetch = vi.fn()
      .mockResolvedValueOnce(imageResponse(PNG_DATA, 'image/png'))
      .mockResolvedValueOnce(imageResponse(JPEG_DATA, 'image/jpeg; charset=binary'));
    vi.stubGlobal('fetch', mockFetch);
    const prReview = createPrReview({
      body: `Body ![screen](${firstUrl})`,
      comments: [{ author: 'alice', body: `<img alt="detail" src="${secondUrl}" />` }],
      reviews: [{ author: 'bob', body: `Duplicate ![again](${firstUrl})` }],
    });

    const prepared = await preparePrReviewTask(prReview, '/repo');

    try {
      expect(prepared.task).toContain('Body [Image #1]');
      expect(prepared.task).toContain('**alice**: [Image #2]');
      expect(prepared.task).toContain('**bob**: Duplicate [Image #1]');
      expect(prepared.task).not.toContain(firstUrl);
      expect(prepared.task).not.toContain(secondUrl);
      expect(prepared.attachments).toHaveLength(2);
      expect(prepared.attachments?.map((attachment) => attachment.fileName)).toEqual([
        'image-1.png',
        'image-2.jpg',
      ]);
      expect(mockSaveImage).toHaveBeenNthCalledWith(1, PNG_DATA, 'image/png');
      expect(mockSaveImage).toHaveBeenNthCalledWith(2, JPEG_DATA, 'image/jpeg');
      expect(mockExecFileSync).toHaveBeenCalledWith(
        'gh',
        ['auth', 'token', '--hostname', 'github.com'],
        expect.objectContaining({ cwd: '/repo' }),
      );
      expect(mockFetch).toHaveBeenCalledTimes(2);
      expect(mockFetch).toHaveBeenNthCalledWith(
        1,
        firstUrl,
        expect.objectContaining({
          headers: expect.objectContaining({ Authorization: 'Bearer ghs_test_token' }),
        }),
      );
    } finally {
      prepared.cleanupAttachments?.();
    }

    expect(mockCleanup).toHaveBeenCalledTimes(1);
  });

  it('GitHub attachment 以外の画像 URL は取得しない', async () => {
    const externalUrl = 'https://example.com/image.png';
    const mockFetch = vi.fn();
    vi.stubGlobal('fetch', mockFetch);
    const prReview = createPrReview({ body: `![external](${externalUrl})` });

    const prepared = await preparePrReviewTask(prReview, '/repo');

    expect(prepared.task).toContain(`![external](${externalUrl})`);
    expect(prepared.attachments).toBeUndefined();
    expect(prepared.cleanupAttachments).toBeUndefined();
    expect(mockExecFileSync).not.toHaveBeenCalled();
    expect(mockFetch).not.toHaveBeenCalled();
  });

  it.each([
    { mimeType: 'image/gif', data: GIF_DATA, extension: 'gif' },
    { mimeType: 'image/webp', data: WEBP_DATA, extension: 'webp' },
  ])('$mimeType の画像を attachment として受け入れる', async ({ mimeType, data, extension }) => {
    const imageUrl = `https://github.com/user-attachments/assets/${extension}-image`;
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(imageResponse(data, mimeType)));
    const prReview = createPrReview({ body: `![screen](${imageUrl})` });

    const prepared = await preparePrReviewTask(prReview, '/repo');

    try {
      expect(prepared.attachments?.[0]?.fileName).toBe(`image-1.${extension}`);
      expect(mockSaveImage).toHaveBeenCalledWith(data, mimeType);
    } finally {
      prepared.cleanupAttachments?.();
    }
  });

  it('Content-Type と magic bytes が一致しない画像を拒否して一時ファイルを残さない', async () => {
    const imageUrl = 'https://github.com/user-attachments/assets/22222222-2222-2222-2222-222222222222';
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(imageResponse(PNG_DATA, 'image/jpeg')));
    const prReview = createPrReview({ body: `![screen](${imageUrl})` });

    await expect(preparePrReviewTask(prReview, '/repo')).rejects.toThrow(
      'Image Content-Type does not match image data: image/jpeg !== image/png',
    );
    expect(mockCleanup).toHaveBeenCalledTimes(1);
  });

  it('Content-Length が画像サイズ上限を超える応答を本文読込前に拒否する', async () => {
    const imageUrl = 'https://github.com/org/repo/assets/12345/oversized';
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(
      imageResponse(PNG_DATA, 'image/png', 10 * 1024 * 1024 + 1),
    ));
    const prReview = createPrReview({ body: `<img src='${imageUrl}'>` });

    await expect(preparePrReviewTask(prReview, '/repo')).rejects.toThrow('byte limit');
  });

  it('非画像の magic bytes を拒否する', async () => {
    const imageUrl = 'https://github.com/user-attachments/assets/33333333-3333-3333-3333-333333333333';
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(
      imageResponse(Buffer.from('not an image'), 'image/png'),
    ));
    const prReview = createPrReview({ body: `![screen](${imageUrl})` });

    await expect(preparePrReviewTask(prReview, '/repo')).rejects.toThrow('magic bytes');
  });
});

