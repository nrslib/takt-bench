    33	function extensionForMimeType(mimeType: string): string {
    34	  switch (mimeType) {
    35	    case 'image/png':
    36	      return 'png';
    37	    case 'image/jpeg':
    38	      return 'jpg';
    39	    case 'image/gif':
    40	      return 'gif';
    41	    case 'image/webp':
    42	      return 'webp';
    43	    default:
    44	      throw new Error(`Unsupported pasted image type: ${mimeType}`);
    45	  }
    46	}
    47	
    48	function validateImageAttachmentSessionId(sessionId: string): void {
    49	  if (sessionId.length === 0) {
    50	    throw new Error('Image attachment sessionId is required.');
    51	  }
    52	  if (
    53	    sessionId === '.'
    54	    || sessionId === '..'
    55	    || sessionId.includes('/')
    56	    || sessionId.includes('\\')
    57	    || path.isAbsolute(sessionId)
    58	    || path.win32.isAbsolute(sessionId)
    59	  ) {
    60	    throw new Error('Image attachment sessionId must be a single path segment.');
    61	  }
    62	}
