   366	function fetchPrReviewThreads(owner: string, repo: string, prNumber: number, cwd: string): PrReviewComment[] {
   367	  try {
   368	    const comments: PrReviewComment[] = [];
   369	    let endCursor: string | undefined;
   370	
   371	    for (let page = 1; page <= GRAPHQL_PAGINATION_HARD_CAP; page += 1) {
   372	      const raw = execFileSync(
   373	        'gh',
   374	        buildReviewThreadsGraphqlArgs(owner, repo, prNumber, endCursor),
   375	        { cwd, encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
   376	      );
