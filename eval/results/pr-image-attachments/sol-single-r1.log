   194	/**
   195	 * Format PR review data into task text for workflow execution.
   196	 */
   197	export function formatPrReviewAsTask(prReview: PrReviewData): string {
   198	  const parts: string[] = [];
   199	
   200	  parts.push(`## PR #${prReview.number} Review Comments: ${prReview.title}`);
   201	
   202	  if (prReview.body) {
   203	    parts.push('');
   204	    parts.push('### PR Description');
   205	    parts.push(prReview.body);
   206	  }
   207	
   208	  const summaries: PrReviewComment[] = [];
   209	  const active: PrReviewComment[] = [];
   210	  const outdatedUnresolved: PrReviewComment[] = [];
   211	  const resolved: PrReviewComment[] = [];
   212	  const legacyInlineComments: PrReviewComment[] = [];
   213	
   214	  for (const review of prReview.reviews) {
   215	    switch (review.threadState) {
   216	      case 'active':
   217	        active.push(review);
   218	        break;
   219	      case 'outdated-unresolved':
   220	        outdatedUnresolved.push(review);
   221	        break;
   222	      case 'resolved':
   223	        resolved.push(review);
   224	        break;
   225	      case undefined:
   226	        if (review.path === undefined) {
   227	          summaries.push(review);
   228	        } else {
   229	          legacyInlineComments.push(review);
   230	        }
   231	        break;
   232	    }
   233	  }
   234	
   235	  const hasThreadState = active.length > 0 || outdatedUnresolved.length > 0 || resolved.length > 0;
   236	  if (hasThreadState) {
   237	    parts.push('');
   238	    parts.push('### Review Policy');
   239	    parts.push(...REVIEW_THREAD_POLICY);
   240	  }
   241	
   242	  appendReviewSection(parts, '### Review Summaries', summaries, formatPrReviewComment);
   243	  appendReviewSection(parts, '### Active Review Threads', active, formatPrReviewComment);
   244	  appendReviewSection(parts, '### Outdated But Unresolved Review Threads', outdatedUnresolved, formatPrReviewComment);
   245	  appendReviewSection(parts, '### Resolved / Outdated Review Threads', resolved, formatResolvedPrReviewComment);
   246	  appendReviewSection(parts, '### Review Comments', legacyInlineComments, formatPrReviewComment);
   247	
   248	  if (prReview.comments.length > 0) {
   249	    parts.push('');
   250	    parts.push('### Conversation Comments');
   251	    for (const comment of prReview.comments) {
   252	      parts.push(`**${comment.author}**: ${comment.body}`);
   253	    }
   254	  }
   255	
   256	  if (prReview.files.length > 0) {
   257	    parts.push('');
   258	    parts.push('### Changed Files');
   259	    for (const file of prReview.files) {
   260	      parts.push(`- ${file}`);
   261	    }
   262	  }
   263	
   264	  return parts.join('\n');
   265	}
