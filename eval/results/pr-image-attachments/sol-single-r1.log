   226	async function downloadImage(url: string, token: string): Promise<DownloadedImage> {
   227	  const response = await fetch(url, {
   228	    headers: {
   229	      Accept: 'image/png,image/jpeg,image/gif,image/webp',
   230	      Authorization: `Bearer ${token}`,
   231	    },
   232	    redirect: 'follow',
   233	    signal: AbortSignal.timeout(DOWNLOAD_TIMEOUT_MS),
   234	  });
   235	  if (!response.ok) {
   236	    throw new Error(`GitHub returned HTTP ${response.status}.`);
   237	  }
   238	
   239	  const contentType = parseImageContentType(response);
   240	  const data = await readResponseBody(response);
   241	  const detectedMimeType = inferImageMimeTypeFromMagicBytes(data);
   242	  if (detectedMimeType === null) {
   243	    throw new Error('Unsupported image data. Expected PNG, JPEG, GIF, or WebP magic bytes.');
   244	  }
   245	  if (detectedMimeType !== contentType) {
   246	    throw new Error(`Image Content-Type does not match image data: ${contentType} !== ${detectedMimeType}`);
   247	  }
   248	  return { data, mimeType: detectedMimeType };
   249	}
