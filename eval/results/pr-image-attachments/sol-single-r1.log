   265	export async function resolveExecutionContext(
   266	  cwd: string,
   267	  task: string,
   268	  options: Pick<PipelineExecutionOptions, 'createWorktree' | 'skipGit' | 'branch' | 'issueNumber' | 'prNumber'>,
   269	  pipelineConfig: PipelineConfig | undefined,
   270	  prBranch?: string,
   271	  prBaseBranch?: string,
   272	): Promise<ExecutionContext> {
   273	  if (options.prNumber !== undefined) {
   274	    validatePrBranches(options.prNumber, prBranch, prBaseBranch);
   275	  }
   276	  if (options.createWorktree) {
   277	    const result = await confirmAndCreateWorktree(
   278	      cwd,
   279	      task,
   280	      options.createWorktree,
   281	      prBranch,
   282	      prBaseBranch,
   283	      options.prNumber !== undefined,
   284	    );
   285	    const branch = requireBranch(result.branch, 'worktree execution');
   286	    const baseBranch = requireBaseBranch(result.baseBranch, 'worktree execution');
   287	    if (result.isWorktree) {
   288	      success(`Worktree created: ${sanitizeTerminalText(result.execCwd)}`);
   289	    }
   290	    if (
   291	      options.prNumber !== undefined
   292	      && (!result.pullRequestBaseRef || !result.pullRequestHeadRef)
   293	    ) {
   294	      throw new Error(`PR #${options.prNumber} worktree did not materialize PR diff refs.`);
   295	    }
   296	    return attachPipelinePrContext(
   297	      options.prNumber,
   298	      prBaseBranch,
   299	      {
   300	        execCwd: result.execCwd,
   301	        branch,
   302	        baseBranch,
   303	        isWorktree: result.isWorktree,
   304	        taskSlug: result.taskSlug,
   305	      },
   306	      {
   307	        baseRef: result.pullRequestBaseRef,
   308	        headRef: result.pullRequestHeadRef,
   309	      },
   310	    );
   311	  }
   312	  if (options.skipGit) {
   313	    return attachPipelinePrContext(
   314	      options.prNumber,
   315	      prBaseBranch,
   316	      resolveSkipGitExecutionContext(cwd, prBranch, prBaseBranch),
   317	    );
   318	  }
   319	  if (prBranch) {
   320	    const safePrBranch = sanitizeTerminalText(prBranch);
   321	    info(`Fetching and checking out PR branch: ${safePrBranch}`);
   322	    checkoutBranch(cwd, prBranch);
   323	    success(`Checked out PR branch: ${safePrBranch}`);
   324	    const baseBranch = prBaseBranch ?? resolveExecutionBaseBranch(cwd);
   325	    return attachPipelinePrContext(
   326	      options.prNumber,
   327	      prBaseBranch,
   328	      {
   329	        execCwd: cwd,
   330	        branch: prBranch,
   331	        baseBranch,
   332	        isWorktree: false,
   333	      },
   334	      {
   335	        baseRef: materializePullRequestBase(cwd, cwd, baseBranch),
   336	        headRef: toLocalBranchRef(prBranch),
   337	      },
   338	    );
   339	  }
   340	  const baseBranch = resolveExecutionBaseBranch(cwd);
   341	  const branch = options.branch ?? generatePipelineBranchName(pipelineConfig, options.issueNumber);
   342	  const safeBranch = sanitizeTerminalText(branch);
   343	  info(`Creating branch: ${safeBranch}`);
   344	  execFileSync('git', ['checkout', '-b', branch], { cwd, stdio: 'pipe' });
   345	  success(`Branch created: ${safeBranch}`);
   346	  return { execCwd: cwd, branch, baseBranch, isWorktree: false };
   347	}
