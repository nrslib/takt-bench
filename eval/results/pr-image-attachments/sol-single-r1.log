   122	export function createImageAttachmentStore(
   123	  options: ImageAttachmentStoreOptions,
   124	): ImageAttachmentStore {
   125	  if (options.tmpRoot.length === 0) {
   126	    throw new Error('Image attachment tmpRoot is required.');
   127	  }
   128	  validateImageAttachmentSessionId(options.sessionId);
   129	
   130	  let attachments: InteractiveImageAttachment[] = options.initialAttachments
   131	    ? [...options.initialAttachments]
   132	    : [];
   133	  const sessionDir = path.join(options.tmpRoot, 'takt', options.sessionId);
   134	  const taktTmpDir = path.dirname(sessionDir);
   135	  const attachmentDir = path.join(sessionDir, 'attachments');
   136	
   137	  return {
   138	    async saveImage(data: Buffer, mimeType: string): Promise<InteractiveImageAttachment> {
   139	      const index = attachments.length + 1;
   140	      const fileName = `image-${index}.${extensionForMimeType(mimeType)}`;
   141	      const tempPath = path.join(attachmentDir, fileName);
   142	      const attachment: InteractiveImageAttachment = {
   143	        placeholder: `[Image #${index}]`,
   144	        tempPath,
   145	        fileName,
   146	      };
   147	
   148	      ensurePrivateDirectory(taktTmpDir);
   149	      ensurePrivateDirectory(sessionDir);
   150	      ensurePrivateDirectory(attachmentDir);
   151	      writeNewPrivateFileWithMode(tempPath, data, PRIVATE_FILE_MODE);
   152	      attachments = [...attachments, attachment];
   153	      return attachment;
   154	    },
   155	
   156	    listAttachments(): InteractiveImageAttachment[] {
   157	      return [...attachments];
   158	    },
   159	
   160	    cleanup(): void {
   161	      fs.rmSync(sessionDir, { recursive: true, force: true });
   162	    },
   163	  };
   164	}
