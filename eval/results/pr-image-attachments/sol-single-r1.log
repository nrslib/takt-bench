   218	export async function resolveTaskContent(options: PipelineExecutionOptions): Promise<TaskContent | undefined> {
   219	  const { cwd } = options;
   220	  if (options.prNumber) {
   221	    info(`Fetching PR #${options.prNumber} review comments...`);
   222	    const prReview = fetchVcsResource(
   223	      `PR #${options.prNumber}`,
   224	      cwd,
   225	      (provider) => provider.fetchPrReviewComments(options.prNumber!, cwd),
   226	    );
   227	    if (!prReview) return undefined;
   228	    let preparedPrTask: Awaited<ReturnType<typeof preparePrReviewTask>>;
   229	    try {
   230	      preparedPrTask = await preparePrReviewTask(prReview, cwd);
   231	    } catch (err) {
   232	      error(`Failed to prepare PR #${options.prNumber} images: ${getErrorMessage(err)}`);
   233	      return undefined;
   234	    }
   235	    success(`PR #${options.prNumber} fetched: "${sanitizeTerminalText(prReview.title)}"`);
   236	    return {
   237	      task: preparedPrTask.task,
   238	      prBranch: prReview.headRefName,
   239	      prBaseBranch: prReview.baseRefName,
   240	      ...(preparedPrTask.attachments ? { attachments: preparedPrTask.attachments } : {}),
   241	      ...(preparedPrTask.cleanupAttachments
   242	        ? { cleanupAttachments: preparedPrTask.cleanupAttachments }
   243	        : {}),
   244	    };
   245	  }
   246	  if (options.issueNumber) {
   247	    info(`Fetching issue #${options.issueNumber}...`);
   248	    const issue = fetchVcsResource(
   249	      `issue #${options.issueNumber}`,
   250	      cwd,
   251	      (provider) => provider.fetchIssue(options.issueNumber!, cwd),
   252	    );
   253	    if (!issue) return undefined;
   254	    const task = formatIssueAsTask(issue);
   255	    success(`Issue #${options.issueNumber} fetched: "${sanitizeTerminalText(issue.title)}"`);
   256	    return { task, issue };
   257	  }
   258	  if (options.task) {
   259	    return { task: options.task };
   260	  }
   261	  error('Either --issue, --pr, or --task must be specified');
   262	  return undefined;
   263	}
