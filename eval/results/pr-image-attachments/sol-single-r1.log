     1	export type SupportedImageMimeType = 'image/png' | 'image/jpeg' | 'image/gif' | 'image/webp';
     2	
     3	const PNG_SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
     4	const GIF87A_SIGNATURE = Buffer.from('GIF87a');
     5	const GIF89A_SIGNATURE = Buffer.from('GIF89a');
     6	const RIFF_SIGNATURE = Buffer.from('RIFF');
     7	const WEBP_SIGNATURE = Buffer.from('WEBP');
     8	
     9	export function inferImageMimeTypeFromMagicBytes(data: Buffer): SupportedImageMimeType | null {
    10	  if (data.subarray(0, PNG_SIGNATURE.length).equals(PNG_SIGNATURE)) {
    11	    return 'image/png';
    12	  }
    13	  if (data.length >= 3 && data[0] === 0xff && data[1] === 0xd8 && data[2] === 0xff) {
    14	    return 'image/jpeg';
    15	  }
    16	  if (
    17	    data.subarray(0, GIF87A_SIGNATURE.length).equals(GIF87A_SIGNATURE)
    18	    || data.subarray(0, GIF89A_SIGNATURE.length).equals(GIF89A_SIGNATURE)
    19	  ) {
    20	    return 'image/gif';
    21	  }
    22	  if (
    23	    data.subarray(0, RIFF_SIGNATURE.length).equals(RIFF_SIGNATURE)
    24	    && data.subarray(8, 12).equals(WEBP_SIGNATURE)
    25	  ) {
    26	    return 'image/webp';
    27	  }
    28	  return null;
    29	}
