    15	    const cliStatus = provider.checkCliStatus(cwd);
    16	    if (!cliStatus.available) {
    17	      throw new Error(cliStatus.error);
    18	    }
    19	    const issue = await withProgress(
    20	      'Fetching issue...',
    21	      (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
    22	      async () => provider.fetchIssue(issueOption, cwd),
    23	    );
    24	    return { initialInput: formatIssueAsTask(issue), issueNumber: issueOption };
    25	  }
    26	
    27	  if (task && isDirectTask(task)) {
    28	    const provider = getGitProvider();
    29	    const cliStatus = provider.checkCliStatus(cwd);
    30	    if (!cliStatus.available) {
    31	      throw new Error(cliStatus.error);
    32	    }
    33	    const tokens = task.trim().split(/\s+/);
    34	    const issueNumbers = parseIssueNumbers(tokens);
    35	    if (issueNumbers.length === 0) {
    36	      throw new Error(`Invalid issue reference: ${task}`);
    37	    }
    38	    const issues = await withProgress(
    39	      'Fetching issues...',
    40	      (fetchedIssues) => `Issues fetched: ${fetchedIssues.map((issue) => `#${issue.number}`).join(', ')}`,
    41	      async () => issueNumbers.map((n) => provider.fetchIssue(n, cwd)),
    42	    );
    43	    return {
    44	      initialInput: issues.map(formatIssueAsTask).join('\n\n---\n\n'),
    45	      ...(issueNumbers.length === 1 ? { issueNumber: issueNumbers[0] } : {}),
    46	    };
    47	  }
    48	
    49	  return null;
    50	}
