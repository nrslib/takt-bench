     if (!cliStatus.available) {
       throw new Error(cliStatus.error);
     }
     const issue = await withProgress(
       'Fetching issue...',
       (fetchedIssue) => `Issue fetched: #${fetchedIssue.number} ${fetchedIssue.title}`,
       async () => provider.fetchIssue(issueOption, cwd),
