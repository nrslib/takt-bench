   256	async function downloadPrImages(
   257	  urls: readonly string[],
   258	  cwd: string,
   259	  attachmentStore: ImageAttachmentStore,
   260	): Promise<{ attachments: TaskAttachment[]; placeholders: Map<string, string> }> {
   261	  if (urls.length > MAX_PR_IMAGE_ATTACHMENTS) {
   262	    throw new Error(`PR contains more than ${MAX_PR_IMAGE_ATTACHMENTS} unique image attachments.`);
   263	  }
   264	
   265	  const token = readGhAuthToken(cwd);
   266	  const placeholders = new Map<string, string>();
   267	  let totalBytes = 0;
   268	  for (const url of urls) {
   269	    let image: DownloadedImage;
   270	    try {
   271	      image = await downloadImage(url, token);
   272	    } catch (error) {
   273	      throw new Error(`Failed to download PR image ${describeImageUrl(url)}: ${getErrorMessage(error)}`);
   274	    }
   275	    totalBytes += image.data.length;
   276	    if (totalBytes > MAX_PR_IMAGE_TOTAL_BYTES) {
   277	      throw new Error(`PR images exceed the ${MAX_PR_IMAGE_TOTAL_BYTES} byte total limit.`);
   278	    }
   279	    const attachment = await attachmentStore.saveImage(image.data, image.mimeType);
   280	    placeholders.set(url, attachment.placeholder);
   281	  }
   282	
   283	  return {
   284	    attachments: attachmentStore.listAttachments(),
   285	    placeholders,
   286	  };
   287	}
