   118	function replaceImageMarkups(content: string, placeholders: ReadonlyMap<string, string>): string {
   119	  const markups = collectImageMarkups(content);
   120	  if (markups.length === 0) {
   121	    return content;
   122	  }
   123	
   124	  const parts: string[] = [];
   125	  let cursor = 0;
   126	  for (const markup of markups) {
   127	    if (markup.start < cursor) {
   128	      continue;
   129	    }
   130	    const placeholder = placeholders.get(markup.url);
   131	    if (placeholder === undefined) {
   132	      continue;
   133	    }
   134	    parts.push(content.slice(cursor, markup.start), placeholder);
   135	    cursor = markup.end;
   136	  }
   137	  parts.push(content.slice(cursor));
   138	  return parts.join('');
   139	}
