   113	
   114	function copyAttachmentEntry(sourcePath: string, destinationPath: string): void {
   115	  const stats = fs.lstatSync(sourcePath);
   116	  if (stats.isSymbolicLink()) {
   117	    throw new Error(`Task attachments must not contain symlinks: ${sourcePath}`);
   118	  }
   119	  if (stats.isDirectory()) {
   120	    fs.mkdirSync(destinationPath, { recursive: true });
   121	    for (const entry of fs.readdirSync(sourcePath)) {
   122	      copyAttachmentEntry(path.join(sourcePath, entry), path.join(destinationPath, entry));
   123	    }
   124	    return;
   125	  }
   126	  if (!stats.isFile()) {
   127	    throw new Error(`Task attachments must be regular files or directories: ${sourcePath}`);
   128	  }
   129	  fs.mkdirSync(path.dirname(destinationPath), { recursive: true });
   130	  fs.copyFileSync(sourcePath, destinationPath);
   131	}
   132	
   133	interface AttachmentTreeManifest {
   134	  readonly root: TaskAttachmentManifestEntry;
   135	  readonly entries: readonly TaskAttachmentManifestEntry[];
   136	}
   137	
   138	function hashAttachmentContent(content: string | Buffer): string {
   139	  return createHash('sha256').update(content).digest('hex');
   140	}
   141	
   142	function readAttachmentTreeManifest(
   143	  absolutePath: string,
   144	  relativePath: string,
   145	): AttachmentTreeManifest {
   146	  const stats = fs.lstatSync(absolutePath);
   147	  if (stats.isSymbolicLink()) {
   148	    throw new Error(`Task attachments must not contain symlinks: ${absolutePath}`);
   149	  }
   150	  if (stats.isFile()) {
   151	    const root = Object.freeze({
   152	      relativePath,
   153	      kind: 'file' as const,
   154	      contentSha256: hashAttachmentContent(fs.readFileSync(absolutePath)),
   155	    });
   156	    return Object.freeze({ root, entries: Object.freeze([root]) });
   157	  }
   158	  if (!stats.isDirectory()) {
   159	    throw new Error(`Task attachments must be regular files or directories: ${absolutePath}`);
   160	  }
   161	
   162	  const children = fs.readdirSync(absolutePath)
   163	    .sort()
   164	    .map((entry) => readAttachmentTreeManifest(
   165	      path.join(absolutePath, entry),
   166	      path.posix.join(relativePath, entry),
   167	    ));
   168	  const root = Object.freeze({
   169	    relativePath,
   170	    kind: 'directory' as const,
   171	    contentSha256: hashAttachmentContent(JSON.stringify(
   172	      children.map((child) => child.root),
   173	    )),
   174	  });
   175	  return Object.freeze({
   176	    root,
   177	    entries: Object.freeze([
   178	      root,
   179	      ...children.flatMap((child) => child.entries),
   180	    ]),
   181	  });
   182	}
   183	
   184	export function resolveTaskAttachmentManifest(
   185	  taskDir: string,
   186	): TaskAttachmentManifest {
   187	  const attachmentsDir = path.join(taskDir, 'attachments');
   188	  if (!fs.existsSync(attachmentsDir)) {
   189	    return Object.freeze([]);
   190	  }
   191	
   192	  const stats = fs.lstatSync(attachmentsDir);
   193	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   194	    throw new Error(`Task attachments must be a regular directory: ${attachmentsDir}`);
   195	  }
   196	
   197	  return readAttachmentTreeManifest(attachmentsDir, 'attachments').entries;
   198	}
   199	
   200	function assertTaskAttachmentManifestEntry(
   201	  taskDir: string,
   202	  expected: TaskAttachmentManifestEntry,
   203	  actual: TaskAttachmentManifestEntry | undefined,
   204	): void {
   205	  const entryPath = path.join(taskDir, expected.relativePath);
   206	  if (actual === undefined) {
   207	    throw new Error(`Task attachment is missing: ${entryPath}`);
   208	  }
   209	  if (actual.kind !== expected.kind) {
   210	    throw new Error(`Task attachment type changed: ${entryPath}`);
   211	  }
   212	  if (actual.contentSha256 !== expected.contentSha256) {
   213	    throw new Error(`Task attachment content changed: ${entryPath}`);
   214	  }
   215	}
   216	
   217	function assertTaskAttachmentsMatchManifest(
   218	  taskDir: string,
   219	  expectedManifest: TaskAttachmentManifest,
   220	): void {
   221	  const actualManifest = resolveTaskAttachmentManifest(taskDir);
   222	  const expectedByPath = new Map(
   223	    expectedManifest.map((entry) => [entry.relativePath, entry]),
   224	  );
   225	  const actualByPath = new Map(
   226	    actualManifest.map((entry) => [entry.relativePath, entry]),
   227	  );
   228	
   229	  for (const expected of expectedManifest) {
   230	    if (!actualByPath.has(expected.relativePath)) {
   231	      throw new Error(
   232	        `Task attachment is missing: ${path.join(taskDir, expected.relativePath)}`,
   233	      );
   234	    }
   235	  }
   236	  for (const actual of actualManifest) {
   237	    if (!expectedByPath.has(actual.relativePath)) {
   238	      throw new Error(
   239	        `Task attachment was added after resolution: ${path.join(taskDir, actual.relativePath)}`,
   240	      );
   241	    }
   242	  }
   243	  for (const expected of expectedManifest) {
   244	    assertTaskAttachmentManifestEntry(
   245	      taskDir,
   246	      expected,
   247	      actualByPath.get(expected.relativePath),
   248	    );
   249	  }
   250	}
   251	
   252	function copyExistingTaskAttachments(sourceTaskDir: string, taskDir: string): void {
   253	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   254	  if (!fs.existsSync(sourceAttachmentsDir)) {
   255	    return;
   256	  }
   257	
   258	  const stats = fs.lstatSync(sourceAttachmentsDir);
   259	  if (stats.isSymbolicLink() || !stats.isDirectory()) {
   260	    throw new Error(`Task attachments must be a regular directory: ${sourceAttachmentsDir}`);
   261	  }
   262	
   263	  copyAttachmentEntry(sourceAttachmentsDir, path.join(taskDir, 'attachments'));
   264	}
   265	
   266	export function prepareTaskSpecDirectory(
   267	  cwd: string,
   268	  taskContent: string,
   269	  attachments?: readonly TaskAttachment[],
   270	  options?: PrepareTaskSpecOptions,
   271	): PreparedTaskSpec {
   272	  const orderContent = buildTaskOrderContent(taskContent, attachments);
   273	  return prepareEnqueuedTaskSpecDirectory(cwd, taskContent, {
   274	    orderContent,
   275	    beforeWrite: (taskDir) => {
   276	      if (options?.sourceTaskDir) {
   277	        copyExistingTaskAttachments(options.sourceTaskDir, taskDir);
   278	      }
   279	      promoteTaskAttachments(taskDir, attachments);
   280	    },
   281	  });
   282	}
   283	
   284	export function copyTaskAttachmentsToRunContext(
   285	  sourceTaskDir: string,
   286	  runContextTaskDir: string,
   287	  expectedManifest: TaskAttachmentManifest,
   288	): void {
   289	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   290	  const sourceAttachmentsDir = path.join(sourceTaskDir, 'attachments');
   291	  if (expectedManifest.length !== 0) {
   292	    copyAttachmentEntry(sourceAttachmentsDir, path.join(runContextTaskDir, 'attachments'));
   293	  }
   294	  assertTaskAttachmentsMatchManifest(sourceTaskDir, expectedManifest);
   295	  assertTaskAttachmentsMatchManifest(runContextTaskDir, expectedManifest);
   296	}

