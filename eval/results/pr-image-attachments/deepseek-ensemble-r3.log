   445	export async function downloadPrReviewImageAttachments(
   446	  references: readonly PrReviewImageReference[],
   447	  deps: PrReviewImageDownloadDeps,
   448	): Promise<{ attachments: StoredImageAttachment[]; cleanup: () => void }> {
   449	  if (references.length === 0) {
   450	    return { attachments: [], cleanup: () => undefined };
   451	  }
   452	  const downloadDir = createTempDownloadDir(deps.tmpRoot);
   453	  try {
   454	    const token = await deps.getToken();
   455	    const attachments: StoredImageAttachment[] = [];
   456	    for (const reference of references) {
   457	      const response = await fetchImageWithRedirects(reference.url, token, deps.fetch);
   458	      const detectedMimeType = validateImageResponse(response);
   459	      const extension = extensionForImageMimeType(detectedMimeType);
   460	      const baseName = reference.fileName.replace(/\.[^.]+$/, '');
   461	      const fileName = `${baseName}.${extension}`;
   462	      const tempPath = path.join(downloadDir, fileName);
   463	      if (fs.existsSync(tempPath)) {
   464	        throw new Error(`Image attachment temp file already exists: ${tempPath}`);
   465	      }
   466	      writeNewPrivateFileWithMode(tempPath, response.body, PRIVATE_FILE_MODE);
   467	      attachments.push({
   468	        placeholder: reference.placeholder,
   469	        tempPath,
   470	        fileName,
   471	      });
   472	    }
   473	
   474	    let cleaned = false;
   475	    const cleanup = (): void => {
   476	      if (cleaned) {
   477	        return;
   478	      }
   479	      cleaned = true;
   480	      fs.rmSync(downloadDir, { recursive: true, force: true });
   481	    };
   482	    return { attachments, cleanup };
   483	  } catch (error) {
   484	    fs.rmSync(downloadDir, { recursive: true, force: true });
   485	    throw error;
   486	  }
   487	}
