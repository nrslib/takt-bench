   132	        pageInfo { hasNextPage endCursor }
   133	        nodes {
   134	          id
   135	          isResolved
   136	          isOutdated
   137	          resolvedBy { login }
   138	          comments(first:${REVIEW_THREAD_COMMENTS_PER_PAGE}) {
   139	            pageInfo { hasNextPage endCursor }
   140	            nodes {
   141	              path
   142	              line
   143	              originalLine
   144	              body
   145	              url
   146	              author { login }
   147	            }
   148	          }
   149	        }
   150	      }
   151	    }
   152	  }
   153	}
   154	`;
