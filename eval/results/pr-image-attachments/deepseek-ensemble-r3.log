   231	function buildReviewThreadsGraphqlArgs(
   232	  owner: string,
   233	  repo: string,
   234	  prNumber: number,
   235	  endCursor: string | undefined,
   236	): string[] {
   237	  const args = [
   238	    'api',
   239	    'graphql',
   240	    '-f',
   241	    `owner=${owner}`,
   242	    '-f',
   243	    `repo=${repo}`,
   244	    '-F',
   245	    `number=${prNumber}`,
   246	  ];
   247	
   248	  if (endCursor !== undefined) {
   249	    args.push('-f', `endCursor=${endCursor}`);
   250	  }
   251	
   252	  args.push('-f', `query=${REVIEW_THREADS_QUERY}`);
   253	  return args;
   254	}
