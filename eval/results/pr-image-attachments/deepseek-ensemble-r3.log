    27	interface PipelineOutcome {
    28	  exitCode: number;
    29	  result: PipelineResult;
    30	}
    31	
    32	async function runPipeline(options: PipelineExecutionOptions): Promise<PipelineOutcome> {
    33	  const { cwd, workflow, autoPr, skipGit } = options;
    34	  const pipelineConfig = resolveConfigValues(cwd, ['pipeline']).pipeline;
    35	
    36	  const buildResult = (overrides: Partial<PipelineResult> = {}): PipelineResult => ({
    37	    success: false, workflow, issueNumber: options.issueNumber, ...overrides,
    38	  });
    39	
    40	  const taskContent = await resolveTaskContent(options);
    41	  if (!taskContent) return { exitCode: EXIT_ISSUE_FETCH_FAILED, result: buildResult() };
    42	
    43	  try {
    44	    let context: ExecutionContext;
    45	    try {
    46	      context = await resolveExecutionContext(
    47	        cwd,
    48	        taskContent.task,
    49	        options,
    50	        pipelineConfig,
    51	        taskContent.prBranch,
    52	        taskContent.prBaseBranch,
    53	      );
    54	    } catch (err) {
    55	      error(`Failed to prepare execution environment: ${getErrorMessage(err)}`);
    56	      return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult() };
    57	    }
    58	
    59	    log.info('Pipeline workflow execution starting', { workflow, branch: context.branch, skipGit, issueNumber: options.issueNumber });
    60	    const workflowOk = await runWorkflow(cwd, workflow, taskContent.task, context.execCwd, options, context, taskContent.attachments);
    61	    if (!workflowOk) {
    62	      return { exitCode: EXIT_WORKFLOW_FAILED, result: buildResult({ branch: context.branch }) };
    63	    }
    64	
    65	    if (!skipGit && context.branch) {
    66	      const commitMessage = buildCommitMessage(pipelineConfig, taskContent.issue, options.task);
    67	      if (!await commitAndPush(context.execCwd, cwd, context.branch, commitMessage, context.isWorktree)) {
    68	        return { exitCode: EXIT_GIT_OPERATION_FAILED, result: buildResult({ branch: context.branch }) };
    69	      }
    70	    }
    71	
    72	    let prUrl: string | undefined;
    73	    if (autoPr && !skipGit && context.branch) {
    74	      prUrl = submitPullRequest(cwd, context.branch, context.baseBranch, taskContent, workflow, pipelineConfig, options);
    75	      if (!prUrl) {
    76	        return { exitCode: EXIT_PR_CREATION_FAILED, result: buildResult({ branch: context.branch }) };
    77	      }
    78	    } else if (autoPr && skipGit) {
    79	      info('--auto-pr is ignored when --skip-git is specified (no push was performed)');
    80	    }
    81	
    82	    blankLine();
    83	    const safeWorkflow = sanitizeTerminalText(workflow);
    84	    const issueStatus = taskContent.issue
    85	      ? `#${taskContent.issue.number} "${sanitizeTerminalText(taskContent.issue.title)}"`
    86	      : 'N/A';
    87	    const branchStatus = context.branch ? sanitizeTerminalText(context.branch) : '(current)';
    88	    status('Issue', issueStatus);
    89	    status('Branch', branchStatus);
    90	    status('Workflow', safeWorkflow);
    91	    status('Result', 'Success', 'green');
    92	
    93	    return { exitCode: 0, result: buildResult({ success: true, branch: context.branch, prUrl }) };
    94	  } finally {
    95	    taskContent.attachmentCleanup?.();
    96	  }
    97	}
    98	export async function executePipeline(options: PipelineExecutionOptions): Promise<number> {
    99	  const startTime = Date.now();
   100	  const runId = generateRunId();
   101	  let pipelineResult: PipelineResult = { success: false, workflow: options.workflow, issueNumber: options.issueNumber };
   102	
   103	  try {
   104	    const outcome = await runPipeline(options);
   105	    pipelineResult = outcome.result;
   106	    return outcome.exitCode;
   107	  } finally {
   108	    await notifySlack(runId, startTime, pipelineResult);
   109	  }
   110	}
   111	
   112	interface PipelineResult {
   113	  success: boolean;
   114	  workflow: string;
   115	  issueNumber?: number;
   116	  branch?: string;
   117	  prUrl?: string;
   118	}
   119	
   120	async function notifySlack(runId: string, startTime: number, result: PipelineResult): Promise<void> {
   121	  const webhookUrl = getSlackWebhookUrl();
   122	  if (!webhookUrl) return;
   123	
   124	  const durationSec = Math.round((Date.now() - startTime) / 1000);
   125	  const task: SlackTaskDetail = {
   126	    name: 'pipeline',
   127	    success: result.success,
   128	    workflow: result.workflow,
   129	    issueNumber: result.issueNumber,
   130	    durationSec,
   131	    branch: result.branch,
   132	    prUrl: result.prUrl,
   133	  };
   134	  const message = buildSlackRunSummary({
   135	    runId,
   136	    total: 1,
   137	    success: result.success ? 1 : 0,
   138	    failed: result.success ? 0 : 1,
   139	    durationSec,
   140	    concurrency: 1,
   141	    tasks: [task],
   142	  });
   143	
   144	  await sendSlackNotification(webhookUrl, message);
   145	}
