   207	export async function interactiveMode(
   208	  cwd: string,
   209	  initialInput?: InteractiveSeedInput,
   210	  workflowContext?: WorkflowContext,
   211	  sessionId?: string,
   212	  runSessionContext?: RunSessionContext,
   213	  options?: InteractiveModeOptions,
   214	): Promise<InteractiveModeResult> {
   215	  const assistantMode = options?.assistantMode ?? 'assistant';
   216	  const baseCtx = initializeSession(cwd, getAssistantSessionPersona(assistantMode), {
   217	    provider: options?.provider,
   218	    model: options?.model,
   219	  });
   220	  const ctx = sessionId ? { ...baseCtx, sessionId } : baseCtx;
   221	
   222	  displayAndClearSessionState(cwd, ctx.lang);
   223	
   224	  const hasPreview = !!workflowContext?.stepPreviews?.length;
   225	  const hasRunSession = !!runSessionContext;
   226	  const runPromptVars = hasRunSession
   227	    ? formatRunSessionForPrompt(runSessionContext)
   228	    : { runTask: '', runWorkflow: '', runStatus: '', runStepLogs: '', runReports: '' };
   229	
   230	  const systemPrompt = loadTemplate('score_interactive_system_prompt', ctx.lang, {
   231	    grillMe: assistantMode === 'grill-me',
   232	    hasWorkflowPreview: hasPreview,
   233	    workflowStructure: workflowContext?.workflowStructure ?? '',
   234	    stepDetails: hasPreview ? formatStepPreviews(workflowContext!.stepPreviews!, ctx.lang) : '',
   235	    hasRunSession,
   236	    ...runPromptVars,
   237	  });
   238	  const ui = getLabelObject<InteractiveUIText>('interactive.ui', ctx.lang);
   239	  const assistantInitContext = loadAssistantInitContext(cwd);
