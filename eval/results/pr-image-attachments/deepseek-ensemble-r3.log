    75	export function formatSessionStatus(state: SessionState, lang: 'en' | 'ja'): string {
    76	  const lines: string[] = [];
    77	
    78	  // Status line
    79	  if (state.status === 'success') {
    80	    lines.push(getLabel('interactive.previousTask.success', lang));
    81	  } else if (state.status === 'error') {
    82	    lines.push(
    83	      getLabel('interactive.previousTask.error', lang, {
    84	        error: state.errorMessage!,
    85	      }),
    86	    );
    87	  } else if (state.status === 'user_stopped') {
    88	    lines.push(getLabel('interactive.previousTask.userStopped', lang));
    89	  }
    90	
    91	  // Workflow name
    92	  lines.push(
    93	    getLabel('interactive.previousTask.workflow', lang, {
    94	      workflowName: state.workflowName,
    95	    }),
    96	  );
    97	
    98	  // Timestamp
    99	  const timestamp = new Date(state.timestamp).toLocaleString(lang === 'ja' ? 'ja-JP' : 'en-US');
   100	  lines.push(
   101	    getLabel('interactive.previousTask.timestamp', lang, {
   102	      timestamp,
   103	    }),
   104	  );
   105	
   106	  return lines.join('\n');
   107	}
