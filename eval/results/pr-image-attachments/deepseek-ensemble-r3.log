     5	export function detectImageMimeType(data: Buffer): string | null {
     6	  if (data.length >= 8
     7	    && data[0] === 0x89
     8	    && data[1] === 0x50
     9	    && data[2] === 0x4e
    10	    && data[3] === 0x47
    11	    && data[4] === 0x0d
    12	    && data[5] === 0x0a
    13	    && data[6] === 0x1a
    14	    && data[7] === 0x0a) {
